# ============================================================================
#  Machine Party 8-player mod (public repo) — boundaries
#
#  ⚠️ This file protects **contributors**. Building in this repo produces the game's own source code
#  (the unpacked src\ and the patched patch\). Those must **never be committed**.
#
#  Project red lines. Serve legitimate copies only, and never redistribute original game assets.
# ============================================================================

# ---- Game source produced during builds, never commit ------------------------
# src\   = vanilla scripts you unpacked from your own copy of the game (the game's source code)
# patch\ = fully patched scripts (also contain game source)
# Only the diff patches in patches\ are public. These two folders are local intermediates.
/src/
/patch/

# ---- Build outputs ------------------------------------------------------------
/patch_gdc/
/dist/
*.gdc

# ---- The game itself, never in any form ---------------------------------------
*.pck
*.exe
/game/
/game_test/

# ---- Third-party tool binaries. docs\BUILD.md links to them, no rehosting -------
/tools/gdre/
*.zip

# ---- Misc ---------------------------------------------------------------------
*.log
*.tmp
Thumbs.db
desktop.ini
.vs/
.vscode/
