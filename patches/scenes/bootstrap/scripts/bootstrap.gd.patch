 func check_debug_tools_launch(command_line_arguments):
@@ -36,8 +39,50 @@ func check_debug_tools_launch(command_line_arguments):
 	for arg in command_line_arguments:
 		if arg == "-debug-tools":
 			Globals.allow_singleplayer = true
+			if NetworkManager.MP8_DEV_TOOLS:
+				Globals.debug = true  # [MP8] Dev builds only. Triggers the debug lobby routing above
 			Globals.enable_debug_tools()
 
+		# [MP8] Fast-forward switches for automated testing.
+		#
+		# Iron rule - **only skip cutscenes outside minigames, never touch the timing inside a minigame.**
+		# Both items below happen before the minigame starts, so they are safe.
+		#   skipping_intro_cutscene → the opening animation of the match
+		#   debug_instant_start     → the cutscene of the minigame draw (intermission_cutscene_intro)
+		#
+		# ⚠️ The two items below were both tried and both backfired (2026-08-14). Don't add them back.
+		#
+		# ① debug_skip_intermission — the server skips the draw and goes straight to load_minigame()
+		#    before clients have built their nodes, so RPCs that arrive first are dropped entirely.
+		#    Tested in practice it caused 352 recv_nodes unauthorized errors (0 with it off).
+		#
+		# ② debug_skip_brief — skips the pre-game briefing and countdown, moving start_pattern() earlier.
+		#    Every disco_dodge tile has a timer in set_data_rpc() that "after 7 seconds swaps the displayed symbol at random
+		#    without updating symbol_index" (a display/index dual-state hazard that ships with vanilla).
+		#    In the normal flow the briefing + countdown lasts far longer than 7 seconds, so those timers are long done. With it skipped,
+		#    start_pattern() sets the symbols correctly first, then the 7-second timers fire and change the display to random symbols,
+		#    so the display and the actual logic come apart - **tiles that should collapse don't, and tiles that shouldn't collapse do**.
+		#    This symptom looks a lot like "8 players broke the minigame", but it has nothing to do with player count.
+		if NetworkManager.MP8_DEV_TOOLS and arg == "mp8fast":
+			Globals.debug_instant_start = true
+			Globals.skipping_intro_cutscene = true
+			print("[MP8] mp8fast: only skipping cutscenes outside minigames (in-match timing untouched)")
+
+		# [MP8] Skip only the opening animation and **touch no timing at all** (`play.ps1 -Clean` uses this).
+		#
+		# `mp8fast` actually bundles two things, and they can be split apart.
+		#   `skipping_intro_cutscene` → skips the opening animation of the match. This is a **normal option built into the game**,
+		#       the lobby has a "skip intro" button for it (`lobby_scene.gd:331`). It is not a debug hack, and real players often turn it off too.
+		#   `debug_instant_start` → also skips `set_intermission_viewport_screen(true)` in the draw cutscene
+		#       and a 1-second wait, **compressing the in-match lead-up timing** (pitfall #20 - tested in practice, one match produced
+		#       320 extra recv_nodes unauthorized errors).
+		#
+		# When judging "is it fun / is it behaving normally" we only want the former. We skip watching the opening animation every match,
+		# without the fast-forward switch creating fake bugs.
+		if NetworkManager.MP8_DEV_TOOLS and arg == "mp8skipintro":
+			Globals.skipping_intro_cutscene = true
+			print("[MP8] mp8skipintro: skipping opening animation, in-match timing same as real players")
+
 func check_game_invite_launch(command_line_arguments):
 	var join_lobby = false
 	var lobby_code = -1
