 		get_tree().call_deferred("change_scene_to_file", local_development_scene)
 		return
 
-	if OS.has_feature("editor") and Globals.debug:
+	# [MP8] The debug lobby stays editor-only, as in vanilla, except in dev builds of this mod (MP8_DEV_TOOLS)
+	if (OS.has_feature("editor") or NetworkManager.MP8_DEV_TOOLS) and Globals.debug:
 
