+# [MP8] Switch for the capacity guard, set at the end of _ready().
+#
+# It guards against the sequence below — which can only happen **when another mod is installed**,
+# and when Overtime runs on its own this code never triggers even once.
+#
+#   1. Host a lobby: steam_backend.join_host() passes max_player_count to Steam.createLobby(), 8 players, all normal
+#   2. Some mod writes NetworkManager.max_player_count as 4 at runtime
+#      (a known case is MachineParty+'s "Make Lobby Public", whose MAX_PLAYERS_CAP is hard-coded to 4)
+#   3. Leave the lobby for the main menu: create_backend() only rebuilds the backend, **this autoload is not rebuilt**, so that 4 survives
+#   4. Host again: createLobby(..., 4) — the new lobby only admits 4 players
+#   5. No code ever changes it back. Only restarting the game fixes it
+#
+# What makes this bug nasty is that it **survives across lobbies, has no visible cause, and is completely silent**.
+# The corruption happens in one match and shows up in the next. The host sees a perfectly normal lobby,
+# except the 5th player can't get in.
+#
+# ⚠️ The guard itself fixes step 2, but the real value is that push_warning line —
+# when a player reports "my lobby only admits 4 people", the log names exactly who did it and what it was lowered to,
+# instead of a cross-session witch hunt.
+#
+# Only blocks "shrinking", not "growing". If someone really makes a 12-player mod in the future, let it through.
+#
+# Locking at the end of _ready() is safe. Autoloads are added with add_child and run _ready one at a time,
+# the loader (if any) comes before this node, and every mod's initialization runs before this line.
+# Our own -trailer branch (which lowers capacity to 5) also runs before the lock, so it's unaffected.
+var _mp8_cap_locked: bool = false
+
+# The capacity we settle on once locked. It's pinned to this value — **both smaller and larger are blocked**.
+#
+# Originally it only blocked "shrinking", which had a ratchet flaw. Once a mod wrote 9, the floor became 9,
+# and after that even writing 8 back was blocked. In a more extreme case, writing 100 would blow up the seat array outright.
+# And "allow growing" was originally a gap left for a hypothetical 12-player mod — but that kind of mod
+# would have to replace network_manager.gd wholesale (MAX_PLAYERS is a const, inlined everywhere),
+# and would never write this variable at runtime. The gap went unused and only left the flaw behind, so it's closed.
+var _mp8_cap_want: int = MAX_PLAYERS
+
+# Rate limit for push_warning. If a mod writes this every frame, without a limit that's one log line per frame,
+# enough to bloat godot.log to hundreds of MB within a few minutes. The same value is only reported the first time,
+# then at most one more line every 5 seconds, including the number of suppressed writes.
+var _mp8_cap_warn_at: float = -1.0
+var _mp8_cap_warn_val: int = -0x7FFFFFFF
+var _mp8_cap_warn_skipped: int = 0
+
+var max_player_count: int = MAX_PLAYERS:
+	set(v):
+		if _mp8_cap_locked and v != _mp8_cap_want:
+			_mp8_cap_warn(v)
+			return
+		max_player_count = v
+
+
+func _mp8_cap_warn(v: int) -> void :
+
+	var now: float = float(Time.get_ticks_msec()) / 1000.0
+
+	# Same value within 5 seconds — just count it, don't spam the log
+	if v == _mp8_cap_warn_val and _mp8_cap_warn_at >= 0.0 and now - _mp8_cap_warn_at < 5.0:
+		_mp8_cap_warn_skipped += 1
+		return
+
+	var tail: String = ""
+	if _mp8_cap_warn_skipped > 0:
+		tail = " (in the previous %.0f s, %d more identical writes were suppressed)" % [now - _mp8_cap_warn_at, _mp8_cap_warn_skipped]
+
+	push_warning("[MP8] External code tried to change lobby capacity from %d to %d, ignored%s (see _mp8_cap_locked)" % [
+		_mp8_cap_want, v, tail
+	])
+
+	_mp8_cap_warn_at = now
+	_mp8_cap_warn_val = v
+	_mp8_cap_warn_skipped = 0
 
 signal backend_ready()
 signal on_server_created()
