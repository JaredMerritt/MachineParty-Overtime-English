+# [MP8] ================ Runtime spawn point top-up ================
+# The spawn point containers in each minigame scene only hold 4 Markers (duck_hunt only has 3 duck spots).
+# spawn_players() reads positions[counter] with no modulo and no bounds check, so any extra
+# players get null, teleport_rpc aborts when it receives Nil, and those players stay at the default position.
+# Here, when a container enters the tree, it's topped up to MAX_PLAYERS, with each new spot at the midpoint of two adjacent original spots,
+# which keeps it inside the valid play area. No .tscn is changed, and all 17 minigames share this.
+
+const MP8_SPAWN_CONTAINERS: Array[String] = [
+	"playerspawnpositions",
+	"player spawn positions",
+	"spawnpositions",
+	"playerpositions",
+	"playerspawn",
+	"playerspawnparent",
+	# [MP8] "duckplayerspawnpositions" was **removed** from here (2026-08-15, T6b).
+	# The generic algorithm takes midpoints of adjacent points, and for Duck Hunt's 3 points it produces **overlapping** spawn points —
+	# with j=1 the midpoint of (-5,+5) = 0, exactly on top of a vanilla Marker3D. In testing, two pairs of ducks ended up stacked together.
+	# Duck Hunt now does its own top-up in _mp8_ensure_duck_spawns() in duck_hunt.gd,
+	# extending along the z=104 row at a spacing of 5, alternating between both sides.
+	# [MP8] "workstationspawns" was **removed** from here (2026-08-16, T21).
+	# Manufacture Gun's 4 stations sit in the corners of the arena, so the generic midpoints = the midpoints of the four edges,
+	# and in testing 3 of the 4 new spots landed inside solid objects (measured with probe33).
+	#   mid(0-1) @ (-7.29, 0.00) → collision box Box 4×4.5×9 of the wall with the recipe indicator lights, distance 0.00
+	#   mid(2-3) @ (10.75, 0.10) → pallet 0.10 + wall collision box 0.34
+	#   mid(3-0) @ ( 1.68,-7.88) → central parts table desk left 1.62 (workbench half-width 1.18, grazing it)
+	# Now manufacture_gun.gd's _mp8_expand_workstations() places them itself using "corner pairing"
+	# (each vanilla station is shifted 3.2 m along the wall toward the arena center, plus a partner desk).
+	# Only manufacture_gun uses this container name in the whole project (confirmed with grep), so removing it doesn't affect other minigames.
+	"spectatepositions",
+]
+
+# [MP8] A/B switches, used when debugging crashes to tell "caused by this mod's runtime changes" apart from "vanilla crashes anyway".
+#   mp8notopup  = skip the spawn point top-up
+#   mp8audit    = **print** the diagnostic log (see _mp8_audit_on below)
+# Both are passed on the command line and cached in _ready() (reading cmdline every frame or for every node is too wasteful).
+var _mp8_no_topup: bool = false
+
+# [MP8] 2026-08-25 changed from **an off switch to opt-in** (it used to be on unless `mp8noaudit` was passed).
+# 🩸 The reason is that in real-player match logs, the `[MP8-AUDIT]` dump made up **8.1%** (1174 of 14425 lines,
+# 30 lines per minigame load) — players never pass `mp8noaudit`, so **release builds were printing it the whole time**.
+# In the same log, Spine Breaker's `Node not found` was only 3.0%, and back then I even told the user "don't worry about it".
+# Our own always-on diagnostic noise was 2.7 times that, purely diagnostic with zero value for players — this is what should have been turned off first.
+#
+# Now it only prints in the editor, on the test rig with `-debug-tools`, or when `mp8audit` is passed explicitly.
+# Normal play (Steam double-click, nothing passed) is naturally quiet. `mp8noaudit` is kept as a forced off switch.
+var _mp8_audit_on: bool = false
+
+# [MP8] L1a — switch the Label of the main menu notice dialog to AUTOWRAP_WORD_SMART.
+#
+# Vanilla uses `AUTOWRAP_WORD`, which **only breaks lines at word boundaries**. Chinese has no spaces, so a whole Chinese sentence
+# never wraps at all, overflows horizontally, and gets both ends clipped by the outer clip_contents ScrollContainer
+# (in testing, the Chinese for "Versions don't match, both sides must be on the same version. You: v2.1.2+overtime-1.6" showed up as
+#  "don't match, both sides must be on the same version. You: v2.1.2+overtim", with both the start and the end missing).
+#
+# This isn't a problem we introduced — all of vanilla's Chinese notices (LOC_ROOM_DISBANDED and the like) are affected,
+# those strings are just short and happen not to exceed one line. Switching to WORD_SMART is a net improvement for them too.
+# The cost is that very long ASCII strings get cut in the middle (v2.1.2+ov / ertime-1.6). Readable, just not pretty.
+#
+# ⚠️ Only the wrap mode changes, **not the size**. Enlarging that 512×192 box (L1b) was tried too. It can be enlarged,
+# but naively giving it a fixed height makes the Label taller than the box and spill out at the top and bottom. It would have to be computed from the text's actual height.
+# The only gain would be "fitting more text", and the copy is already written to a ≤105 px budget, so it isn't done.
+func _mp8_fix_dialog_label(handler) -> void :
+
+	if handler == null or not is_instance_valid(handler):
+		return
+	var lbl = handler.get("message_label")
+	if lbl == null or not is_instance_valid(lbl) or not (lbl is Label):
+		print("[MP8] Dialog Label not found, skipping the wrap fix (doesn't affect functionality)")
+		return
+	(lbl as Label).autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+
+
+func _mp8_on_node_added(node: Node) -> void :
+
+	if node is MultiplayerMenuLobbyHandler:
+		_mp8_extend_lobby.call_deferred(node)
+		return
+
+	# [MP8] L1a - wrap mode of the main menu notice dialog (see _mp8_fix_dialog_label)
+	if node is DialogMessageHandler:
+		_mp8_fix_dialog_label.call_deferred(node)
+		return
+
+	# [MP8] Match start snapshot — **always** prints one line (same reason as _mp8_boot_banner).
+	# When a player reports "XX got stuck" or "someone is missing", this line pins "which minigame, how many players, host or client"
+	# into the log. Without it, the report alone can't tell whether it's that minigame's problem or a problem with a player-count tier —
+	# and in this project those are completely different debugging paths.
+	if node is Minigame:
+		print("[MP8] Match start: %s | %d players | this peer=%s" % [
+			String(node.name),
+			PlayerManager.player_presences.size(),
+			("host" if multiplayer.is_server() else "client"),
+		])
+
+	# [MP8-AUDIT] Read-only diagnostic. When a minigame enters the tree, print every spawn-related node/array without changing anything
+	if node is Minigame and _mp8_audit_on:
+		_mp8_audit.call_deferred(node)
+
+	if _mp8_no_topup:
+		return
+
+	# [MP8] T4b - array-style spawn points (see the long comment on _mp8_topup_spawn_arrays below)
+	if node is Minigame:
+		_mp8_topup_spawn_arrays.call_deferred(node)
+
+	if not MP8_SPAWN_CONTAINERS.has(String(node.name).to_lower()):
+		return
+
+	_mp8_topup.call_deferred(node)
+
+# The lobby player display slots (3D model + nametag + customization assigner) are @export arrays, and the scene only fills in 4 entries.
+# update_player_list() indexes them one by one by counter, so the 5th player goes out of bounds and doesn't show up.
+# Here the last display slot is copied and laid out further along the spacing of the last two, up to MAX_PLAYERS.
+func _mp8_extend_lobby(h) -> void :
+
+	if not is_instance_valid(h):
+		return
+
+	var n: int = h.players.size()
+
+	print("[MP8] extend_lobby hit handler=%s players=%d models=%s" % [
+		str(h.get_path()), n, str(h.get("player_models"))
+	])
+
+	if n < 2 or n >= MAX_PLAYERS:
+		print("[MP8]   skipped (n=%d is not between 2..%d)" % [n, MAX_PLAYERS])
+		return
+
+	if h.customization_assigners.size() < n or h.nametags.size() < n:
+		return
+
+	var parent = h.players[0].get_parent()
+
+	# The 4 vanilla slots are already correct (the artist baked the real placement into Armature local coordinates,
+	# and each slot's offset is different, so never rearrange them).
+	# The approach is to copy these 4 slots as a whole, then shift the whole set to form a second row.
+	# The copies inherit exactly the same baked offsets, so the second row is laid out just like vanilla, only moved forward.
+	for j in range(MAX_PLAYERS - n):
+
+		var src_slot = h.players[j % n]
+		var src_assigner = h.customization_assigners[j % n]
+		var src_nametag = h.nametags[j % n]
+
+		if not src_slot.is_ancestor_of(src_assigner) or not src_slot.is_ancestor_of(src_nametag):
+			print("[MP8] Display slot %d has an unexpected structure, skipping" % (j % n))
+			continue
+
+		var rel_a: NodePath = src_slot.get_path_to(src_assigner)
+		var rel_t: NodePath = src_slot.get_path_to(src_nametag)
+
+		var dup = src_slot.duplicate()
+		dup.name = "MP8Slot%d" % (n + j)
+		parent.add_child(dup)
+		dup.position = src_slot.position + MP8_ROW2_OFFSET
+		dup.visible = false
+
+		h.players.append(dup)
+		h.customization_assigners.append(dup.get_node(rel_a))
+		h.nametags.append(dup.get_node(rel_t))
+
+	# Chairs get copied too. The visible decorative chairs in the scene are duplicated as a group and shifted by the same amount,
+	# so the players in the second row land in the same relative positions as in vanilla.
+	_mp8_clone_chairs(parent, MP8_ROW2_OFFSET)
+
+	# The second row is closer to the camera, so pull the camera back a little for some margin
+	var cam = parent.get_parent().get_node_or_null("Camera3D")
+	if cam:
+		var before = cam.position
+		cam.position = Vector3(before.x, before.y * 1.08, before.z * 1.22)
+		print("[MP8] camera %s -> %s" % [str(before), str(cam.position)])
+
+	print("[MP8] lobby slots: %d -> %d (second row offset %s)" % [n, h.players.size(), str(MP8_ROW2_OFFSET)])
+
+	# Print once right after laying out, and again 4 seconds later.
+	# Same both times -> the formula works but the visual judgment was wrong. Different -> something else overwrote it.
+	_mp8_dump_slots(h, "just laid out")
+	await get_tree().create_timer(4.0).timeout
+	if is_instance_valid(h):
+		_mp8_dump_slots(h, "after 4s")
+
+
+# Offset of the second row relative to the 4 vanilla slots. This is the only number that needs tuning.
+#   larger z = closer to the camera (lower on screen), larger x = further right.
+const MP8_ROW2_OFFSET := Vector3(0.6, 0.0, 5.2)
+
+
+# Duplicate the visible decorative chairs in the scene as a group and shift them by the same amount,
+# so the second row's players and chairs line up with each other exactly as in vanilla.
+func _mp8_clone_chairs(parent, offset: Vector3) -> void :
+
+	var env = parent.get_parent().get_node_or_null("lobby environment1")
+	if env == null:
+		print("[MP8] Can't find lobby environment1, skipping chairs")
+		return
+
+	if env.has_node("MP8ChairRow"):
+		return
+
+	var holder := Node3D.new()
+	holder.name = "MP8ChairRow"
+	env.add_child(holder)
+
+	var cloned: int = 0
+	for c in env.get_children():
+		if c == holder:
+			continue
+		if not (c is Node3D) or not c.visible:
+			continue
+		if not String(c.name).to_lower().begins_with("chair"):
+			continue
+		var d = c.duplicate()
+		d.name = "MP8" + String(c.name)
+		holder.add_child(d)
+		d.transform = c.transform
+		d.position = c.position + offset
+		d.visible = true
+		cloned += 1
+
+	print("[MP8] Copied %d chairs, offset %s" % [cloned, str(offset)])
+
+
+func _mp8_dump_slots(h, tag: String) -> void :
+
+	# [MP8] 2026-08-25 a diagnostic dump from the same family as _mp8_audit, switched to opt-in along with it.
+	if not _mp8_audit_on:
+		return
+
+	print("[MP8] ---- Display slot positions (%s) ----" % tag)
+	for i in h.players.size():
+		var s = h.players[i]
+		if not is_instance_valid(s):
+			print("[MP8]   slot %d <invalid>" % i)
+			continue
+		print("[MP8]   slot %d '%s' pos=%s gpos=%s vis=%s chair=%s" % [
+			i, str(s.name), str(s.position), str(s.global_position),
+			str(s.visible), str(_mp8_find_chair(s))
+		])
+
+
+# Look for a chair mesh in the display slot's subtree. Found -> the chair moves with the slot. Not found -> the chair is separate scene decoration.
+func _mp8_find_chair(node: Node) -> String :
+
+	for c in node.get_children():
+		if String(c.name).to_lower().contains("chair"):
+			return String(c.name)
+		var deeper: String = _mp8_find_chair(c)
+		if deeper != "":
+			return deeper
+	return ""
+
+# [MP8-AUDIT] Purely read-only diagnostic. Changes no nodes and no arrays, only prints logs.
+# The goal is to see in a single match where each minigame's spawn points actually live, and which ones MP8_SPAWN_CONTAINERS doesn't cover.
+# The source stores spawn points in two ways - container nodes (points via get_children) and @export Array[Node3D] (a plain array of references),
+# and the latter has no "container" at all, so both kinds are printed here.
+func _mp8_audit(mg: Node) -> void :
+
+	if not is_instance_valid(mg):
+		return
+
+	var script_path: String = "?"
+	if mg.get_script():
+		script_path = String(mg.get_script().resource_path)
+
+	print("[MP8-AUDIT] ========== Minigame '%s' ==========" % str(mg.name))
+	print("[MP8-AUDIT] script=%s is_server=%s players=%d" % [
+		script_path, str(multiplayer.is_server()), PlayerManager.player_presences.size()
+	])
+
+	print("[MP8-AUDIT] -- Script properties --")
+	for p in mg.get_property_list():
+
+		if not (int(p.get("usage", 0)) & PROPERTY_USAGE_SCRIPT_VARIABLE):
+			continue
+
+		var pname: String = String(p.get("name", ""))
+		var v = mg.get(pname)
+
+		if v is Array:
+			if v.size() > 0 and v.size() < MAX_PLAYERS:
+				print("[MP8-AUDIT]   [array] %s length=%d" % [pname, v.size()])
+			continue
+
+		if v is Node3D:
+			var ln: String = pname.to_lower()
+			if ln.contains("spawn") or ln.contains("position"):
+				print("[MP8-AUDIT]   [container] %s -> '%s' children=%d" % [
+					pname, str(v.name), v.get_child_count()
+				])
+
+	print("[MP8-AUDIT] -- Nodes in the subtree with spawn/position --")
+	_mp8_audit_walk(mg, mg, 0)
+	print("[MP8-AUDIT] ========== Diagnostic done ==========")
+
+
+func _mp8_audit_walk(root: Node, node: Node, depth: int) -> void :
+
+	if depth > 8:
+		return
+
+	for c in node.get_children():
+
+		var ln: String = String(c.name).to_lower()
+		if ln.contains("spawn") or ln.contains("position"):
+
+			print("[MP8-AUDIT]   %s [%s] children=%d" % [
+				str(root.get_path_to(c)), c.get_class(), c.get_child_count()
+			])
+
+			# Print the point coordinates too. The top-up needs to "copy with a shift at the vanilla spacing",
+			# so first we need to know what the vanilla spacing is. Reading the .scn statically doesn't work (binary + script dependencies),
+			# and reading at runtime gives real world coordinates, which is more accurate anyway.
+			if c.get_child_count() > 0 and c.get_child_count() <= 12:
+				for gc in c.get_children():
+					if gc is Node3D:
+						print("[MP8-AUDIT]       %-22s pos=%s gpos=%s rot=%s" % [
+							str(gc.name), str(gc.position),
+							str(gc.global_position), str(gc.rotation_degrees)
+						])
+
+			if c is Node3D:
+				print("[MP8-AUDIT]       (container itself) gpos=%s" % str(c.global_position))
+
+		_mp8_audit_walk(root, c, depth + 1)
+
+
+# [MP8] ============ T4b - top-up for array-style spawn points ============
+#
+# Spawn points are stored **in two ways** in the source, and the node-name allowlist (MP8_SPAWN_CONTAINERS) only covers the first.
+#
+#   (a) container style  `@export var xxx_node: Node3D`        points come from node.get_children()
+#   (b) array style      `@export var xxx: Array[Node3D]`      **indexes the array directly**
+#
+# Style (b) has no concept of a "container" at all — stuffing Markers into the `PlayerSpawnPositions` container does nothing,
+# because spawn_players() reads that array with its 4 baked-in references. The three style (b) minigames
+# (Exploding Collar Race 1 / Escalator Pit 2 / Smoke Break 4) couldn't be adapted because of this, which is P1-C in HANDOFF.
+#
+# The property name `player_spawn_positions` is **a fact read out of the decompiled source one by one, not a guess**.
+# green_pea uses the same property name but stores a container (Node3D) in it, so here it branches by **type**.
+# Only a real Array takes this path. Containers still go down the already-verified node-name path, so the two don't clash.
+const MP8_SPAWN_ARRAY_PROPS: Array[String] = [
+	"player_spawn_positions",
+]
+
+
+func _mp8_topup_spawn_arrays(mg: Node) -> void :
+
+	if not is_instance_valid(mg):
+		return
+
+	# Minigames that manage their own spawn points (Escalator Pit places by escalator track, Duck Hunt by the duck row) are left alone here.
+	# The flag is read with Object.get(), which returns null without an error when the property doesn't exist.
+	if mg.get("mp8_owns_spawns") == true:
+		return
+
+	for pname in MP8_SPAWN_ARRAY_PROPS:
+
+		var arr = mg.get(pname)
+		if not (arr is Array):
+			continue
+		if arr.size() == 0 or arr.size() >= MAX_PLAYERS:
+			continue
+
+		var originals: Array = []
+		for e in arr:
+			if not (e is Node3D):
+				originals.clear()
+				break
+			originals.append(e)
+		if originals.is_empty():
+			continue
+
+		var pts: Array[Vector3] = []
+		for o in originals:
+			pts.append(o.global_position)
+
+		var extra: Array[Vector3] = _mp8_spread_inside(pts, MAX_PLAYERS)
+
+		var holder: Node = originals[0].get_parent()
+		var added := PackedStringArray()
+
+		for p in extra:
+			# The template is **the original point nearest to the new point**. Properties other than position (rotation, scale, script)
+			# are inherited from the nearest one. Smoke Break uses global_rotation, and copying the wrong facing would leave players with their backs to the railing.
+			var tmpl: Node3D = originals[0]
+			var best: float = INF
+			for o in originals:
+				var d: float = o.global_position.distance_to(p)
+				if d < best:
+					best = d
+					tmpl = o
+
+			var dup: Node3D = tmpl.duplicate()
+			dup.name = "MP8Spawn%d" % arr.size()
+			holder.add_child(dup)
+			dup.global_position = p
+			arr.append(dup)
+			added.append("(%.2f, %.2f, %.2f)" % [p.x, p.y, p.z])
+
+		# Self-check - print the minimum spacing. Two points overlapping is the most typical way this kind of top-up goes wrong
+		# (the generic midpoint algorithm produces overlapping spots for 3 points, which bit us in Duck Hunt),
+		# and you can't tell from the "4 -> 8 succeeded" log line alone.
+		var min_d: float = INF
+		for i in arr.size():
+			for j in range(i + 1, arr.size()):
+				min_d = minf(min_d, arr[i].global_position.distance_to(arr[j].global_position))
+
+		print("[MP8] spawn array '%s' (%s): %d -> %d, added %s, min spacing %.2f m%s" % [
+			pname, str(mg.name), originals.size(), arr.size(),
+			", ".join(added), min_d,
+			"  ⚠️ Too close!" if min_d < 0.8 else ""
+		])
+
+
+# Pick want-n more points **inside the convex hull** of the original points, maximizing the minimum spacing between all points.
+#
+# Two hard constraints, both learned from pitfalls hit in practice.
+#   1. **Don't move the original points** — the vanilla coordinates are the only thing vouched for as "definitely in bounds".
+#   2. **New points can only be convex combinations of original points** — a convex combination always lands inside the hull, so it can never end up outside the arena
+#      (the first Duck Hunt version expanded outward at the original spacing, and in testing someone jumped off the map).
+#
+# The method is farthest-point insertion. The candidate pool = the 1/8..7/8 division points between every pair of original points,
+# and each round picks the one "farthest from the already chosen set". Much more robust than "midpoint of adjacent points" —
+# the latter produces **two exactly overlapping** new points for 4 evenly spaced collinear points (in testing, Escalator Pit's
+# mid(1,2) and mid(3,0) were 0.02 m apart, with two players stacked on top of each other).
+func _mp8_spread_inside(originals: Array[Vector3], want: int) -> Array[Vector3] :
+
+	var chosen: Array[Vector3] = originals.duplicate()
+	var result: Array[Vector3] = []
+
+	if originals.size() < 2 or want <= originals.size():
+		return result
+
+	var pool: Array[Vector3] = []
+	for i in originals.size():
+		for j in range(i + 1, originals.size()):
+			for k in range(1, 8):
+				pool.append(originals[i].lerp(originals[j], float(k) / 8.0))
+
+	while chosen.size() < want:
+
+		var best: Vector3 = pool[0]
+		var best_d: float = -1.0
+
+		for c in pool:
+			var d: float = INF
+			for ch in chosen:
+				d = minf(d, c.distance_to(ch))
+			if d > best_d:
+				best_d = d
+				best = c
+
+		chosen.append(best)
+		result.append(best)
+
+	return result
+
+
+func _mp8_topup(container: Node) -> void :
+
+	if not is_instance_valid(container):
+		return
+
+	# Minigames that manage their own spawn points shouldn't be touched via the container path either — otherwise the container gets stuffed with
+	# Markers **nobody reads** (Escalator Pit got 4 extra in testing), and the log would also print a line
+	# "PlayerSpawnPositions: 4 -> 8" that misleads debugging.
+	var up: Node = container
+	while up != null:
+		if up is Minigame:
+			if up.get("mp8_owns_spawns") == true:
+				return
+			break
+		up = up.get_parent()
+
+	var originals = container.get_children()
+	var n: int = originals.size()
+
+	if n == 0 or n >= MAX_PLAYERS:
+		return
+
+	for j in range(MAX_PLAYERS - n):
+
+		var a = originals[j % n]
+		var b = originals[(j + 1) % n]
+
+		if not (a is Node3D) or not (b is Node3D):
+			return
+
+		var extra = a.duplicate()
+		extra.name = "MP8Extra%d" % j
+		container.add_child(extra)
+		extra.position = a.position.lerp(b.position, 0.5 if j < n else 0.25)
+
+	print("[MP8] spawn container '%s': %d -> %d" % [container.name, n, container.get_child_count()])
+
