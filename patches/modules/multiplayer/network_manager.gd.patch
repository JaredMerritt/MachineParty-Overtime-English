+# [MP8] See the end of _ready(). Runs unconditionally, once per launch.
+func _mp8_boot_banner() -> void :
+
+	var loader: Node = get_tree().root.get_node_or_null("ModLoader")
+	var mods: Array = []
+	# Only treat it as MPML when both methods exist — other loaders
+	# (e.g. the godot-mod-loader family) may also name their autoload ModLoader,
+	# so reporting "MPML installed" from the node name alone would be a false positive.
+	var is_mpml: bool = loader != null \
+		and loader.has_method("mod_list") and loader.has_method("loader_version")
+
+	if is_mpml:
+		mods = loader.call("mod_list")
+
+	# Distribution route. With the MPML overlay pack, overtime is in the mods list.
+	# ModLoader present but no overtime = the player patched the PCK and also installed a loader separately (both side by side).
+	var via: String = "PCK repack"
+	if loader != null and not is_mpml:
+		via = "PCK repack + some other loader installed (not MPML)"
+	if is_mpml:
+		var has_overtime: bool = false
+		for m in mods:
+			if str(m).begins_with("overtime"):
+				has_overtime = true
+		via = "MPML overlay pack" if has_overtime else "PCK repack + MPML also installed"
+
+	print("[MP8] ======== Machine Party · Overtime ========")
+	print("[MP8] mod version  : %s" % MP8_VERSION_TAG)
+	print("[MP8] handshake    : %s" % Globals.game_version)
+	print("[MP8] player cap   : %d (vanilla 4)" % MAX_PLAYERS)
+	print("[MP8] install type : %s" % via)
+	if is_mpml:
+		print("[MP8] other mods   : %s" % (", ".join(PackedStringArray(mods)) if not mods.is_empty() else "(loader only)"))
+	# The resolved user data path contains the Windows account name, and this block gets posted publicly, so print the generic path instead
+	print("[MP8] log file     : %APPDATA%\\Godot\\app_userdata\\Machine Party\\logs\\godot.log")
+	print("[MP8] When reporting a bug, please paste this block too -> https://github.com/DarkJadeStone/MachineParty-Overtime/issues")
+	print("[MP8] =========================================")
+
+# [MP8] UID resolution self-test. Checks each uid:// used in the crashing minigames, whether it resolves to a path and whether it actually loads.
+# The control group is the res:// path used by Disco Dodge (that game is verified to run fine).
+func _mp8_uid_selftest() -> void :
+
+	var cases := [
+		["uid://cav2dhye17owt", "Duck Hunt - duck player"],
+		["uid://bg7h0g6d2m2xu", "Duck Hunt - hunter player"],
+		["uid://badl26ts540cw", "DVD Roomba - roomba"],
+		["uid://w6wpt3kvl74p",  "DVD Roomba - player"],
+		["uid://cyhptkj072mxh", "Green Pea - player"],
+		["uid://bwixccr50fbc2", "Briefing screen - input label (this mod has modified this script)"],
+	]
+
+	print("[MP8-UID] ========== UID resolution self-test ==========")
+
+	for c in cases:
+		var txt: String = c[0]
+		var who: String = c[1]
+
+		var id: int = ResourceUID.text_to_id(txt)
+		var known: bool = ResourceUID.has_id(id)
+		var path: String = ""
+		if known:
+			path = ResourceUID.get_id_path(id)
+
+		var loaded: String = "not tried"
+		if known:
