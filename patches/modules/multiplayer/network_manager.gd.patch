+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Frame time probe (opt-in via `mp8perf`) — finds which layer the 8-player lag is in
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# Background. Players reported "Train Race and Disco Dodge lag like a slideshow with 8 players, **for everyone**" (T50 ⑤).
+# Reading the code already ruled out four things (see HANDOFF T50 ⑤). It's not our per-frame code (not a single line was added),
+# not extra objects placed, not synchronizer traffic (lowest in these two levels), and not pure network latency (everyone lags).
+# Also, **8-player Duck Hunt doesn't lag** — so it's something specific to these two scenes × player count.
+#
+# At this point it's time to stop reading and start measuring. This probe prints a line every 2 seconds, splitting a frame's cost into three layers.
+#
+#   process   — script logic (GDScript in _process / _physics_process)
+#   physics   — physics stepping (rigid bodies, collisions, character controllers)
+#   draw/obj  — rendering (draw call count, drawn object count)
+#
+# **Whichever of the three grows with player count is the layer where the root cause lives** — that's the only purpose of this probe.
+# How to compare. With the same 8 instances, run Duck Hunt (no lag) and Train Race (lag) separately, and compare the numbers on the same line.
+#
+# It hangs off NetworkManager rather than a minigame script because NetworkManager is an autoload that persists across minigames.
+# One change covers all 15 minigames, otherwise the side-by-side comparison above wouldn't be possible.
+#
+# ⚠️ Uses a Timer instead of _process. This script has no _process, and adding one risks overriding the base class (same approach as T49).
+# ⚠️ Opt-in. A release player launching by double-click passes nothing → not a single byte is written (same rule as the diagnostic log).
+# ⚠️ Writes **one file per instance** instead of relying on print. With 8 instances all sharing one godot.log, the output overwrites itself,
+#    which already bit us once this round (see HANDOFF T49 "standing diagnostics"). Garbled perf data means the whole run was wasted.
+#    The file name uses the process id instead of the peer id — autoload _ready runs before the connection is set up, when there is no peer id yet.
+# ⚠️ Flush every line. After testing, the game is force-killed by stop.ps1, and without a flush everything in the buffer is lost.
+var _mp8_perf_on: bool = false
+var _mp8_perf_timer: Timer = null
+var _mp8_perf_f: FileAccess = null
+
+func _mp8_perf_start() -> void :
+
+	_mp8_perf_on = mp8_args().has("mp8perf")
+	if not _mp8_perf_on:
+		return
+
+	_mp8_perf_f = FileAccess.open("user://mp8_perf_%d.log" % OS.get_process_id(), FileAccess.WRITE)
+	print("[MP8-PERF] Frame time probe on (one line every 2 s) → user://mp8_perf_%d.log" % OS.get_process_id())
+
+	_mp8_perf_timer = Timer.new()
+	_mp8_perf_timer.wait_time = 2.0
+	_mp8_perf_timer.autostart = true
+	_mp8_perf_timer.timeout.connect(_mp8_perf_tick)
+	add_child(_mp8_perf_timer)
+
+
+func _mp8_perf_tick() -> void :
+
+	if not _mp8_perf_on:
+		return
+
+	# Which minigame is currently being played — without this, the side-by-side numbers can't be matched to a level
+	var where: String = "?"
+	if Globals != null:
+		var mg = Globals.get("current_minigame_identifier")
+		if mg != null:
+			where = str(mg)
+
+	var line: String = "[MP8-PERF] %-14s fps=%5.1f | script %6.2f ms | physics %6.2f ms | draw calls %5d | draw objects %5d | nodes %5d | players %d" % [
+		where,
+		Performance.get_monitor(Performance.TIME_FPS),
+		Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0,
+		Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1000.0,
+		int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),
+		int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME)),
+		int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)),
+		PlayerManager.player_presences.size() if PlayerManager != null else -1,
+	]
+	print(line)
+	if _mp8_perf_f != null:
+		_mp8_perf_f.store_line(line)
+		_mp8_perf_f.flush()
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] T53 **actionable messages** for version mismatches (2026-08-31)
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# Vanilla has just one sentence for every mismatch (`LOC_TAG_VERSION_MISMATCH`).
+#     "Connection failed. Your current game version does not match this lobby."
+# It doesn't tell the player **what to do** — because the handshake compares the whole string for equality
+# (`enet_backend.gd:133` / `steam_backend.gd:169`), and the four cases below all take the same path.
+#   my mod is older / my mod is newer / the host has no mod / I have no mod but the host does.
+# The first three need completely different actions (I update / host updates / uninstall and restore), and for the fourth
+# we can't even prompt the action "go install the mod". 1.5 is going to block another batch of people, so this time we spell it out.
+#
+# ── Why the two sides report their versions to each other ──
+# On refusal the client only has the `RefuseReason.VersionMismatch` enum and **doesn't know the host's version**,
+# so from that alone it can't tell "host is on vanilla" apart from "host is on a different mod version".
+# So the host reports its full version string **the moment each peer connects**, and the client replies with its own once it receives it.
+#
+# The criterion is **whether anything was received**, not what was received. Received → the string has the exact version, so we can work out who is newer.
+# Not received → the other side doesn't have this handshake. ⚠️ "Not installed" and "version too old" **can't be told apart**,
+# so the text can only say "no version reported", and can't claim "they don't have it installed".
+#
+# 🩸 **The two directions differ in precision (tested 2026-09-03, don't mix them up)**.
+#   · **Host judging a client**: a 1.5 client **does** reply (its mp8_hello_rpc replies to the server, and the host is the server)
+#     → once this is fixed, 1.5 players can be named precisely **right away**. Not received = vanilla or ≤1.4.
+#   · **Client judging the host**: a 1.5 host **will never** report — its hello hangs off `on_peer_connected`,
+#     and that signal is never emitted for refused players (that's exactly the bug fixed this time).
+#     So **for this 1.5↔1.6 mismatch, the client side can only land in case ③**, no matter what we change on our side.
+#     Not received = vanilla / ≤1.4 / **or 1.5**. Both sides need to be ≥ MP8_HELLO_SINCE for it to be precise.
+#
+# ── Why the fourth case (I have no mod, the host does) can only be shown on the host's screen ──
+# That client runs **vanilla code** that we can't change a single line of, so it will always show the vanilla sentence.
+# The only one who can still say anything is the host — so that message goes to **the host's lobby message bar**
+# (`lobby_handler.send_lobby_message`, built into vanilla and already used when copying the lobby code),
+# so the host can tell the person who can't get in. That's all that can be done for this case, don't count on the client side.
+#
+# ⚠️ The hello RPCs live on a separate child node, MP8Hello, not on NetworkManager itself.
+#    Godot identifies RPCs by their position in each node's sorted RPC list, so extra RPCs on NetworkManager would
+#    shift vanilla's and could land on a different method in another build. A vanilla or older client simply has no
+#    MP8Hello node, so the engine drops the message with one error line on their machine and nothing else happens.
+
+signal mp8_join_blocked(text: String)   # Host side - someone was blocked by version, carries the text to show the host
+
+var _mp8_host_version: String = ""              # Client side - the full version string reported by the host
+var _mp8_peer_versions: Dictionary = {}         # Host side - network_id -> that peer's version string
+var _mp8_peers_accepted: Dictionary = {}        # Host side - peers that were actually accepted (see below)
+var _mp8_hello: MP8Hello = null                 # The MP8Hello child node that carries the two hello RPCs
+
+
+# Carries the version hello in both directions. Version strings from the network are untrusted text, so both handlers
+# keep only a short run of version characters before storing anything.
+class MP8Hello extends Node:
+
+	# Client side - the host reports its version. Only the host may send this.
+	@rpc("any_peer", "call_remote", "reliable")
+	func hello_rpc(full_version: String) -> void :
+		if multiplayer.get_remote_sender_id() != 1:
+			return
+		var nm: Node = get_parent()
+		nm.set("_mp8_host_version", nm.call("mp8_clean_version", full_version))
+		hello_back_rpc.rpc_id(1, Globals.game_version)
+
+	# Host side - a client answers with its own version, stored under the peer that really sent it
+	@rpc("any_peer", "call_remote", "reliable")
+	func hello_back_rpc(full_version: String) -> void :
+		if not multiplayer.is_server():
+			return
+		var nm: Node = get_parent()
+		var versions: Dictionary = nm.get("_mp8_peer_versions")
+		versions[multiplayer.get_remote_sender_id()] = nm.call("mp8_clean_version", full_version)
+
+
+# 🩸 Fix from testing on 2026-09-03. The hook used to hang off `on_peer_connected`, and **that signal is never emitted for refused players**.
+#
+# The vanilla backend join chain (enet_backend.gd / steam_backend.gd have exactly the same shape)
+#     multiplayer.peer_connected      ← engine level, **emitted for everyone who connects**
+#       → _on_player_connected() → send_client_data_rpc.rpc_id(peer)
+#       → peer replies with receive_client_data_rpc(its own client_data)
+#           if client_game_version != Globals.game_version:
+#               refuse_client_rpc.rpc_id(peer, VersionMismatch)
+#               return                                   ← refused players take this path and stop here
+#       → acknowledge_client_data_rpc()
+#             on_peer_connected.emit()                   ← **only players who pass the version check get here**
+#
+# The consequence (tested) is that players with a mismatched version never receive a single hello,
+#   · the host-side "someone was kept out" (case ④) **has never fired**,
+#   · on the client side `_mp8_host_version` is always empty → `mp8_mismatch_text()` always lands in case ③,
+#     so the three branches ①②⑤ are **unreachable**.
+# A control experiment confirmed it. When a vanilla client was refused, its log didn't even have "method does not exist" (= the host never sent hello),
+# while on a successful same-version join the host's `_mp8_peer_versions` did hold the peer's version (= the mechanism itself works).
+#
+# The fix is to hook the **engine-level** `multiplayer.peer_connected` instead.
+# We connect in the autoload's _ready(), earlier than the backend node does (it's only created at `set_active_backend`),
+# so our hello goes out **before** `send_client_data_rpc`. Both are reliable and on the same channel,
+# so hello is guaranteed to reach the peer before the refusal does.
+#
+# ⚠️ This also drops the old "wait 2 seconds and check" approach. In testing, going from peer_connected to
+# peer_disconnected took only **2 ms** (local ENet, very high lobby frame rate), so after 2 seconds everyone was long gone.
+# The decision now hangs off `peer_disconnected` — a deterministic moment, not a guessed duration.
+func _mp8_version_hooks() -> void :
+
+	_mp8_hello = MP8Hello.new()
+	_mp8_hello.name = "MP8Hello"
+	add_child(_mp8_hello)
+
+	multiplayer.peer_connected.connect(_mp8_on_raw_peer_connected)
+	multiplayer.peer_disconnected.connect(_mp8_on_raw_peer_disconnected)
+
+	# The game-level on_peer_connected = "this person passed the version check and was accepted".
+	# We record it, so on `peer_disconnected` we can tell "left normally" apart from "was kept out".
+	on_peer_connected.connect(func(nid): _mp8_peers_accepted[nid] = true)
+
+
+# Host - as soon as anyone connects (**before the version check**), report our own version first.
+func _mp8_on_raw_peer_connected(network_id: int) -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	_mp8_hello.hello_rpc.rpc_id(network_id, Globals.game_version)
+
+
+# Host - a peer disconnected. If it was never accepted, it was blocked by version — this is the trigger for case ④.
+func _mp8_on_raw_peer_disconnected(network_id: int) -> void :
+
+	var theirs: String = String(_mp8_peer_versions.get(network_id, ""))
+	_mp8_peer_versions.erase(network_id)
+
+	if not multiplayer.is_server():
+		return
+
+	# Someone who played a match normally and then left was accepted, not refused
+	if _mp8_peers_accepted.has(network_id):
+		_mp8_peers_accepted.erase(network_id)
+		return
+
+	# They're not on the accepted list → they connected but never got in. Across both the ENet and Steam backends,
+	# the only branch that leaves someone "connected but not accepted" is the version mismatch one.
+	mp8_join_blocked.emit(_mp8_blocked_text_for_host(theirs))
+
+
+# Version strings from the network are untrusted. Keep at most 64 version characters (letters, digits, . + -)
+# so a peer can't put arbitrary sentences, links or megabytes of text into the refusal dialog or the host's lobby bar.
+func mp8_clean_version(s: String) -> String :
+	var out: String = ""
+	for ch in s.substr(0, 256):
+		if out.length() >= 64:
+			break
+		var c: int = ch.unicode_at(0)
+		var ok: bool = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
+		if ok or ch == "." or ch == "+" or ch == "-":
+			out += ch
+	return out
+
+
+# Extract the mod tag from the full version string (none means an empty string = vanilla). The string looks like `v2.1.2+overtime-1.5`
+func _mp8_tag_of(full_version: String) -> String:
+	var i: int = full_version.find("+overtime-")
+	return "" if i < 0 else full_version.substr(i + 1)
+
+
+# Version comparison - `overtime-1.5` → [1, 5], compared segment by segment. An edition suffix like `-en` is ignored here.
+# Anything unrecognized counts as equal (better to say too little than to say it backwards).
+func _mp8_cmp_tag(a: String, b: String) -> int:
+	var pa := a.trim_prefix("overtime-").get_slice("-", 0).split(".")
+	var pb := b.trim_prefix("overtime-").get_slice("-", 0).split(".")
+	for i in maxi(pa.size(), pb.size()):
+		var x: int = int(pa[i]) if i < pa.size() and pa[i].is_valid_int() else 0
+		var y: int = int(pb[i]) if i < pb.size() and pb[i].is_valid_int() else 0
+		if x != y:
+			return -1 if x < y else 1
+	return 0
+
+
+# Edition suffix of a tag. `overtime-1.7-en` → "en", `overtime-1.6` → "" (the upstream edition).
+# Different editions never share a lobby, even with the same numbers, because their network protocols differ.
+func _mp8_edition_of(tag: String) -> String:
+	var v: String = tag.trim_prefix("overtime-")
+	var i: int = v.find("-")
+	return "" if i < 0 else v.substr(i + 1)
+
+
+func _mp8_zh() -> bool:
+	return TranslationServer.get_locale().to_upper().begins_with("ZH")
+
+
+# ── Client side - what to show on refusal ──────────────────────────────────────────────
+# Called by _on_join_refused in lobby_scene.gd, replacing tr("LOC_TAG_VERSION_MISMATCH").
+#
+# 🩸 **Read this section before changing anything here (tested 2026-09-03, all backed by archived screenshots).**
+#
+# The text ends up in the main menu's `DialogMessageHandler` (`GameManager.main_menu_dialog_message`
+# → a Label in `main_menu`). That Label sits in a **clip_contents=true
+# ScrollContainer**, wrapped in a fixed 512×192 Panel, and **has no visible scrollbar**.
+#
+#   · **Hard budget: the Label must be ≤ 105 px tall to be fully visible.** Anything beyond that is silently clipped.
+#     Chinese line height is 36 px (3 lines = 105). English line height is 29 px (3 lines = 87, **4 lines = 117 clips half a line**).
+#   · The 1.5 copy was "two paragraphs + two version-string lines", and in testing **only the first sentence showed** —
+#     players never saw a single word of the "what to do" part or the version strings. None of T53's value ever got through.
+#   · That leads to a hard trade-off. **In English you can only have one of the "opening label" and the "action sentence"**,
+#     since having both always takes 4 lines. Chinese is denser and fits both.
+#
+# ⚠️ One more thing (also tested). The Label's autowrap was originally `AUTOWRAP_WORD`, which **only breaks at word boundaries**.
+#    Chinese has no spaces, so a whole Chinese sentence **doesn't wrap** and overflows horizontally with both ends clipped.
+#    The 1.5 Chinese copy only survived by luck — it happened to contain ASCII words like `Overtime` and `1.4` that provided break points.
+#    It's now switched to `AUTOWRAP_WORD_SMART` at runtime by `_mp8_fix_dialog_label()` (see that function).
+#
+# **After any change, measure it again**. It can be checked locally without actually producing a version mismatch —
+# write `GameManager.main_menu_dialog_message` and call `check_for_message()` again,
+# which is exactly the same render path. (Remember to set `Globals.splash_screen_viewed = true` first,
+# otherwise the screen stays on the opening logo and the main menu UI never shows up.)
+
+# "The version from which the host actively reports its own version".
+# 🩸 **Check this number by hand when releasing**. It equals the version number this fix actually shipped in,
+# and doesn't follow MP8_VERSION_TAG by itself. Getting it wrong only makes the number in case ③'s sentence inaccurate, it doesn't affect functionality.
+const MP8_HELLO_SINCE: String = "1.7-en"
+
+
+# "v2.1.2+overtime-1.5" -> "1.5" (returns an empty string if there's no tag)
+func _mp8_tag_num(full_version: String) -> String:
+	return _mp8_tag_of(full_version).trim_prefix("overtime-")
+
+
+# "v2.1.2+overtime-1.5" -> "v2.1.2"
+func _mp8_base_of(full_version: String) -> String:
+	var i: int = full_version.find("+overtime-")
+	return full_version if i < 0 else full_version.substr(0, i)
+
+
+func mp8_mismatch_text() -> String:
+
+	var zh: bool = _mp8_zh()
+	var mine: String = Globals.game_version
+	var theirs: String = _mp8_host_version
+
+	# ③ The host reported no version → vanilla, or older than MP8_HELLO_SINCE (those versions don't report).
+	#    The two can't be told apart, so only state the observable fact "not reported", and don't claim "the host has no mod".
+	if theirs.is_empty():
+		if zh:
+			return ("Can't join: host sent no Overtime version (maybe missing or below "
+				+ MP8_HELLO_SINCE + ").\nYour version: " + mine)
+		return ("Version mismatch: the host reported no Overtime version.\nYour build: " + mine)
+
+	var my_tag: String = _mp8_tag_of(mine)
+	var their_tag: String = _mp8_tag_of(theirs)
+	var cmp: int = _mp8_cmp_tag(my_tag, their_tag)
+
+	# The version line lists **only the part that differs**. ①② differ in the mod version, ⑤ differs in the base game.
+	# Two full strings won't fit in 3 lines, and in these cases the player knows both versions, so the full strings don't need relaying.
+	# (Only case ③ keeps the full string — that's exactly what gets sent to the host to check.)
+
+	# ⑥ A different edition of Overtime (for example upstream 1.6 and 1.7-en). They can never share a lobby.
+	if _mp8_edition_of(my_tag) != _mp8_edition_of(their_tag):
+		return ("Can't join: this lobby runs a different Overtime edition.\nYou "
+			+ _mp8_tag_num(mine) + " / Host " + _mp8_tag_num(theirs))
+
+	# ⑤ Same mod version but still refused → the difference is the base game
+	if cmp == 0:
+		if zh:
+			return ("Can't join: same Overtime version, different base game version.\nYou "
+				+ _mp8_base_of(mine) + " / Host " + _mp8_base_of(theirs))
+		return ("Version mismatch: same Overtime build, different game version.\nYou "
+			+ _mp8_base_of(mine) + " · Host " + _mp8_base_of(theirs))
+
+	# ① My version is older
+	if cmp < 0:
+		if zh:
+			return ("Can't join: your Overtime is older. Get the new version and reinstall.\nYou "
+				+ _mp8_tag_num(mine) + " / Host " + _mp8_tag_num(theirs))
+		return ("Version mismatch: your Overtime build is older.\nYou "
+			+ _mp8_tag_num(mine) + " · Host " + _mp8_tag_num(theirs))
+
+	# ② My version is newer
+	if zh:
+		return ("Can't join: your Overtime is newer. Ask the host to update to match.\nYou "
+			+ _mp8_tag_num(mine) + " / Host " + _mp8_tag_num(theirs))
+	return ("Version mismatch: your Overtime build is newer.\nYou "
+		+ _mp8_tag_num(mine) + " · Host " + _mp8_tag_num(theirs))
+
+
+# ── Host side - ④ a one-line notice to the host when someone can't get in ────────────────────────────
+# This is the **only** place where the fourth case (the peer has no mod) can say anything, see the notes at the start of this section.
+func _mp8_blocked_text_for_host(their_version: String) -> String:
+
+	# ⚠️ This one ends up in the **lobby message bar** (lobby_handler.send_lobby_message),
+	#    which is a different control from the client's dialog, and its length limit **hasn't been measured**. Written short for now.
+	var zh: bool = _mp8_zh()
+	var tag: String = MP8_VERSION_TAG.trim_prefix("overtime-")
+
+	# Don't hard-code "below X". This text is for the host, and the host's own tag and MP8_HELLO_SINCE
+	# aren't equal during development, so writing both numbers would contradict itself (in testing, "below 1.6. This lobby is on 1.5.").
+	if their_version.is_empty():
+		if zh:
+			return ("A player was refused (version mismatch): they don't have Overtime, or theirs is too old. "
+				+ "This lobby is on " + tag + ".")
+		return ("A player was refused: no Overtime, or a build too old. This lobby is on "
+			+ tag + ".")
+
+	var their_tag: String = _mp8_tag_num(their_version)
+	if their_tag.is_empty():
+		if zh:
+			return "A player was refused (version mismatch): they are on vanilla. This lobby is on " + tag + "."
+		return "A player was refused: they are on vanilla. This lobby is on " + tag + "."
+
+	if _mp8_edition_of(_mp8_tag_of(their_version)) != _mp8_edition_of(MP8_VERSION_TAG):
+		return ("A player was refused: they run a different Overtime edition (" + their_tag
+			+ "), this lobby " + tag + ".")
+
+	var cmp: int = _mp8_cmp_tag(_mp8_tag_of(their_version), MP8_VERSION_TAG)
+	if cmp == 0:
+		if zh:
+			return ("A player was refused (version mismatch): same Overtime version, different base game version"
+				+ " (theirs " + _mp8_base_of(their_version) + ").")
+		return ("A player was refused: same Overtime build, different game version (theirs "
+			+ _mp8_base_of(their_version) + ").")
+
+	if zh:
+		return ("A player was refused (version mismatch): their Overtime " + their_tag
+			+ ", this lobby " + tag + ".")
+	return ("A player was refused: their Overtime " + their_tag
+		+ ", this lobby " + tag + ".")
+
+
+# ═════════════ [MP8] Re-asserting the Steam lobby member limit ═════════════
+#
+# The capacity guard (_mp8_cap_locked) can only protect the **variable** NetworkManager.max_player_count.
+# But the Steam lobby member limit is **Steam-side state**, set by Steam.setLobbyMemberLimit(),
+# which the guard can't reach.
+#
+# A known case is MachineParty+'s "Make Lobby Public", which runs
+#     max_players = clampi(max_players, MIN_PLAYERS, MAX_PLAYERS_CAP)   # CAP hard-coded to 4
+#     Steam.setLobbyMemberLimit(id, max_players)
+# As soon as the host flips that switch, Steam clamps the lobby to 4 — the 5th player gets refused by Steam directly,
+# and none of our logs make a sound (because it isn't our variable being changed).
+# Its UI stepper also only goes up to 4, so "I want an 8-player public lobby" simply can't be expressed
+# there — setting it back doesn't go against the host's wishes.
+#
+# The approach is to check every 2 seconds on the host side, and if it's below our capacity, set it back and log a line.
+# No tug-of-war. MP+ only sets the member limit once in publish(), and its 2-second timer only changes lobby data.
+#
+# ⚠️ Guarded throughout with has_method / has_signal — I can't statically confirm which methods this GodotSteam build exposes,
+# so if one is missing it quietly skips, and never crashes because of it.
+var _mp8_lobby_timer: Timer = null
+var _mp8_lobby_last_fix: int = -1
+
+
+func _mp8_lobby_guard_start() -> void :
+
+	_mp8_lobby_timer = Timer.new()
+	_mp8_lobby_timer.name = "MP8LobbySizeGuard"
+	_mp8_lobby_timer.wait_time = 2.0
+	_mp8_lobby_timer.autostart = true
+	_mp8_lobby_timer.timeout.connect(_mp8_enforce_lobby_size)
+	add_child(_mp8_lobby_timer)
+
+
+func _mp8_enforce_lobby_size() -> void :
+
+	if active_backend_type != NetworkBackendType.Steam:
+		return
+	if not (multiplayer and multiplayer.has_multiplayer_peer() and multiplayer.is_server()):
+		return
+	if active_backend == null:
+		return
+
+	# lobby_id only exists on the Steam backend subclass, not on the base MultiplayerBackend — read it duck-typed
+	var lobby_id: int = int(active_backend.get("lobby_id") if active_backend.get("lobby_id") != null else 0)
+	if lobby_id <= 0:
+		return
+
+	if not (Engine.has_singleton("Steam") or ClassDB.class_exists("Steam")):
+		return
+
+	# If there's a getter, read first and only restore the known clamp to 4 (MachineParty+ can't express more than 4).
+	# Any other lower limit, like 2 or 3, is the host's own choice and is left alone. Without a getter, just set it blindly (idempotent)
+	if Steam.has_method("getLobbyMemberLimit"):
+		var cur: int = int(Steam.getLobbyMemberLimit(lobby_id))
+		if cur != 4 or cur >= max_player_count:
+			return
+		if not Steam.has_method("setLobbyMemberLimit"):
+			return
+		Steam.setLobbyMemberLimit(lobby_id, max_player_count)
+		if _mp8_lobby_last_fix != cur:
+			_mp8_lobby_last_fix = cur
+			push_warning("[MP8] Steam lobby limit was lowered to %d by another mod (known case: MachineParty+'s 'Make Lobby Public'), set back to %d" % [cur, max_player_count])
+	else:
+		if Steam.has_method("setLobbyMemberLimit"):
+			Steam.setLobbyMemberLimit(lobby_id, max_player_count)
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Release hardening helpers, shared by every patched script
+# ═══════════════════════════════════════════════════════════════════════════
+
+# Launch arguments for the mod's own dev switches. Release builds (MP8_DEV_TOOLS false) always get an empty list,
+# so every mp8* flag keeps its default and none of the editors, debug keys or rule switches can be turned on.
+func mp8_args() -> Array :
+	if not MP8_DEV_TOOLS:
+		return []
+	return Array(OS.get_cmdline_args())
+
+
+# True when the RPC being handled was sent by the host, or is a local call.
+# RPCs that only the host is meant to send check this first, so a modified client can't call them on anyone.
+func mp8_sender_is_host(mp: MultiplayerAPI) -> bool :
+	var s: int = mp.get_remote_sender_id()
+	return s == 0 or s == 1
+
+
+# Range and finiteness checks for numbers that arrive over the network.
+# NaN, infinite or absurdly large transforms can break physics and rendering on every machine.
+func mp8_finite(x: float, limit: float = 100000.0) -> bool :
+	return is_finite(x) and absf(x) <= limit
+
+
+func mp8_finite_v2(v: Vector2, limit: float = 100000.0) -> bool :
+	return mp8_finite(v.x, limit) and mp8_finite(v.y, limit)
+
+
+func mp8_finite_v3(v: Vector3, limit: float = 100000.0) -> bool :
+	return mp8_finite(v.x, limit) and mp8_finite(v.y, limit) and mp8_finite(v.z, limit)
+
+
+# A name or label from another player, safe for a plain Label. Control characters such as newlines are dropped
+# (they could forge extra lines) and the length is capped.
+func mp8_plain_text(s: String, max_len: int = 32) -> String :
+	var out: String = ""
+	for ch in s.substr(0, max_len * 4):
+		if out.length() >= max_len:
+			break
+		var c: int = ch.unicode_at(0)
+		if c < 32 or c == 127:
+			continue
+		out += ch
+	return out
+
+
+# Text for a RichTextLabel with BBCode on. Every "[" becomes the [lb] escape tag, so the text can't open tags.
+func mp8_bbcode_text(s: String, max_len: int = 32) -> String :
+	return mp8_plain_text(s, max_len).replace("[", "[lb]")
+
+
+# Text that ends up inside a file name. Path and reserved characters are dropped as well, so it can't leave user://
+func mp8_file_text(s: String, max_len: int = 32) -> String :
+	var out: String = ""
+	for ch in mp8_plain_text(s, max_len):
+		if not "\\/:*?\"<>|.".contains(ch):
+			out += ch
+	return out if out != "" else "x"
+
