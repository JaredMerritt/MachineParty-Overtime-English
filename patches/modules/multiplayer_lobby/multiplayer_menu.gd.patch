+# [MP8] Auto-start. Once everyone has joined, the host presses START by itself, saving a manual button click.
+# Only runs on the host instance. It gives up on timeout, so it never locks up the lobby.
+func _mp8_autostart(want: int) -> void :
+
+	print("[MP8] autostart: waiting for %d players" % want)
+
+	var waited: int = 0
+	while waited < 180:
+
+		await get_tree().create_timer(1.0).timeout
+		waited += 1
+
+		if not NetworkManager.active_backend:
+			continue
+
+		var n: int = NetworkManager.active_backend.connected_players.size()
+
+		if waited % 5 == 0:
+			print("[MP8] autostart: %d/%d connected (%d s)" % [n, want, waited])
+
+		if n >= want:
+			print("[MP8] autostart: all %d players are in, starting in 3 seconds" % n)
+			# [MP8] The lobby 8-seat promo shot is taken during these 3 seconds — this is the **only** "everyone is here,
+			# match not started yet" window. Miss it and all that's left is empty chairs, or you're already in a minigame.
+			# The original single 3-second wait is split into 1.5 + 1.5. Total time is unchanged, so match start timing isn't affected.
+			await get_tree().create_timer(1.5).timeout
+			_mp8_lobby_shot()
+			await get_tree().create_timer(1.5).timeout
+			print("[MP8] autostart: starting match")
+			_on_lobby_start_button_pressed()
+			return
+
+	print("[MP8] autostart: waited %d s and still short of %d players, giving up" % [waited, want])
+
+
+# [MP8] Lobby 8-seat promo shot (mp8promo).
+#
+# This is **a separate thing** from the in-match screenshots in game.gd. Those hook into load_minigame(),
+# and during the lobby phase game.gd isn't in the tree yet, so they can't reach it. That's why the lobby shot has to be taken here on its own.
+#
+# Only runs on the host instance (autostart only runs on the host anyway) and captures the host's viewport —
+# the lobby camera is a fixed position with all eight seats in frame (T1~T3 already checked visually).
+#
+# Output goes to user://mp8_promo_lobby.png
+func _mp8_lobby_shot() -> void :
+
+	if not NetworkManager.mp8_args().has("mp8promo"):
+		return
+
+	await RenderingServer.frame_post_draw
+
+	var img: Image = get_viewport().get_texture().get_image()
+	if img != null:
+		img.save_png("user://mp8_promo_lobby.png")
+		print("[MP8] mp8promo: saved user://mp8_promo_lobby.png")
+
