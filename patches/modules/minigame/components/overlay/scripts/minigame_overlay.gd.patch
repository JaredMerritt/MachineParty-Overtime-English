 	round_label.text = tr("LOC_IM_ROUND") % [_round, _total]
 
+# [MP8] ===== Countdown customization (all empty by default, no effect on the other 14 minigames) =====
+#
+# This overlay is **shared by all minigames**, so it only adds switches that "do nothing when the field is empty",
+# and each minigame fills them in itself. Only Duck Hunt uses them right now (see _mp8_setup_countdown in duck_hunt.gd).
+#
+# Key premise - the countdown text is **rendered separately on each machine**. The server only broadcasts the "3"/"2"/"1"/"GO!"
+# tokens (see Minigame._on_countdown_tick), so at the same moment the ducks can see one line and
+# the hunters another, with no extra RPC needed.
+var mp8_go_text: String = ""        # If non-empty, replaces the "GO!" text (red, one size larger, violent shake)
+var mp8_one_text: String = ""       # If non-empty, **fully replaces the countdown "1"** (red), e.g. "Hunters heavily buffed"
+var mp8_shake_on_go: bool = false   # Shake on the GO beat
+
+const MP8_RED: Color = Color(1.0, 0.18, 0.18)
+const MP8_GO_FONT_SCALE: float = 1.18   # "One size larger" (user changed it back from two sizes larger on 2026-08-15)
+const MP8_SHAKE_AMPLITUDE: float = 34.0 # Shake amplitude in pixels. Bigger means more violent
+const MP8_SHAKE_STEPS: int = 16
+
+var _mp8_label_base_color: Color = Color.WHITE
+var _mp8_label_base_size: int = 128
+var _mp8_label_base_saved: bool = false
+var _mp8_label_base_position: Vector2 = Vector2.ZERO
+var _mp8_shake_tween: Tween = null
+
+
 func set_countdown(text: String, _with_fade: bool = true, _fade_time: float = 0.5):
 	var is_valid_string = false
+	var mp8_token: String = text  # [MP8] Remember the original token, since it can't be recognized once the text is replaced
 	match text:
 		"3":
 			is_valid_string = true
@@ -49,14 +74,82 @@ func set_countdown(text: String, _with_fade: bool = true, _fade_time: float = 0.
 			is_valid_string = true
 			pass
 	if is_valid_string:
-		countdown_label.text = tr(text)
+		# [MP8] Swap "GO!" for the slogan the minigame chose, and replace "1" entirely with a hint (e.g. "Hunters heavily buffed")
+		if mp8_token == "GO!" and mp8_go_text != "":
+			countdown_label.text = mp8_go_text
+		elif mp8_token == "1" and mp8_one_text != "":
+			countdown_label.text = mp8_one_text
+		else:
+			countdown_label.text = tr(text)
 	else:
 		print("Invalid string found for countdown label. Skipping text assignment.")
 		countdown_label.text = ""
 
+	_mp8_apply_countdown_style(mp8_token)
+
