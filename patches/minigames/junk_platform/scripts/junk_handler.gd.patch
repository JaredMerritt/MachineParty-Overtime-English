+	# so the snapshot loop below skips it and never broadcasts that UP*999 position.
+	_mp8_recycle_stuck_junk(_delta)
+
 	var data: Dictionary[int, Transform3D]
 	for k in junk_instances.keys():
 		if junk_instances[k].active:
@@ -46,9 +88,25 @@ func _physics_process(_delta: float) -> void :
 
 	updata_junk_positions_rpc.rpc(data)
 
+# [MP8] 2026-08-25 — pausing rock drops must be **the handler's own state**, it can't rely only on "stopping the timer".
+#
+# The old code only did `timer.stop()` in junk_platform._mp8_apply_junk_speed(),
+# but set_active(true) below does an **unconditional** `timer.start()` — as soon as a new round starts
+# (or the handler is reactivated), the pause is silently undone while the HUD still shows "drops paused".
+# That was the missing piece of "the pause is guaranteed to apply everywhere". The state has to live on the object being controlled.
+var mp8_paused: bool = false
+
+
 func set_active(_active: bool):
 	active = _active
+
+	# [MP8] Clear the idle timers both when play starts and when it stops, so they don't carry over between phases (see _mp8_recycle_stuck_junk)
+	mp8_idle_time.clear()
 	if active:
+		mp8_stuck_recycled = 0
+
+	# [MP8] While paused, this **must not** restart the timer (see the block above mp8_paused).
+	if active and not mp8_paused:
 		timer.start(spawn_interval)
 
 func add_spawn_point(_network_id: int, _position: Vector3):
@@ -72,6 +130,13 @@ func updata_junk_positions_rpc(data: Dictionary[int, Transform3D]):
 
 
 func _on_timer_timeout():
+
+	# [MP8] Safety net. Normally the timer is stopped while paused and we never get here.
+	# But if any path restarts it (historically that was set_active), this still won't let it through.
+	# Note it **returns directly and does not reschedule the timer** — rescheduling would lift the pause on its own.
+	if mp8_paused:
+		return
+
 	for p in spawn_points.values():
 		var junk_instance: JunkCubeRigidbody
 		if not caught_junk.is_empty():
@@ -111,3 +176,56 @@ func _on_catcher_body_entered(body):
 	if body is JunkCubeRigidbody:
 		body.reset_rpc.rpc()
 		caught_junk.append(body)
+
+
+# ═══════ [MP8] 2026-08-19 — actively recycle debris stuck motionless on the platform after a timeout ═══════
+#
+# Server only (the call site at the top of `_physics_process` already returns early via `is_server()`).
+# For the reasoning and the full chain, see the long comment on mp8_stuck_recycle_time at the top of the file.
+func _mp8_recycle_stuck_junk(delta: float) -> void :
+
+	# Don't count time when not in play. Debris sitting still between rounds or during results is normal,
+	# and without clearing, a batch would be misjudged as "stuck for a minute" right at the start of the next round.
+	if not active:
+		mp8_idle_time.clear()
+		return
+
+	for k in junk_instances.keys():
+
+		var junk: JunkCubeRigidbody = junk_instances[k]
+
+		if not is_instance_valid(junk):
+			mp8_idle_time.erase(k)
+			continue
+
+		# Already in the pool (or not dropped yet) — reset_rpc sets active to false.
+		# This check also automatically skips pieces "just taken by the catcher area", so they never get pushed into the pool twice.
+		if not junk.active:
+			mp8_idle_time[k] = 0.0
+			continue
+
+		# Being held by a player doesn't count as stuck, someone is using it (while held, freeze=true and speed is always 0,
+		# so without this exclusion it would vanish from their hands after being held for a minute).
+		if junk.held_by:
+			mp8_idle_time[k] = 0.0
+			continue
+
+		# Still moving (falling / thrown / rolling slowly) — reset the timer to zero.
+		if junk.linear_velocity.length() > mp8_stuck_speed_threshold:
+			mp8_idle_time[k] = 0.0
+			continue
+
+		var idle: float = mp8_idle_time.get(k, 0.0) + delta
+
+		if idle < mp8_stuck_recycle_time:
+			mp8_idle_time[k] = idle
+			continue
+
+		# Timed out. Take **exactly the same path as the catcher area**, and it gets dropped again on the next tick.
+		mp8_idle_time[k] = 0.0
+		junk.reset_rpc.rpc()
+		caught_junk.append(junk)
+
+		mp8_stuck_recycled += 1
+		print("[MP8] Junk Platform: #%d still for over %.0f s, actively recycled (piece %d this match, %d in pool)" % [
+			k, mp8_stuck_recycle_time, mp8_stuck_recycled, caught_junk.size()])
