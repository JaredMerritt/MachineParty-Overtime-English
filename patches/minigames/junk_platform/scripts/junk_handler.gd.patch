@@ -11,6 +11,37 @@ const junk_scene = preload("uid://c0tipjbyg5ofd")
 @export var max_junk: int = 40
 @export var platform_radius: float = 6.0
 
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 2026-08-19 — debris resting motionless on the platform must be actively recycled, or no more rocks fall for the rest of the match
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# Vanilla has **only one** recycle path. Debris falls off the platform → hits the `junk_catcher` Area3D
+# → `_on_catcher_body_entered()` → `reset_rpc()` + goes back into the `caught_junk` pool.
+# The platform does **not** recycle, and neither does the compactor (neither one touches reset_rpc / caught_junk).
+#
+# So debris that comes to rest on the platform and never falls off is **permanently out of circulation**.
+#   `_on_timer_timeout()` picks instances in this order, "drain caught_junk first, only create new ones once the pool is empty,
+#    and creating new ones is capped by counter < max_junk" —
+#   `counter` only ever goes up. Once all 40 are lying on the platform,
+#   `junk_instance` is null on every tick, **not a single rock falls again**, and the match is ruined.
+#
+# ⚠️ 8-player matches are far worse than vanilla. There is **one drop point per player** (`add_spawn_point` runs once per player),
+# so a single tick drops 8 pieces, and the interval is also squeezed from 3.0 s all the way down to 1.0 s —
+# a 40-piece pool runs dry in a dozen or so seconds. Vanilla 4-player runs at half this rate, and its platform is emptier so debris falls off more easily.
+#
+# The fix is that the server tracks "how long it has been still" every physics frame for each piece that is **in play and not held by anyone**.
+# Past mp8_stuck_recycle_time it takes **exactly the same path** as the catcher area (reset_rpc + into the pool),
+# and it gets dropped again on the next tick. The pool circulates again and counter is left alone.
+#
+# [MP8] 2026-08-24 the user decided 60 → 30 seconds.
+# Mechanical consequence — still debris on the platform turns over twice as fast. The pool refills faster (less likely to thin out late in the match),
+# and pile-ups on the platform are cleared more often. The cost is that debris a player leaves sitting on the ground is taken after 30 seconds
+# (debris held in hand doesn't count, the held_by exclusion below still applies).
+@export var mp8_stuck_recycle_time: float = 30.0
+# Speed threshold (m/s) for "not moving". Godot puts resting rigid bodies to sleep, so their speed is 0.
+# A little headroom tolerates physics jitter. Anything rolling slowly (faster than this) isn't stuck and its timer resets to zero.
+@export var mp8_stuck_speed_threshold: float = 0.15
+
 @export_category("Nodes")
 @export var junks_node: Node3D
 @export var timer: Timer
@@ -25,6 +56,12 @@ var junk_instances: Dictionary[int, JunkCubeRigidbody]
 var caught_junk: Array[JunkCubeRigidbody]
 var elapsed: float = 0.0
 
+# [MP8] How many seconds each piece of debris "has been still", keyed by the same indices as junk_instances.
+# Only the server reads or writes this (recycle decisions happen entirely server-side, clients get the broadcast transforms).
+var mp8_idle_time: Dictionary[int, float] = {}
+# How many pieces were actively recycled this match, for logging only
+var mp8_stuck_recycled: int = 0
+
 func _ready() -> void :
 
 	if multiplayer.is_server():
@@ -39,6 +76,11 @@ func _physics_process(_delta: float) -> void :
 	if active:
 		elapsed += _delta
 
