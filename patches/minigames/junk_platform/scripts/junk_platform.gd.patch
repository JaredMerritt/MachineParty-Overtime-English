+++ b/minigames/junk_platform/scripts/junk_platform.gd
@@ -30,21 +30,404 @@ var finished: bool = false
 
 var player_count: int = 0
 
+# [MP8] ===== Expand Junk Platform to 8 platforms =====
+#
+# This minigame has **a physical platform per player**, so it isn't the kind where adding a spawn point is enough.
+# One platform = Area3D collider + platform visuals + damage indicator ring + compactor + alarm audio source, 5 groups of nodes in total.
+#
+# ---- How the scene is built (reverse-engineered, read this before changing anything) ----
+#
+# 1. **Platform colliders are static, while the visuals hang off the rotating `visuals base`**.
+#    For the half of the players on the far side, `camera_base` and `visuals_base` are rotated 180° around Y together,
+#    so platform 1 ends up with the diagonally opposite platform's visuals under it — which is why the script re-identifies them
+#    (`platform_visuals` → `platform_visuals_flipped`). **Flip pairing = directly diagonal.**
+#
+# 2. **Numbering can't be trusted, only positions can**. `platform main parent1` is not under `Platform1`
+#    (tested, parent1 is at (-13,+13) while Platform1 is at (-13,-13)),
+#    and the two diagonal platforms **reference the same set of visuals** (1 references 1 and 3, 3 references 3 and 1).
+#    So moving things **must group them by spatial position**, not by number, or the same node gets moved twice.
+#
+# 3. The `junk platform compactors` parent node has its own -90° rotation,
+#    so a compactor's local coordinates must be multiplied by the parent transform to get world coordinates (after converting, each one really is right above its platform).
+#
+# ---- Layout (settled by the user on 2026-08-16) ----
+#
+# The 4 vanilla platforms sit at (±13, 0, ±13) with radius 6, 26 apart (14 gap between edges) — they're **islands**.
+#
+# ⚠️ The first version laid them out as "two rows of 4" (z=±13, x=±6.5/±19.5). Everything worked, but spacing dropped to 13
+#    with only a gap of 1 between edges, so **a player could step straight onto someone else's platform** and the island feel was gone.
+#
+# Final decision (user, 2026-08-16) — an **octagon**. The 4 vanilla platforms don't move at all,
+# and the 4 new ones are placed at bearings 0°/90°/180°/270° at radius MP8_NEW_RADIUS,
+# each rotated 45° around Y so its facing matches where it stands. At radius 22.5 the gap between neighboring edges is about 4.1 (the first version had 1.0), too wide to walk across.
+#
+# ⚠️⚠️ **The camera stays exactly as in vanilla, not a single character changed** (the user explicitly asked for this on 2026-08-16, pending their feedback).
+# The previous version's "automatic pull-back framing" is now **off by default** and only runs when mp8junkcam is passed (see _mp8_pull_camera_back).
+# Why the previous version was rejected. Auto-framing backs off along the line of sight, and with the view pitched down 34.5°,
+# backing off 9 units raises the camera to y≈28, above the top of the compactors at y≈27, so their lids smear across the top of the frame and block the view.
+#
+# The cost of not moving the camera is that **framing headroom is set by vanilla and can no longer be fixed by pulling the camera back**.
+# The centers of vanilla's near row of platforms (z=+13) already sit close to the bottom edge of the frame,
+# so once the ring radius gets bigger, the platform directly in front drops out of frame.
+# `_mp8_report_camera()` writes whether each platform is "in frame" under both orientations straight to the log,
+# so nobody has to guess by staring at the screen. The radius can be changed temporarily with the command-line arg mp8junkr=<radius>, no recompile needed.
+
+# Radius for the new platforms. The vanilla corners are at √(13²+13²) = 18.38.
+# A bigger radius spreads them out more, but also brings the platform directly in front closer to the camera (the camera is at z=27.66).
+#   18.38 (same circle) → neighbor gap only 2.1, might still be walkable
+#   22.5            → gap 4.1, basically not walkable
+# ⚠️ The camera doesn't move anymore, so this value is **the only knob** and the framing depends entirely on it.
+# The command-line arg mp8junkr=<radius> can override it temporarily without a recompile (tune it alongside the [MP8-CAM] health-check lines in the log).
+const MP8_NEW_RADIUS: float = 22.5
+
+# Rotate the new platforms 45° around Y so their facing matches "standing at a 45° bearing" (user request)
+const MP8_NEW_YAW_DEGREES: float = 45.0
+
+# Player placement. platforms[i] ↔ spawn point[i] ↔ player i, and platforms are ordered
+# **the 4 vanilla ones first, duplicates after**, so edge cases naturally split into two halves.
+#   P1~P4 = the vanilla corner platforms (original nodes, positions untouched)
+#   P5~P8 = the new platforms at 45° bearings (duplicates + rotated 45°)
+# So the symptom of "only the duplicates are broken" is all of P5~P8 failing, which is cleanly distinguishable from "one side is broken".
+# P8 also holds the last slot in the array, so out-of-bounds indexing hits them first.
+
+var _mp8_expanded: bool = false
+
+
+# [MP8] ===== Debug aids — "who am I" in the top right + number keys to change rock drop speed =====
+#
+# 1. **Player id in the top right**. With 8 instances open you can't tell whose window is whose just from the picture
+#    (platform nameplates show "whose platform this is", but not "who I'm controlling").
+# 2. **Number keys change rock drop speed**. Vanilla drops rocks fast (a batch every 3 seconds, speeding up to a batch every 1 second within 10 seconds),
+#    far too fast to get a good look at the indicator rings / collapses / compactors. On 2026-08-16 the user asked for the multiplier to be controlled by keys.
+#
+# ⚠️ The rock drop timer **only runs on the server** (junk_handler only connects timeout under `if multiplayer.is_server()`),
+# so key presses have to notify the server via RPC. A client changing its own local value has no effect at all.
+
+const MP8_JUNK_SPEED_KEYS: Dictionary = {
+	KEY_1: 1.0,    # normal speed
+	KEY_2: 2.0,    # 2x slower
+	KEY_3: 5.0,    # 5x slower
+	KEY_4: 10.0,   # 10x slower
+	KEY_5: 0.0,    # pause rock drops
+}
+
+# [MP8] Master switch for debug aids (on 2026-08-16 the user required all three to be off for the final wrap-up).
+# It controls three things. ① number keys for rock drop speed ② "who am I" in the top right ③ nameplates above platforms.
+# It follows `-debug-tools` — the test rig always passes it and **release builds never do**, so real play is naturally clean.
+# To turn them off on the test rig too and see what real play looks like, pass `mp8nojunkdebug`.
+var _mp8_debug_aids: bool = false
+var _mp8_junk_keys: bool = false
+var _mp8_junk_mult: float = 1.0
+var _mp8_junk_base_interval: float = 0.0
+var _mp8_junk_base_min: float = 0.0
+var _mp8_debug_canvas: CanvasLayer = null
+# [MP8] 2026-08-25 the clickable "pause rock drops" button the user asked for. Key 5 still works, and both go through the same RPC.
+var _mp8_junk_btn: Button = null
+var _mp8_id_label: Label = null
+var _mp8_junk_label: Label = null
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8-DIAG] Standing Junk Platform diagnostics (built for T49, **opt-in, release builds write nothing**)
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# Symptom (player report + reproduced with 8 local instances) — everyone fell off, the match doesn't settle, junk keeps falling, the frame rate collapses.
+# Known so far. `[MP8] Junk Platform results` was never printed once → check_game_end() never got past
+#       `active_players.size() > 1`, meaning **someone was never judged dead**.
+#
+# There's only one thing to tell apart.
+#   A. `event_fallen` printed but `emit_died` didn't  → the fall triggered, but that 1.5-second tween
+#      never reaches its end (the death chain breaks in the second half).
+#   B. Neither printed                              → the fall **never triggered at all**, and the player landed on some
+#      collision surface and stood there (probe72 measured a surface at y=-0.06 at bearings 45°/135°/225°/315°, r=14~24.5,
+#      above the void plane at y=-2.00). The **y value** in the periodic snapshots gives the answer directly.
+#
+# ⚠️ Writes **one file per instance** (user://mp8_diag_<peer>.log). With 8 instances they all share one
+#    godot.log and overwrite each other, so that log is garbled and unreadable. That's the main reason this diagnostic exists.
+# ⚠️ **Flush every line**. A hung match gets force-killed, and without flushing everything in the buffer is lost.
+#
+# [Decided by the user on 2026-08-27 — keep it as a standing feature, don't delete it] T49 was pinned down at a glance from the snapshots'
+# "y=-999 and active=false" — that's the fingerprint of `kill_rpc()`,
+# and it cleanly separated "the player was killed but never taken off the books" from "the player never died at all".
+# The switch follows the same rule as the diagnostic log (`-debug-tools` / `mp8diag` / editor),
+# so **a release player who double-clicks to launch passes nothing → not a single byte is written**.
+var _mp8_diag_on: bool = false
+var _mp8_diag_f: FileAccess = null
+var _mp8_diag_timer: Timer = null
+
+
 func _ready() -> void :
 	super._ready()
 
+	# [MP8] ⚠️ The flags must be computed **before** _mp8_expand_platforms().
+	# The nameplates above platforms are built during platform expansion, so any later is too late to block them.
+	_mp8_init_flags()
+
+	_mp8_diag_start()
+	_mp8_sweep_start()
+
 	camera.current = true
 
+	# [MP8] Expand platforms. **Must finish before spawn_players()** — spawn points are derived from platform positions,
+	# and junk drop points are in turn derived from spawn points (add_spawn_point(id, spawn point + 20 m)).
+	if not NetworkManager.mp8_args().has("mp8noexpand"):
+		_mp8_expand_platforms()
+
 	if multiplayer.is_server():
 
 		countdown_state.countdown_started.connect(_on_countdown_started)
 		countdown_state.tick.connect(_on_countdown_tick)
 		countdown_state.expired.connect(_on_countdown_expired)
 
+	# [MP8] Debug aids. The base drop values must be recorded here — key presses later apply "original value × multiplier",
+	# and without a recorded base, pressing repeatedly would compound (pressing 5x twice would give 25x).
+	_mp8_init_debug()
+
 	if GameManager.local_game:
 		await get_tree().create_timer(1.0).timeout
 		minigame_ready.emit(1)
 
+
+# [MP8] Debug aid flags, must be computed before any HUD / nameplate is built
+func _mp8_init_flags() -> void :
+
+	var args: Array = NetworkManager.mp8_args()
+	# [MP8] 2026-08-25 priority change — **explicitly passing mp8junkdebug beats mp8nojunkdebug**.
+	# The reason is that `-Clean` in `play.ps1` automatically adds `mp8nojunkdebug` (to keep the test rig picture clean),
+	# and by project convention `-Clean` is always passed — in the old code nojunk overrode everything,
+	# so "showing the top-right panel in a -Clean match" was **simply impossible** (`-Extra mp8junkdebug` got overridden too).
+	# Release builds pass neither flag, so real play is still naturally clean and the wrap-up requirement is unaffected.
+	_mp8_debug_aids = args.has("mp8junkdebug") \
+		or (args.has("-debug-tools") and not args.has("mp8nojunkdebug"))
+	_mp8_junk_keys = _mp8_debug_aids or args.has("mp8junkkeys")
+
+	# [MP8] View mode (on 2026-08-25 the user asked for B / C versions to compare, and C was chosen after live testing the same day)
+	#   not passed = **C** (MP8_VIEW_DEFAULT). This comment line used to say "original",
+	#           which was the behavior before B/C was decided and is now outdated — the default is C now.
+	#   =a   = original, 2 orientations (0°/180°), mixed double-ring layout, identical value for value to before the change
+	#   =b   = 4 orientations (0/90/180/270), **layout unchanged**
+	#   =c   = 8 orientations (every 45°), layout changed to a regular octagon at a single radius
+	# See the long block above MP8_VIEW_STEPS for the criteria and trade-offs.
+	var vm: String = _mp8_arg("mp8junkview=").to_lower()
+	_mp8_view_mode = vm if MP8_VIEW_STEPS.has(vm) else MP8_VIEW_DEFAULT
+	if vm != "" and not MP8_VIEW_STEPS.has(vm):
+		push_warning("[MP8] Junk Platform: mp8junkview=%s not recognized, running with default C (only a / b / c are accepted)" % vm)
+	print("[MP8] Junk Platform: view mode = %s (%d orientations, step %.0f°)" % [
+		("original" if _mp8_view_mode == MP8_VIEW_VANILLA else _mp8_view_mode.to_upper()),
+		int(round(360.0 / _mp8_facing_step())), _mp8_facing_step()
+	])
+
+
+# [MP8] Debug aid init. Record base values and build the HUD
+func _mp8_init_debug() -> void :
+
+	if junk_handler != null:
+		_mp8_junk_base_interval = junk_handler.spawn_interval
+		_mp8_junk_base_min = junk_handler.min_spawn_interval
+
+	# Starting multiplier. The command-line arg mp8junkslow=<multiplier> takes priority. If it isn't passed, the debug rig defaults to 5x slower
+	# (user, 2026-08-16, "make the rock countdown 5x longer"), and release builds without -debug-tools keep normal speed.
+	var v: String = _mp8_arg("mp8junkslow=")
+	if v.is_valid_float():
+		_mp8_junk_mult = float(v)
+	elif _mp8_junk_keys:
+		_mp8_junk_mult = 5.0
+
+	if multiplayer.is_server():
+		_mp8_apply_junk_speed()
+
+	_mp8_show_id_hud()
+	_mp8_update_junk_hud()
+
+
+# [MP8] Debug overlay, shared by the top-right id and the rock drop speed hint
+func _mp8_debug_layer() -> CanvasLayer:
+	if _mp8_debug_canvas == null:
+		_mp8_debug_canvas = CanvasLayer.new()
+		_mp8_debug_canvas.layer = 100
+		add_child(_mp8_debug_canvas)
+	return _mp8_debug_canvas
+
+
+# [MP8] Apply the game's own font to debug Labels.
+# ⚠️ Without it the default theme font is used and **its letter spacing is broken**. In testing the text crammed together
+# ("P3  id 104..." shows up as "P36idc104..."), and switching to half-width spaces doesn't help. See the same pitfall on the Duck Hunt side.
+func _mp8_style_label(lbl: Label, color: Color) -> void :
+
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 26)
+	lbl.add_theme_color_override("font_color", color)
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+
+
+# [MP8] Always show "who am I" in the top right, with player name + network id.
+#
+# This is a **first-person HUD**. Each machine only shows its own player.
+# The name has to wait for PlayerManager to fill it in and may not be available in _ready, so
+# spawn_players calls this again to refresh when it broadcasts nameplates (see mp8_set_platform_labels_rpc).
+func _mp8_show_id_hud() -> void :
+
+	# [MP8] Wrap-up requirement (user, 2026-08-16) — hidden in real play, only shown on the debug rig
+	if not _mp8_debug_aids:
+		return
+
+	if _mp8_id_label == null:
+		var lbl := Label.new()
+		lbl.set_anchors_preset(Control.PRESET_TOP_RIGHT)
+		lbl.offset_left = -420.0
+		lbl.offset_top = 12.0
+		lbl.offset_right = -16.0
+		# [MP8] 2026-08-25 raised from 52 to 150, since this block now holds three lines (who / view mode / my orientation)
+		lbl.offset_bottom = 150.0
+		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+		_mp8_style_label(lbl, Color(1.0, 0.95, 0.4))
+		_mp8_debug_layer().add_child(lbl)
+		_mp8_id_label = lbl
+
+	var me: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var who: String = ""
+	if PlayerManager.player_presences.has(me):
+		who = String(PlayerManager.player_presences[me].network_name)
+
+	# [MP8] 2026-08-25 — added two lines of view info. When comparing B/C, this is the only way to tell which setting you're on.
+	# The orientation is **this machine's** value (each machine rotates on its own), so the 8 windows should show 8 different numbers (version C)
+	# or matching pairs (version B). All identical = orientation isn't being applied, which is obvious at first glance.
+	var lines := PackedStringArray()
+	lines.append(("id %d" % me) if who == "" else ("%s   id %d" % [who, me]))
+	lines.append("view %s   %d steps total" % [
+		("original" if _mp8_view_mode == MP8_VIEW_VANILLA else _mp8_view_mode.to_upper()),
+		int(round(360.0 / _mp8_facing_step()))
+	])
+	lines.append("my orientation %.0f°" % _mp8_my_facing)
+	_mp8_id_label.text = "\n".join(lines)
+
+
+# [MP8] Rock drop speed hint (only shown when debug keys are on, so it doesn't block the picture in real play)
+func _mp8_update_junk_hud() -> void :
+
+	if not _mp8_junk_keys:
+		return
+
+	if _mp8_junk_label == null:
+		var lbl := Label.new()
+		lbl.set_anchors_preset(Control.PRESET_TOP_WIDE)
+		lbl.offset_top = 12.0
+		lbl.offset_bottom = 52.0
+		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+		_mp8_style_label(lbl, Color(0.6, 0.9, 1.0))
+		_mp8_debug_layer().add_child(lbl)
+		_mp8_junk_label = lbl
+
+	var state: String
+	if _mp8_junk_mult <= 0.0:
+		state = "drops paused"
+	elif is_equal_approx(_mp8_junk_mult, 1.0):
+		state = "normal speed (a batch every %.1f s)" % _mp8_junk_base_interval
+	else:
+		state = "%.0fx slower (a batch every %.1f s)" % [_mp8_junk_mult, _mp8_junk_base_interval * _mp8_junk_mult]
+
+	_mp8_junk_label.text = "[Drop debug] %s    1=normal 2=2x slower 3=5x slower 4=10x slower 5=pause" % state
+
+	# [MP8] 2026-08-25 user request — make the same switch a **clickable button**.
+	# Key 5 still works — both go through the same mp8_set_junk_speed_rpc, so they never track separate state.
+	# ⚠️ This minigame **doesn't capture the mouse** (grepping the whole project finds nothing setting Input.mouse_mode for it), so the button is clickable.
+	#    Check this before copying it into other minigames. Where the mouse is captured, the button is dead.
+	# [MP8] 2026-08-25 the user decided — **the button only appears for the host**, clients only keep number key 5.
+	# The reason is that pausing is **global** (`_mp8_apply_junk_speed()`, which actually stops the timer, only runs on the server),
+	# and a clickable button in each of 8 windows = any client could stop rock drops for everyone with one click, too costly for a stray mouse click.
+	# Number keys stay available on all peers — that's the existing behavior, and keys aren't as easy to hit by accident as a button.
+	if multiplayer.is_server() and _mp8_junk_btn == null:
+		var b := Button.new()
+		b.set_anchors_preset(Control.PRESET_TOP_RIGHT)
+		b.offset_left = -220.0
+		b.offset_top = 158.0
+		b.offset_right = -16.0
+		b.offset_bottom = 202.0
+		var bf = load("res://fonts/Terminal F4.ttf")
+		if bf != null:
+			b.add_theme_font_override("font", bf)
+		b.add_theme_font_size_override("font_size", 24)
+		b.pressed.connect(_mp8_toggle_junk_pause)
+		_mp8_debug_layer().add_child(b)
+		_mp8_junk_btn = b
+
+	# The button is never created on clients (see above), so this null check is required
+	if _mp8_junk_btn != null:
+		_mp8_junk_btn.text = "Resume drops" if _mp8_junk_mult <= 0.0 else "Pause drops"
+
+
+# [MP8] One click of the button = toggle between "paused" and "normal speed".
+# It uses exactly the same RPC as number key 5, so all 8 windows always agree,
+# and there's no need to separately remember "how many times slower it was last time" — the button only pauses/resumes, finer speeds still use the number keys.
+func _mp8_toggle_junk_pause() -> void :
+	mp8_set_junk_speed_rpc.rpc(0.0 if _mp8_junk_mult > 0.0 else 1.0)
+
+
+# [MP8] Number keys change rock drop speed.
+# Keys can be pressed on **any machine**, but the timer that matters is on the server, so this goes through an RPC broadcast.
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_junk_keys:
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+	if not MP8_JUNK_SPEED_KEYS.has(key.keycode):
+		return
+
+	mp8_set_junk_speed_rpc.rpc(float(MP8_JUNK_SPEED_KEYS[key.keycode]))
+	get_viewport().set_input_as_handled()
+
+
+# [MP8] Only the host may change drop speed (the keys only exist in dev builds). call_local makes the host refresh its own HUD right away too.
+# Every machine receives it → the hint line stays consistent across all 8 windows, with no "I pressed it but others still show the old value".
+@rpc("any_peer", "call_local", "reliable")
+func mp8_set_junk_speed_rpc(mult: float) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not (NetworkManager.mp8_finite(mult, 1000.0)):
+		return
+
+	_mp8_junk_mult = mult
+	if multiplayer.is_server():
+		_mp8_apply_junk_speed()
+	_mp8_update_junk_hud()
+	print("[MP8] Drop speed -> %s" % [
+		"paused" if mult <= 0.0 else ("%.0fx slower" % mult if mult > 1.0 else "normal speed")
+	])
+
+
+# [MP8] Where the timer actually gets changed. **Only runs on the server**.
+# The multiplier applies to both spawn_interval and min_spawn_interval.
+# Vanilla is "a batch every 3 seconds at the start, speeding up linearly to a batch every 1 second within 10 seconds". Multiplying both endpoints slows the whole curve,
+# while multiplying only the start would still speed up to a batch every 1 second after 10 seconds, which is the same as not tuning it.
+func _mp8_apply_junk_speed() -> void :
+
+	if junk_handler == null or _mp8_junk_base_interval <= 0.0:
+		return
+
+	# [MP8] 2026-08-25 — write "paused" into the handler's **state**, don't just stop the timer once.
+	# If only the timer is stopped, `set_active(true)` (a new round starts / the handler is reactivated) will **unconditionally**
+	# restart it, silently undoing the pause while the HUD still shows "drops paused".
+	# That was the missing piece of "the pause is guaranteed to apply everywhere" — the state has to live on the object being controlled.
+	junk_handler.mp8_paused = (_mp8_junk_mult <= 0.0)
+
+	if _mp8_junk_mult <= 0.0:
+		if junk_handler.timer != null:
+			junk_handler.timer.stop()
+		return
+
+	junk_handler.spawn_interval = _mp8_junk_base_interval * _mp8_junk_mult
+	junk_handler.min_spawn_interval = _mp8_junk_base_min * _mp8_junk_mult
+
+	# The timer is already running on the old interval. Without a restart this cycle keeps the old pace (pressing the key seems to do nothing)
+	if junk_handler.active and junk_handler.timer != null:
+		junk_handler.timer.start(junk_handler.spawn_interval)
+
 func fade_in_ambience():
 	for speaker_controller in ambience_speaker_controllers:
 		speaker_controller.speaker.volume_linear = 0
@@ -71,6 +454,866 @@ func initialize(_round_number: int, _total_rounds: int, _scores: Dictionary = {}
 
 	state_machine.transition_to_rpc.rpc(&"Round", {"round": _round_number, "total": _total_rounds})
 
+# [MP8] Expand the 4 platforms to MAX_PLAYERS.
+func _mp8_expand_platforms() -> void :
+
+	if _mp8_expanded:
+		return
+	var target: int = NetworkManager.MAX_PLAYERS
+	var n: int = platforms.size()
+	if n == 0 or n >= target:
+		return
+	_mp8_expanded = true
+
+	# ---- 1. Identify "each platform's whole kit" by spatial position ----
+	# Not by number (see item 2 in the file header). The numbers don't line up, and diagonal platforms reference the same nodes.
+	var groups: Array = []
+	for p in platforms:
+		groups.append({"platform": p, "nodes": [], "pos": p.global_position})
+
+	for parent_path in [
+		"visuals base/junk platform visuals2",
+		"visuals base/damage indicators",
+		"junk platform compactors",
+	]:
+		var parent: Node = get_node_or_null(parent_path)
+		if parent == null:
+			continue
+		for child in parent.get_children():
+			if child is Node3D:
+				_mp8_assign_to_nearest(groups, child)
+
+	# The alarm audio sources are loose pieces under the root node (speaker_indicator alarm1..4)
+	for child in get_children():
+		if child is Node3D and String(child.name).begins_with("speaker_indicator alarm"):
+			_mp8_assign_to_nearest(groups, child)
+
+	# ---- 2. Duplicate the missing sets ----
+	# Duplicate the whole group and **translate it as a unit**, so relationships within the group (compactor right above the platform, etc.) are kept automatically
+	# without needing to know any absolute offsets — that's the hard-learned lesson from the lobby layout (pitfall #8).
+	var all_groups: Array = groups.duplicate()
+	for i in range(n, target):
+		var src: Dictionary = groups[i % n]
+		var clone: Dictionary = {"nodes": [], "pos": src["pos"]}
+
+		var dup_platform: JunkPlatformPlatform = src["platform"].duplicate()
+		dup_platform.name = "MP8Platform%d" % (i + 1)
+		src["platform"].get_parent().add_child(dup_platform)
+		dup_platform.global_position = src["platform"].global_position
+		clone["platform"] = dup_platform
+		platforms.append(dup_platform)
+
+		for node in src["nodes"]:
+			var dup_node: Node3D = node.duplicate()
+			dup_node.name = "MP8_%d_%s" % [i + 1, node.name]
+			node.get_parent().add_child(dup_node)
+			dup_node.transform = node.transform
+			clone["nodes"].append(dup_node)
+
+		all_groups.append(clone)
+
+	# ---- 3. Move positions ----
+	# The 4 vanilla ones **don't move at all** (delta = 0), only the 4 new ones get moved to the 45° bearings.
+	var original_positions: Array = []
+	for g in groups:
+		original_positions.append(g["pos"])
+	var slots: Array[Vector3] = _mp8_slot_positions(original_positions)
+
+	for i in all_groups.size():
+		if i >= slots.size():
+			break
+		var g: Dictionary = all_groups[i]
+		var delta: Vector3 = slots[i] - g["pos"]
+		delta.y = 0.0
+		if delta.length() < 0.01:
+			continue  # the vanilla ones, don't move
+
+		# New platforms also rotate 45° around the arena center so their facing matches where they stand (user request).
+		# The whole group rotates together. Rotate around Y then translate, so relationships within the group (compactor right above) stay unchanged.
+		# [MP8] In version C the 4 vanilla ones move too, but **only their radius changes and their bearing stays the same**, so their yaw is 0.
+		# Only the 4 new ones rotate 45° so their facing matches where they stand (i >= n means new).
+		var yaw: float = deg_to_rad(MP8_NEW_YAW_DEGREES) if i >= n else 0.0
+		_mp8_move_group(g, slots[i], yaw)
+
+	# [MP8] Record the final positions **after moving**. B/C modes use them for geometric matching when re-identifying visuals by orientation
+	# (see _mp8_rebind_for_facing). g["pos"] is from before the move and can't be used.
+	_mp8_groups_final.clear()
+	for i in all_groups.size():
+		var gg: Dictionary = all_groups[i]
+		_mp8_groups_final.append({
+			"platform": gg["platform"],
+			"nodes": gg["nodes"],
+			"pos": (slots[i] if i < slots.size() else gg["pos"]),
+		})
+
+	_mp8_report_gaps(slots)
+	_mp8_check_pairing(slots)
+
+	# ---- 4. Rewire, own set + diagonal set ----
+	# ⚠️ duplicate() doesn't remap @export references that point elsewhere (pitfall #14),
+	# so without rewiring all 8 platforms would point at the original 4 sets, and one collapse would light up a whole area.
+	for i in all_groups.size():
+		# ⚠️ Pairing **must be computed by position**, not by index arithmetic (item 2 at the top of this file, numbering can't be trusted, only positions can).
+		# It used to be `(i + size/2) % size`, which is wrong for the octagon's slot order.
+		#   0:(-13,-13) 1:(13,-13) 2:(13,13) 3:(-13,13) 4:(0,22.5) 5:(22.5,0) 6:(0,-22.5) 7:(-22.5,0)
+		# i+4 pairs 0 with 4, i.e. (-13,-13) with (0,22.5), which is **not a 180° pairing at all**.
+		# The correct pairs are 0↔2, 1↔3, 4↔6, 5↔7.
+		var partner: int = _mp8_opposite_index(slots, i)
+		_mp8_wire_platform(all_groups[i], all_groups[partner])
+
+		# Log the wiring details, which node the indicator ring is wired to and how many rings it has.
+		# "My ring lights up with someone else's junk" can only be diagnosed against this line. From the picture alone you can't tell miswiring from vanilla behavior.
+		var pl: JunkPlatformPlatform = all_groups[i]["platform"]
+		var own_i: Node3D = _mp8_pick(all_groups[i], "damage indicator")
+		var far_i: Node3D = _mp8_pick(all_groups[partner], "damage indicator")
+		print("[MP8-WIRE] platform%d (%.0f,%.0f) rings=%d own ring=%s flipped ring=%s(platform%d)" % [
+			i + 1, slots[i].x, slots[i].z, pl.damage_circles.size(),
+			"none" if own_i == null else own_i.name,
+			"none" if far_i == null else far_i.name, partner + 1
+		])
+
+	# ---- 5. Pad spawn points to the same count, in one-to-one order with the platforms ----
+	_mp8_rebuild_spawn_points(slots)
+
+	# ---- 6. Camera framing ----
+	# First record the **vanilla camera**. camera_base hasn't been rotated 180° yet at this point, so this is the only clean baseline,
+	# and per-player mode needs it to judge "whose platform is pushed against the edge".
+	if camera != null:
+		_mp8_cam_xf0 = camera.global_transform
+		_mp8_cam_fov0 = camera.fov
+
+	# By default **the whole arena uniformly** pulls back + lowers + widens the FOV (the version the user picked on 2026-08-16).
+	# It's done here rather than via per-player RPCs because the offset is added in camera_base's **local** space,
+	# so when camera_base later rotates 180° the offset rotates with it, both sides are naturally symmetric, and nobody needs to know who's on which side.
+	if not NetworkManager.mp8_args().has("mp8junkcamper"):
+		var c: Vector3 = _mp8_cam_values()
+		_mp8_apply_camera(c.x, c.y, c.z)
+
+	# Framing quality isn't judged by eye — the health check results go straight into the log.
+	_mp8_report_camera(all_groups, slots)
+
+	# ---- 7. Hang a nameplate above each platform ----
+	_mp8_build_platform_labels()
+
+	print("[MP8] Junk Platform: %d -> %d platforms (vanilla corners unmoved + 4 new at 45° bearings, radius %.1f, camera kept vanilla)" % [
+		n, platforms.size(), _mp8_radius()
+	])
+
+
+# [MP8] Hang a nameplate above each platform.
+#
+# With 4 platforms this isn't needed. Your camera puts your platform right in front, so you recognize it at a glance.
+# With 8 platforms, 4 are crammed into one row and position alone can't tell you which one is yours, so this was added.
+#
+# Height 8. Players stand on the platform (about 2 tall), and the compactor rests 27 m up and passes through the space between when it slams down,
+# so hanging it at 8 m keeps it above players' heads without the compactor pushing it out of frame.
+# It's a **child node** of the platform, so when the platform collapses (visible=false) the nameplate disappears with it, no extra handling needed.
+const MP8_LABEL_HEIGHT: float = 8.0
+const MP8_LABEL_FONT_SIZE: int = 96
+
+var _mp8_platform_labels: Array[Label3D] = []
+var _mp8_label_names: Array = []   # filled by the server in spawn_players, then broadcast
+
+
+func _mp8_build_platform_labels() -> void :
+
+	_mp8_platform_labels.clear()
+
+	# ⚠️ **`_mp8_label_names` must always be sized to the platform count**, even when nameplates are off.
+	# `spawn_players()` writes `_mp8_label_names[nearest] = name` by index,
+	# so an empty array means an out-of-bounds write — exactly the pattern from pitfall #13 (release templates don't bounds-check,
+	# and an out-of-bounds write is an outright 0xc0000005 native crash).
+	_mp8_label_names.clear()
+	for p in platforms:
+		_mp8_label_names.append("")
+
+	# [MP8] Wrap-up requirement (user, 2026-08-16) — nameplates above platforms are hidden in real play and only shown on the debug rig.
+	# The cost is that with 8 platforms you can't tell which one is yours by position alone (which is exactly why nameplates were added),
+	# but the user looked at it and decided against them, so we go with their call.
+	if not _mp8_debug_aids:
+		return
+
+	for p in platforms:
+		var lbl := Label3D.new()
+		lbl.name = "MP8NameLabel"
+		lbl.text = ""
+		lbl.billboard = BaseMaterial3D.BILLBOARD_ENABLED  # cameras on the two sides differ by 180°, so it must always face the viewer
+		lbl.font_size = MP8_LABEL_FONT_SIZE
+		lbl.outline_size = 24
+		lbl.modulate = Color(1.0, 0.95, 0.4)
+		lbl.outline_modulate = Color.BLACK
+		var f = load("res://fonts/Terminal F4.ttf")
+		if f != null:
+			lbl.font = f
+		p.add_child(lbl)
+		lbl.position = Vector3(0.0, MP8_LABEL_HEIGHT, 0.0)
+		_mp8_platform_labels.append(lbl)
+
+
+# [MP8] The server works out "who owns platform i" and broadcasts it to everyone.
+# The nameplates themselves are already built in each machine's _ready, this only sends the text.
+@rpc("authority", "call_local", "reliable")
+func mp8_set_platform_labels_rpc(names: Array) -> void :
+
+	for i in _mp8_platform_labels.size():
+		if i < names.size():
+			_mp8_platform_labels[i].text = NetworkManager.mp8_plain_text(str(names[i]))
+		else:
+			_mp8_platform_labels[i].text = ""
+
+	# [MP8] PlayerManager is definitely filled in by now, so also refresh the top-right "who am I" to the version with the name
+	_mp8_show_id_hud()
+
+
+# [MP8] Move a whole group's kit to a new position and rotate it by yaw around its own center.
+# Rotate around the group's original center first, then translate as a unit — so relationships within the group (compactor right above the platform,
+# indicator ring around the platform) are fully preserved without needing any absolute offsets.
+func _mp8_move_group(g: Dictionary, target: Vector3, yaw: float) -> void :
+
+	var center: Vector3 = g["pos"]
+	var basis_rot := Basis(Vector3.UP, yaw)
+
+	var nodes: Array = [g["platform"]]
+	nodes.append_array(g["nodes"])
+
+	for node in nodes:
+		var offset: Vector3 = node.global_position - center
+		offset = basis_rot * offset
+		node.global_position = target + offset
+		node.global_transform.basis = basis_rot * node.global_transform.basis
+
+
+# [MP8] Log the **edge gap** between neighboring platforms.
+# This is the direct test for "can you walk onto someone else's platform". The first version's gap was only 1, one step would carry you across.
+func _mp8_report_gaps(slots: Array[Vector3]) -> void :
+
+	var radius: float = 6.0
+	if junk_handler != null and "platform_radius" in junk_handler:
+		radius = junk_handler.platform_radius
+
+	var min_gap: float = 1e20
+	for i in slots.size():
+		for j in range(i + 1, slots.size()):
+			var d: float = Vector2(
+				slots[i].x - slots[j].x, slots[i].z - slots[j].z
+			).length()
+			min_gap = minf(min_gap, d - radius * 2.0)
+
+	print("[MP8] Minimum platform edge gap %.2f (between vanilla corners it's %.2f, too small a gap lets players walk across)" % [
+		min_gap, 26.0 - radius * 2.0
+	])
+
+
+# [MP8] Assign a node to the nearest platform (horizontal distance only, the compactors are 28 m up)
+func _mp8_assign_to_nearest(groups: Array, node: Node3D) -> void :
+
+	var best: int = -1
+	var best_dist: float = 1e20
+	var np: Vector3 = node.global_position
+	for i in groups.size():
+		var gp: Vector3 = groups[i]["pos"]
+		var d: float = Vector2(np.x - gp.x, np.z - gp.z).length()
+		if d < best_dist:
+			best_dist = d
+			best = i
+	# Farther than one platform diameter from the nearest platform means it's a shared arena piece (lights, floor) and belongs to no platform
+	if best >= 0 and best_dist < 12.0:
+		groups[best]["nodes"].append(node)
+
+
+# [MP8] World coordinates of the 8 slots.
+# The first 4 = vanilla corners **left in place** (keeping the "island" spacing of 26).
+# The last 4 = at the 45° bearings, radius MP8_NEW_RADIUS.
+# The order must match the platforms array (original 4 first, duplicates after).
+func _mp8_slot_positions(original_positions: Array) -> Array[Vector3]:
+
+	var out: Array[Vector3] = []
+
+	for p in original_positions:
+		out.append(Vector3(p.x, 0.0, p.z))
+
+	# Vanilla corners are at ±45° and ±135°. The new ones go at 0°, 90°, 180°, 270°
+	var r: float = _mp8_radius()
+
+	# [MP8] Version C — the 4 vanilla ones also move onto the same radius to form a regular octagon (**bearing unchanged, only radius changes**).
+	# This is the only layout difference between B and C — 45° is only a symmetry angle at equal radius, which is what makes one orientation per player possible.
+	if _mp8_view_mode == "c":
+		for i in out.size():
+			var a: float = atan2(out[i].x, out[i].z)
+			out[i] = Vector3(sin(a) * r, 0.0, cos(a) * r)
+
+	for k in 4:
+		var angle: float = deg_to_rad(90.0 * float(k))
+		out.append(Vector3(sin(angle) * r, 0.0, cos(angle) * r))
+	return out
+
+
+# [MP8] Read a command-line arg "<prefix>=<value>", returns an empty string if not passed
+func _mp8_arg(prefix: String) -> String:
+	for a in NetworkManager.mp8_args():
+		var s: String = String(a)
+		if s.begins_with(prefix):
+			return s.substr(prefix.length())
+	return ""
+
+
+# [MP8] New platform radius, overridable with the command-line arg mp8junkr=<radius> (the camera doesn't move anymore, so this is the only framing knob)
+func _mp8_radius() -> float:
+	var v: String = _mp8_arg("mp8junkr=")
+	if v.is_valid_float():
+		return float(v)
+	return MP8_NEW_RADIUS
+
+
+# [MP8] Find slot i's 180° opposite slot, the one closest to (x,z) negated.
+#
+# Why it has to be computed this way. The far-side half of the players have visuals_base rotated 180° around Y,
+# so visuals that live at world position V get rendered at (-V.x, -V.z).
+# That position is exactly where the "opposite platform's" collider is, so after flipping, platform i must use the **opposite platform's** visuals.
+# The pairing is determined entirely by geometry and has nothing to do with array indices.
+func _mp8_opposite_index(slots: Array[Vector3], i: int) -> int:
+
+	var target := Vector2( - slots[i].x, - slots[i].z)
+	var best: int = i
+	var best_d: float = 1e20
+	for j in slots.size():
+		var d: float = Vector2(slots[j].x, slots[j].z).distance_to(target)
+		if d < best_d:
+			best_d = d
+			best = j
+	return best
+
+
+# [MP8] Pairing self-check. The flip pairing must be an **involution** (my opposite's opposite = me),
+# and no two platforms may claim the same opposite. If either fails, the slots aren't laid out symmetrically,
+# which shows up as "my indicator ring lights up with someone else's junk" — very hard to recognize by eye as a pairing bug.
+func _mp8_check_pairing(slots: Array[Vector3]) -> void :
+
+	var partners: Array[int] = []
+	for i in slots.size():
+		partners.append(_mp8_opposite_index(slots, i))
+
+	var bad: bool = false
+	var seen: Dictionary = {}
+	for i in partners.size():
+		if partners[partners[i]] != i:
+			bad = true
+		if seen.has(partners[i]):
+			bad = true
+		seen[partners[i]] = true
+
+	var txt: PackedStringArray = []
+	for i in partners.size():
+		txt.append("%d(%.0f,%.0f)->%d" % [
+			i + 1, slots[i].x, slots[i].z, partners[i] + 1
+		])
+	print("[MP8] Flip pairing %s: %s" % [
+		"❌does not hold (slots are not 180° symmetric)" if bad else "✓involution holds",
+		" ".join(txt)
+	])
+
+
+# [MP8] Point all of a platform's references back to its own kit, with flipped pointing at the diagonal set
+# [MP8] 🩸 T49 (2026-08-27) — **these four kinds are not the same thing and can't all be re-identified by orientation together.**
+#
+# probe73 measured exactly where each one is attached.
+#
+#   damage indicator (37)         → under `visuals base`       ✅ rotates with visuals_base
+#   platform main    (4)          → under `visuals base`       ✅ rotates with it
+#   compactor        (35)         → `junk platform compactors` ❌ **child of root, doesn't rotate**
+#   speaker_indicator alarm (4)   → alarm1..4 under root       ❌ **doesn't rotate**
+#
+# The **premise** of re-identifying is "this thing rotated away with visuals_base, so find the set that's currently above me".
+# The last two kinds don't rotate at all — re-identifying them means making a platform drive a compactor that is **not physically above it**.
+#
+# All three symptoms came from this (user tested on 2026-08-27).
+#   · "More than five pieces of debris and the compactor still doesn't come down" — the one this platform drives is somewhere else.
+#   · "Some players can still be seen after being crushed by the compactor" — each machine has a different orientation → each slams its own,
+#      and the player your machine crushed was never crushed on the server (hit detection is already decided solely by the server).
+#   · The match can't end — players who should die don't.
+#
+# So the sole reason the `fixed` parameter exists is that **compactors and alarm audio must always bind to their own group**,
+# which is determined by geometry, comes out the same on every machine, and has no orientation mixed in.
+# When fixed isn't passed it falls back to own (initial wiring during layout, where the two are the same group anyway).
+func _mp8_wire_platform(own: Dictionary, partner: Dictionary, fixed = null) -> void :
+
+	var p: JunkPlatformPlatform = own["platform"]
+
+	# The two kinds that rotate get re-identified by orientation (own = the group currently above this platform)
+	var own_indicator: Node3D = _mp8_pick(own, "damage indicator")
+	var own_visual: Node3D = _mp8_pick(own, "platform main")
+
+	# The two kinds that don't rotate always take **their own group**, regardless of orientation
+	var src_fixed: Dictionary = own if fixed == null else fixed
+	var own_compactor = _mp8_pick(src_fixed, "compactor")
+	var own_alarm = _mp8_pick(src_fixed, "speaker_indicator alarm")
+
+	var far_indicator: Node3D = _mp8_pick(partner, "damage indicator")
+	var far_visual: Node3D = _mp8_pick(partner, "platform main")
+	var far_compactor = _mp8_pick(partner, "compactor")
+	var far_alarm = _mp8_pick(partner, "speaker_indicator alarm")
+
+	if own_indicator != null:
+		p.damage_circle_parent = own_indicator
+	if far_indicator != null:
+		p.damage_circle_parent_flipped = far_indicator
+
+	var vis: Array[Node3D] = []
+	if own_indicator != null:
+		vis.append(own_indicator)
+	if own_visual != null:
+		vis.append(own_visual)
+	p.platform_visuals = vis
+
+	var vis_f: Array[Node3D] = []
+	if far_indicator != null:
+		vis_f.append(far_indicator)
+	if far_visual != null:
+		vis_f.append(far_visual)
+	p.platform_visuals_flipped = vis_f
+
+	if own_compactor != null:
+		p.compactor = own_compactor
+	if far_compactor != null:
+		p.compactor_flipped = far_compactor
+	if own_alarm != null:
+		p.speaker_alarm = own_alarm
+	if far_alarm != null:
+		p.speaker_alarm_flipped = far_alarm
+
+	p.assign_indicators()
+
+
+# Pick one node from a group's kit by name prefix (duplicates have "MP8_<index>_" prepended to their names, hence contains)
+func _mp8_pick(group: Dictionary, keyword: String):
+	for node in group["nodes"]:
+		if String(node.name).contains(keyword):
+			return node
+	return null
+
+
+# [MP8] Pad spawn points to match the platform count, with **order strictly matching the platforms**.
+# Junk drop points are derived from spawn points (add_spawn_point(id, spawn point + 20 m) in spawn_players),
+# so if spawn points don't follow the platforms, junk falls into the void at the old positions.
+func _mp8_rebuild_spawn_points(slots: Array[Vector3]) -> void :
+
+	var container: Node3D = player_spawn_position_node
+	if container == null:
+		return
+
+	var kids: Array = container.get_children()
+	if kids.is_empty():
+		return
+
+	var template: Node3D = kids[0]
+	while container.get_child_count() < slots.size():
+		var dup: Node3D = template.duplicate()
+		dup.name = "MP8Spawn%d" % container.get_child_count()
+		container.add_child(dup)
+
+	var all: Array = container.get_children()
+	for i in slots.size():
+		if i >= all.size():
+			break
+		var m: Node3D = all[i]
+		# Stand at the platform center, raised slightly so we don't get stuck in the collider
+		m.global_position = slots[i] + Vector3(0.0, template.global_position.y, 0.0)
+
+
+# [MP8] ═══════════ View modes B / C (on 2026-08-25 the user asked for two versions to compare) ═══════════
+#
+# What prompted it is 8 players crammed into 2 orientations, with the far ones blocked by the near ones.
+#
+# ---- Why vanilla only has 2 orientations ----
+#
+# When the orientation changes, **the camera and visuals rotate together** (`camera_base` + `visuals_base`),
+# while the platforms' **colliders/logic nodes stay put** (Platform1..4 pinned at ±13).
+# So once `visuals_base` rotates, the visuals that sat over platform A end up over another platform,
+# and every platform must **re-identify the set currently above it** — vanilla uses
+# two slots for this, `platform_visuals` / `platform_visuals_flipped`, **so there are only two states**.
+# That's the whole origin of 0°/180°.
+#
+# 🩸 **That isn't a hard limit, it's "only two states were prepared".** Re-identifying can be computed geometrically
+# for any angle — provided that angle maps "visual groups" back onto "platform positions",
+# i.e. it **must be a symmetry angle of the platform ring**. That's exactly where B and C differ.
+#
+# ---- B — layout unchanged, 4 orientations ----
+#
+# Right now it's a **mixed double ring**. Inner ring of 4 at r=18.38 at 45/135/225/315°, outer ring of 4 at r=22.5 at 0/90/180/270°.
+#   Rotate 90° → inner lands on inner, outer lands on outer ✅
+#   Rotate 45° → inner lands on the outer ring's **angles**, but **the radius doesn't match** ❌
+# So there are only 4 settings. The 8 players share orientations in pairs, and the two platforms in each shared pair are exactly the ones at θ±22.5° —
+# **both closest to the camera, side by side along the bottom edge of the frame**, so neither blocks the other.
+#
+# ---- C — form a regular octagon, 8 orientations ----
+#
+# Move **the 4 vanilla ones out to r=22.5 too** (bearing unchanged, only radius changes), and 45° becomes a symmetry angle → one setting per player.
+# ⚠️ This **overturns the user's 2026-08-16 decision that "the 4 vanilla ones don't move at all"**.
+#    But the point of that decision was the island feel / gap, and C is **better** on that front.
+#    Regular octagon r=22.5, neighboring center distance 2R·sin(22.5°) = 17.22, minus two platform radii of 6 → **gap 5.2**,
+#    wider than the current mixed double ring's 4.1 (the rejected same-radius 18.38 only had 2.1, and that was the walkable one).
+#
+# ---- What neither version touches ----
+#
+# The camera's **position and fov** still go through the existing path (`mp8junkcam=` / `_mp8_apply_camera`), only orientation changes here.
+# There's no other free attachment point available in the camera hierarchy.
+#   `Camera3D.rotation`  is written **every frame** by `anim_camera sway` (autoplay)
+#   `CameraDefault`      is written by `shaker_camera shake` as its Target
+#   `ShakerComponent3D`  is itself the shake component
+# **Only `camera_base` has nobody fighting over it**, so orientation can only rotate that.
+# [User's live-test decision on 2026-08-25 — **use version C** ("looks basically fine")]
+# So the default is c. The other two settings are demoted to **debug knobs for comparison**, only used when mp8junkview=a / =b is passed.
+#   a = original (2 orientations, mixed double ring, identical value for value to before this round)
+#   b = 4 orientations, layout unchanged
+#   c = 8 orientations, regular octagon (**current default**)
+const MP8_VIEW_STEPS: Dictionary = {"a": 180.0, "b": 90.0, "c": 45.0}
+const MP8_VIEW_DEFAULT: String = "c"
+# The setting that takes vanilla's two-state path (the `platform_visuals` ↔ `_flipped` toggle).
+# All other settings use geometric re-identification via `_mp8_apply_view()`.
+const MP8_VIEW_VANILLA: String = "a"
+
+var _mp8_view_mode: String = MP8_VIEW_DEFAULT
+var _mp8_my_facing: float = 0.0
+# Each group's kit after moving, `{"platform":, "nodes":, "pos": final world coordinates}`
+var _mp8_groups_final: Array = []
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 🩸 T49 safety gate — clear players who are "already killed but never taken off the books" out of active_players
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# This gate **wasn't added for any one bug**, it's structural.
+# This match is pure elimination (it only ends at `active_players.size() <= 1`), and **there is no timeout fallback at all** —
+# one player not taken off the books = this minigame hangs forever. Junk keeps falling, debris piles up, the frame rate keeps collapsing, and players can only force-quit.
+# T49 was the compactor killing a player on a client via `kill_rpc` while `emit_died` never fired on the server
+# (the root cause is fixed in `junk_platform_compactor.gd`). If some other "killed but not taken off the books"
+# path shows up later, it'll be a few seconds late at most instead of hanging the whole match.
+#
+# The test is `active == false`. `kill_rpc()` always sets it to false (that's the only sign of being judged dead),
+# and living players are always true. **No position test** (`y < -100` and the like) — that's a symptom, not the essence, and a different kill method would slip past it.
+#
+# ⚠️ **The grace period must be longer than the 1.5-second tween in `fall_rpc`**. A fall sets `active = false` first,
+#    and only calls `emit_died` 1.5 seconds later. Too short a grace period would take **players who are mid-fall** off the books early —
+#    placements would get scrambled, and results might even run while someone is still in the air.
+# ⚠️ **Only sweep while `junk_handler.active`**. Before the match starts everyone's `active` is false
+#    (`set_active_rpc(true)` and `junk_handler.set_active(true)` are sent at the same moment),
+#    so without this gate the countdown phase would clear everyone at once.
+const MP8_SWEEP_TICK: float = 1.0
+const MP8_SWEEP_GRACE: float = 3.0
+var _mp8_dead_since: Dictionary[int, float] = {}
+var _mp8_sweep_timer: Timer = null
+
+
+func _mp8_facing_step() -> float:
+	return float(MP8_VIEW_STEPS.get(_mp8_view_mode, 180.0))
+
+
+# [MP8] Which orientation this player should use.
+# At rest the camera is on the +Z side looking toward -Z, so orientation = the platform's bearing `atan2(x, z)`, rounded to the mode's step.
+# ⚠️ **With step=180 this is equivalent to vanilla case by case**, so all three modes can share this one function.
+#    (±13,+13) → ±45° → rounds to 0. (±13,−13) → ±135° → rounds to 180.
+func _mp8_facing_for(pos: Vector3) -> float:
+	var step: float = _mp8_facing_step()
+	var bearing: float = rad_to_deg(atan2(pos.x, pos.z))
+	return fposmod(round(bearing / step) * step, 360.0)
+
+
+# [MP8] Based on the current orientation, point each platform at the set of visuals "currently above it".
+#
+# `visuals_base` rotated by deg, so visuals that were at g are now at R(deg)·g.
+# Finding the group covering platform p means finding **g ≈ R(−deg)·p**.
+#
+# ⚠️ In B/C modes this **must never** go through vanilla's `platform_visuals = platform_visuals_flipped` again.
+#    That's a two-state toggle, and here the correct set has already been assigned directly, so flipping again would flip it wrong.
+func _mp8_rebind_for_facing(deg: float) -> void :
+
+	if _mp8_groups_final.is_empty():
+		return
+
+	var inv := Basis(Vector3.UP, deg_to_rad( - deg))
+	var hit: int = 0
+	# [MP8] Injectivity self-check (added along the way during T49). This function **picks the nearest independently for each platform**, and nothing
+	# guarantees two platforms won't point at the same visual group. If they ever do, the result is "one compactor shared by two platforms,
+	# and another used by nobody" — nearly impossible to spot by eye, it only shows up as "why won't that platform's compactor come down".
+	# A regular octagon + integer multiples of 45° is a clean permutation in theory, so this **only reports and doesn't correct**.
+	# If it ever fires, the slots aren't laid out symmetrically, and the layout should be investigated instead of patching things here.
+	# (The flip pairing side has `_mp8_check_pairing()` checking the involution, and this path always lacked an equivalent check.)
+	var taken: Dictionary = {}
+
+	for g in _mp8_groups_final:
+		var pl = g["platform"]
+		if pl == null or not is_instance_valid(pl):
+			continue
+
+		var p: Vector3 = Vector3(pl.global_position.x, 0.0, pl.global_position.z)
+		var want: Vector3 = inv * p
+		var want_far: Vector3 = - want
+
+		var best: Dictionary = {}
+		var far: Dictionary = {}
+		var bd: float = INF
+		var fd: float = INF
+		for h in _mp8_groups_final:
+			var hp: Vector3 = h["pos"]
+			var d: float = Vector2(hp.x - want.x, hp.z - want.z).length()
+			if d < bd:
+				bd = d
+				best = h
+			var d2: float = Vector2(hp.x - want_far.x, hp.z - want_far.z).length()
+			if d2 < fd:
+				fd = d2
+				far = h
+
+		if best.is_empty():
+			continue
+
+		var key: String = str(best.get("pos", Vector3.ZERO))
+		if taken.has(key):
+			print("[MP8] Junk Platform: ⚠️ re-identification collision at orientation %.0f° — platforms %s and %s both point at the %s visual group (a compactor will be shared by two platforms)" % [
+				deg, String(pl.name), String(taken[key]), key
+			])
+		taken[key] = String(pl.name)
+
+		# Build a temporary group from the platform itself + that group's kit, reusing the already-verified wiring function.
+		# The third argument `g` = **this platform's own group** — compactors and alarm audio only recognize that one
+		# and don't follow orientation (see the block above _mp8_wire_platform for why).
+		_mp8_wire_platform(
+			{"platform": pl, "nodes": best["nodes"]},
+			(far if not far.is_empty() else best),
+			g
+		)
+		hit += 1
+
+	print("[MP8] Junk Platform: orientation %.0f° → re-identified visuals for %d/%d platforms" % [
+		deg, hit, _mp8_groups_final.size()
+	])
+
+
+# [MP8] Full view switch for B/C modes. **Runs locally, each machine rotates on its own.**
+func _mp8_apply_view(deg: float) -> void :
+
+	_mp8_my_facing = deg
+	if camera_base != null:
+		camera_base.rotation_degrees.y = deg
+	if visuals_base != null:
+		visuals_base.rotation_degrees.y = deg
+	_mp8_rebind_for_facing(deg)
+	_mp8_show_id_hud()
+
+
+# [MP8] ===== Camera — **tune per player, and leave alone everything that can be left alone** (proposed by the user on 2026-08-16) =====
+#
+# The premise that makes this possible (confirmed by reverse-engineering) is that **each machine has its own camera**, not one shared across the arena.
+# Vanilla itself already sends camera commands per player (`rotate_camera_rpc.rpc_id(network_id, ...)`),
+# so giving different players different cameras works fine.
+#
+# ⚠️ **The only locked thing is orientation, which can only be 0° or 180°.**
+# That's because `camera_base` + `visuals_base` rotate together, and platform visuals are **shared in diagonal pairs**
+# (`platform_visuals` / `platform_visuals_flipped`), so there are only these two states.
+# **Position and fov are completely free** and can differ per player.
+#
+# Tested (vanilla camera, octagon radius 22.5, platform radius 5). Of the 8 platforms only the two **directly on the camera's center axis**
+# at (0,0,±R) push against the edge of the frame (vertical margin +1.0 / +2.7 < radius 5),
+# while vanilla framing has plenty of room for the other 6 (margin 7~13).
+# So **only the owners of those two platforms get a bit of pull-back + lowering + wider FOV, and the other 6 players see exactly what vanilla shows**.
+# The smaller the change surface, the less likely it breaks something that was already right (pitfall #21, if vanilla is right, don't touch it).
+#
+# ⚠️⚠️ **Move the camera's position within camera_base's local space, and never move camera_base itself.**
+# camera_base rotates around **its own origin** (tested, it sits right at the world origin).
+# The previous version did `camera_base.global_position += back`, and the result was that
+# the half of the players at orientation 0° did get their camera pulled back, but once camera_base rotated 180°
+# the same world offset pointed the opposite way — **the other half's cameras moved forward instead**.
+# Framing differed between the two sides, and that kind of asymmetry is nearly impossible to spot by eye across 8 small windows.
+# Moving local coordinates avoids this. The offset rotates with camera_base, so both sides are strictly symmetric.
+#
+# The three values can be overridden temporarily with the command-line arg `mp8junkcam=<pull back>,<lower>,<FOV increase>`, no recompile needed,
+# and tuned alongside the [MP8-CAM] health-check lines in the log.
+# [Settled by the user on 2026-08-16] What the user actually picked is this **arena-wide uniform** set.
+#   pull back 6 / lower 2 / FOV +10 (vanilla 50.3 → 60.3), camera (0,27.1,30.7) -> (0,25.1,36.7).
+# The matching screenshot is `notes\shots\oct_cam_b6d2f10_t3_P1.png`.
+# Per-player mode (only adjusts the two players on the center axis, the rest stay vanilla) is still available, enable it by passing `mp8junkcamper`.
+const MP8_CAM_BACK: float = 6.0      # back off **horizontally** along the line of sight (no raising, since raising would pass the compactor tops at y≈26.8 and their lids would smear the picture)
+const MP8_CAM_DOWN: float = 2.0      # lower the camera
+const MP8_CAM_FOV_ADD: float = 10.0  # FOV increase (vanilla 50.3 → 60.3)
+
+var _mp8_cam_xf0: Transform3D        # vanilla camera transform (camera_base hasn't rotated yet in _ready, so it's a clean baseline)
+var _mp8_cam_fov0: float = 0.0
+
+
+# [MP8] Should this player's camera move? Returns (pull back, lower, FOV increase), all 0 = keep vanilla.
+#
+# The test is whether **their own platform** is fully visible on their machine's screen.
+# Only the platform's top surface (where people stand) counts, not the lower part of the platform pillar — on vanilla's two near platforms
+# the pillars are already partly cut off by the bottom edge, which is just how vanilla looks, not a defect.
+func _mp8_camera_adjust_for(pos: Vector3, rot: float) -> Vector3:
+
+	if _mp8_cam_fov0 <= 0.0:
+		return Vector3.ZERO
+
+	# By default the **arena-wide uniform** adjustment is used (already applied in _ready), so don't add a per-player one here and apply it twice
+	if not NetworkManager.mp8_args().has("mp8junkcamper"):
+		return Vector3.ZERO
+
+	var radius: float = 6.0
+	if junk_handler != null and "platform_radius" in junk_handler:
+		radius = junk_handler.platform_radius
+
+	# Their machine's camera only rotates 0° or 180°. Rotating 180° is equivalent to rotating the platform position 180° around Y
+	# ((x,z) -> (-x,-z)) and viewing it with the **vanilla-orientation** camera, so converting the position directly is enough.
+	var p: Vector3 = Vector3(pos.x, 0.0, pos.z)
+	if absf(rot) > 90.0:
+		p = Vector3( - p.x, 0.0, - p.z)
+
+	var half_v: float = deg_to_rad(_mp8_cam_fov0) * 0.5
+	var half_h: float = atan(tan(half_v) * _mp8_aspect())
+	var m: Vector3 = _mp8_frame_margin(_mp8_cam_xf0, half_v, half_h, p)
+
+	if minf(m.y, m.z) >= radius:
+		return Vector3.ZERO   # vanilla framing is enough, change nothing
+
+	return _mp8_cam_values()
+
+
+# [MP8] Camera tweak amounts (pull back, lower, FOV increase), overridable with the command-line arg mp8junkcam=<pull back>,<lower>,<FOV increase>
+func _mp8_cam_values() -> Vector3:
+
+	var back: float = MP8_CAM_BACK
+	var down: float = MP8_CAM_DOWN
+	var fov_add: float = MP8_CAM_FOV_ADD
+	var v: String = _mp8_arg("mp8junkcam=")
+	if v != "":
+		var parts: PackedStringArray = v.split(",")
+		if parts.size() > 0 and String(parts[0]).is_valid_float():
+			back = float(parts[0])
+		if parts.size() > 1 and String(parts[1]).is_valid_float():
+			down = float(parts[1])
+		if parts.size() > 2 and String(parts[2]).is_valid_float():
+			fov_add = float(parts[2])
+	return Vector3(back, down, fov_add)
+
+
+# [MP8] The server sends this per player. No call_local — the server's own copy is called directly in spawn_players.
+@rpc("authority", "call_remote", "reliable")
+func mp8_adjust_camera_rpc(back: float, down: float, fov_add: float) -> void :
+	if not (NetworkManager.mp8_finite(back, 100.0) and NetworkManager.mp8_finite(down, 100.0) and NetworkManager.mp8_finite(fov_add, 60.0)):
+		return
+	_mp8_apply_camera(back, down, fov_add)
+
+
+func _mp8_apply_camera(back: float, down: float, fov_add: float) -> void :
+
+	if camera == null or camera_base == null:
+		return
+
+	var before: Vector3 = camera.global_position
+	var before_fov: float = camera.fov
+
+	# In camera_base's local space, +Z is the direction "facing away from the line of sight" (the camera looks toward -Z),
+	# so pull back = +Z and lower = -Y. The offset rotates with camera_base's 180°, so both sides are symmetric.
+	var t: Transform3D = camera_base.global_transform.affine_inverse() * camera.global_transform
+	t.origin += Vector3(0.0, - down, back)
+	camera.global_transform = camera_base.global_transform * t
+
+	camera.fov = before_fov + fov_add
+
+	print("[MP8] Local camera tweak: pull back %.1f, lower %.1f, FOV %.1f -> %.1f; position (%.1f, %.1f, %.1f) -> (%.1f, %.1f, %.1f)" % [
+		back, down, before_fov, camera.fov,
+		before.x, before.y, before.z,
+		camera.global_position.x, camera.global_position.y, camera.global_position.z
+	])
+
+
+func _mp8_aspect() -> float:
+	var vp: Viewport = get_viewport()
+	if vp != null and vp.get_visible_rect().size.y > 0.0:
+		return vp.get_visible_rect().size.x / vp.get_visible_rect().size.y
+	return 16.0 / 9.0
+
+
+# [MP8] Camera framing health check, which logs "which platforms are in frame and which dropped out" directly.
+#
+# Once the camera doesn't move, framing headroom is set entirely by vanilla, and judging it by staring at 8 small windows is slow and easy to miss things
+# (especially since "out of frame" and "blocked by something else" look very similar by eye). So this computes it properly and prints it.
+#
+# **Both orientations must be computed**. The far-side half of the players have camera_base rotated 180° around Y,
+# which is equivalent to rotating platform positions 180° around Y and viewing with the same camera, so the second orientation just uses (-x, y, -z).
+#
+# What margin means is the world-unit distance from the view frustum boundary to the point.
+#   margin < 0          → even the platform's **center** is off screen, and its owner can't see their own platform at all
+#   0 ≤ margin < radius → the center is on screen, but part of the platform's edge is cut off (vanilla's near row is already like this)
+#   margin ≥ radius     → the whole platform is on screen
+func _mp8_report_camera(groups: Array, slots: Array[Vector3]) -> void :
+
+	if camera == null:
+		return
+
+	var xf: Transform3D = camera.global_transform
+	var half_v: float = deg_to_rad(camera.fov) * 0.5
+	var aspect: float = 16.0 / 9.0
+	var vp: Viewport = get_viewport()
+	if vp != null and vp.get_visible_rect().size.y > 0.0:
+		aspect = vp.get_visible_rect().size.x / vp.get_visible_rect().size.y
+	var half_h: float = atan(tan(half_v) * aspect)
+
+	var radius: float = 6.0
+	if junk_handler != null and "platform_radius" in junk_handler:
+		radius = junk_handler.platform_radius
+
+	print("[MP8-CAM] camera pos=(%.1f, %.1f, %.1f) pitch=%.1f° fov=%.1f half-angle V=%.1f° H=%.1f° platform radius=%.1f camera_base=(%.1f, %.1f, %.1f)" % [
+		xf.origin.x, xf.origin.y, xf.origin.z,
+		- rad_to_deg(xf.basis.get_euler().x), camera.fov,
+		rad_to_deg(half_v), rad_to_deg(half_h), radius,
+		camera_base.global_position.x, camera_base.global_position.y, camera_base.global_position.z
+	])
+
+	for i in slots.size():
+		var s: Vector3 = slots[i]
+		var a: Vector3 = _mp8_frame_margin(xf, half_v, half_h, s)
+		var b: Vector3 = _mp8_frame_margin(xf, half_v, half_h, Vector3( - s.x, s.y, - s.z))
+		print("[MP8-CAM] platform%d (x=%6.1f z=%6.1f)  facing 0°: depth%5.1f vert%+6.1f horiz%+6.1f %s   facing 180°: depth%5.1f vert%+6.1f horiz%+6.1f %s" % [
+			i + 1, s.x, s.z,
+			a.x, a.y, a.z, _mp8_verdict(a, radius),
+			b.x, b.y, b.z, _mp8_verdict(b, radius)
+		])
+
+	# The compactors are the tallest things in the arena (resting position measured at y≈26.8, nearly level with the camera at y≈27).
+	# One that's too close to the lens smears right across the picture — the previous version's "black block at the top" was most likely that.
+	for i in groups.size():
+		var c = _mp8_pick(groups[i], "compactor")
+		if c == null:
+			continue
+		var cp: Vector3 = c.global_position
+		var d0: float = _mp8_frame_margin(xf, half_v, half_h, cp).x
+		var d1: float = _mp8_frame_margin(xf, half_v, half_h, Vector3( - cp.x, cp.y, - cp.z)).x
+		var near: float = minf(d0, d1)
+		if near < 12.0:
+			print("[MP8-CAM] ⚠️ platform%d compactor (y=%.1f) is only %.1f from the lens and will smear across the picture, blocking the view" % [
+				i + 1, cp.y, near
+			])
+
+
+# [MP8] Returns (depth, vertical margin, horizontal margin). Margin = world-unit distance from the frustum boundary to the point, negative = already off screen.
+func _mp8_frame_margin(xf: Transform3D, half_v: float, half_h: float, p: Vector3) -> Vector3:
+
+	var local: Vector3 = xf.affine_inverse() * p
+	var depth: float = - local.z          # camera looks toward -Z
+	if depth <= 0.01:
+		return Vector3(depth, -999.0, -999.0)   # behind the camera
+	return Vector3(
+		depth,
+		depth * tan(half_v) - absf(local.y),
+		depth * tan(half_h) - absf(local.x)
+	)
+
+
+func _mp8_verdict(m: Vector3, radius: float) -> String:
+	var worst: float = minf(m.y, m.z)
+	if worst < 0.0:
+		return "✗center already off screen"
+	if worst < radius:
+		return "△edge cut off"
+	return "✓fully visible"
+
+
