diff --git a/minigames/junk_platform/components/player/scripts/junk_platform_player.gd b/minigames/junk_platform/components/player/scripts/junk_platform_player.gd
--- a/minigames/junk_platform/components/player/scripts/junk_platform_player.gd
+++ b/minigames/junk_platform/components/player/scripts/junk_platform_player.gd
@@ -154,6 +154,21 @@ func update_interaction(_delta: float) -> void :
 		if DynamicInput.is_action_just_pressed(player_presence.device_id, "action_1"):
 
 			for item in in_grab_area:
+
+				# [MP8] T47 ② — **don't grab a piece that's already in someone else's hands.** Vanilla has no check at all here,
+				# whoever presses sets `held_item = item` locally and broadcasts "it's mine". That has two consequences.
+				#   1. Both players think they're holding it but the box only follows one → when the other presses throw,
+				#      `throw_rpc` hits `if not held_by: return` and **throws nothing**
+				#      (same flavor as the Spine Breaker issue where "pressing throw threw the one on someone else's back").
+				#   2. More subtle is the collision exception leak, see the comment on the cube side.
+				# This gate blocks the **common case** (the piece was already picked up a while ago).
+				# ⚠️ It can't block the true window where both press on the same frame — that would need server-authoritative grabbing,
+				#    at the cost of an extra round trip of latency per grab, which hurts the feel more. **Deliberately not done.**
+				#    The hand-off cleanup on the cube side guarantees that even if that happens, no permanent collision exception is left behind.
+				if item.held_by_player != null and is_instance_valid(item.held_by_player) \
+						and item.held_by_player != self:
+					continue
+
 				held_item = item
 				grab_area.set_collision_layer_value(grab_layer, false)
 				held_item.set_held_rpc.rpc(true, get_path())
