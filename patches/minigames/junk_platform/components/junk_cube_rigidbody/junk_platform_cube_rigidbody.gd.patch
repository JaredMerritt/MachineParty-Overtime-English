 @rpc("any_peer", "call_local", "reliable")
 func set_held_rpc(held: bool, _held_by: NodePath):
+
+	# [MP8] T47 ② — **when changing hands, the previous holder's collision exception must be removed first, or it leaks permanently.**
+	#
+	# Vanilla does an unconditional `add_collision_exception_with(held_by_player)` here,
+	# and the whole file has **only one `remove`** (in `throw_rpc`, which removes whoever was `held_by_player` **at that moment**).
+	# So when two players grab the same piece in the same frame, each `set_held_rpc` adds once and the later one overwrites `held_by_player`,
+	# then the throw can only remove the last one — **the exception between the player who lost the grab and this debris is never removed,
+	# and from then on the debris passes straight through them**. It's permanent and gets worse the longer you play.
+	#
+	# ⚠️ The drop/death path is unaffected. `drop_item_rpc` goes through `throw_rpc`, which removes it properly.
+	#    **This hand-off is the only leak.**
+	#
+	# ⚠️ This **does not "reject if someone else is already holding it"**. This RPC is broadcast by each client,
+	#    and arrival order can differ between peers, so rejecting by "first come, first served" would make peers pick **different winners**,
+	#    which is worse than the current "last arrival takes over". A real fix would make grabbing server-authoritative,
+	#    at the cost of an extra round trip of latency on every grab. **The common case is already blocked on the player side**
+	#    (the grab loop in `junk_platform_player.gd` skips items someone else is holding),
+	#    so this only guarantees that **even if the same-frame window is hit, no permanent collision exception is left behind**.
+	var claimer: Node = get_node_or_null(_held_by)
+	if claimer == null:
+		push_warning("[MP8] Junk Platform: set_held_rpc received a path that can't be found %s, ignoring" % String(_held_by))
+		return
+
+	if held_by_player != null and is_instance_valid(held_by_player) and held_by_player != claimer:
+		remove_collision_exception_with(held_by_player)
+		if multiplayer.is_server():
+			print("[MP8] Junk Platform: debris changed hands %s → %s (grabbed in the same frame, removed the old collision exception)" % [
+				String(held_by_player.name), String(claimer.name)
+			])
+
 	visible = false
-	held_by_player = get_node(_held_by)
+	held_by_player = claimer
 	add_collision_exception_with(held_by_player)
 	held_by = held_by_player.grab_position
 	freeze = held
@@ -124,6 +154,22 @@ func reset_rpc():
 	active = false
 	freeze = true
 
+	# ═══════ [MP8] 2026-08-19 — recycling must also turn off the ground shadow ═══════
+	#
+	# `_physics_process` starts with `if not active: return`,
+	# so once active is false the shadow is **never updated again** and stays frozen as it was on the last frame.
+	# Vanilla's `setup_rpc` does turn the shadow off in its deactivate branch (see the else there),
+	# and reset_rpc is the only place missing that line.
+	#
+	# Vanilla never hits this pitfall. Its only recycle entry point is "debris falls off the platform into junk_catcher",
+	# and by then the raycast has long stopped colliding and the shadow is already off.
+	# But the timeout recycle MP8 added (junk_handler._mp8_recycle_stuck_junk) collects debris
+	# **resting on the platform** — the raycast is touching the ground, so the shadow freezes with visible=true
+	# and leaves a permanent stain on the platform, one for every piece recycled.
+	#
+	# This function is a call_local broadcast, so host and clients both turn it off, not just the host.
+	drop_shadow.visible = false
+
 	global_position = Vector3.UP * 999
 	global_rotation = Vector3.ZERO
 
