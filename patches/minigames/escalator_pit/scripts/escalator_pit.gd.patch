+
+# [MP8] ================ Gameplay rework - escalator runs down at a set speed + speeds up over time ================
+#
+# User decision 2026-08-16 - **"The escalator carries players toward the grinder at a set speed, the longer they survive the faster it drops,
+# and players have to press keys faster to survive."** — the minigame's character changes from a "chase race" to **endurance survival**.
+#
+# ⚠️ This **overrides vanilla's core rule**. Vanilla uses `escalator_speed = the speed of the fastest player in the match` (clamped to 1.0),
+# a rubber-band design where "the leader speeds up the whole escalator and drags everyone down (themselves included)".
+# In the new gameplay the escalator **ignores everyone** and only looks at how long the match has been running.
+#
+#     escalator speed = min(start speed + increment per second × seconds elapsed this match, cap)
+#
+# A player's net movement is still `(their own speed − escalator speed) × 0.5 × delta`, so
+#   - the escalator is already carrying players down at the start (start speed > 0), so anyone not pressing keys is bound to fall.
+#   - given enough time the escalator exceeds the player speed cap (2.0) and **nobody can hold on** → every match is bound to end, it can't go on forever.
+#
+# The vanilla rule is kept as a control group via `mp8escmode=vanilla`.
+const MP8_BELT_BASE_DEFAULT: float = 0.35   ## Escalator speed at the start
+const MP8_BELT_RAMP_DEFAULT: float = 0.03   ## How much it increases per second
+const MP8_BELT_CAP_DEFAULT: float = 2.0     ## Cap (= the cap on player speed, once it's reached nobody can keep up)
+
+# [MP8] ===== Placement-based scoring - **survival order** (user decision 2026-08-16) =====
+#
+# Vanilla is cumulative. First to the top +2, others +1. Each time someone falls, everyone still alive +1. The last one left gets another +1.
+# With 8 players that's broken. **Just hanging on is worth up to +8, racing for first only +2**, and once you reach the top you leave the active list
+# and can't earn a single point when others fall afterwards — "hang in mid-air until everyone else falls" is the overwhelmingly best strategy (worse the more players there are).
+#
+# The new gameplay is endurance survival, so **survival time is naturally the placement**, and the minigame's own order arrays serve directly as the placement source
+# (`_mp8_dead_order` / `active_players` / `finished_players`), instead of ranking integer counts at the tally stage
+# — that's this project's iron rule for scoring, the same approach as Duck Hunt (T13).
+#
+# Ranking from worst to best - **first to fall is worst → later falls → still alive at the end → escaped to the top (first to the top is best)**
+# Score = step × placement index, the first to die gets 0. An 8-player match fills exactly {0,2,4,…,14}, no repeats or gaps.
+#
+# The step reuses Duck Hunt's 2. Not because this match needs half points, but **to line up with the scale of placement-based minigames**
+# (placement-based 8-player matches are roughly 0~12~14). If you really need to adjust the scale, use MP8_MINIGAME_SCORE_SCALE in `game.gd`,
+# don't change the step here.
+const MP8_ESC_RANK_STEP: int = 2
+
+var _mp8_dead_order: Array[int] = []    # Order players fell into the grinder (network ids), this match's placement source
+
+var _mp8_survival: bool = true          # false = back to vanilla's "fastest player drives the escalator"
+var _mp8_belt_base: float = MP8_BELT_BASE_DEFAULT
+var _mp8_belt_ramp: float = MP8_BELT_RAMP_DEFAULT
+var _mp8_belt_cap: float = MP8_BELT_CAP_DEFAULT
+var _mp8_belt_elapsed: float = 0.0      # Seconds since Play started this match
+var _mp8_belt_running: bool = false     # Only starts speeding up once the countdown ends
+var _mp8_belt_log_t: float = 0.0
+var _mp8_info_on: bool = false          # mp8escinfo - shows escalator speed on screen, for tuning
+var _mp8_info_label: Label = null
+
+var _mp8_edit_on: bool = false
+var _mp8_edit_sel: int = 0
+var _mp8_edit_step_i: int = 1
+var _mp8_edit_items: Array = []          # `[{ "node": Node3D, "src": String }]`, same order on all 8 machines
+var _mp8_edit_panel: Label = null
+var _mp8_edit_canvas: CanvasLayer = null
+var _mp8_edit_src: String = "auto layout"
+
+
+# Collect the hand-adjustable pieces into the registry - originals first, then their copies (`_MP8L` / `_MP8R`).
+# The order is the same on every machine (same scene + same code), so indices can be used directly as RPC arguments.
+func _mp8_edit_collect() -> void :
+
+	_mp8_edit_items.clear()
+	var art: Node3D = get_node_or_null("escalator pit art11") as Node3D
+	if art == null:
+		return
+
+	for src_name in MP8_EDIT_SOURCES:
+		for c in art.get_children():
+			if not (c is Node3D):
+				continue
+			var nm := String(c.name)
+			if nm == src_name or nm == src_name + "_MP8L" or nm == src_name + "_MP8R" \
+					or nm.begins_with(src_name + "_MP8X"):
+				_mp8_edit_items.append({"node": c, "src": src_name})
+
+
+# Read the save file and place pieces by it. If the file exists, it wins (extra lines create copies, missing lines hide the leftovers).
+func _mp8_apply_layout_file() -> void :
+
+	var rows := _mp8_parse_layout_file()
+	if rows.is_empty():
+		# No save file → use the final placement baked into the code (this is the path the release build takes)
+		rows = []
+		for r in MP8_LAYOUT_BAKED:
+			rows.append({
+				"src": String(r[0]), "pos": r[1], "yaw": float(r[2]),
+				"sx": float(r[3]), "vis": bool(r[4]),
+			})
+		_mp8_edit_src = "built-in final table MP8_LAYOUT_BAKED"
+	else:
+		_mp8_edit_src = "save file %s" % MP8_EDIT_FILE
+	if rows.is_empty():
+		return
+
+	var art: Node3D = get_node_or_null("escalator pit art11") as Node3D
+	if art == null:
+		return
+
+	# Group by source piece and match up each group - line n → the group's nth instance, cloning one if there aren't enough
+	for src_name in MP8_EDIT_SOURCES:
+		var mine: Array = []
+		for it in _mp8_edit_items:
+			if String(it["src"]) == src_name:
+				mine.append(it["node"])
+
+		var want: Array = []
+		for r in rows:
+			if String(r["src"]) == src_name:
+				want.append(r)
+		if want.is_empty():
+			continue
+
+		var proto: Node3D = mine[0] if not mine.is_empty() else null
+		if proto == null:
+			push_warning("[MP8] Escalator Pit: '%s' from the layout file isn't in the scene, skipping" % src_name)
+			continue
+
+		var extra: int = 0
+		while mine.size() < want.size():
+			var m := proto as MeshInstance3D
+			if m == null:
+				break
+			extra += 1
+			var dup := _mp8_clone_mesh(m, Vector3.ZERO)
+			dup.name = "%s_MP8X%d" % [src_name, extra]
+			mine.append(dup)
+			_mp8_edit_items.append({"node": dup, "src": src_name})
+
+		for i in mine.size():
+			var n: Node3D = mine[i]
+			if i >= want.size():
+				n.visible = false                 # Extra copies not listed in the file - hide them
+				continue
+			var r: Dictionary = want[i]
+			n.position = r["pos"]
+			n.rotation = Vector3(n.rotation.x, deg_to_rad(float(r["yaw"])), n.rotation.z)
+			n.scale.x = float(r["sx"])
+			n.visible = bool(r["vis"])
+
+	print("[MP8] Escalator Pit: placed pieces by the manual layout (%d pieces, source: %s)" % [rows.size(), _mp8_edit_src])
+
+
+# File format is `source name, x, y, z, yaw degrees, x scale, visible (1/0)`, and lines starting with `#` are comments.
+# One line = one instance in the scene. To add another handrail, just copy a line and change x.
+func _mp8_parse_layout_file() -> Array :
+
+	# [MP8] Saved layout files are a dev-build editor feature. Release builds always use the built-in layout.
+	if not NetworkManager.MP8_DEV_TOOLS or not FileAccess.file_exists(MP8_EDIT_FILE):
+		return []
+
+	var f := FileAccess.open(MP8_EDIT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] Escalator Pit: can't open %s (%d)" % [MP8_EDIT_FILE, FileAccess.get_open_error()])
+		return []
+
+	var rows: Array = []
+	var line_no: int = 0
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		line_no += 1
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var cols: PackedStringArray = line.split(",", false)
+		if cols.size() < 7:
+			push_warning("[MP8] Escalator Pit: layout file line %d doesn't have 7 columns, skipping: %s" % [line_no, line])
+			continue
+		var src_name: String = cols[0].strip_edges()
+		if not MP8_EDIT_SOURCES.has(src_name):
+			push_warning("[MP8] Escalator Pit: layout file line %d has an unknown piece name '%s', skipping" % [line_no, src_name])
+			continue
+		var numeric: bool = true
+		for k in range(1, 6):
+			if not (cols[k].strip_edges().is_valid_float() and NetworkManager.mp8_finite(float(cols[k]), 1000.0)):
+				numeric = false
+		if not numeric or rows.size() >= 256:
+			continue
+		rows.append({
+			"src": src_name,
+			"pos": Vector3(float(cols[1]), float(cols[2]), float(cols[3])),
+			"yaw": float(cols[4]),
+			"sx": float(cols[5]),
+			"vis": int(cols[6]) != 0,
+		})
+	f.close()
+	return rows
+
+
+func _mp8_save_layout_file() -> bool :
+
+	var f := FileAccess.open(MP8_EDIT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] Escalator Pit: can't write %s (%d)" % [MP8_EDIT_FILE, FileAccess.get_open_error()])
+		return false
+
+	f.store_line("# Escalator Pit (mp8game=2) 8-player manual venue layout — metal sheet and handrail placement")
+	f.store_line("# Each line = one instance: source name, x, y, z, yaw degrees, x scale, visible (1/0)")
+	f.store_line("# To add another handrail: copy a line and change x (the game creates the extra copy automatically).")
+	f.store_line("# To remove one: set the last column to 0, or just delete that line.")
+	f.store_line("# Delete the whole file = go back to the automatic layout in code.")
+	f.store_line("# Saved at %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+
+	for it in _mp8_edit_items:
+		var n: Node3D = it["node"]
+		if not is_instance_valid(n):
+			continue
+		f.store_line("%s, %.3f, %.3f, %.3f, %.0f, %.3f, %d" % [
+			String(it["src"]), n.position.x, n.position.y, n.position.z,
+			rad_to_deg(n.rotation.y), n.scale.x, (1 if n.visible else 0)])
+	f.close()
+
+	print("[MP8] Escalator Pit: layout saved → %s (%d pieces)" % [
+		ProjectSettings.globalize_path(MP8_EDIT_FILE), _mp8_edit_items.size()])
+	return true
+
+
+# Placement broadcast - all 8 windows move together, so it's never a case of "it only looks right on my machine".
+@rpc("any_peer", "call_local", "reliable")
+func mp8_esc_place_rpc(idx: int, pos: Vector3, yaw_deg: float, sx: float, vis: bool) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not (NetworkManager.mp8_finite_v3(pos) and NetworkManager.mp8_finite(yaw_deg) and NetworkManager.mp8_finite(sx, 100.0)):
+		return
+
+	if idx < 0 or idx >= _mp8_edit_items.size():
+		return
+	var n: Node3D = _mp8_edit_items[idx]["node"]
+	if not is_instance_valid(n):
+		return
+	n.position = pos
+	n.rotation = Vector3(n.rotation.x, deg_to_rad(yaw_deg), n.rotation.z)
+	n.scale.x = sx
+	n.visible = vis
+	if _mp8_edit_on:
+		_mp8_edit_refresh()
+
+
+func _mp8_edit_begin() -> void :
+
+	_mp8_edit_collect()
+	if _mp8_edit_items.is_empty():
+		push_warning("[MP8] Escalator Pit: no adjustable pieces found, manual edit mode not starting")
+		_mp8_edit_on = false
+		return
+
+	if _mp8_edit_canvas == null:
+		_mp8_edit_canvas = CanvasLayer.new()
+		_mp8_edit_canvas.layer = 100
+		add_child(_mp8_edit_canvas)
+
+	var lbl := Label.new()
+	lbl.name = "MP8EscEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.offset_left = 16.0
+	lbl.offset_top = -200.0
+	lbl.offset_right = 1100.0
+	lbl.offset_bottom = -8.0
+	# ⚠️ The game's own font must be set explicitly. The default theme font has broken letter spacing (both Manufacture Gun and Duck Hunt got bitten by this)
+	var font = load("res://fonts/Terminal F4.ttf")
+	if font != null:
+		lbl.add_theme_font_override("font", font)
+	lbl.add_theme_color_override("font_color", Color(0.6, 0.95, 1.0))
+	_mp8_edit_canvas.add_child(lbl)
+	_mp8_edit_panel = lbl
+
+	# Hang a number tag above each piece, otherwise with a dozen or so pieces you can't tell which one you're adjusting
+	for i in _mp8_edit_items.size():
+		var n: Node3D = _mp8_edit_items[i]["node"]
+		if not is_instance_valid(n):
+			continue
+		var tag := Label3D.new()
+		tag.name = "MP8EditTag"
+		tag.text = "%d" % (i + 1)
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 200
+		tag.outline_size = 40
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true
+		if font != null:
+			tag.font = font
+		n.add_child(tag)
+		tag.position = Vector3(0.0, 6.0, 0.0)
+
+	_mp8_edit_check_keys()
+	_mp8_edit_refresh()
+	print("[MP8] Escalator Pit: manual venue editing on — %d adjustable pieces, layout source: %s" % [
+		_mp8_edit_items.size(), _mp8_edit_src])
