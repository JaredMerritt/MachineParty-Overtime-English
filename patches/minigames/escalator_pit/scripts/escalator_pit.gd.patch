+# ---------------- 8. Survival gameplay - escalator speed ----------------
+# Escalator speed = min(start + increment per second × seconds since Play started, cap).
+# **Timing only starts when the countdown ends (entering Play)**. Standing around before the start shouldn't use up difficulty early.
+func _mp8_belt_speed(delta: float) -> float :
+
+	if not _mp8_belt_running:
+		return 0.0
+
+	_mp8_belt_elapsed += delta
+	var belt: float = minf(_mp8_belt_base + _mp8_belt_ramp * _mp8_belt_elapsed, _mp8_belt_cap)
+
+	# Log one line per second - when tuning you need to see "at which second people start falling behind"
+	_mp8_belt_log_t += delta
+	if _mp8_belt_log_t >= 1.0:
+		_mp8_belt_log_t = 0.0
+		var fastest: float = 0.0
+		for p in player_characters.values():
+			if p.speed > fastest:
+				fastest = p.speed
+		print("[MP8] Escalator Pit: %5.1f s  escalator %.2f  fastest player %.2f  alive %d%s" % [
+			_mp8_belt_elapsed, belt, fastest, active_players.size(),
+			"   ← escalator at cap, nobody can keep up anymore" if belt >= _mp8_belt_cap - 0.001 else ""])
+
+	_mp8_belt_info(belt)
+	return belt
+
+
