diff --git a/minigames/escalator_pit/scripts/escalator_pit.gd b/minigames/escalator_pit/scripts/escalator_pit.gd
--- a/minigames/escalator_pit/scripts/escalator_pit.gd
+++ b/minigames/escalator_pit/scripts/escalator_pit.gd
@@ -42,6 +42,1259 @@ var camera_progress: float = PI + (PI * 0.5)
 
 var collective_speed: float = 0.0
 
+
+# [MP8] ================ Escalator Pit 8-player adaptation v4 - one venue, 8 lanes ================
+#
+# User decision 2026-08-16 - **all 8 players must race in the same scene and be able to see each other.**
+# (v3's "two venues +120 m apart + two cameras" ran fine in testing and the lights were fixed too, but the two groups could never see
+#   each other — it fails this rule, so the whole approach was scrapped.)
+#
+# ⚠️ Three dead ends, don't go down them again.
+#   v1  Stretch all of art11 sideways 1.8x → the handrails just get widened and shifted, and 8 tracks don't line up with 4 sets of handrails.
+#   v2  Clone a few nodes that "follow the lane" and widen the rest of the backdrop → the clones and the stretched backdrop are always slightly off.
+#   v3  Copy the whole venue offset by +120 m + two cameras → perfect alignment, but split into two groups that can't see each other.
+#
+# **v4's dividing line - everything hinges on this one sentence.**
+#   > Pieces that follow a lane are **only translated, never scaled**. Large backdrop pieces are **only stretched, never translated**.
+#   v2's "misalignment" came from mixing up exactly these two kinds. v4 lists both kinds node by node,
+#   and every name and coordinate comes from probe24 / 29 / 30 / 31 measurements of the **stock PCK**, not guesses.
+#
+# Geometry facts.
+#   1. The 4 lanes are at x = -9.591 / -3.191 / +3.209 / +9.567, spaced 6.4 m apart.
+#   2. **The handrails are single sculpted meshes that each "cover two lanes"**. `Plane_003` covers the left two,
+#      `BézierCurve` + `BézierCurve_001` cover the right two. They can't be split →
+#      **clone step = two lanes = 12.8 m**, which locks lane spacing to vanilla's 6.4 m.
+#   3. 8 lanes span 44.76 m = **2.34x** vanilla's 19.16 m, so the backdrop must be stretched by the same factor.
+#      The `base platform` players stand on is only 30 m wide with railings at ±13.5, so without stretching the outer 4 players would stand off the platform.
+#   4. Lighting is only 4 omni lights (range 29.5), ambient light is pure black, and both directional lights are `visible = false`
+#      — **if the lights don't follow the venue, it's a black void** (lesson from v3's first version, see `_mp8_local_delta`).
+#   5. Camera - the `move` animation writes `CameraTarget` position and rotation every frame,
+#      but **the `Camera3D:fov` track has 0 keys** (probe23) → changing Camera3D's own position is safe.
+const MP8_LANES_MAX: int = 8
+
+## Clone step = two lanes = one handrail mesh. **Do not change this to 6.4**, or the handrails won't line up.
+const MP8_PAIR_STEP_DEFAULT: float = 12.8
+
+## Backdrop X stretch factor = new span / original span = 44.76 / 19.16
+const MP8_WIDE_SCALE_DEFAULT: float = 2.34
+
+## Camera pull-back factor. **Default 1.0 = no pull-back** (user test 2026-08-16 said "everything's too far away in a single camera").
+## Kept only as a comparison knob. `mp8esccam=2.34` brings back the "one camera sees the whole venue" version.
+const MP8_CAM_PULL_DEFAULT: float = 1.0
+
+## **Two vanilla cameras** - the left one frames the left 4 lanes, the right one frames the right 4 lanes (user decision 2026-08-16).
+## The numbers add up. The left 4 lanes run from -22.39 to -3.19 = **19.2 m, exactly vanilla's 4-lane span**,
+## so the camera needs no pull-back and no fov change. **Shifting it as a whole by ±12.8 m** (= one clone step) frames it as fully as vanilla.
+## The camera is local presentation, one per machine, so this is only sent to the player concerned (`rpc_id`).
+const MP8_CAM_SIDE_DEFAULT: float = 12.8
+
+## Swing amplitude factor. Vanilla's `move` animation `.:rotation` sweeps the camera from 26.7° to -31.1° (probe23).
+## Amplifying it = each camera can sweep over the other half, so all 8 players can see each other (the user asked for "a bit more swing").
+const MP8_SWING_DEFAULT: float = 1.6
+
+## fov - 0 = leave it alone (vanilla 68.5). For a bit more peripheral view, pass `mp8escfov=78`.
+const MP8_FOV_DEFAULT: float = 0.0
+
+## Separate stretch factor for `base platform` (texture `paint rusted1 painted bloody1`, the rusty metal plate).
+## User test 2026-08-16 - stretched 2.34x, it **spreads out from under the escalators into a big exposed sheet of yellow metal**
+## — in vanilla its x is only ±15 and it's mostly hidden under the four escalators.
+## **Default 1.0 = no stretch** (the user decided after testing on 2026-08-16 that the yellow metal sheet is not stretched).
+## To stretch it along with everything else, pass `mp8escplat=2.34`. `mp8escplat=-1` = follow `mp8escwide`.
+const MP8_PLAT_SCALE_DEFAULT: float = 1.0
+const MP8_PLAT_NODE: String = "base platform"
+
+## **Pieces that follow a lane** (direct children of art11) - translate only, never scale.
+## Pieces at x < 0 move one step toward -x, x > 0 toward +x, and x ≈ 0 (the middle divider post) gets one copy on each side.
+const MP8_LANE_ART: Array[String] = [
+	"Plane_003",        # Single handrail mesh for the left two lanes
+	"BézierCurve",      # Single handrail mesh for the right two lanes
+	"BézierCurve_001",  # Same as above (two layers)
+	"Cylinder",         # Lane divider post (-6.4)
+	"Cylinder2",        # Lane divider post (0)
+	"Cylinder3",        # Lane divider post (+6.4)
+]
+
+## Overhead gantry - **the beam itself is backdrop** (a 37.5 m crossbar that needs stretching),
+## but **the CRTs among its children are lane pieces** (need translating). It belongs to both kinds, so it's handled separately, see `_mp8_widen_gantry()`.
+const MP8_GANTRY: String = "Cube_009"
+
+var _mp8_step: float = 0.0        # Lane piece translation step (0 = not expanded this match)
+var _mp8_wide: float = 1.0        # Backdrop X stretch factor
+var _mp8_cam_pull: float = 1.0    # Camera pull-back factor (1 = no pull-back)
+var _mp8_cam_side: float = 0.0    # How many meters each of the left and right cameras shifts
+var _mp8_swing: float = 1.0       # Swing amplitude factor
+var _mp8_fov: float = 0.0         # fov override (0 = use vanilla)
+var _mp8_plat: float = -1.0       # Separate stretch factor for base platform (-1 = follow global)
+var _mp8_light_check: Array[Node3D] = []   # Cloned lights, their real world positions get logged after entering the tree as proof
+
+# [MP8] Tells network_manager's generic fill-in that this minigame manages its own spawn points, so stay out of it.
+var mp8_owns_spawns: bool = true
+
+
+# ⚠️ Why this lives in `_enter_tree()` instead of `_ready()`.
+# Godot's order is "root _enter_tree → descendants _enter_tree → descendants _ready → root _ready",
+# and `StairHandler._ready()` copies `paths_parent.get_children()` into its own array.
+# Doing it in the root's `_ready()` is too late — by then it only knows about the vanilla 4 tracks.
+func _enter_tree() -> void :
+	_mp8_parse_gameplay_args()
+	_mp8_build_wide_venue()
+
+
+# ⚠️ The gameplay mode switch and the "8-player adaptation" are separate things. 4-player matches should also use the new gameplay,
+# so this is parsed separately, **before** the player count check in `_mp8_build_wide_venue()`.
+func _mp8_parse_gameplay_args() -> void :
+
+	var args := NetworkManager.mp8_args()
+	_mp8_info_on = args.has("mp8escinfo")
+
+	for a in args:
+		var s := String(a)
+		if s.begins_with("mp8escmode="):
+			_mp8_survival = (s.substr(11) != "vanilla")
+		elif s.begins_with("mp8escbase="):
+			_mp8_belt_base = float(s.substr(11))
+		elif s.begins_with("mp8escramp="):
+			_mp8_belt_ramp = float(s.substr(11))
+		elif s.begins_with("mp8esccapv="):
+			_mp8_belt_cap = float(s.substr(11))
+
+	if _mp8_survival:
+		print("[MP8] Escalator Pit: mode=survival (escalator starts at %.2f, +%.3f per second, capped at %.2f) — the escalator no longer looks at any player's speed" % [
+			_mp8_belt_base, _mp8_belt_ramp, _mp8_belt_cap])
+	else:
+		print("[MP8] Escalator Pit: mode=vanilla (escalator speed = fastest player in the match, clamped to 1.0)")
+
+
+func _mp8_build_wide_venue() -> void :
+
+	var args := NetworkManager.mp8_args()
+
+	# Pure vanilla control group (same flag name as Junk Platform, same meaning - none of this change runs)
+	if args.has("mp8noexpand"):
+		print("[MP8] Escalator Pit: mp8noexpand, keeping the vanilla 4 lanes")
+		return
+
+	var want: int = clampi(PlayerManager.player_presences.size(), 0, MP8_LANES_MAX)
+	if want <= 4:
+		print("[MP8] Escalator Pit: %d players, using the vanilla 4 lanes, nothing changed" % want)
+		return
+
+	_mp8_step = MP8_PAIR_STEP_DEFAULT
+	_mp8_wide = MP8_WIDE_SCALE_DEFAULT
+	_mp8_cam_pull = MP8_CAM_PULL_DEFAULT
+	_mp8_cam_side = MP8_CAM_SIDE_DEFAULT
+	_mp8_swing = MP8_SWING_DEFAULT
+	_mp8_fov = MP8_FOV_DEFAULT
+	_mp8_plat = MP8_PLAT_SCALE_DEFAULT
+	for a in args:
+		var s := String(a)
+		if s.begins_with("mp8escpair="):
+			_mp8_step = float(s.substr(11))
+		elif s.begins_with("mp8escwide="):
+			_mp8_wide = float(s.substr(11))
+		elif s.begins_with("mp8esccam="):
+			_mp8_cam_pull = float(s.substr(10))
+		elif s.begins_with("mp8escside="):
+			_mp8_cam_side = float(s.substr(11))
+		elif s.begins_with("mp8escswing="):
+			_mp8_swing = float(s.substr(12))
+		elif s.begins_with("mp8escfov="):
+			_mp8_fov = float(s.substr(10))
+		elif s.begins_with("mp8escplat="):
+			_mp8_plat = float(s.substr(11))
+	_mp8_edit_on = args.has("mp8escedit")
+
+	# ⚠️ Order matters. **Stretch the backdrop first, then translate the lane pieces**.
+	# The other way round, the lane piece clones would get widened by the parent's later scaling — and that's v2 all over again.
+	_mp8_widen_backdrop()
+	_mp8_clone_lane_art()
+	_mp8_clone_lanes()
+	_mp8_place_spawns()
+	_mp8_clone_lights()
+
+	# Manual layout - collect pieces → if a save file exists, place them by the file (the file wins, and it can add or hide pieces)
+	_mp8_edit_collect()
+	if not args.has("mp8escnofile"):
+		_mp8_apply_layout_file()
+
+	print("[MP8] Escalator Pit: %d players → one venue, 8 lanes (step %.2f m, backdrop X stretch %.2fx, metal sheet %.2fx, camera pull-back %.2fx)" % [
+		want, _mp8_step, _mp8_wide, _mp8_plat, _mp8_cam_pull
+	])
+	_mp8_count_pieces()
+
+	# The line above only proves "it ran", not "where things ended up". The lights especially need to prove themselves (that's where v3 fell over).
+	call_deferred("_mp8_verify_lights")
+
+
+# Count how many copies of each piece exist now — the user said "there are only 12 handrails", so first make the log add up.
+func _mp8_count_pieces() -> void :
+	var art: Node3D = get_node_or_null("escalator pit art11") as Node3D
+	if art == null:
+		return
+	var parts := PackedStringArray()
+	for src_name in MP8_EDIT_SOURCES:
+		var n: int = 0
+		for c in art.get_children():
+			var nm := String(c.name)
+			if nm == src_name or nm.begins_with(src_name + "_MP8"):
+				n += 1
+		parts.append("%s x%d" % [src_name, n])
+	print("[MP8] Escalator Pit: current piece counts — %s (8 lanes; to add or remove pieces, adjust by hand with mp8escedit)" % ", ".join(parts))
+
+
+# ---------------- 1. Large backdrop pieces - stretch only, never translate ----------------
+# The test - anything under art11 **that isn't in MP8_LANE_ART** counts as backdrop (cave, platform, meat grinder, gantry…),
+# and all of it gets `position.x *= k; scale.x *= k` — which is equivalent to "stretch everything k times around world x=0",
+# and it also holds for pieces "whose mesh geometry is offset from the node origin" (`Cube_011` is one of those).
+func _mp8_widen_backdrop() -> void :
+
+	var k := _mp8_wide
+	if is_equal_approx(k, 1.0):
+		return
+
+	var art: Node3D = get_node_or_null("escalator pit art11") as Node3D
+	var widened := 0
+	if art != null:
+		for c in art.get_children():
+			if not (c is Node3D):
+				continue
+			var nm := String(c.name)
+			if MP8_LANE_ART.has(nm):
+				continue                       # Lane piece - leave it completely untouched
+			if nm == MP8_GANTRY:
+				_mp8_widen_gantry(c as MeshInstance3D)
+				widened += 1
+				continue
+			_mp8_widen_node(c as Node3D)
+			widened += 1
+
+	# The whole wire fence group (no lane pieces inside, so it can be stretched as a group)
+	var fence: Node3D = get_node_or_null("escalator pit fence1") as Node3D
+	if fence != null:
+		_mp8_widen_node(fence)
+
+	# ⚠️ The trigger areas must be stretched too. Otherwise the outer 4 players **don't die when they fall and don't finish when they reach the top**.
+	# (Idle testing can't catch this — the bots don't press keys, so nobody moves.)
+	var inter: Node3D = get_node_or_null("Interactive") as Node3D
+	if inter != null:
+		_mp8_widen_node(inter)
+
+	print("[MP8] Escalator Pit: backdrop stretched %.2fx (%d pieces under art11 + wire fence + trigger areas)" % [k, widened])
+
+
+func _mp8_widen_node(n: Node3D) -> void :
+
+	var k: float = _mp8_wide
+	if String(n.name) == MP8_PLAT_NODE and _mp8_plat > 0.0:
+		k = _mp8_plat
+		print("[MP8] Escalator Pit: '%s' uses its own %.2fx (mp8escplat)" % [n.name, k])
+
+	if is_equal_approx(k, 1.0):
+		return
+
+	# Pieces with a Y rotation can't be stretched this way (local x isn't world x), so report them first instead of silently distorting them
+	var eu := n.transform.basis.get_euler()
+	if absf(eu.y) > 0.01:
+		push_warning("[MP8] Escalator Pit: '%s' has a %.1f° Y rotation, so the X stretch is skewed for it, please check it separately" % [
+			n.name, rad_to_deg(eu.y)])
+
+	n.position.x *= k
+	n.scale.x *= k
+
+
+# Overhead gantry - its own mesh is backdrop (stretch it), the CRTs among its children are lane pieces (translate them).
+# Approach - **add a separate widened gantry under art11 and strip the original gantry's own mesh** (`mesh = null`) —
+# the original node stays only as a container for the CRTs, so it no longer draws and doesn't scale its children along with it.
+func _mp8_widen_gantry(bar: MeshInstance3D) -> void :
+
+	if bar == null or bar.mesh == null:
+		return
+
+	var wide := MeshInstance3D.new()
+	wide.name = String(bar.name) + "_MP8WIDE"
+	wide.mesh = bar.mesh
+	wide.transform = bar.transform
+	wide.position.x *= _mp8_wide
+	wide.scale.x *= _mp8_wide
+	wide.material_override = bar.material_override
+	wide.layers = bar.layers
+	wide.cast_shadow = bar.cast_shadow
+	for i in bar.get_surface_override_material_count():
+		wide.set_surface_override_material(i, bar.get_surface_override_material(i))
+	bar.get_parent().add_child(wide)
+
+	bar.mesh = null
+
+	# The gantry's own child meshes (the two long bars `Cube_001` / `Cube_011`) are backdrop too, so stretch them as well
+	for c in bar.get_children():
+		if not (c is Node3D):
+			continue
+		if String(c.name).begins_with("escalator pit crt1"):
+			continue                            # CRT - lane piece, left for the translate step
+		_mp8_widen_node(c as Node3D)
+
+
+# ---------------- 2. Lane pieces - translate only, never scale ----------------
+func _mp8_clone_lane_art() -> void :
+
+	var art: Node3D = get_node_or_null("escalator pit art11") as Node3D
+	if art == null:
+		push_warning("[MP8] Escalator Pit: art11 not found, lane pieces not cloned")
+		return
+
+	var targets: Array[MeshInstance3D] = []
+	for nm in MP8_LANE_ART:
+		var n = art.get_node_or_null(NodePath(nm))
+		if n is MeshInstance3D:
+			targets.append(n as MeshInstance3D)
+		elif n == null:
+			push_warning("[MP8] Escalator Pit: lane piece '%s' is not in the scene" % nm)
+
+	# CRT - the node itself + all mesh children under it.
+	# ⚠️ `crt1_001` also has four 2×2 screen quads under it, **each belonging to a different lane**
+	#    (x = -9.544 / -3.162 / +3.253 / +9.662) — so ownership is decided by **each mesh's own x**,
+	#    and the node must never be cloned together with its subtree (that would leave two quads fighting on top of the originals).
+	var gantry: Node3D = art.get_node_or_null(NodePath(MP8_GANTRY)) as Node3D
+	if gantry != null:
+		for c in gantry.get_children():
+			if not String(c.name).begins_with("escalator pit crt1"):
+				continue
+			if c is MeshInstance3D:
+				targets.append(c as MeshInstance3D)
+			for cc in c.get_children():
+				if cc is MeshInstance3D:
+					targets.append(cc as MeshInstance3D)
+
+	var made := 0
+	for t in targets:
+		for sgn in _mp8_signs_for(_mp8_world_x(t)):
+			_mp8_clone_mesh(t, Vector3(sgn * _mp8_step, 0.0, 0.0))
+			made += 1
+
+	print("[MP8] Escalator Pit: %d lane pieces → %d clones made (translated ±%.2f m only, none scaled)" % [
+		targets.size(), made, _mp8_step])
+
+
+# Pieces at x<0 get one clone to the left, x>0 one to the right, and the one dead center (the middle divider post) gets one on each side.
+func _mp8_signs_for(world_x: float) -> Array :
+	if world_x < -0.05:
+		return [-1.0]
+	if world_x > 0.05:
+		return [1.0]
+	return [-1.0, 1.0]
+
+
+# Create a clean MeshInstance3D (**no children**) that shares the same Mesh resource.
+# Why not `duplicate()`? It copies the subtree too, and the quads under the CRT belong to different lanes.
+func _mp8_clone_mesh(src: MeshInstance3D, world_delta: Vector3) -> MeshInstance3D :
+
+	var m := MeshInstance3D.new()
+	m.name = String(src.name) + ("_MP8L" if world_delta.x < 0.0 else "_MP8R")
+	m.mesh = src.mesh
+	m.transform = src.transform
+	m.position += _mp8_local_delta(src.get_parent(), world_delta)
+	m.material_override = src.material_override
+	m.layers = src.layers
+	m.cast_shadow = src.cast_shadow
+	m.visible = src.visible
+	for i in src.get_surface_override_material_count():
+		m.set_surface_override_material(i, src.get_surface_override_material(i))
+	src.get_parent().add_child(m)
+	return m
+
+
+# ---------------- 3. Tracks - 4 → 8 ----------------
+# `stair_handler.gd` does `for pp in paths_parent.get_children()`, so the count is fully data-driven,
+# which means new tracks **must go under the same `StairPaths`**, and that file needs no changes at all.
+func _mp8_clone_lanes() -> void :
+
+	var paths_parent: Node3D = get_node_or_null("StairPaths") as Node3D
+	if paths_parent == null:
+		push_warning("[MP8] Escalator Pit: StairPaths not found, tracks not expanded")
+		return
+
+	var lanes: Array[Node3D] = []
+	for c in paths_parent.get_children():
+		if c is Node3D:
+			lanes.append(c as Node3D)
+
+	var xs := PackedFloat32Array()
+	for l in lanes:
+		var sgn: float = -1.0 if _mp8_world_x(l) < 0.0 else 1.0
+		var d: Node3D = l.duplicate()
+		d.name = String(l.name) + ("_MP8L" if sgn < 0.0 else "_MP8R")
+		paths_parent.add_child(d)
+		d.position = l.position + _mp8_local_delta(paths_parent, Vector3(sgn * _mp8_step, 0.0, 0.0))
+		xs.append(d.position.x)
+
+	var all := PackedFloat32Array()
+	for c in paths_parent.get_children():
+		if c is Node3D:
+			all.append((c as Node3D).position.x)
+	all.sort()
+	print("[MP8] Escalator Pit: tracks %d → %d, x = %s" % [
+		lanes.size(), paths_parent.get_child_count(), str(all)])
+
+
+# ---------------- 4. Spawn points - 4 → 8, sorted by x from left to right ----------------
+# Spawn points are `@export var player_spawn_positions: Array[Node3D]` — **array-based**, not container-based.
+# Adding Markers to a container does nothing at all, `spawn_players()` reads this array (P1-C in HANDOFF).
+func _mp8_place_spawns() -> void :
+
+	if player_spawn_positions.is_empty():
+		push_warning("[MP8] Escalator Pit: player_spawn_positions is empty, giving up on adding spawn points")
+		return
+
+	var holder: Node = player_spawn_positions[0].get_parent()
+	var all: Array[Node3D] = []
+	for m in player_spawn_positions:
+		all.append(m)
+
+	for v in all.duplicate():
+		var sgn: float = -1.0 if _mp8_world_x(v) < 0.0 else 1.0
+		var d: Node3D = v.duplicate()
+		d.name = String(v.name) + ("_MP8L" if sgn < 0.0 else "_MP8R")
+		holder.add_child(d)
+		d.position = v.position + _mp8_local_delta(holder, Vector3(sgn * _mp8_step, 0.0, 0.0))
+		all.append(d)
+
+	# Sort by world x from left to right. Spawning starts counter at 0, so player order = standing order
+	all.sort_custom(func(a: Node3D, b: Node3D): return _mp8_world_x(a) < _mp8_world_x(b))
+
+	player_spawn_positions.clear()
+	for m2 in all:
+		player_spawn_positions.append(m2)
+
+	var xs := PackedFloat32Array()
+	for m3 in all:
+		xs.append(_mp8_world_x(m3))
+	print("[MP8] Escalator Pit: spawn points 4 → %d, x = %s" % [all.size(), str(xs)])
+
+
+# ---------------- 5. Lights - widen along with the venue ----------------
+# ⚠️ This step is where v3's first version had "4 players fall into a black void". Be sure to read the `_mp8_local_delta` comment.
+# **Never touch** directional lights (they're global, and both are visible=false in this scene).
+func _mp8_clone_lights() -> void :
+
+	var lights: Node = get_node_or_null("light parent")
+	if lights == null:
+		push_warning("[MP8] Escalator Pit: light parent not found, lights not expanded — the outer side will be dark")
+		return
+
+	var omnis: Array[Node3D] = []
+	for c in lights.get_children():
+		if c is OmniLight3D:
+			omnis.append(c as Node3D)
+
+	for o in omnis:
+		for sgn in [-1.0, 1.0]:
+			var od: Node3D = o.duplicate()
+			od.name = String(o.name) + ("_MP8L" if sgn < 0.0 else "_MP8R")
+			lights.add_child(od)
+			od.position = o.position + _mp8_local_delta(lights, Vector3(sgn * _mp8_step, 0.0, 0.0))
+			_mp8_light_check.append(od)
+
+	print("[MP8] Escalator Pit: omni lights %d → %d (one extra copy each on the left and right, covering the widened venue)" % [
+		omnis.size(), omnis.size() * 3])
+
+
+# ---------------- 6. Camera - two vanilla cameras (left and right) + bigger swing ----------------
+# User testing on 2026-08-16 rejected "one pulled-back camera sees the whole venue" - **too far away, players too small**.
+# The fix is **two vanilla cameras** — the left one shifted -12.8 m to frame the left 4 lanes, the right one +12.8 m to frame the right 4 lanes.
+# The numbers add up. The left 4 lanes run from -22.39 to -3.19 = **19.2 m, exactly vanilla's 4-lane span**,
+# so no pull-back or fov change is needed. **Framing matches vanilla and players don't get any smaller**.
+# Then the `move` animation's side-to-side swing is amplified so each camera sweeps over the other half — all 8 players can see each other.
+#
+# ⚠️ The `move` animation writes `CameraTarget` position and rotation every frame, so both must be changed **in the animation keys**.
+#    Writing the node properties directly gets overwritten the same frame (that's how the IK target change was wasted effort).
+#    The `Camera3D:fov` track has 0 keys (probe23) → fov can be written straight to the node.
+func _mp8_setup_camera() -> void :
+
+	if _mp8_step <= 0.0:
+		return
+
+	_mp8_apply_swing()
+
+	if _mp8_fov > 0.0 and camera_3d != null:
+		camera_3d.fov = _mp8_fov
+		print("[MP8] Escalator Pit: camera fov -> %.1f" % _mp8_fov)
+
+	# For comparison - the one-camera-sees-everything version (not used by default)
+	if not is_equal_approx(_mp8_cam_pull, 1.0) and camera_3d != null:
+		var d: float = camera_3d.global_position.length()
+		var pull: float = (_mp8_cam_pull - 1.0) * d
+		camera_3d.position.z += pull
+		print("[MP8] Escalator Pit: camera pulled back %.1f m along its line of sight (factor %.2f)" % [pull, _mp8_cam_pull])
+
+
+func _mp8_cam_anim(anim_name: StringName) -> Animation :
+	var ct: Node3D = get_node_or_null("CameraTarget") as Node3D
+	if ct == null:
+		return null
+	var ap: AnimationPlayer = ct.get_node_or_null("anim_camera movement") as AnimationPlayer
+	if ap == null:
+		return null
+	return ap.get_animation(anim_name)
+
+
+# Swing - amplify the **y (side-to-side pan)** of every `.:rotation` key relative to their mean.
+# ⚠️ Animation is a resource and gets **cached across matches** — amplifying repeatedly would swing harder every match.
+#    So the first time, the original key values are stored in meta for that track, and from then on it always recomputes from meta (repeated calls don't stack).
+func _mp8_apply_swing() -> void :
+
+	if is_equal_approx(_mp8_swing, 1.0):
+		return
+
+	var mv: Animation = _mp8_cam_anim(&"move")
+	if mv == null:
+		return
+
+	for t in mv.get_track_count():
+		if String(mv.track_get_path(t)) != ".:rotation":
+			continue
+
+		var meta_key := "mp8_orig_rot_%d" % t
+		var orig: Array = []
+		if mv.has_meta(meta_key):
+			orig = mv.get_meta(meta_key)
+		else:
+			for k in mv.track_get_key_count(t):
+				orig.append(mv.track_get_key_value(t, k))
+			mv.set_meta(meta_key, orig)
+		if orig.size() < mv.track_get_key_count(t):
+			continue
+
+		var mean: float = 0.0
+		for v in orig:
+			mean += (v as Vector3).y
+		mean /= float(maxi(orig.size(), 1))
+
+		var lo: float = 999.0
+		var hi: float = -999.0
+		for k in mv.track_get_key_count(t):
+			var v: Vector3 = orig[k]
+			var y: float = mean + (v.y - mean) * _mp8_swing
+			mv.track_set_key_value(t, k, Vector3(v.x, y, v.z))
+			lo = minf(lo, y)
+			hi = maxf(hi, y)
+
+		print("[MP8] Escalator Pit: camera swing x%.2f (center %.1f°, now sweeps %.1f° to %.1f°)" % [
+			_mp8_swing, rad_to_deg(mean), rad_to_deg(lo), rad_to_deg(hi)])
+
+
+# Two cameras - shift the camera rig on that player's machine over to their half of the venue.
+# The camera is **local presentation, one per machine**, so this is only sent to that player (`rpc_id`). A broadcast would move everyone's camera.
+@rpc("authority", "call_local", "reliable")
+func mp8_set_camera_side_rpc(offset_x: float) -> void :
+
+	var ct: Node3D = get_node_or_null("CameraTarget") as Node3D
+	if ct == null:
+		return
+
+	var ap: AnimationPlayer = ct.get_node_or_null("anim_camera movement") as AnimationPlayer
+	var base: Vector3 = ct.position
+
+	if ap != null:
+		# The baseline comes from the **RESET animation** (which we never modify), so this function can be called repeatedly **without stacking offsets** —
+		# Animations persist across matches in the resource cache, so using the "current value" as the baseline would drift further every match.
+		base = _mp8_anim_base_position(ap, base)
+		var mv: Animation = ap.get_animation(&"move")
+		if mv != null:
+			for t in mv.get_track_count():
+				if String(mv.track_get_path(t)) != ".:position":
+					continue
+				for k in mv.track_get_key_count(t):
+					mv.track_set_key_value(t, k, Vector3(base.x + offset_x, base.y, base.z))
+
+	ct.position = Vector3(base.x + offset_x, base.y, base.z)
+
+	print("[MP8] Escalator Pit: local camera shifted x %+.1f (framing the 4 lanes on the %s half)" % [
+		offset_x, "left" if offset_x < 0.0 else "right"])
+
+
+func _mp8_anim_base_position(ap: AnimationPlayer, fallback: Vector3) -> Vector3 :
+	var reset: Animation = ap.get_animation(&"RESET")
+	if reset == null:
+		return fallback
+	for t in reset.get_track_count():
+		if String(reset.track_get_path(t)) == ".:position" and reset.track_get_key_count(t) > 0:
+			var v = reset.track_get_key_value(t, 0)
+			if v is Vector3:
+				return v
+	return fallback
+
+
+# ---------------- 7. Manual venue editing (mp8escedit) - the user places the metal sheet and handrails themselves ----------------
+#
+# User decision 2026-08-16 - **"Don't stretch the yellow metal sheet, I'll place the sheet and the handrails myself."**
+# Conventions copied from Manufacture Gun's `mp8gunedit` (two manual editors in the same project shouldn't follow two different sets of rules).
+#   In game, select with keys → move → press 0 to save → the next match **reads the save file first**.
+#   The save file is plain text you can edit directly in Notepad, even without launching the game.
+#
+# ⚠️ All 8 instances share the same `user://` directory (pitfall #15) — here that's a good thing. Save once,
+#    and next time all 8 instances read the same copy, so layouts naturally can't differ between machines.
+const MP8_EDIT_FILE: String = "user://mp8_esc_layout.txt"
+const MP8_EDIT_STEPS: Array[float] = [1.0, 0.5, 0.1]
+const MP8_EDIT_YAW_STEP: float = 15.0
+const MP8_EDIT_SCALE_STEP: float = 0.1
+
+## Pieces that can be adjusted by hand. **The original and each of its copies get one line each**, so to add a handrail, add another line to the file.
+const MP8_EDIT_SOURCES: Array[String] = [
+	"base platform",     # The rusty metal plate (yellow metal sheet), texture paint rusted1 painted bloody1
+	"Plane_003",         # The escalator shell set on the left half, texture escalator.png
+	"BézierCurve",       # The two dark grey metal handrails on the right half (albedo 0.146 / roughness 0.36)
+	"BézierCurve_001",
+]
+
+## **Final placement hand-tuned by the user on 2026-08-16 22:48**, baked straight into the code — so it works without
+## the `mp8_esc_layout.txt` in `%APPDATA%` (players on the release build won't have that file).
+## One entry = [source piece name, position, yaw degrees, x scale, visible]. If a save file exists, **the file takes priority**.
+## A backup is kept in `notes\mp8_esc_layout.txt`. To change it, run the game with `-EscEdit`, place things and press 0,
+## then paste the new `mp8_esc_layout.txt` back into this table.
+const MP8_LAYOUT_BAKED: Array = [
+	["base platform",   Vector3(-19.024, -0.812,   3.477),   0.0, 1.0, true],
+	["base platform",   Vector3( 18.976, -0.812,   3.477),   0.0, 1.0, true],
+	["base platform",   Vector3( -0.024, -0.812,   3.477),   0.0, 1.0, true],
+	["Plane_003",       Vector3( -9.559,  6.435, -11.366),   0.0, 1.0, true],
+	["Plane_003",       Vector3(-22.359,  6.435, -11.366),   0.0, 1.0, true],
+	["Plane_003",       Vector3(  3.141,  6.435, -11.366),   0.0, 1.0, true],
+	["BézierCurve",     Vector3(  9.313, 14.572, -16.690), -95.0, 1.0, true],
+	["BézierCurve",     Vector3( 13.113, 14.572, -16.690), -95.0, 1.0, true],
+	["BézierCurve_001", Vector3(  6.313, 15.125, -16.690), -95.0, 1.0, true],
+	["BézierCurve_001", Vector3( 22.113, 15.125, -16.690), -95.0, 1.0, true],
