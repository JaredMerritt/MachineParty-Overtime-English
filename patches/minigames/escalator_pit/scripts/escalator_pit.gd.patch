+# [MP8] Survival order → placement points. Build a list from worst to best, score = step × index.
+func _mp8_score_by_survival() -> void :
+
+	var order: Array[int] = []
+
+	# 1) Players who fell into the grinder, in the order they fell (first to die is worst)
+	for nid in _mp8_dead_order:
+		order.append(nid)
+
+	# 2) Players still standing on the escalator at match end (usually just the last survivor)
+	for ap in active_players:
+		if is_instance_valid(ap) and ap.player_presence != null:
+			var a_id: int = ap.player_presence.network_id
+			if not order.has(a_id):
+				order.append(a_id)
+
+	# 3) Players who climbed to the top and escaped, **in reverse order** - last to the top goes earlier, first to the top goes last = highest score
+	for i in range(finished_players.size() - 1, -1, -1):
+		var fp = finished_players[i]
+		if is_instance_valid(fp) and fp.player_presence != null:
+			var f_id: int = fp.player_presence.network_id
+			if not order.has(f_id):
+				order.append(f_id)
+
+	for i in order.size():
+		player_scores[order[i]] = MP8_ESC_RANK_STEP * i
+
+	# Anyone not on the list (disconnected mid-match) gets 0, so no leftover value from the previous match remains
+	for key in player_scores.keys():
+		if not order.has(key):
