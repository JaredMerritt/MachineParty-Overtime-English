+		return
+	var k: float = _mp8_belt_shrink()
+	if k > 0.01:
+		mp8_belt_uv_step = MP8_BELT_UV_STEP / k
+
+
+func _mp8_belt_shrink() -> float :
+	var span_orig: float = float(MP8_ORIG_SLOTS - 1) * MP8_SLOT_SPACING
+	var span_new: float = float(mp8_slot_count - 1) * MP8_SLOT_SPACING
+	if span_orig <= 0.0:
+		return 1.0
+	return span_new / span_orig
+
+
+# [MP8] The server broadcasts the station count/slot count. If a client didn't expand at _ready because the player count hadn't synced yet,
+# it catches up here. Idempotent — _mp8_expand_stations has its own _mp8_expanded gate,
+# and _mp8_fit_belts always recomputes from _mp8_belt_base (instead of shrinking an already shrunk belt again).
+@rpc("authority", "call_local", "reliable")
+func _mp8_sync_rpc(seats: int, slots: int, push: float) -> void :
+
+	# Clamp everything from the network. An unbounded station count would make every client allocate without limit.
+	mp8_seats = clampi(seats, MP8_ORIG_SEATS, NetworkManager.MAX_PLAYERS)
+	mp8_seat_step = 360.0 / float(mp8_seats)
+	mp8_slot_count = clampi(slots, 4, MP8_ORIG_SLOTS)
+	mp8_ring_push = clampf(push, 0.0, 20.0) if NetworkManager.mp8_finite(push) else 0.0
+	_mp8_calc_uv_step()
+
+	if mp8_seats > MP8_ORIG_SEATS:
+		if not _mp8_expanded:
+			print("[MP8] Burn Recycle: this side didn't expand at _ready (player count was too low at the time), catching up now with the server's %d stations" % mp8_seats)
+			_mp8_expand_stations()
+		_mp8_fit_belts(mp8_slot_count)
+
+	print("[MP8] Burn Recycle sync: %d stations / %d slots / outer ring push %.2f m / belt scale %.3f / UV step %.4f" % [
+		mp8_seats, mp8_slot_count, mp8_ring_push, _mp8_belt_shrink(), mp8_belt_uv_step])
+
+
+# [MP8] The three prop sets baked in per station count, 4 → 8.
+#
+# Placement is pure rotation (derivation in the file header), so duplicating = rotating the original's global_transform by one angle step around world Y.
+# **Use global_transform, not transform**. `indicators parent` has its own -90° yaw,
+# so rotating the local transform would come out wrong (same family as pitfall #27. Before touching it, check whether the parent's basis is identity).
+func _mp8_expand_stations() -> void :
+
+	if _mp8_expanded:
+		return
+	_mp8_expanded = true
+
+	# ---- 1. Presses ----
+	# Numbering derivation — vanilla press world yaw = 90*id + C. With 8 stations we need yaw = 45*seat + C.
+	# Substituting gives seat = 2*id — i.e. **none of the originals need to move, they just get renumbered**,
+	# and the four 45° copies fill in exactly the odd numbers. This derivation doesn't depend on the actual value of C.
+	var src_presses: Array = presses.duplicate()
+	for src in src_presses:
+		if src == null:
+			continue
+		var old_id: int = src.press_id
+		var dup: BurnRecyclePress = src.duplicate()
+		src.press_id = old_id * 2
+		dup.name = "MP8Press%d" % (old_id * 2 + 1)
+		src.get_parent().add_child(dup)
+		# New pieces are always odd-numbered = outer ring, so after rotating they also get pushed outward along the radial (two-tier layout)
+		dup.global_transform = _mp8_place(src.global_transform, old_id * 2, old_id * 2 + 1)
+		dup.press_id = old_id * 2 + 1
+		# Pitfall #14 — duplicate() **does not** repoint @export references to its own children at the copy
+		_mp8_reresolve_press(src, dup)
+		presses.append(dup)
+
+	# ---- 2. Results indicators (same numbering rule, a different C but the same formula) ----
+	var src_inds: Array = indicators.duplicate()
+	for src in src_inds:
+		if src == null:
+			continue
+		var old_id: int = src.indicator_id
+		var dup: BurnRecycleIndicator = src.duplicate()
+		src.indicator_id = old_id * 2
+		dup.name = "MP8Indicator%d" % (old_id * 2 + 1)
+		src.get_parent().add_child(dup)
+		dup.global_transform = _mp8_place(src.global_transform, old_id * 2, old_id * 2 + 1)
+		dup.indicator_id = old_id * 2 + 1
+		# Indicators only have the one export indicator_id, and the light body comes from get_child(0) → no re-resolving needed
+		indicators.append(dup)
+
+	# ---- 3. Conveyor belts — rebuild the whole array in station order ----
+	# Doesn't reuse the vanilla scene order — that order is **off by one** (see the file header).
+	# Station 0's belt is identified by geometry. Station 0's item lane is at world (x=5.2, z=+3..-14),
+	# midpoint z=-5.5, and the belt closest to that point is the one.
+	# Station 0 has yaw = 0 and sits on the inner ring (not pushed out), so its local coordinates are world coordinates.
+	# The item lane runs along x from -3.00 to +14.00 (midpoint +5.50), and radial z is always 5.20.
+	var anchor: Vector3 = Vector3(
+		MP8_SLOT_FIRST_X + float(MP8_ORIG_SLOTS - 1) * MP8_SLOT_SPACING * 0.5, 0.0,
+		MP8_STATION_RADIAL_Z)
+	var seat0: MeshInstance3D = null
+	var best: float = INF
+	for b in belts:
+		if b == null:
+			continue
+		var d: float = Vector2(b.global_position.x - anchor.x, b.global_position.z - anchor.z).length()
+		if d < best:
+			best = d
+			seat0 = b
+	if seat0 == null:
+		printerr("[MP8] Burn Recycle: belts is empty, skipping the conveyor belt step")
+	else:
+		print("[MP8] Burn Recycle: station 0's belt identified as \"%s\" (%.2f m from the expected point, it only counts as correct if the second closest is far off)" % [
+			seat0.name, best])
+
+		var originals: Array = belts.duplicate()
+		var rebuilt: Array[MeshInstance3D] = []
+		_mp8_belt_base.clear()
+
+		for s in mp8_seats:
+			var want: Transform3D = _mp8_place(seat0.global_transform, 0, s)
+			var reuse: MeshInstance3D = null
+			for b in originals:
+				if b != null and b.global_position.distance_to(want.origin) < 0.5:
+					reuse = b
+					break
+			if reuse != null:
+				rebuilt.append(reuse)
+			else:
+				var dup: MeshInstance3D = seat0.duplicate()
+				dup.name = "MP8Belt%d" % s
+				seat0.get_parent().add_child(dup)
+				dup.global_transform = want
+				# The four vanilla belts **each have their own material** (measured by probe58, not shared).
+				# A copy shares the source's material by default, so two stations' UV scrolling would fight over the same property,
+				# which is why the copy gets its own.
+				var mat: Material = seat0.get_active_material(0)
+				if mat != null:
+					dup.set_surface_override_material(0, mat.duplicate())
+				rebuilt.append(dup)
+			_mp8_belt_base.append(rebuilt[s].global_transform)
+
+		belts = rebuilt
+
+	_mp8_report_stations()
+
+
+# [MP8] Shorten the belts to the slot count and slide them along their own long axis to the new item lane midpoint.
+#
+# The user decided "overlap allowed" on 2026-08-17, so this step is **not about preventing overlap**,
+# but about making the belt length match the stretch that actually carries items (shortening also reduces overlap as a side effect).
+#
+# Geometry — the belt's long axis is its own local +X, which points exactly along the player's local +z (item lane direction).
+# Scaling happens around the belt's own center, so scale first and then translate along the long axis by the difference between the two midpoints.
+# The relation "the belt center is offset 0.79 m from the item lane midpoint" is preserved automatically, with no need to know it's 0.79.
+#
+# Idempotent — always recomputes from _mp8_belt_base (the unshortened 45° placement).
+func _mp8_fit_belts(slots: int) -> void :
+
+	if _mp8_belt_base.is_empty():
+		return
+
+	if MP8_BELT_FIT:
+		var span_orig: float = float(MP8_ORIG_SLOTS - 1) * MP8_SLOT_SPACING
+		var span_new: float = float(slots - 1) * MP8_SLOT_SPACING
+		var k: float = span_new / span_orig
+		# The item lane midpoint moves from (first slot + old span/2) to (first slot + new span/2), and the belt moves the same distance.
+		# ⚠️ Move along **_mp8_goods_dir(i)**, not the belt's own basis.x — the four vanilla belts'
+		# +X directions are inconsistent (some forward, some reversed), so using it as the direction would slide half the belts the wrong way.
+		var slide: float = (span_new - span_orig) * 0.5
+
+		for i in _mp8_belt_base.size():
+			if i >= belts.size() or belts[i] == null:
+				continue
+			var base: Transform3D = _mp8_belt_base[i]
+			var t: Transform3D = base
+			t.basis = base.basis * Basis.from_scale(Vector3(k, 1.0, 1.0))
+			t.origin = base.origin + _mp8_goods_dir(i) * slide
+			belts[i].global_transform = t
+
+		print("[MP8] Burn Recycle: belts shortened for %d slots to %.3fx (%.2f→%.2f m), slid %+.2f m along the long axis" % [
+			slots, k, span_orig, span_new, slide])
+
+	_mp8_check_belt_overlap()
+
+
+# [MP8] Do the belts still overlap? Computed from real geometry, not estimated.
+#
+# Each belt is a line segment in the XZ plane. Center = node position, direction = its own +X,
+# length = the Mesh's AABB.x × that axis's scale (actual values, so it stays correct even if a game update swaps the model).
+# Compute the shortest distance between every pair of segments. 0 means they really do intersect.
+# This log line is the only way to judge "is the two-tier layout pushed out far enough" — watch it when the user tunes mp8burnpush=.
+func _mp8_check_belt_overlap() -> void :
+
+	var segs: Array = []
+	for b in belts:
+		if b == null or b.mesh == null:
+			continue
+		var t: Transform3D = b.global_transform
+		var half: float = b.mesh.get_aabb().size.x * t.basis.get_scale().x * 0.5
+		var dir: Vector3 = t.basis.x.normalized()
+		var a: Vector3 = t.origin - dir * half
+		var c: Vector3 = t.origin + dir * half
+		segs.append([Vector2(a.x, a.z), Vector2(c.x, c.z)])
+
+	if segs.size() < 2:
+		return
+
+	var worst: float = INF
+	var crossings: int = 0
+	for i in segs.size():
+		for j in range(i + 1, segs.size()):
+			var pts: PackedVector2Array = Geometry2D.get_closest_points_between_segments(
+				segs[i][0], segs[i][1], segs[j][0], segs[j][1])
+			var d: float = pts[0].distance_to(pts[1])
+			if d < 0.01:
+				crossings += 1
+			worst = minf(worst, d)
+
+	if crossings > 0:
+		print("[MP8] Burn Recycle: ⚠️ %d pairs of belts still intersect (%.2f m push isn't enough, increase mp8burnpush=)" % [
+			crossings, mp8_ring_push])
+	else:
+		print("[MP8] Burn Recycle: no belts intersect ✅ min clearance %.2f m (push %.2f m)" % [
+			worst, mp8_ring_push])
+
+
+# [MP8] Rotate around the world Y axis by an angle (position included, i.e. orbiting the arena center)
+func _mp8_spin(t: Transform3D, degrees: float) -> Transform3D:
+	var b: Basis = Basis(Vector3.UP, deg_to_rad(degrees))
+	return Transform3D(b * t.basis, b * t.origin)
+
+
+# [MP8] A station's **radial unit vector** (pointing from the center to the station) = that station player's local **+Z**.
+# ⚠️ Not +X (that's where the first version went wrong). The 5.20 m from the center to the control panel/item lane is local z, see the constants block above.
+# Rotating by θ around Y maps local Z to (sinθ, 0, cosθ). "Pushing outward" means adding distance along this direction.
+func _mp8_radial(seat: int) -> Vector3:
+	var th: float = deg_to_rad(mp8_seat_step * float(seat))
+	return Vector3(sin(th), 0.0, cos(th))
+
+
+# [MP8] A station's **item lane direction** (items travel from index 0 to the last slot) = that station player's local **+X**.
+# Perpendicular to the radial. It's the belt's long axis, so the "slide along the long axis" after shortening is computed along this direction.
+func _mp8_goods_dir(seat: int) -> Vector3:
+	var th: float = deg_to_rad(mp8_seat_step * float(seat))
+	return Vector3(cos(th), 0.0, - sin(th))
+
+
+# [MP8] Which ring a station belongs to. Odd = outer ring (pushed out by mp8_ring_push m), even = inner ring (stays put).
+# The even numbers are exactly the four vanilla stations, so **not a single inner-ring prop has moved**.
+func _mp8_push_for(seat: int) -> float:
+	if mp8_ring_push <= 0.0:
+		return 0.0
+	return mp8_ring_push if (seat % 2) == 1 else 0.0
+
+
+# [MP8] Place a prop from from_seat to to_seat. First rotate around the center, then push along the radial by the difference between the two rings.
+# At every current call site from_seat is on the inner ring (push 0). The term is kept so the formula stays self-consistent.
+func _mp8_place(t: Transform3D, from_seat: int, to_seat: int) -> Transform3D:
+	var out: Transform3D = _mp8_spin(t, mp8_seat_step * float(to_seat - from_seat))
+	out.origin += _mp8_radial(to_seat) * _mp8_push_for(to_seat) \
+		- _mp8_radial(from_seat) * _mp8_push_for(from_seat)
+	return out
+
+
+# [MP8] Pitfall #14 — duplicate() doesn't remap @export references that point to its own children.
+# Presses have two such references, anim_press (plays the "press" animation) and decals (blood splatter).
+# Without re-resolving them, the death animation for stations 5~8 would play on the **original** (the press for 1~4 would move instead).
+func _mp8_reresolve_press(src: BurnRecyclePress, dup: BurnRecyclePress) -> void :
+
+	if src.anim_press != null:
+		var rel: NodePath = src.get_path_to(src.anim_press)
+		var node: Node = dup.get_node_or_null(rel)
+		if node is AnimationPlayer:
+			dup.anim_press = node
+		else:
+			printerr("[MP8] Burn Recycle: press copy didn't hook up anim_press (relative path %s)" % str(rel))
+
+	var new_decals: Array[Decal] = []
+	for d in src.decals:
+		if d == null:
+			continue
+		var nd: Node = dup.get_node_or_null(src.get_path_to(d))
+		if nd is Decal:
+			new_decals.append(nd)
+	dup.decals = new_decals
+
+
+# [MP8] Self-check + log after expanding. If the ids aren't exactly one each of 0..N-1, shout immediately —
+# a wrong press id = the death flow aborts when someone is eliminated (they can keep playing), which is harder to spot than a crash.
+func _mp8_report_stations() -> void :
+
+	var press_ids: Array = []
+	for p in presses:
+		if p != null:
+			press_ids.append(p.press_id)
+	var ind_ids: Array = []
+	for i in indicators:
+		if i != null:
+			ind_ids.append(i.indicator_id)
+	press_ids.sort()
+	ind_ids.sort()
+
+	var want: Array = []
+	for s in mp8_seats:
+		want.append(s)
+
+	print("[MP8] Burn Recycle station table: %d belts / %d presses %s / %d indicator groups %s" % [
+		belts.size(), presses.size(), str(press_ids), indicators.size(), str(ind_ids)])
+	if press_ids != want:
+		printerr("[MP8] ❌ Press ids are not %s — elimination for stations 5~8 will abort, must investigate" % str(want))
+	if ind_ids != want:
+		printerr("[MP8] ❌ Indicator ids are not %s" % str(want))
+	if belts.size() < mp8_seats:
+		printerr("[MP8] ❌ Only %d conveyor belts, not enough for %d stations" % [belts.size(), mp8_seats])
+
+	# Two-tier layout — log each station's ring and radius so you can see at a glance whether the inner and outer rings are separated
+	var rows: Array = []
+	for s in mini(belts.size(), mp8_seats):
+		if belts[s] == null:
+			continue
+		var r: float = belts[s].global_position.dot(_mp8_radial(s))
+		rows.append("#%d %s %.2fm" % [s, "outer" if _mp8_push_for(s) > 0.0 else "inner", r])
+	print("[MP8] Burn Recycle rings: %s" % " / ".join(rows))
+
+
+# [MP8] Log placement/name/score at results time. **No scores are changed**, purely for checking in phase ②.
+# Only runs on the server (check_game_end itself only reaches here on the server).
+func _mp8_log_scores() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var lines: Array = []
+	var ranked: Array = player_scores.keys()
+	ranked.sort_custom(func(a, b): return player_scores[a] > player_scores[b])
+	var rank: int = 1
+	for network_id in ranked:
+		var who: String = str(network_id)
+		if PlayerManager.player_presences.has(network_id):
+			who = PlayerManager.player_presences[network_id].network_name
+		lines.append("#%d %s %d pts" % [rank, who, player_scores[network_id]])
+		rank += 1
+
+	print("[MP8] Burn Recycle results (%d players present / %d dead / %d stations): %s" % [
+		player_count, dead_players.size(), mp8_seats, " / ".join(lines)])
+
+
+# [MP8] Per-round parts leaderboard — at **the end of each round**, list one player per line in the top-left, sorted by part count from most to least
+#(requested by the user on the night of 2026-08-17, and corrected once on the spot. It's at the end of **a round** and shows **part count**,
+# not placement score at the end of a match — the two numbers are completely different, don't mix them up again).
+#
+#   · Part count = `valid_burns + valid_recycles`, the number vanilla uses to decide elimination
+#     (the lowest score is out in `eliminate_players()`), and also the number shown on each player's own score screen.
+#   · Placement score = `player_scores`, only settled at the end of a match and accumulated on the intermission scoreboard. **The leaderboard doesn't show it.**
+#
+# Why an RPC instead of each side computing its own? Only the server holds the authoritative alive list (who's still in),
+# and all 8 windows must show the same numbers — if each computed its own, any packet loss would make them show different things,
+# which is worse than showing nothing (people would think the scoring is wrong).
+# It sends two parallel arrays, ids + part counts, and **each side looks up names itself** in `PlayerManager.player_presences`,
+# falling back to showing the id if not found (same fallback as `_mp8_log_scores`).
+#
+# Convention — **empty `ids` = remove the leaderboard** (used when a new round starts). **A count < 0 = eliminated**,
+# and that row shows `——` instead of a number (their count froze in the round they died, so showing it would be stale data).
+@rpc("authority", "call_local", "reliable")
+func _mp8_score_board_rpc(ids: PackedInt32Array, counts: PackedInt32Array) -> void :
+
+	if ids.size() != counts.size() or ids.size() > NetworkManager.MAX_PLAYERS:
+		return
+
+	# Empty = remove the leaderboard
+	if ids.is_empty():
+		if _mp8_score_panel != null:
+			_mp8_score_panel.text = ""
+		return
+
+	# [part count, name, id]. Alive players sorted by part count descending come first, and eliminated ones sink to the bottom.
+	# Ties sort by name — without a fixed order the row order would differ across the 8 windows and look like the numbers don't match.
+	var rows: Array = []
+	for i in ids.size():
+		var network_id: int = ids[i]
+		var who: String = str(network_id)
+		if PlayerManager.player_presences.has(network_id):
+			# Names go through mp8_plain_text, so a name with newlines can't forge extra leaderboard rows
+			who = NetworkManager.mp8_plain_text(String(PlayerManager.player_presences[network_id].network_name))
+		rows.append([counts[i], who, network_id])
+	rows.sort_custom(func(a, b):
+		var da: bool = int(a[0]) < 0
+		var db: bool = int(b[0]) < 0
+		if da != db:
+			return db                      # Eliminated players sink to the bottom
+		if not da and a[0] != b[0]:
+			return a[0] > b[0]
+		return String(a[1]) < String(b[1]))
+
+	# With -BurnDebug the network_id is listed too (needed to match up with the logs one by one during sign-off).
+	# Without it, it's a clean leaderboard for players with just part counts and names.
+	var with_id: bool = NetworkManager.mp8_args().has("mp8burndebug")
+
+	var lines := PackedStringArray()
+	lines.append("Parts this round")
+	for r in rows:
+		var n: int = int(r[0])
+		var num: String = "——" if n < 0 else "%3d" % n
+		var tail: String = " (%d)" % int(r[2]) if with_id else ""
+		var out: String = "%s  —  %s%s" % [num, String(r[1]), tail]
+		if n < 0:
+			out += "  eliminated"
+		lines.append(out)
+
+	_mp8_score_build()
+	if _mp8_score_panel != null:
+		_mp8_score_panel.text = "\n".join(lines)
+
+
+# [MP8] Server side — collect this round's part counts and send them out. Eliminated players are sent as -1 (see the convention on the RPC).
+# ⚠️ Iterates `players`, not `active_players` — the leaderboard needs to show who's already out.
+func _mp8_score_broadcast() -> void :
+
+	if not multiplayer.is_server() or not _mp8_score_on or mp8_seats <= MP8_ORIG_SEATS:
+		return
+
+	var ids := PackedInt32Array()
+	var counts := PackedInt32Array()
+	for network_id in players.keys():
+		var p = players[network_id]
+		if p == null:
+			continue
+		ids.append(network_id)
+		counts.append( - 1 if not active_players.has(network_id) \
+			else int(p.valid_burns) + int(p.valid_recycles))
+
+	if ids.is_empty():
+		return
+	_mp8_score_board_rpc.rpc(ids, counts)
+
+
+# [MP8] The leaderboard container. CanvasLayer + Label, the same approach as the -BurnDebug panel.
+# ⚠️ Both sit in the top-left. When -BurnDebug is on, the leaderboard moves down so it doesn't overlap
+#(that one is the per-player binding panel, fixed at about 7 lines tall, and 190 pixels is enough to clear it).
+func _mp8_score_build() -> void :
+
+	if _mp8_score_panel != null:
+		return
+
+	var lbl := Label.new()
+	lbl.name = "MP8BurnScoreBoard"
+	lbl.set_anchors_preset(Control.PRESET_TOP_LEFT)
+	lbl.position = Vector2(
+		14.0, 190.0 if NetworkManager.mp8_args().has("mp8burndebug") else 10.0)
+	lbl.add_theme_color_override("font_color", Color(1.0, 0.94, 0.6))
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.add_theme_font_size_override("font_size", 22)
+
+	_mp8_score_canvas = CanvasLayer.new()
+	_mp8_score_canvas.layer = 127
+	_mp8_score_canvas.add_child(lbl)
+	# Parented under the minigame root = destroyed with the minigame, so it disappears naturally at intermission without manual cleanup
+	add_child(_mp8_score_canvas)
+	_mp8_score_panel = lbl
+
+
+# [MP8] Self-screenshot (HANDOFF section 8). The game saves the PNG itself, so no screen recording permission is needed.
+# There's only one thing to check in this match — **how crowded 8 stations at 45° really get, and whether the belt overlap looks bad**.
+# The filename includes the peer id, so each of the 8 instances saves its own (each one shows that player's own station view).
+func _mp8_shot(tag: String, delay: float = 0.0) -> void :
+
+	if not NetworkManager.mp8_args().has("mp8shot"):
+		return
+
+	if delay > 0.0:
+		await get_tree().create_timer(delay, false).timeout
+	if not is_inside_tree():
+		return
+	await RenderingServer.frame_post_draw
+
+	var peer: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var img: Image = get_viewport().get_texture().get_image()
+	if img != null:
+		img.save_png("user://mp8_burn_%s_%d.png" % [tag, peer])
+		print("[MP8] mp8shot: saved user://mp8_burn_%s_%d.png" % [tag, peer])
+
+
+# [MP8] Get a command-line argument of the form mp8xxx=<value>
+func _mp8_arg(prefix: String) -> String:
+	for a in NetworkManager.mp8_args():
+		var s: String = str(a)
+		if s.begins_with(prefix):
+			return s.substr(prefix.length())
+	return ""
+
