+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] -BurnEdit — manual tweaking of whole stations (requested by the user 2026-08-18)
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# Constitution hard rule #1, "layout belongs to the user". The two-tier layout above (4 inner + 4 outer, 2.0 m push)
+# is a **computed default**, and the user wants to drag things around in the real game.
+#
+# ### One "station" = four things, moved together rigidly
+#
+#   1. **Player instance** (control panel / two levers / piston / score screen / item lane / **camera** all live inside it)
+#   2. belts[·]      conveyor belt
+#   3. presses[·]    press
+#   4. indicators[·] results indicator
+#
+# ⚠️ The last three are **grouped by geometric angle, not by id**. The reason is that press_id / indicator_id and the station number
+# are separated by a vanilla constant offset (press yaw = 90*id + 90, indicator yaw = 90*id - 90, player yaw = 90*seat),
+# and expansion stacks another renumbering on top, "original i → 2i, copy → 2i+1". Grouping by id means one mistake cascades,
+# while **identifying "who stands at this station" by world angle can never go wrong**. See _mp8_seat_of_pos().
+#
+# ### The player instance's origin is at the arena center, not at the station
+#
+# This is the most counterintuitive part of this match. The player instance origin is (0,0,0) (it only gets a radial offset after the push),
+# and the control panel and the rest sit at **local +Z 5.20 m**. That means
+#   * Moving a station = adding a world offset to the instance position (player and camera move together).
+#   * Rotating a station = rotating around the **station anchor** (not the instance origin), otherwise the slightest touch flings the player to the other side of the arena.
+# The anchor is instance-local (0, 0, MP8_STATION_RADIAL_Z) transformed to world, see _mp8_station_anchor().
+#
+# ### What gets saved is "offsets relative to the default layout", not absolute coordinates
+#
+# user://mp8_burn_layout.txt, one station per line, as dx, dz, dyaw.
+# Deleting the file = back to the computed two-tier defaults. Offsets are saved instead of absolute values so that
+# after changing mp8burnpush= or the slot count, the manual tweaks still stack on top.
+#
+# ### Why an overview camera is a must (T key)
+#
+# Forklift Certified is a top-down view of the whole arena, so one window is enough to judge the layout. **In this match everyone has a first-person camera**,
+# and window 1 by default only sees station 0's own view, **with no way to see how the other stations are laid out**.
+# So edit mode brings its own top-down overview camera, and T toggles between "overview / the selected station player's own view".
+# The latter is what really needs judging — what framing an outer-ring player actually sees.
+#
+# ### Scope
+#
+# While editing, only **local** nodes move (window 1 seeing it is enough to judge). After saving, in **the next match**
+# _mp8_layout_rpc broadcasts it to all sides. Hardware is placed locally on each side, and player instances add the offsets in setup_rpc.
+
+const MP8_BURN_LAYOUT_FILE: String = "user://mp8_burn_layout.txt"
+const MP8_EDIT_STEPS: Array = [0.25, 1.0, 4.0]
+const MP8_EDIT_YAW_STEP: float = 15.0
+
+var _mp8_edit_on: bool = false
+var _mp8_edit_sel: int = 0
+var _mp8_edit_step_i: int = 0
+var _mp8_edit_canvas: CanvasLayer = null
+var _mp8_edit_panel: Label = null
+var _mp8_edit_cam: Camera3D = null
+var _mp8_edit_overview: bool = true
+# Linked mode — the four stations with the same parity move together. On by default (the four new ones should stay symmetric), G turns it off.
+var _mp8_edit_link: bool = true
+# Pause — **the whole match** (the host presses P, and _mp8_pause_rpc makes each of the 8 instances freeze its own tree)
+var _mp8_paused: bool = false
+var _mp8_pause_modes: Array = []
+
+# seat -> player instance (only filled on the server, recorded in spawn_players)
+var _mp8_seat_players: Dictionary = {}
+# seat -> [Vector3 position offset, float yaw offset], length = mp8_seats, identical on all sides (RPC broadcast)
+var _mp8_layout: Array = []
+var _mp8_layout_src: String = "built-in default (two-tier layout)"
+
+
+# [MP8] The player script calls this in setup_rpc to get its station's manual tweak offsets.
+# Without manual tweaks it's (0,0,0) and 0 — not a single value changes.
+func mp8_layout_delta(seat: int) -> Array :
+	if seat >= 0 and seat < _mp8_layout.size():
+		return _mp8_layout[seat]
+	return [Vector3.ZERO, 0.0]
+
+
+# [MP8] Used by the player script to compute the station anchor (a method across files is more robust than reading a const)
+func mp8_station_radial() -> float :
+	return MP8_STATION_RADIAL_Z
+
+
+# ── [MP8] Push the surrounding walls back as a whole (user decision 2026-08-18 — push back 5 m) ──────────────────────
+#
+# With 8 stations + the outer ring pushed out the arena feels cramped, so the user wants the surrounding walls pushed back.
+#
+# ### Why "scale + recenter" instead of "move each wall 5 m"
+#
+# Measured by probe63 — **the surrounding walls are one single mesh**, not four separate nodes —
+# `clientside visuals parent/burn recycle main wall7/main walls`,
+# a MeshInstance3D with its node origin at (0,0,0), AABB size 47.88 × 13.38 × 48.95,
+# and its center offset to (-1.59, 6.69, 2.12). There are no separate "east wall/west wall" nodes to move individually,
+# so the only option is a **non-uniform scale** of the whole thing, then a translation to move the room center back —
+# which is equivalent to moving each wall outward along its own normal by push meters.
+#
+# The per-axis scale factors are computed from the AABB at runtime (not hardcoded), so this won't need changing if the mesh is swapped later.
+#   scale_x = (width + 2*push) / width     scale_z = (depth + 2*push) / depth     scale_y = 1
+#
+# **y isn't scaled**. Only push the walls out, don't raise the ceiling by 5 m too.
+#
+# ### Three verified safety points
+#
+#   1. **There is no CollisionObject3D / CollisionShape3D anywhere in the subtree** (probe63 Q6) —
+#      it's purely decorative, so pitfall #28 "scaling breaks colliders" doesn't apply here.
+#   2. **Only this one wall node is touched**. Its siblings include `incinerator` (the central incinerator at (0, 0.68, 0))
+#      and 6 OmniLight3D lights — **none of them move**. The incinerator is dead center, and moving it with the walls would give the trick away.
+#   3. **≤4 players, not a single value changes** (the call site has a seats > 4 gate), so 4-player matches are identical to retail value for value.
+#
+# ### Costs (an informed choice, not a bug)
+#
+#   * The walls get stretched about 20% horizontally, and the textures stretch sideways with them.
+#   * The room gets bigger but the lights didn't move (they're above the center), so **the far walls will be a bit darker than before**.
+#   Both only affect how the background looks. If it really looks bad, pass mp8burnwall=0 to turn it off.
+func _mp8_push_walls(push: float) -> void :
+
+	if push <= 0.0:
+		return
+
+	var wall: MeshInstance3D = find_child("main walls", true, false) as MeshInstance3D
+	if wall == null:
+		push_warning("[MP8] Burn Recycle: can't find the 'main walls' node, surrounding walls not pushed back")
+		return
+	if wall.mesh == null:
+		push_warning("[MP8] Burn Recycle: 'main walls' has no mesh, surrounding walls not pushed back")
+		return
+
+	var ab: AABB = wall.mesh.get_aabb()
+	if ab.size.x < 0.01 or ab.size.z < 0.01:
+		push_warning("[MP8] Burn Recycle: 'main walls' AABB is flat, not risking a scale")
+		return
+
+	var sx: float = (ab.size.x + push * 2.0) / ab.size.x
+	var sz: float = (ab.size.z + push * 2.0) / ab.size.z
+
+	# Scaling pushes the AABB center away from the node origin proportionally, and then a translation moves it back —
+	# so "the room center stays put and each wall moves back push meters", instead of "the whole room slides to one side".
+	var c: Vector3 = ab.get_center()
+	wall.scale = Vector3(sx, 1.0, sz)
+	wall.position += Vector3(c.x - c.x * sx, 0.0, c.z - c.z * sz)
+
+	print("[MP8] Burn Recycle: surrounding walls pushed back %.2f m (%.2f x %.2f → %.2f x %.2f, scale %.4f/%.4f, y unchanged)" % [
+		push, ab.size.x, ab.size.z, ab.size.x + push * 2.0, ab.size.z + push * 2.0, sx, sz])
+
+
+# ── [MP8] Keep only the floor and stations, hide the rest of the scene (user decision 2026-08-18) ──────────────────
+#
+# Once the layout was finalized, the user wanted "everything in the scene invisible except the floor and the players' stations".
+#
+# ### The floor and walls are in **the same mesh**, but luckily as separate surfaces
+#
+# Measured by probe63/64 — `clientside visuals parent/burn recycle main wall7/main walls`
+# is a single **ArrayMesh with 4 surfaces**, each with its own named material.
+#
+#   surface 0  floor tiles       ← **floor, keep**
+#   surface 1  metal wall        ← hide
+#   surface 2  brick wall baked  ← hide
+#   surface 3  void              ← hide
+#
+# Godot has no API for "hiding a single surface" (`visible` applies to the whole MeshInstance3D),
+# so the surfaces to hide get a **fully transparent override material**.
+# Surfaces are identified by **material name**, not index — indexes can drift when the art changes, names don't.
+# If the name `floor tiles` can't be found someday, it's better to **hide nothing** and warn
+# than to guess blindly by index, which could hide the floor too and leave players floating.
+#
+# ### Shadows get turned off too
+#
+# Transparent materials don't cast shadows by default in Godot 4, but `cast_shadow` is a property of **the whole MeshInstance**,
+# not per surface. To make sure the hidden walls don't leave "shadows of invisible things" on the floor,
+# shadow casting is simply turned off for this whole mesh — the floor casting shadows is pointless anyway (there's nothing under it).
+#
+# ### What else is hidden
+#
+# The central incinerator `incinerator` (7.39 x 10.07 x 7.27, right in the middle of the arena) — it isn't a station,
+# and it sits right in the middle of the top-down overview. **None of the 6 lights next to it were touched** (lights aren't meshes,
+# and they are siblings of incinerator, not children, so hiding it doesn't turn them off).
+#
+# **What stays** — the four conveyor belts, four presses, results indicators, conveyor racks,
+# and the control panel/levers/piston/score screen that come with each player instance — all part of the "operating stations".
+#
+# ### Relation to "push the walls back 5 m"
+#
+# Since the walls are hidden, pushing them out is pointless, and **the floor and walls share one mesh** —
+# pushing would stretch the floor texture 20% sideways as well. So when the scene is hidden the **push is skipped** (see the call site).
+# To see the original with walls, pass `mp8burnkeepscene` (`play.ps1 -BurnKeepScene`),
+# and then the walls come back and the push is applied as well.
+const MP8_FLOOR_MATERIAL_NAME: String = "floor tiles"
+
+
+func _mp8_invisible_material() -> StandardMaterial3D :
+
+	var m := StandardMaterial3D.new()
+	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+	m.albedo_color = Color(0.0, 0.0, 0.0, 0.0)
+	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	m.disable_receive_shadows = true
+	return m
+
+
+func _mp8_hide_scenery() -> void :
+
+	# ── Surrounding walls — only hide the non-floor surfaces ──────────────────────────────
+	var mw: MeshInstance3D = find_child("main walls", true, false) as MeshInstance3D
+	if mw == null or mw.mesh == null:
+		push_warning("[MP8] Burn Recycle: can't find 'main walls', walls not hidden")
+	else:
+		# First confirm the floor surface really exists. If not, leave the whole thing alone (better to hide nothing than to hide the wrong thing)
+		var floor_i: int = - 1
+		for i in mw.mesh.get_surface_count():
+			var mat: Material = mw.mesh.surface_get_material(i)
+			if mat != null and String(mat.resource_name) == MP8_FLOOR_MATERIAL_NAME:
+				floor_i = i
+				break
+
+		if floor_i < 0:
+			push_warning("[MP8] Burn Recycle: no surface with material name '%s' in 'main walls' — hiding nothing (not risking a guess by index, the floor could get hidden)" % MP8_FLOOR_MATERIAL_NAME)
+		else:
+			var names := PackedStringArray()
+			for i in mw.mesh.get_surface_count():
+				if i == floor_i:
+					continue
+				var mat2: Material = mw.mesh.surface_get_material(i)
+				names.append("%d:%s" % [
+					i, "(unnamed)" if mat2 == null else String(mat2.resource_name)])
+				mw.set_surface_override_material(i, _mp8_invisible_material())
+
+			# Hidden walls shouldn't leave shadows on the floor (cast_shadow applies to the whole mesh, not per surface)
+			mw.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+
+			print("[MP8] Burn Recycle: walls hidden — kept surface %d '%s' (floor), hid %s" % [
+				floor_i, MP8_FLOOR_MATERIAL_NAME, ", ".join(names)])
+
+	# ── Central incinerator ────────────────────────────────────────────────────
+	var inc: Node3D = find_child("incinerator", true, false) as Node3D
+	if inc != null:
+		inc.visible = false
+		print("[MP8] Burn Recycle: central incinerator hidden (none of the 6 lights touched, they are siblings, not children)")
+	else:
+		push_warning("[MP8] Burn Recycle: can't find 'incinerator'")
+
+
+# [MP8] Visible platform — show/hide the **static station frames** (console bodies) in the main scene.
+#
+# Groups are identified by **name prefix**, not index — the same lesson as `_mp8_hide_scenery()`, indexes drift when the art changes.
+# Structure (measured by probe65)
+#
+#   burn recycle visuals final
+#     ├ conveyor control panel main parent_001 / _002 / _003 / _004   ← one set each, 4 sets total
+#     │    └ conveyor frame (18.19 x 5.86 x 3.84, console body) + baked-in piston/levers/panel screen
+#     └ Cube_135 ...                                                  ← other decorations, untouched
+#
+# ⚠️ Besides the frame, each set also has a **static** piston/levers/control panel screen baked in (same dimensions as the player instance's, value for value,
+# and station 0's copy sits in the same position as the player instance's). So hiding a whole parent set = the frame and that static copy
+# disappear together, while **the player instance's own copy is unaffected** (that's a different tree, managed by mp8_set_panel_visible).
+#
+# Purely visual, done locally on each side, no RPC. `visible` doesn't touch colliders (it isn't scale, so pitfall #28 doesn't apply).
+func _mp8_set_frames_visible(on: bool) -> void :
+
+	var root: Node = find_child(MP8_VISUALS_ROOT_NAME, true, false)
+	if root == null:
+		push_warning("[MP8] Burn Recycle: can't find '%s', visible platform switch had no effect" % MP8_VISUALS_ROOT_NAME)
+		return
+
+	var hit: int = 0
+	for c in root.get_children():
+		if not String(c.name).begins_with(MP8_FRAME_PARENT_PREFIX):
+			continue
+		var c3: Node3D = c as Node3D
+		if c3 == null:
+			continue
+		c3.visible = on
+		hit += 1
+
+	# If nothing is found, warn instead of silently doing nothing — "the switch didn't work" and "it worked but there were no frames to begin with"
+	# look identical on screen, and without a warning the next investigation would be wasted.
+	if hit == 0:
+		push_warning("[MP8] Burn Recycle: no node under '%s' has a name starting with '%s', visible platform switch had no effect" % [
+			MP8_VISUALS_ROOT_NAME, MP8_FRAME_PARENT_PREFIX])
+		return
+
+	print("[MP8] Burn Recycle: visible platform (static station frames) %d sets → %s%s" % [
+		hit, "shown" if on else "hidden",
+		" (vanilla only has 4 sets and they weren't expanded to 8, so even-numbered stations have one and odd-numbered don't)" if hit < mp8_seats else ""])
+
+
+# [MP8] Player control platform — show/hide the piston / levers / control panel screen that come with each player instance.
+# Applied to **all** player instances (this is something everyone can see, not local UI), forwarded to each instance to toggle itself.
+func _mp8_set_panels_visible(on: bool) -> void :
+
+	var hit: int = 0
+	for c in player_parent_node.get_children():
+		var p: BurnRecyclePlayer = c as BurnRecyclePlayer
+		if p == null:
+			continue
+		p.mp8_set_panel_visible(on)
+		hit += 1
+
+	print("[MP8] Burn Recycle: player control platforms %d → %s" % [hit, "shown" if on else "hidden"])
+
+
+func _mp8_layout_reset() -> void :
+	_mp8_layout = []
+	for i in mp8_seats:
+		_mp8_layout.append([Vector3.ZERO, 0.0])
+
+
+# [MP8] World position → which station it belongs to (grouped by the nearest azimuth around Y).
+# Station s's azimuth = mp8_seat_step * s (same convention as _mp8_radial).
+func _mp8_seat_of_pos(pos: Vector3) -> int :
+
+	if absf(pos.x) < 0.001 and absf(pos.z) < 0.001:
+		return - 1                     # Dead center of the arena, the angle can't be determined
+
+	var ang: float = rad_to_deg(atan2(pos.x, pos.z))
+	var best: int = 0
+	var best_d: float = 1e9
+	for s in mp8_seats:
+		var d: float = absf(wrapf(ang - mp8_seat_step * float(s), - 180.0, 180.0))
+		if d < best_d:
+			best_d = d
+			best = s
+	return best
+
+
+# [MP8] Station anchor — the world position of player instance local (0, 0, radius) ≈ where the control panel is. Station rotations pivot around it.
+# Falls back to the default geometry if the player instance hasn't spawned yet.
+func _mp8_station_anchor(seat: int) -> Vector3 :
+
+	var p = _mp8_seat_players.get(seat)
+	if p != null and is_instance_valid(p):
+		return (p as Node3D).global_transform * Vector3(0.0, 0.0, MP8_STATION_RADIAL_Z)
+
+	return _mp8_radial(seat) * (MP8_STATION_RADIAL_Z + _mp8_push_for(seat))
+
+
+# [MP8] Main scene hardware at this station (belt / press / indicator), grouped by geometry.
+func _mp8_station_hardware(seat: int) -> Array :
+
+	var out: Array = []
+	for arr in [belts, presses, indicators]:
+		for n in arr:
+			if n == null or not is_instance_valid(n):
+				continue
+			if _mp8_seat_of_pos((n as Node3D).global_position) == seat:
+				out.append(n)
+	return out
+
+
+# [MP8] **Snapshot of the default layout** — seat -> [[node, default global_transform], ...].
+#
+# Why a snapshot instead of stacking offsets onto the current pose on every key press?
+# Translation and "rotate around the anchor" **don't commute**. While tweaking it would rotate "around the current anchor", but replay in the next match
+# only knows the accumulated (dpos, dyaw) and can only rotate around the **default anchor** — the two would differ by an offset,
+# so "how I laid it out" and "how it comes out next match" wouldn't line up.
+# So every change **rebuilds from the snapshot**. First rotate by dyaw around the default anchor, then translate by dpos.
+# What you see while tweaking = the replay result, value for value.
+var _mp8_station_base: Dictionary = {}
+
+
+# [MP8] A station's default anchor (without manual offsets). Station rotations pivot around it.
+func _mp8_default_anchor(seat: int) -> Vector3 :
+	return _mp8_radial(seat) * (MP8_STATION_RADIAL_Z + _mp8_push_for(seat))
+
+
+# [MP8] Capture the default pose of every part at this station. It's only captured once, and all later rebuilds use it as the base.
+func _mp8_snapshot_station(seat: int) -> Array :
+
+	if _mp8_station_base.has(seat):
+		return _mp8_station_base[seat]
+
+	var rows: Array = []
+	var nodes: Array = _mp8_station_hardware(seat)
+	var p = _mp8_seat_players.get(seat)
+	if p != null and is_instance_valid(p):
+		nodes.append(p)
+
+	for n in nodes:
+		rows.append([n, (n as Node3D).global_transform])
+
+	_mp8_station_base[seat] = rows
+	return rows
+
+
+# [MP8] Rebuild one station from the snapshot using the layout table (rotate around the default anchor first, then translate). **Only touches local nodes.**
+func _mp8_apply_station(seat: int) -> void :
+
+	if seat < 0 or seat >= _mp8_layout.size():
+		return
+
+	var row: Array = _mp8_layout[seat]
+	var dpos: Vector3 = row[0]
+	var dyaw: float = float(row[1])
+
+	var anchor: Vector3 = _mp8_default_anchor(seat)
+	var b: Basis = Basis(Vector3.UP, deg_to_rad(dyaw))
+
+	for e in _mp8_snapshot_station(seat):
+		var n3: Node3D = e[0]
+		if n3 == null or not is_instance_valid(n3):
+			continue
+		var t: Transform3D = e[1]          # Default pose, not the current pose
+		t.origin = anchor + b * (t.origin - anchor) + dpos
+		t.basis = b * t.basis
+		n3.global_transform = t
+
+
+# [MP8] Apply the layout table to the **main scene hardware** (done locally on each side). The player instance part is added in setup_rpc,
+# because player instances haven't spawned yet when this RPC arrives.
+func _mp8_apply_hardware_layout() -> void :
+
+	for s in mini(_mp8_layout.size(), mp8_seats):
+		var row: Array = _mp8_layout[s]
+		if (row[0] as Vector3).is_zero_approx() and absf(float(row[1])) < 0.001:
+			continue
+		_mp8_apply_station(s)
+
+
+# [MP8] Layout table broadcast. The server sends it in spawn_players, and each side places its hardware locally.
+# ⚠️ Must be sent before setup_rpc, because player instances query mp8_layout_delta() in setup_rpc.
+@rpc("authority", "call_local", "reliable")
+func _mp8_layout_rpc(flat: PackedFloat32Array) -> void :
+
+	_mp8_layout_reset()
+	var n: int = mini(int(flat.size() / 3), _mp8_layout.size())
+	for i in n:
+		var offset := Vector3(flat[i * 3], 0.0, flat[i * 3 + 1])
+		if not (NetworkManager.mp8_finite_v3(offset, 100.0) and NetworkManager.mp8_finite(flat[i * 3 + 2], 360.0)):
+			continue
+		_mp8_layout[i] = [offset, flat[i * 3 + 2]]
+
+	_mp8_apply_hardware_layout()
+
+
+func _mp8_layout_flat() -> PackedFloat32Array :
+
+	var flat := PackedFloat32Array()
+	for row in _mp8_layout:
+		flat.append((row[0] as Vector3).x)
+		flat.append((row[0] as Vector3).z)
+		flat.append(float(row[1]))
+	return flat
+
+
+func _mp8_load_layout() -> void :
+
+	_mp8_layout_reset()
+
+	# [MP8] Saved layout files are a dev-build editor feature. Release builds always use the built-in layout.
+	if not NetworkManager.MP8_DEV_TOOLS or not FileAccess.file_exists(MP8_BURN_LAYOUT_FILE):
+		return
+
+	var f := FileAccess.open(MP8_BURN_LAYOUT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] Burn Recycle: can't read %s (error %d)" % [
+			MP8_BURN_LAYOUT_FILE, FileAccess.get_open_error()])
+		return
+
+	var i: int = 0
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var parts: PackedStringArray = line.split(",", false)
+		if parts.size() < 3:
+			push_warning("[MP8] Burn Recycle: can't parse this line of the layout file, skipping")
+			continue
+		if not (parts[0].strip_edges().is_valid_float() and parts[1].strip_edges().is_valid_float() and parts[2].strip_edges().is_valid_float()):
+			continue
+		if i < _mp8_layout.size():
+			_mp8_layout[i] = [
+				Vector3(float(parts[0].strip_edges()), 0.0, float(parts[1].strip_edges())),
+				float(parts[2].strip_edges()),
+			]
+		i += 1
+	f.close()
+
+	_mp8_layout_src = "saved file (%d lines)" % i
+	print("[MP8] Burn Recycle: loaded manual layout, %d lines → %s" % [
+		i, ProjectSettings.globalize_path(MP8_BURN_LAYOUT_FILE)])
+
+
+func _mp8_save_layout() -> bool :
+
+	var f := FileAccess.open(MP8_BURN_LAYOUT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] Burn Recycle: can't write %s (error %d)" % [
+			MP8_BURN_LAYOUT_FILE, FileAccess.get_open_error()])
+		return false
+
+	f.store_line("# Burn Recycle (mp8game=17) manual station layout — one station per line, %d lines total" % mp8_seats)
+	f.store_line("# Each line: dx, dz, dyaw (offsets relative to the **default two-tier layout**, not absolute coordinates)")
+	f.store_line("# One station = player instance (incl. control panel/item lane/score screen/camera) + conveyor belt + press + indicator, moved as a whole")
+	f.store_line("# Deleting this file = back to the default (4 inner + 4 outer, pushed out %.2f m)" % mp8_ring_push)
+	f.store_line("# Can be edited directly in Notepad. Saved at %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for s in _mp8_layout.size():
+		var row: Array = _mp8_layout[s]
+		var d: Vector3 = row[0]
+		f.store_line("%.3f, %.3f, %.1f    # station %d (%s)" % [
+			d.x, d.z, float(row[1]), s, "outer ring" if _mp8_push_for(s) > 0.0 else "inner ring"])
+	f.close()
+
+	print("[MP8] Burn Recycle: layout saved (%d stations) → %s" % [
+		_mp8_layout.size(), ProjectSettings.globalize_path(MP8_BURN_LAYOUT_FILE)])
+	return true
+
+
+# ── In-match manual tweak UI ────────────────────────────────────────────────────────────
+
