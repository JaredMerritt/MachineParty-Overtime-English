+	print("[MP8] Burn Recycle: -BurnEdit on (QE select station / IJKL move / UO rotate / T switch view / G link / P pause / V control platform / B static platform / 5 step size / 0 save / 9 reset / 8 report)")
+	print("[MP8] Burn Recycle: linking is **on** by default — adjust any of the four new stations and the other three move the same way in their own local frames")
+	_mp8_edit_refresh()
+
+
+# [MP8] Pause / resume (P key) — **pauses the whole match, all 8 instances stop together** (user decision 2026-08-18).
+#
+# While positioning, items keep moving forward and the countdown keeps running, which makes it hard to line things up. And this match is networked,
+# so freezing only the host is pointless — the server keeps running rounds and sending items, and on release everything jumps far ahead.
+# So the host presses P, and an RPC makes **each side freeze its own tree**.
+#
+# ### Why not just set get_tree().paused = true and call it done
+#
+# Once paused, this node's `_unhandled_key_input` stops too — pressing P could never resume, and edit mode would be bricked on the spot.
+# So **this node** is set to PROCESS_MODE_ALWAYS (the keyboard keeps responding),
+# while **each of its direct children** is explicitly set to PAUSABLE.
+# ⚠️ This step can't be skipped. `PROCESS_MODE_INHERIT` inherits the parent's **effective mode**,
+# so once the parent is ALWAYS, every INHERIT descendant becomes ALWAYS too — which amounts to not pausing at all.
+# Once the children are explicitly PAUSABLE, their own INHERIT descendants freeze normally
+# (round_timer, the state machine, players and the conveyor belt tweens are all in there).
+# On resume the original modes are restored one by one, leaving no trace.
+#
+# ### Are RPCs still received while paused? Yes, and that is what makes unfreezing possible at all
+#
+# `SceneTree.paused` turns off **nodes'** `_process` / `_physics_process` / `_input`,
+# while multiplayer polling happens at the SceneTree level and isn't affected by it.
+# On top of that, this node is PROCESS_MODE_ALWAYS while paused. So the unfreeze RPC sent when the host presses P
+# always reaches every side. (This is the premise the whole approach relies on, so don't change this node back to PAUSABLE.)
+#
+# ### Clients don't need edit mode on
+#
+# `_mp8_pause_rpc` is independent of `_mp8_edit_on`. Only instance 1 of the 8 has -BurnEdit on,
+# but the other 7 still need to freeze. So the pause logic lives in the RPC, not in the key handler.
+@rpc("authority", "call_local", "reliable")
+func _mp8_pause_rpc(on: bool) -> void :
+
+	# Pausing freezes every client's whole game, so it only exists in dev builds. Release builds only ever accept an unpause.
+	if on and not NetworkManager.MP8_DEV_TOOLS:
+		return
+	if on == _mp8_paused:
+		return
+
+	if on:
+		_mp8_pause_modes = []
+		for c in get_children():
+			_mp8_pause_modes.append([c, c.process_mode])
+			if c.process_mode == Node.PROCESS_MODE_INHERIT:
+				c.process_mode = Node.PROCESS_MODE_PAUSABLE
+		process_mode = Node.PROCESS_MODE_ALWAYS
+		if _mp8_edit_canvas != null:
+			_mp8_edit_canvas.process_mode = Node.PROCESS_MODE_ALWAYS
+		get_tree().paused = true
+		_mp8_paused = true
+		print("[MP8] Burn Recycle: ⏸ whole match paused")
+	else:
+		get_tree().paused = false
+		process_mode = Node.PROCESS_MODE_INHERIT
+		for e in _mp8_pause_modes:
+			var n: Node = e[0]
+			if n != null and is_instance_valid(n):
+				n.process_mode = e[1]
+		_mp8_pause_modes = []
+		_mp8_paused = false
+		print("[MP8] Burn Recycle: ▶ whole match resumed")
+
+	if _mp8_edit_panel != null:
+		_mp8_edit_refresh()
+
+
+func _mp8_edit_toggle_pause() -> void :
+
+	# @rpc("authority") can only be sent by the server. Host = window 1 = the one with edit mode on,
+	# so the normal path always works. If it's pressed on a client by accident, fall back to freezing only this machine rather than silently doing nothing.
+	if multiplayer.is_server():
+		_mp8_pause_rpc.rpc(not _mp8_paused)
+	else:
+		push_warning("[MP8] Burn Recycle: this isn't the host, so P only freezes this machine (pausing the whole match must be done in window 1)")
+		_mp8_pause_rpc(not _mp8_paused)
+
+
+func _mp8_edit_seat_camera(seat: int) -> void :
+
+	# Switch to a station's "own player looking out" framing. The camera lives inside the player scene,
+	# and normally only the owning player's side has current=true. Setting it current locally doesn't affect anyone else.
+	var p = _mp8_seat_players.get(seat)
+	if p == null or not is_instance_valid(p):
+		print("[MP8] Burn Recycle: station %d has no player instance yet, can't switch to that player's view" % seat)
+		return
+
+	var cam: Camera3D = null
+	for n in (p as Node).find_children("*", "Camera3D", true, false):
+		cam = n
+		break
+
+	if cam == null:
+		print("[MP8] Burn Recycle: can't find a Camera3D in station %d's player instance" % seat)
+		return
+
+	cam.current = true
+	_mp8_edit_overview = false
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on:
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = float(MP8_EDIT_STEPS[_mp8_edit_step_i])
+	var moved: bool = true
+
+	match key.keycode:
+		KEY_Q:
+			_mp8_edit_sel = (_mp8_edit_sel - 1 + mp8_seats) % mp8_seats
+		KEY_E:
+			_mp8_edit_sel = (_mp8_edit_sel + 1) % mp8_seats
+		KEY_I:
+			_mp8_edit_nudge(_mp8_screen_to_world(Vector2(0, - 1)) * step)
+		KEY_K:
+			_mp8_edit_nudge(_mp8_screen_to_world(Vector2(0, 1)) * step)
+		KEY_J:
+			_mp8_edit_nudge(_mp8_screen_to_world(Vector2(- 1, 0)) * step)
+		KEY_L:
+			_mp8_edit_nudge(_mp8_screen_to_world(Vector2(1, 0)) * step)
+		KEY_U:
+			_mp8_edit_turn(- MP8_EDIT_YAW_STEP)
+		KEY_O:
+			_mp8_edit_turn(MP8_EDIT_YAW_STEP)
+		KEY_5:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+		KEY_T:
+			if _mp8_edit_overview:
+				_mp8_edit_seat_camera(_mp8_edit_sel)
+			elif _mp8_edit_cam != null:
+				_mp8_edit_cam.current = true
+				_mp8_edit_overview = true
+		KEY_G:
+			_mp8_edit_link = not _mp8_edit_link
+		KEY_P:
+			_mp8_edit_toggle_pause()
+		KEY_V:
+			# [MP8] Show/hide player control platforms. ⚠️ **Only flips this window** (unlike the P pause, which goes through an RPC).
+			# This is an observation switch for "I want to see the layout clearly", so there's no reason for others to change along with it.
+			# To hide them in all 8 windows, use the command line mp8burnnopanel (play.ps1 -BurnNoPanel).
+			_mp8_show_panels = not _mp8_show_panels
+			_mp8_set_panels_visible(_mp8_show_panels)
+		KEY_B:
+			# [MP8] Show/hide the visible platform (static station frames). Same as above, only flips this window.
+			_mp8_show_frames = not _mp8_show_frames
+			_mp8_set_frames_visible(_mp8_show_frames)
+		KEY_0:
+			_mp8_save_layout()
+		KEY_9:
+			_mp8_edit_reset_all()
+		KEY_8:
+			_mp8_edit_report()
+			moved = false
+		_:
+			moved = false
+
+	if moved:
+		_mp8_edit_refresh()
+
+
+# [MP8] Screen direction → world horizontal direction (computed live from the current camera's basis vectors, with y flattened).
+func _mp8_screen_to_world(dir: Vector2) -> Vector3 :
+
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector3(dir.x, 0.0, dir.y)
+
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var right: Vector3 = cam.global_transform.basis.x
+	fwd.y = 0.0
+	right.y = 0.0
+	if fwd.length() < 0.001:
+		fwd = Vector3(0, 0, - 1)
+	if right.length() < 0.001:
+		right = Vector3(1, 0, 0)
+
+	return (right.normalized() * dir.x - fwd.normalized() * dir.y).normalized()
+
+
+# [MP8] Link group — **the four stations with the same parity move together** (requested by the user 2026-08-18).
+#
+# Odd = the four added by the expansion (outer ring), even = the four vanilla ones.
+# The four new ones are at 45°/135°/225°/315°, a rotationally symmetric set —
+# when the user adjusts one, the other three must follow **the same way**, otherwise tweaking all four by hand would never line them up.
+#
+# ⚠️ "The same way" **is not the same world displacement**. The four stations face 90° apart from each other,
+# and translating them together in world coordinates would slide all four in the same direction into a clump, wrecking the symmetry on the spot.
+# The right way is to **move them the same way in their own local frames**. Split the selected station's displacement into
+# "radial component + tangential (item lane direction) component", then reassemble it with each station's own radial/tangent.
+# That way "1 m outward" means 1 m outward for each of the four. See _mp8_edit_nudge().
+#
+# The G key turns linking off so you can fine-tune one station on its own.
+func _mp8_edit_group(seat: int) -> Array :
+
+	if not _mp8_edit_link:
+		return [seat]
+
+	var g: Array = []
+	for s in mp8_seats:
+		if (s % 2) == (seat % 2):
+			g.append(s)
+	return g
+
+
+func _mp8_edit_nudge(delta: Vector3) -> void :
+
+	var s0: int = _mp8_edit_sel
+
+	# Break this displacement down into the **selected station's** local frame
+	var r0: Vector3 = _mp8_radial(s0)          # Radial (from the center toward the station)
+	var t0: Vector3 = _mp8_goods_dir(s0)       # Tangent (item lane direction)
+	var d_radial: float = delta.dot(r0)
+	var d_tangent: float = delta.dot(t0)
+
+	for s in _mp8_edit_group(s0):
+		# Reassemble with **each station's own** radial/tangent → all four move outward/sideways by the same amount
+		var d: Vector3 = _mp8_radial(s) * d_radial + _mp8_goods_dir(s) * d_tangent
+		var row: Array = _mp8_layout[s]
+		_mp8_layout[s] = [(row[0] as Vector3) + d, row[1]]
+		_mp8_apply_station(s)                  # Rebuild from the snapshot, don't stack onto the current pose
+
+
+func _mp8_edit_turn(dyaw: float) -> void :
+
+	# Rotation is around each station's own anchor and already independent of facing, so the same angle can be applied directly
+	for s in _mp8_edit_group(_mp8_edit_sel):
+		var row: Array = _mp8_layout[s]
+		_mp8_layout[s] = [row[0], float(row[1]) + dyaw]
+		_mp8_apply_station(s)
+
+
+func _mp8_edit_reset_all() -> void :
+
+	for s in mp8_seats:
+		_mp8_layout[s] = [Vector3.ZERO, 0.0]
+		_mp8_apply_station(s)              # Rebuilding with zeroed offsets = back to the snapshot as is
+	print("[MP8] Burn Recycle: reset to the default two-tier layout (the saved file is still there, only pressing 0 overwrites it)")
+
+
+func _mp8_edit_refresh() -> void :
+
+	if _mp8_edit_panel == null:
+		return
+
+	var s: int = _mp8_edit_sel
+	var row: Array = _mp8_layout[s]
+	var d: Vector3 = row[0]
+	var anchor: Vector3 = _mp8_station_anchor(s)
+	var hw: int = _mp8_station_hardware(s).size()
+	var has_p: bool = _mp8_seat_players.get(s) != null
+
+	var grp: Array = _mp8_edit_group(s)
+	var grp_txt: String = "adjusting this one alone"
+	if _mp8_edit_link:
+		grp_txt = "linked with the four %s %s" % [
+			"new (odd)" if (s % 2) == 1 else "vanilla (even)", str(grp)]
+
+	var lines := PackedStringArray()
+	lines.append("[MP8] Burn Recycle · manual station tweak    source=%s%s" % [
+		_mp8_layout_src, "    ⏸ whole match paused" if _mp8_paused else ""])
+	lines.append("Selected station %d (%s)  parts: player %s + %d hardware pieces" % [
+		s, "outer ring" if _mp8_push_for(s) > 0.0 else "inner ring", "yes" if has_p else "no", hw])
+	lines.append("Link: %s" % grp_txt)
+	lines.append("Offset dx=%.2f dz=%.2f dyaw=%.0f°    anchor(%.2f, %.2f) radius %.2f m" % [
+		d.x, d.z, float(row[1]), anchor.x, anchor.z, Vector2(anchor.x, anchor.z).length()])
+	lines.append("Step %.2f m    view: %s" % [
+		float(MP8_EDIT_STEPS[_mp8_edit_step_i]), "overview" if _mp8_edit_overview else "station %d player" % s])
+	lines.append("Visible (this window only): control platform %s    static platform %s" % [
+		"shown" if _mp8_show_panels else "hidden", "shown" if _mp8_show_frames else "hidden"])
+	lines.append("QE select station | IJKL move (screen-relative) | UO rotate %.0f° | T switch view" % MP8_EDIT_YAW_STEP)
+	lines.append("G toggle link | P pause/resume | V control platform | B static platform | 5 step size | 0 save | 9 reset | 8 report")
+
+	_mp8_edit_panel.text = "\n".join(lines)
+
+
+func _mp8_edit_report() -> void :
+
+	print("[MP8] Burn Recycle: ==== manual station layout report (source=%s) ====" % _mp8_layout_src)
+	print("   Visible (this window): player control platform=%s  static station frames=%s" % [
+		"shown" if _mp8_show_panels else "hidden", "shown" if _mp8_show_frames else "hidden"])
+	for s in mp8_seats:
+		var row: Array = _mp8_layout[s]
+		var d: Vector3 = row[0]
+		var a: Vector3 = _mp8_station_anchor(s)
+		print("   #%d %s  offset(%.2f, %.2f) yaw%+.0f°  anchor(%.2f, %.2f) radius %.2f  hardware %d pcs  player %s" % [
+			s, "outer" if _mp8_push_for(s) > 0.0 else "inner", d.x, d.z, float(row[1]),
+			a.x, a.z, Vector2(a.x, a.z).length(),
+			_mp8_station_hardware(s).size(),
+			"yes" if _mp8_seat_players.get(s) != null else "no"])
+
+	# Reuse the existing pairwise belt intersection self-check (computed from the belts' current world positions, so it stays accurate after manual tweaks)
+	_mp8_check_belt_overlap()
