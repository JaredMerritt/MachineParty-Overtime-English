+	cam.position = Vector3(0.0, 26.0, 0.0)
+	cam.rotation_degrees = Vector3(- 89.0, 0.0, 0.0)
+	cam.fov = 60.0
+	add_child(cam)
+	_mp8_edit_cam = cam
+	cam.current = true
+	_mp8_edit_overview = true
