+# ---- In-match manual editing ----
+
+func _mp8_edit_begin() -> void :
+
+	var lbl := Label.new()
+	lbl.name = "MP8MineEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.offset_left = 16.0
+	lbl.offset_top = -132.0
+	lbl.offset_right = 940.0
+	lbl.offset_bottom = -8.0
+	_mp8_style(lbl, Color(0.6, 0.95, 1.0))
+	_mp8_layer().add_child(lbl)
+	_mp8_edit_panel = lbl
+
+	# A number tag above each spawn point — Marker3D itself is invisible, so without tags there's no telling which one you're adjusting
+	var f = load("res://fonts/Terminal F4.ttf")
+	for i in player_spawn_positions.size():
+		var n: Node3D = player_spawn_positions[i]
+		if n == null or not is_instance_valid(n):
+			continue
+		var tag := Label3D.new()
+		tag.name = "MP8SpawnTag"
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 160
+		tag.outline_size = 32
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true
+		if f != null:
+			tag.font = f
+		n.add_child(tag)
+		tag.position = Vector3(0.0, 3.0, 0.0)
+		_mp8_tags.append(tag)
+
+	_mp8_check_keys()
+	_mp8_edit_refresh()
+	print("[MP8] Exploding Collar Race: spawn point manual edit mode on — %d adjustable points" % player_spawn_positions.size())
+
+
+func _mp8_layer() -> CanvasLayer :
+	if _mp8_edit_canvas == null:
+		_mp8_edit_canvas = CanvasLayer.new()
+		_mp8_edit_canvas.layer = 100
+		add_child(_mp8_edit_canvas)
+	return _mp8_edit_canvas
+
+
+# ⚠️ The game's own font must be set explicitly. The default theme font has broken letter spacing (this is the fourth time we've hit this)
+func _mp8_style(lbl: Label, color: Color) -> void :
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 22)
+	lbl.add_theme_color_override("font_color", color)
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+
+
+# Rather than betting that I/J/K/L/M/N are free, check the InputMap at startup and report any clashes
+func _mp8_check_keys() -> void :
+
+	var mine: Dictionary = {
+		KEY_1: "select 1", KEY_2: "select 2", KEY_3: "select 3", KEY_4: "select 4",
+		KEY_5: "select 5", KEY_6: "select 6", KEY_7: "select 7", KEY_8: "select 8",
+		KEY_I: "far", KEY_K: "near", KEY_J: "left", KEY_L: "right",
+		KEY_M: "step size", KEY_N: "report", KEY_0: "save", KEY_9: "reset",
+	}
+	var clash := PackedStringArray()
+	for action in InputMap.get_actions():
+		for ev in InputMap.action_get_events(action):
+			var k := ev as InputEventKey
+			if k == null:
+				continue
+			for code in [k.keycode, k.physical_keycode]:
+				if code != 0 and mine.has(code):
+					clash.append("%s(%s)↔%s" % [
+						OS.get_keycode_string(code), mine[code], String(action)
+					])
+	if clash.is_empty():
+		print("[MP8] Exploding Collar Race: manual edit keys don't clash with the game's InputMap (checked %d actions)" % InputMap.get_actions().size())
+	else:
+		print("[MP8] Exploding Collar Race: ⚠️ key clash — %s" % ", ".join(clash))
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or player_spawn_positions.is_empty():
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+
+	match key.keycode:
+		KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8:
+			var want: int = key.keycode - KEY_1
+			if want >= player_spawn_positions.size():
+				return
+			_mp8_edit_sel = want
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			# Move by **screen direction**. The camera looks toward -Z, so screen left/right is world x,
+			# but the direction is computed live from the camera basis vectors, not hardcoded — so it won't flip if the camera ever changes.
+			var dir: Vector2 = _mp8_screen_axis(key.keycode)
+			if dir == Vector2.ZERO:
+				return
+			var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+			var cur := Vector2(n.global_position.x, n.global_position.z)
+			mp8_move_spawn_rpc.rpc(_mp8_edit_sel, cur + Vector2(dir.y, dir.x) * step)
+
+		KEY_M:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_0:
+			var ok: bool = _mp8_save_spawns()
+			_mp8_edit_refresh()
+			if _mp8_edit_panel != null:
+				_mp8_edit_panel.text = ("[Saved] These coordinates will be used automatically from the next match\n" if ok
+					else "[Save failed] Check the log\n") + _mp8_edit_panel.text
+
+		KEY_9:
+			var d: Array = _mp8_default_spawns(player_spawn_positions.size())
+			for i in mini(d.size(), player_spawn_positions.size()):
+				mp8_move_spawn_rpc.rpc(i, d[i])
+			print("[MP8] Exploding Collar Race: spawn points reset to the built-in defaults (the save file wasn't deleted, delete it to fully revert)")
+
+		KEY_N:
+			print("[MP8] Exploding Collar Race spawn point report: %s" % _mp8_spawn_desc())
+
+		_:
+			return
+
+	get_viewport().set_input_as_handled()
+
+
+# Screen direction → world horizontal direction. Returns Vector2(dx, dz).
+func _mp8_screen_axis(code: int) -> Vector2 :
+
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector2.ZERO
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var r2 := Vector2(right.x, right.z)
+	var f2 := Vector2(fwd.x, fwd.z)
+	if r2.length() < 0.001 or f2.length() < 0.001:
+		return Vector2.ZERO
+	r2 = r2.normalized()
+	f2 = f2.normalized()
+	match code:
+		KEY_L: return Vector2(r2.y, r2.x)
+		KEY_J: return - Vector2(r2.y, r2.x)
+		KEY_I: return Vector2(f2.y, f2.x)
+		KEY_K: return - Vector2(f2.y, f2.x)
+	return Vector2.ZERO
+
+
+# [MP8] any_peer + call_local - all 8 machines move it together.
+# Only the server reads the spawn points themselves, but **the number tags and the players standing on them** have to be visible on every machine, hence the broadcast.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_move_spawn_rpc(slot: int, pos: Vector2) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not (NetworkManager.mp8_finite_v2(pos)):
+		return
+
+	if slot < 0 or slot >= player_spawn_positions.size():
+		return
+	var n: Node3D = player_spawn_positions[slot]
+	if n == null or not is_instance_valid(n):
+		return
+
+	var p: Vector2 = _mp8_clamp(pos)
+	n.global_position = Vector3(p.x, n.global_position.y, p.y)
+
+	# Move the player standing on this point along with it — easier to place when you can see it.
+	# (Spawn points are assigned by shuffle, so look up by **node object**, not by index.)
+	#
+	# ⚠️ Both of these must hold.
+	#  ① Only the server moves players. `_mp8_owner` is only filled in spawn_players() (on the server),
+	#     so the client copy is empty. Also, **sending another RPC from inside a broadcast RPC handler**
+	#     means all 8 machines each broadcast it again, which turns straight into a storm.
+	#  ② Use vanilla's `teleport_rpc` instead of writing global_position directly —
+	#     writing it directly only takes effect locally, and everyone else still sees the player where they were.
+	if multiplayer.is_server():
+		var who = _mp8_owner.get(n)
+		if who != null and is_instance_valid(who):
+			who.teleport_rpc.rpc(Vector3(p.x, (who as Node3D).global_position.y, p.y))
+
+	_mp8_edit_refresh()
+
+
+func _mp8_edit_refresh() -> void :
+
+	for i in _mp8_tags.size():
+		var t: Label3D = _mp8_tags[i]
+		if t == null or not is_instance_valid(t):
+			continue
+		var sel: bool = (i == _mp8_edit_sel)
+		t.text = ("▼%d▼" % (i + 1)) if sel else str(i + 1)
+		t.modulate = (Color(1.0, 0.85, 0.2) if sel else Color(0.55, 0.75, 0.85))
+
+	if _mp8_edit_panel == null:
+		return
+
+	var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+	var cur := Vector2(n.global_position.x, n.global_position.z)
+
+	# Distance to the nearest other spawn point (too close and players get crammed together)
+	var gap: float = INF
+	for i in player_spawn_positions.size():
+		if i == _mp8_edit_sel:
+			continue
+		var o: Node3D = player_spawn_positions[i]
+		if o == null or not is_instance_valid(o):
+			continue
+		gap = minf(gap, cur.distance_to(Vector2(o.global_position.x, o.global_position.z)))
+
+	_mp8_edit_panel.text = "\n".join([
+		"[Spawn edit] selected %d / %d total   step %.1f m   source %s" % [
+			_mp8_edit_sel + 1, player_spawn_positions.size(),
+			MP8_EDIT_STEPS[_mp8_edit_step_i], _mp8_layout_src],
+		"position x=%.2f  z=%.2f      nearest point %.2f m %s" % [
+			cur.x, cur.y, gap, ("✓" if gap >= 1.5 else "⚠crowded")],
+		"allowed range x∈[%.1f,%.1f] z∈[%.1f,%.1f] (corridor widened ×%.2f; minefield starts at z=-10, z=+10 is the fall-behind death zone)" % [
+			MP8_SPAWN_BOX_MIN.x * _mp8_wide, MP8_SPAWN_BOX_MAX.x * _mp8_wide,
+			MP8_SPAWN_BOX_MIN.y, MP8_SPAWN_BOX_MAX.y, _mp8_wide],
+		"1~8 select   I/K far/near   J/L left/right   M step   0 save   9 reset   N report",
+	])
+
