+# [MP8] Widen the whole corridor sideways. Adjustable with the command line `mp8minewide=<factor>`, default 1.2.
+#
+# ⚠️ **Must run on every machine**. These are all local scene nodes on each machine and aren't network synced
+#    (the same reason Manufacture Gun's _mp8_setup_field has to run on every machine).
+#    Mine positions are computed by the server and sent one by one over RPC, so as long as **the walls are equally wide on every machine**, everything lines up.
+func _mp8_widen_field() -> void :
+
+	var forced: String = _mp8_arg("mp8minewide=")
+	_mp8_wide = (clampf(float(forced), 1.0, 2.0) if forced.is_valid_float() else MP8_WIDE_DEFAULT)
+
+	if is_equal_approx(_mp8_wide, 1.0):
+		print("[MP8] Exploding Collar Race: widen factor 1.0, venue unchanged")
+		return
+
+	# ---- ① Scale what can be scaled (contains only meshes or Box) ----
+	var scaled := PackedStringArray()
+	for path in MP8_WIDE_SCALE_NODES:
+		var n: Node3D = get_node_or_null(path) as Node3D
+		if n == null:
+			push_warning("[MP8] Exploding Collar Race: %s not found, this part wasn't widened (the corridor will be misaligned)" % path)
+			continue
+		# Only touch x, and **assign rather than multiply** — multiplying would get wider every match (the T19 pitfall)
+		n.scale = Vector3(_mp8_wide, n.scale.y, n.scale.z)
+		scaled.append(path)
+
+	# ---- ② Anything with cylinders/spheres is only translated, never scaled ----
+	var moved: int = 0
+	for parent_path in MP8_WIDE_MOVE_PARENTS:
+		var parent: Node = get_node_or_null(parent_path)
+		if parent == null:
+			push_warning("[MP8] Exploding Collar Race: %s not found" % parent_path)
+			continue
+		for c in parent.get_children():
+			if c is Node3D:
+				var n3: Node3D = c
+				n3.position = Vector3(n3.position.x * _mp8_wide, n3.position.y, n3.position.z)
+				moved += 1
+
+	# ---- ③ Move the danger sign further right (user request 2026-08-16) ----
+	var forced_sign: String = _mp8_arg("mp8minesign=")
+	var shift: float = (float(forced_sign) if forced_sign.is_valid_float() else MP8_SIGN_SHIFT_DEFAULT)
+	var sign_note := "not moved"
+	if not is_equal_approx(shift, 0.0):
+		var parts := PackedStringArray()
+		# The visual piece is under the scaled Geometry, so a local offset gets magnified by the parent's scale,
+		# so the factor is divided out here to make sure the visual and the collider move **the same world distance**.
+		var vis: Node3D = get_node_or_null(MP8_SIGN_VISUAL) as Node3D
+		if vis != null:
+			vis.position.x += shift / _mp8_wide
+			parts.append("visual→%.2f" % vis.global_position.x)
+		var col: Node3D = get_node_or_null(MP8_SIGN_COLLIDER) as Node3D
+		if col != null:
+			col.position.x += shift
+			parts.append("collider→%.2f" % col.global_position.x)
+		sign_note = "moved right %.1f m (%s)" % [shift, ", ".join(parts)]
+
+	print("[MP8] Exploding Collar Race: corridor widened ×%.2f — inner walls %.2f~%.2f → %.2f~%.2f, minefield width %.1f → %.1f" % [
+		_mp8_wide, -8.06, 7.99, -8.06 * _mp8_wide, 7.99 * _mp8_wide,
+		16.0, 16.0 * _mp8_wide
+	])
+	print("[MP8] Exploding Collar Race: scaled %d nodes (%s); translated %d colliders (they contain cylinders/spheres, **can't be scaled**); danger sign %s" % [
+		scaled.size(), ", ".join(scaled), moved, sign_note
+	])
+	print("[MP8] Exploding Collar Race: harvester KillArea 17.0 → %.1f wide (corridor %.1f, still spans it, no way around)" % [
+		17.0 * _mp8_wide, 16.05 * _mp8_wide
+	])
+
+
+func _mp8_arg(prefix: String) -> String :
+	for a in NetworkManager.mp8_args():
+		if String(a).begins_with(prefix):
+			return String(a).substr(prefix.length())
+	return ""
+
+
+# Default layout - **the 4 vanilla points are kept byte for byte**, and new points are inserted within the x span of their respective rows (split into front and back rows by z).
+# Vanilla is already a 2×2 grid, two in the front row at z≈1.85 and two in the back row at z≈7.43. 8 players = 4 per row.
+func _mp8_default_spawns(want: int) -> Array :
+
+	var orig: Array = []
+	for n in player_spawn_positions:
+		if n != null and is_instance_valid(n):
+			orig.append(Vector2(n.global_position.x, n.global_position.z))
+	if orig.is_empty():
+		return []
+
+	# Split into two rows by z (vanilla's front and back rows are 5.6 m apart, so one cut at the middle value is enough)
+	var zsum: float = 0.0
+	for o in orig:
+		zsum += o.y
+	var zmid: float = zsum / float(orig.size())
+
+	var rows: Array = [[], []]
+	for o in orig:
+		rows[0 if o.y < zmid else 1].append(o)
+
+	var out: Array = orig.duplicate()
+	var need: int = want - orig.size()
+	var r: int = 0
+
+	# Take turns inserting into the two rows - each time pick that row's **current largest gap** and insert at its midpoint
+	while need > 0:
+		var row: Array = rows[r % 2]
+		r += 1
+		if row.size() < 2:
+			continue
+		row.sort_custom(func(a, b): return a.x < b.x)
+		var bi: int = 0
+		var bw: float = -1.0
+		for i in row.size() - 1:
+			var w: float = row[i + 1].x - row[i].x
+			if w > bw:
+				bw = w
+				bi = i
+		var mid := Vector2(
+			(row[bi].x + row[bi + 1].x) * 0.5,
+			(row[bi].y + row[bi + 1].y) * 0.5
+		)
+		row.insert(bi + 1, mid)
+		out.append(mid)
+		need -= 1
+
+	return out
+
+
+func _mp8_apply_spawns(pts: Array) -> void :
+
+	var parent: Node3D = null
+	if player_spawn_positions.size() > 0 and is_instance_valid(player_spawn_positions[0]):
+		parent = player_spawn_positions[0].get_parent() as Node3D
+	if parent == null:
+		push_warning("[MP8] Exploding Collar Race: spawn point parent node not found, spawn points not filled in")
+		return
+
+	# The vanilla nodes **keep using the original objects** (their positions only change with >4 players). Missing ones are created new
+	var arr: Array[Node3D] = []
+	for i in pts.size():
+		var p: Vector2 = _mp8_clamp(pts[i])
+		var n: Node3D
+		if i < player_spawn_positions.size() and is_instance_valid(player_spawn_positions[i]):
+			n = player_spawn_positions[i]
+		else:
+			n = Marker3D.new()
+			n.name = "MP8Spawn%d" % i
+			parent.add_child(n)
+		n.global_position = Vector3(p.x, 0.0, p.y)
+		arr.append(n)
+
+	player_spawn_positions = arr
+
+
+# [MP8] The allowed x range **widens along with the corridor** (z is unchanged, nothing is stretched along z)
+func _mp8_clamp(p: Vector2) -> Vector2 :
+	return Vector2(
+		clampf(p.x, MP8_SPAWN_BOX_MIN.x * _mp8_wide, MP8_SPAWN_BOX_MAX.x * _mp8_wide),
+		clampf(p.y, MP8_SPAWN_BOX_MIN.y, MP8_SPAWN_BOX_MAX.y)
+	)
+
+
+func _mp8_spawn_desc() -> String :
+	var parts := PackedStringArray()
+	for i in player_spawn_positions.size():
+		var n: Node3D = player_spawn_positions[i]
+		if n != null and is_instance_valid(n):
+			parts.append("%d(%.2f,%.2f)" % [i + 1, n.global_position.x, n.global_position.z])
+	return " ".join(parts)
+
+
+func _mp8_load_spawns() -> Array :
+
+	# [MP8] Saved layout files are a dev-build editor feature. Release builds always use the built-in layout.
+	if not NetworkManager.MP8_DEV_TOOLS or not FileAccess.file_exists(MP8_SPAWN_FILE):
+		return []
+	var f := FileAccess.open(MP8_SPAWN_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] Exploding Collar Race: can't open %s (%d)" % [MP8_SPAWN_FILE, FileAccess.get_open_error()])
+		return []
+
+	var rows: Array = []
+	var ln: int = 0
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		ln += 1
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var cols: PackedStringArray = line.split(",", false)
+		if cols.size() < 2:
+			push_warning("[MP8] Exploding Collar Race: spawn file line %d isn't 2 numbers, skipping: %s" % [ln, line])
+			continue
+		var x: String = cols[0].strip_edges()
+		var z: String = cols[1].strip_edges()
+		if not (x.is_valid_float() and z.is_valid_float()):
+			push_warning("[MP8] Exploding Collar Race: spawn file line %d has non-numeric values, skipping: %s" % [ln, line])
+			continue
+		rows.append(Vector2(float(x), float(z)))
+	f.close()
+	return rows
+
+
+func _mp8_save_spawns() -> bool :
+
+	var f := FileAccess.open(MP8_SPAWN_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] Exploding Collar Race: can't write %s (%d)" % [MP8_SPAWN_FILE, FileAccess.get_open_error()])
+		return false
+
+	f.store_line("# Exploding Collar Race (mp8game=1) spawn points — each line = x, z")
+	f.store_line("# ⚠️ Only applies with 5 or more players; with ≤4 players the vanilla 4 are always used, untouched down to the byte.")
+	f.store_line("# Venue: the minefield covers x∈[-8,+8], z∈[-90,-10]; spawn points must stay **before** the minefield (z > -10),")
+	f.store_line("#       and z can't reach +10 (that's the KillArea, the fall-behind-and-die zone, you'd die the moment you spawn).")
+	f.store_line("# Delete this file = go back to the built-in default layout.")
+	f.store_line("# Saved at %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for n in player_spawn_positions:
+		if n != null and is_instance_valid(n):
+			f.store_line("%.2f, %.2f" % [n.global_position.x, n.global_position.z])
+	f.close()
+
+	print("[MP8] Exploding Collar Race: spawn points saved → %s" % ProjectSettings.globalize_path(MP8_SPAWN_FILE))
+	print("[MP8] Exploding Collar Race: current layout — %s" % _mp8_spawn_desc())
+	return true
