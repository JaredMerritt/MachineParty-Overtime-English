+# [MP8] Placement-based results - **completely overwrite** player_scores.
+#
+# It overwrites instead of changing vanilla's three `+= 1` spots, because vanilla adds points as the race goes,
+# while placements are only known once everyone is done. Leaving those increments in is harmless — they all get overwritten here.
+func _mp8_rank_scores() -> void :
+
+	var d: int = _mp8_dead_order.size()
+	var f: int = finished_players.size()
+	var rows := PackedStringArray()
+
+	# Zero everything first. Anyone who neither finished nor blew up (e.g. disconnected mid-match) gets 0,
+	# and must not keep the leftover points vanilla added along the way.
+	for id in player_scores.keys():
+		player_scores[id] = 0
+
+	# The dead - earliest deaths at the bottom
+	for i in d:
+		var id: int = _mp8_dead_order[i]
+		if player_scores.has(id):
+			player_scores[id] = i
+
+	# Finishers - ranked above the dead, earlier arrivals score higher, and full health gets +1 more
+	for j in f:
+		var p = finished_players[j]
+		if p == null or not is_instance_valid(p):
+			continue
+		var id: int = p.player_presence.network_id
+		if not player_scores.has(id):
+			continue
+		var s: int = d + (f - 1 - j)
+		var full: bool = (p.lives == p.max_lives)
+		if full:
+			s += 1
+		player_scores[id] = s
+		rows.append("#%d %s %d pts%s" % [
+			j + 1, String(p.player_presence.network_name), s, (" (full health)" if full else "")
+		])
+
+	print("[MP8] Exploding Collar Race results (%d players: finished %d / died %d) — %s%s" % [
+		player_scores.size(), f, d, " | ".join(rows),
+		("" if d == 0 else " || died (early→late): %s" % ", ".join(_mp8_dead_names()))
+	])
+
+
+func _mp8_dead_names() -> PackedStringArray :
+	var out := PackedStringArray()
+	for i in _mp8_dead_order.size():
+		var id: int = _mp8_dead_order[i]
+		var nm: String = str(id)
+		if player_characters.has(id) and is_instance_valid(player_characters[id]):
+			nm = String(player_characters[id].player_presence.network_name)
+		out.append("%s %d pts" % [nm, i])
+	return out
