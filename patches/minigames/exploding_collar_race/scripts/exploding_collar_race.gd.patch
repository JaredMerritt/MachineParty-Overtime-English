+func _mp8_setup_spawns() -> void :
+
+	var args := NetworkManager.mp8_args()
+	_mp8_no_expand = args.has("mp8noexpand")
+	_mp8_edit_on = args.has("mp8mineedit")
+	mp8_player_count = PlayerManager.player_presences.size()
+
+	print("[MP8] Exploding Collar Race: runtime values — spawn points %d / mine_distance %.2f / detection %.2f / detonation %.2f / harvester delay %.1f; %d players this match" % [
+		player_spawn_positions.size(), mine_distance, mine_detection_threshold,
+		mine_explosion_threshold, harvester_start_delay, mp8_player_count,
+	])
+
+	if _mp8_no_expand:
+		print("[MP8] Exploding Collar Race: mp8noexpand, venue and spawn points left completely unchanged (pure vanilla control group, ⚠️ must be used with 4 players)")
+		return
+
+	# ≤4 players - **venue and spawn points untouched down to the byte**, identical to vanilla value for value
+	if mp8_player_count <= 4:
+		print("[MP8] Exploding Collar Race: %d players, using the vanilla venue and 4 spawn points, nothing changed" % mp8_player_count)
+		return
+
+	_mp8_widen_field()
+
+	var want: int = mini(maxi(mp8_player_count, 5), MP8_MAX_PLAYERS)
+	var pts: Array = ([] if args.has("mp8minenofile") else _mp8_load_spawns())
+
+	if pts.is_empty():
+		pts = _mp8_default_spawns(want)
+		_mp8_layout_src = "built-in default (vanilla 4 + 4 inserted)"
+	else:
+		_mp8_layout_src = "save file %s" % MP8_SPAWN_FILE
+
+	# If there are fewer than needed, fill in from the defaults (rough placement beats a missing point → fewer points = fewer players spawned)
+	while pts.size() < want:
+		var fill: Array = _mp8_default_spawns(want)
+		pts.append(fill[pts.size()])
+
+	_mp8_apply_spawns(pts)
+
+	print("[MP8] Exploding Collar Race: spawn points 4 → %d (%s) — %s" % [
+		player_spawn_positions.size(), _mp8_layout_src, _mp8_spawn_desc()
+	])
