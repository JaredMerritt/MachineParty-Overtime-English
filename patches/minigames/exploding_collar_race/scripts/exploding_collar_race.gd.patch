+# and `Harvester/CollisionShape3D`, a **sphere** (r=0.5).
+# Symptom the user hit in testing - **touching the danger sign gets you stuck in place**. This was the cause.
+const MP8_WIDE_SCALE_NODES: Array[String] = [
+	"Geometry",                        # Meshes only, no colliders
+	"Colliders",                       # Side walls are Box + the ground is WorldBoundary (a plane, scaling has no effect)
+	"Interactive",                     # Finish and midpoint areas are both Box (the finish has to follow the truck, and the truck is in Geometry)
+	"Harvester/KillArea",              # Box
+	"Harvester/BehindKillArea",        # Box
+	"Harvester/mine clearing machine1",# The vehicle's meshes only
+]
+# These are **translated only, not scaled**. They contain cylinders/spheres, and scaling would break the collision.
+# The gate opening pieces are Box, but they share `StaticBody3D` with the cylinders, so it's simpler to translate them all together,
+# and they're already 19.39 m wide, so just moving them outward naturally widens the gate gap too.
+const MP8_WIDE_MOVE_PARENTS: Array[String] = ["StaticBody3D"]
