+
+
+# [MP8] Top up the spawn points to 8, arranged as a regular octagon. The 4 vanilla ones are not touched at all.
+#
+# ⚠️ Only adds what's missing. If the scene ever provides 8 on its own, nothing is added twice.
+# ⚠️ Everything is **computed at runtime** from the vanilla points, no hardcoded coordinates — if the scene moves, this still lines up.
+func _mp8_topup_spawns() -> void :
+
+	if player_spawn_parent_node == null:
+		push_warning("[MP8] DVD Roomba: no spawn point container, skipping 8-seat setup")
+		return
+
+	var originals: Array = []
+	for c in player_spawn_parent_node.get_children():
+		if c is Node3D:
+			originals.append(c)
+
+	var n: int = originals.size()
+	if n == 0 or n >= 8:
+		return
+
+	# Center = centroid of the vanilla points. Radius = average distance to the centroid
+	var center: Vector3 = Vector3.ZERO
+	for o in originals:
+		center += o.position
+	center /= float(n)
+
+	var radius: float = 0.0
+	for o in originals:
+		radius += Vector2(o.position.x - center.x, o.position.z - center.z).length()
+	radius /= float(n)
+
+	# Angles of the vanilla points, sorted, with the bisector of each adjacent pair used as a new point's direction
+	var angles: Array = []
+	for o in originals:
+		angles.append(atan2(o.position.z - center.z, o.position.x - center.x))
+	angles.sort()
+
+	var added := PackedStringArray()
+
+	for i in angles.size():
+
+		if originals.size() + added.size() >= 8:
+			break
+
+		var a: float = angles[i]
+		var b: float = float(angles[(i + 1) % angles.size()])
+		if b <= a:
+			b += TAU                       # Wrap across the -π/π seam so we don't get the opposite direction
+		var mid: float = (a + b) * 0.5
+
+		var p: Vector3 = Vector3(
+			center.x + cos(mid) * radius,
+			originals[0].position.y,
+			center.z + sin(mid) * radius
+		)
+
+		# Template is the vanilla point nearest the new point, so rotation/scale/script are inherited from the closest one
+		var tmpl: Node3D = originals[0]
+		var best: float = INF
+		for o in originals:
+			var d: float = o.position.distance_to(p)
+			if d < best:
+				best = d
+				tmpl = o
+
+		var dup: Node3D = tmpl.duplicate()
+		dup.name = "MP8Spawn%d" % (n + added.size())
+		player_spawn_parent_node.add_child(dup)
+		dup.position = p
+		added.append("(%.2f, %.2f)" % [p.x, p.z])
+
+	# Self-check that logs the minimum spacing. **Two coincident points is the classic way this kind of top-up breaks**
+	# (the vanilla container top-up produces two (0,0) points in this very minigame, see the section at the top of this file),
+	# and the "4 -> 8 succeeded" log line alone won't reveal it.
+	var pts: Array = []
+	for c in player_spawn_parent_node.get_children():
+		if c is Node3D:
+			pts.append(c.position)
+
+	var min_d: float = INF
+	for i in pts.size():
+		for j in range(i + 1, pts.size()):
+			min_d = minf(min_d, Vector2(pts[i].x - pts[j].x, pts[i].z - pts[j].z).length())
+
+	print("[MP8] DVD Roomba: spawn points %d → %d (center (%.2f, %.2f) radius %.2f, min spacing %.2f m) added %s" % [
+		n, pts.size(), center.x, center.z, radius, min_d, " ".join(added)
+	])
+
