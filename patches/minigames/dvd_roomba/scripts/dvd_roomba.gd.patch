+# [MP8] Logs placement/name/score at results time (no scores are changed).
+# Same format as Junk Platform, Spine Breaker and Green Pea, so the placement-based minigames are easy to compare side by side.
+# ⚠️ Deliberately logs both the 'players present' and 'players dead' counts. A difference > 1 means someone disconnected,
+# and disconnects are the only thing this change fixes — without logging them there's no way to verify the fix.
+func _mp8_log_scores() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var keys: Array = player_scores.keys()
+	keys.sort_custom(func(a, b): return player_scores[a] > player_scores[b])
+
