+func _mp8_child_count(path: String) -> int :
+	var n: Node = get_node_or_null(path)
+	return (n.get_child_count() if n != null else -1)
+
+
+# [MP8] A permanent top-right line "Guns nerfed · <degree>", in blue (requested by the user 2026-08-16).
+#
+# Following the rule already set for Duck Hunt - **only state the direction and degree, never show actual numbers**
+# (user 2026-08-15 - numbers are the designer's business, players only need the direction). Blue = nerf, also reusing Duck Hunt's colors.
+#
+# This is **one on-screen notice per machine, not one per player node**. Building it once on the minigame root node is enough.
+# ⚠️ Duck Hunt hung its HUD on the player, so in each machine's node tree all 8 players built their own Label,
+# piled up in a heap in the top-right corner, and it took a `network_id == multiplayer.get_unique_id()` check to fix.
+# Here it's built on the minigame from the start, so that problem can't happen.
+#
+# The degree is bucketed by multiplier (not hard-coded by player count), so the label stays correct when `mp8gunpower=` is used to tweak the value.
+#   ≥1.0 hidden | ≥0.875 slightly | ≥0.825 mildly | ≥0.70 moderately | otherwise heavily
+# Matching the default table - 5 players 0.90=slightly, 6 players 0.85=mildly, 7 players 0.80=moderately, 8 players 0.60=heavily.
+func _mp8_gun_hud() -> void :
+
+	var m: float = _mp8_gun_power()
+	if m >= 1.0:
+		return          # Not nerfed, so show nothing at all (≤4 players = vanilla, not a single extra pixel on screen)
+
+	var level: String
+	if m >= 0.875:
+		level = "slightly"
+	elif m >= 0.825:
+		level = "mildly"
+	elif m >= 0.70:
+		level = "moderately"
+	else:
+		level = "heavily"
+
+	# User decision 2026-08-16 - **always one fixed language** (originally Chinese, English in this translation, ignores the language setting),
+	# with the degree word embedded in the middle of the phrase — "Guns heavily nerfed", not "Heavily · guns nerfed".
+	var txt: String = "Guns %s nerfed" % level
+
+	var layer := CanvasLayer.new()
+	layer.name = "MP8GunNerfHud"
+	layer.layer = 100
+	add_child(layer)
+
+	var lbl := Label.new()
+	lbl.set_anchors_preset(Control.PRESET_TOP_RIGHT)
+	lbl.offset_left = -640.0
+	lbl.offset_top = 14.0
+	lbl.offset_right = -18.0
+	lbl.offset_bottom = 54.0
+	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+	lbl.text = txt
+
+	# ⚠️ The game's own font must be set explicitly. The default theme font **has broken letter spacing**,
+	# and in testing it squashes "P3  id 104…" into "P36idc104…". Duck Hunt and Junk Platform both fell for this, this is the third time.
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 26)
+	lbl.add_theme_color_override("font_color", Color(0.42, 0.71, 1.0))   # Blue = nerf
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	layer.add_child(lbl)
+
+	print("[MP8] Manufacture Gun: top-right notice '%s' (multiplier ×%.2f, %d players this match)" % [txt, m, mp8_player_count])
+
+
+# [MP8] This match's "gun power multiplier". The table lives in ManufactureGunPlayer (that's where it gets used).
+# The command line `mp8gunpower=<multiplier>` can override it temporarily without recompiling — used for tuning the feel.
+func _mp8_gun_power() -> float :
+
+	var forced: String = _mp8_arg("mp8gunpower=")
+	if forced.is_valid_float():
+		var f: float = clampf(float(forced), 0.05, 4.0)
+		print("[MP8] Manufacture Gun: command line forced gun power ×%.2f (%d players this match)" % [f, mp8_player_count])
+		return f
+
+	# Player counts not in the table (≤4, or in case it's ever above 8) always get 1.0 = vanilla
+	return float(ManufactureGunPlayer.MP8_GUN_POWER_BY_COUNT.get(mp8_player_count, 1.0))
+
