+# [MP8] Part scattering - scale the total with player count, keeping vanilla's share of "6.5 per player".
+#   4 players → 26 (byte-for-byte same as vanilla)  5 → 33  6 → 39  7 → 46  8 → 52
+# The command line mp8gunitems=<n> can override it temporarily without recompiling.
+#
+# How new points are generated (probe35 verified offline that 5~8 players all get 0 newly introduced problem points)
+#   Candidate = a real part point + the direction toward a neighbour **at the same height, ≤ 3.5 m away** × min(0.45, d/3)
+#   Selection = farthest point insertion (each round picks the candidate farthest from the points already chosen)
+#
+# Why the direction must point at another real part point - there really is a valid part sitting in that direction,
+# so this small step heads into "an area where parts can be".
+#   ✗ Tried "offset 0.45 m toward the group centroid, rotating by the golden angle each round" — the resulting directions had nothing vouching for them,
+#     and the part_016 point got rotated straight into the wall collider at x=12.4.
+#   ✗ Can't use "evenly spaced points between two points" either. The 11 floor points span 20 m, the lines between them cut across the center parts table,
+#     and the in-between points fall under the table where players can never reach them.
+#   ✗ The farthest point insertion step can't be skipped either — without it the minimum gap drops to 0.34 m (vanilla 1.015),
+#     and two parts end up stacked together (the same problem as two players stacking in Escalator Pit).
+#
+# ⚠️ One thing that didn't work out, stated plainly - the idea was to "scatter new parts toward the outer floor, spreading the 8 players away from the center parts
+# table". In testing it **can't be done** — the 11 floor points are too sparse, with only 2 pairs within 3.5 m
+# (017↔018 at 1.49, 015↔019 at 2.24), so there are only 4 safe candidates. Loosening the neighbour cap
+# scatters points into pallets and walls. So the actual distribution of 52 parts for 8 players is
+# **center parts table 28 / other tabletops 9 / floor 15** (vanilla 10 / 5 / 11), more concentrated on the parts table than vanilla.
+# If it really feels crowded it needs a different approach (e.g. let a physics query pick points, or hand-place a batch of outer points). Tweaking these two constants won't fix it.
+func _mp8_item_positions(base: Array[Vector3]) -> Array[Vector3] :
+
+	if _mp8_no_expand or base.is_empty():
+		return base
+
+	var p: int = maxi(mp8_player_count, 1)
+	var want: int = int(round(float(base.size()) * float(p) / 4.0))
+
+	var ov: String = _mp8_arg("mp8gunitems=")
+	if ov != "":
+		want = maxi(base.size(), int(ov))
+
+	if want <= base.size():
+		print("[MP8] Manufacture Gun: %d parts (%d players, same as vanilla)" % [base.size(), p])
+		return base
+
+	var lowi: Array[int] = []
+	var highi: Array[int] = []
+	for i in base.size():
+		if base[i].y < MP8_ITEM_FLOOR_Y:
+			lowi.append(i)
+		else:
+			highi.append(i)
+
+	var out: Array[Vector3] = base.duplicate()
+	var need: int = want - base.size()
+
+	var got: Array[Vector3] = _mp8_item_pick(base, lowi, need)
+	out.append_array(got)
+	need -= got.size()
+
+	var got2: Array[Vector3] = _mp8_item_pick(base, highi, need)
+	out.append_array(got2)
+
+	print("[MP8] Manufacture Gun: parts %d → %d (%d players; floor group +%d / tabletop group +%d)%s" % [
+		base.size(), out.size(), p, got.size(), got2.size(),
+		("" if out.size() >= want else "  ⚠️ not enough candidates, only got %d" % out.size())
+	])
+
+	if out.size() < want:
+		push_warning("[MP8] Manufacture Gun: only got %d parts (need %d), some players may not be able to build a gun" % [
+			out.size(), want
+		])
+
+	return out
+
+
+func _mp8_item_pick(base: Array[Vector3], grp: Array[int], need: int) -> Array[Vector3] :
+
+	var out: Array[Vector3] = []
+	if need <= 0 or grp.size() < 2:
+		return out
+
+	# Candidate pool
+	var pool: Array[Vector3] = []
+	for i in grp:
+		var lst: Array = []
+		for j in grp:
+			if j == i:
+				continue
+			var d: float = base[i].distance_to(base[j])
+			if d <= MP8_ITEM_NEIGHBOUR_CAP:
+				lst.append([d, j])
+		lst.sort_custom(func(a, b): return a[0] < b[0])
+		for e in lst:
+			var d2: float = e[0]
+			var j2: int = e[1]
+			var dir := Vector2(base[j2].x - base[i].x, base[j2].z - base[i].z)
+			if dir.length() < 0.001:
+				continue
+			dir = dir.normalized()
+			pool.append(base[i] + Vector3(dir.x, 0.0, dir.y) * minf(MP8_ITEM_STEP, d2 / 3.0))
+
+	# Farthest point insertion
+	var chosen: Array[Vector3] = []
+	for i in grp:
+		chosen.append(base[i])
+
+	while out.size() < need and not pool.is_empty():
+		var best: int = -1
+		var best_d: float = -1.0
+		for k in pool.size():
+			var d3: float = INF
+			for c in chosen:
+				d3 = minf(d3, pool[k].distance_to(c))
+			if d3 > best_d:
+				best_d = d3
+				best = k
+		if best < 0:
+			break
+		chosen.append(pool[best])
+		out.append(pool[best])
+		pool.remove_at(best)
+
+	return out
+
