+# [MP8] Add stations from the MP8_LAYOUT_* table. Every new slot **copies the whole vanilla #0 group**
+# (station marker + its empty desk + its tutorial highlight box), then moves the whole group to the target position and turns it to the target angle.
+# The four originals are the same prefab (empty desk meshes are all 2.36×2.14×3.71 and highlight boxes all 2.36×2.11×3.88,
+# measured by probe33), so any of them works as the template, and #0 is the simplest and most predictable.
+#
+# ⚠️ Why **player spawn points are not moved** - spawn points are left to network_manager's generic top-up
+# (its 4 midpoints were all measured to be on open floor). One version moved them itself, shifting spawn points along with the stations,
+# and in testing 2 of them landed inside solid geometry ((-1.32,-5.15) inside a prop on the center parts table,
+# (-1.32,+5.33) right inside the parts table collision box). The cost is that players #5~8 are a bit farther from their own stations,
+# and the log prints each player's distance.
+func _mp8_expand_workstations(want: int) -> void :
+
+	var ws: Node3D = get_node_or_null("WorkstationSpawns") as Node3D
+	if ws == null:
+		push_warning("[MP8] Manufacture Gun: WorkstationSpawns not found, stations not expanded")
+		return
+
+	var originals: Array[Node3D] = []
+	for c in ws.get_children():
+		if c is Node3D:
+			originals.append(c)
+
+	if originals.is_empty():
+		push_warning("[MP8] Manufacture Gun: no stations at all, can't expand")
+		return
+	if originals.size() >= want:
+		return
+
+	var desks: Node3D = get_node_or_null("empty_desks") as Node3D
+	_mp8_collect_workspace_boxes()
+
+	var layout: Array = _mp8_layout_live
+	var src: Node3D = originals[0]
+	var src_desk: Node3D = (_mp8_nearest_child(desks, src.global_position) if desks != null else null)
+	var src_box: MeshInstance3D = _mp8_nearest_box(src.global_position)
+
+	var added := PackedStringArray()
+
+	for i in layout.size():
+
+		if ws.get_child_count() >= want:
+			break
+
+		var target: Vector3 = layout[i][0]
+		var yaw: float = layout[i][1]
+
+		# ---- Station marker ----
+		var dup: Node3D = src.duplicate()
+		dup.name = "MP8Workstation%d" % i
+		ws.add_child(dup)
+		dup.global_position = Vector3(target.x, src.global_position.y, target.z)
+		dup.rotation_degrees = Vector3(0.0, yaw, 0.0)
+
+		# ---- Its empty desk ----
+		var desk_note: String = "no empty desk"
+		var d2: Node3D = null
+		if src_desk != null:
+			d2 = _mp8_clone_to(src_desk, target, yaw, "MP8%d" % i)
+			if d2 != null:
+				empty_desk_array.append(d2)
+				desk_note = String(src_desk.name)
+
+		# ---- Its tutorial highlight box ----
+		var b2: MeshInstance3D = null
+		if src_box != null:
+			var b = _mp8_clone_to(src_box, target, yaw, "MP8%d" % i)
+			if b is MeshInstance3D:
+				b2 = b
+				_mp8_ws_boxes.append(b2)
+
+		# [MP8] Manual tuning mode needs to move this whole group at once, so **references are recorded at build time**.
+		# They are not identified afterwards by position. Position is exactly what's about to change, so using it as a key drifts further off with every move
+		# (the flip side of Junk Platform's "ids can't be trusted, positions can" rule — when positions change, references are what you trust).
+		_mp8_slots.append({
+			"marker": dup, "desk": d2, "box": b2, "ws": null, "tag": null,
+		})
+
+		added.append("new%d(%.2f,%.2f) rot %.0f° empty desk %s" % [
+			i, target.x, target.z, yaw, desk_note
+		])
+
+	print("[MP8] Manufacture Gun: stations %d → %d (layout %s) — %s" % [
+		originals.size(), ws.get_child_count(), _mp8_layout_src, " | ".join(added)
+	])
+	print("[MP8] Manufacture Gun: empty_desk_array %d → %d entries; %d tutorial highlight boxes" % [
+		originals.size(), empty_desk_array.size(), _mp8_ws_boxes.size()
+	])
+
+	_mp8_check_slots(ws)
+
+
+# One piece of a group copy - move it to the target horizontal position and turn it to the target angle, **keeping its own y**
+# (the empty desk sits at -0.117 and the highlight box around +1.9, and these in-group offsets must not change).
+func _mp8_clone_to(src: Node3D, target: Vector3, yaw: float, suffix: String) -> Node3D :
+
+	var parent: Node = src.get_parent()
+	if parent == null:
+		return null
+
+	var dup: Node3D = src.duplicate()
+	dup.name = "%s_%s" % [String(src.name), suffix]
+	parent.add_child(dup)
+	dup.global_position = Vector3(target.x, src.global_position.y, target.z)
+	dup.global_rotation_degrees = Vector3(0.0, yaw, 0.0)
+	return dup
+
+
+# Self-check - every station must match exactly one empty desk, and no two stations may claim the same desk.
+# (Same style as the two Junk Platform flip-pairing self-checks. A failure prints ❌, so there's no need to eyeball the screen.)
+func _mp8_check_slots(ws: Node3D) -> void :
+
+	var used: Array[int] = []
+	var bad := 0
+	var parts := PackedStringArray()
+
+	for c in ws.get_children():
+		if not (c is Node3D):
+			continue
+		var best := -1
+		var bd: float = INF
+		for k in empty_desk_array.size():
+			var d: Node3D = empty_desk_array[k]
+			if d == null or not is_instance_valid(d):
+				continue
+			var dd: float = _mp8_flat(d.global_position, (c as Node3D).global_position)
+			if dd < bd:
+				bd = dd
+				best = k
+		if best < 0 or bd > MP8_DESK_MATCH_TOL:
+			bad += 1
+			parts.append("%s→no desk(nearest %.2f)❌" % [String(c.name), bd])
+		elif used.has(best):
+			bad += 1
+			parts.append("%s→desk%d already claimed❌" % [String(c.name), best])
+		else:
+			used.append(best)
+			parts.append("%s→desk%d(%.2f)" % [String(c.name), best, bd])
+
+	print("[MP8-WIRE] Manufacture Gun: station↔empty desk pairing %s — %s" % [
+		("✓ one-to-one" if bad == 0 else "❌ %d mismatches" % bad), ", ".join(parts)
+	])
+	if bad > 0:
+		push_warning("[MP8] Manufacture Gun: stations and empty desks aren't one-to-one, empty desks may not disappear")
+
+
+func _mp8_collect_workspace_boxes() -> void :
+
+	_mp8_ws_boxes = []
+	var marker: Node = get_node_or_null("PlayerMarker")
+	if marker == null:
+		return
+	var boxes = marker.get("bounds_workspaces")
+	if not (boxes is Array):
+		return
+	for b in (boxes as Array):
+		if b is MeshInstance3D:
+			_mp8_ws_boxes.append(b)
+
+
+func _mp8_nearest_child(parent: Node, pos: Vector3) -> Node3D :
+	var best: Node3D = null
+	var bd: float = INF
+	for c in parent.get_children():
+		if not (c is Node3D):
+			continue
+		var d: float = _mp8_flat((c as Node3D).global_position, pos)
+		if d < bd:
+			bd = d
+			best = c
+	return (best if bd <= MP8_DESK_MATCH_TOL else null)
+
+
+func _mp8_nearest_box(pos: Vector3) -> MeshInstance3D :
+	var best: MeshInstance3D = null
+	var bd: float = INF
+	for b in _mp8_ws_boxes:
+		if not is_instance_valid(b):
+			continue
+		var d: float = _mp8_flat(b.global_position, pos)
+		if d < bd:
+			bd = d
+			best = b
+	return (best if bd <= MP8_DESK_MATCH_TOL * 3.0 else null)
+
+
+func _mp8_flat(a: Vector3, b: Vector3) -> float :
+	return Vector2(a.x - b.x, a.z - b.z).length()
+
+
+func _mp8_arg(prefix: String) -> String :
+	for a in NetworkManager.mp8_args():
+		if String(a).begins_with(prefix):
+			return String(a).substr(prefix.length())
+	return ""
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Manual table tuning — the user pushes the 4 new tables to where they want them, in game
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# Only **the 4 new tables** move (user decision 2026-08-16). The 4 vanilla ones don't change by a single byte,
+# so 4-player matches always match vanilla value for value, and probe37's validity check keeps its calibration baseline.
+#
+# It has three parts.
+#   ① Save file user://mp8_gun_layout.txt — read at match start, overrides the built-in ring table
+#   ② In-match keys — select table / push table / rotate table / save, synced across all 8 windows via RPC
+#   ③ On-screen readout — live display of the two criteria this project paid dearly to learn
+#        Pitfall #25 - placement must be judged by **spacing in the screen projection**, not by whether it fits on the floor
+#        probe36   - tables too close together make their interactions fight each other (see MP8_MIN_DESK_GAP)
+
+
+# Precedence - save file > mp8gunlayout= > built-in ring.
+func _mp8_build_live_layout(ignore_file: bool) -> void :
+
+	var from_file: Array = ([] if ignore_file else _mp8_parse_layout_file())
+
+	if not from_file.is_empty():
+		_mp8_layout_live = from_file
+		_mp8_layout_src = "save file %s" % MP8_LAYOUT_FILE
+		print("[MP8] Manufacture Gun: loaded manually tuned layout — %s" % _mp8_layout_desc())
+		return
+
+	# ⚠️ Const arrays are read-only in Godot 4, and so is the inner [Vector3, float],
+	# so it must be **rebuilt entry by entry** rather than duplicate() (a shallow copy, where the inner arrays stay read-only).
+	var base: Array = (MP8_LAYOUT_SOLVER if _mp8_layout == "solver" else MP8_LAYOUT_RING)
+	_mp8_layout_live = []
+	for r in base:
+		_mp8_layout_live.append([r[0], float(r[1])])
+	_mp8_layout_src = "built-in %s" % _mp8_layout
+
+
+func _mp8_layout_desc() -> String :
+	var parts := PackedStringArray()
+	for i in _mp8_layout_live.size():
+		var p: Vector3 = _mp8_layout_live[i][0]
+		parts.append("new%d(%.2f,%.2f)@%.0f°" % [i + 1, p.x, p.z, _mp8_layout_live[i][1]])
+	return " ".join(parts)
+
+
+# File format is one table per line (x, z, rotation in degrees), and lines starting with `#` are comments.
+# Deliberately made so a person can edit it directly in Notepad — it can be changed without launching the game.
+func _mp8_parse_layout_file() -> Array :
+
+	# [MP8] Saved layout files are a dev-build editor feature. Release builds always use the built-in layout.
+	if not NetworkManager.MP8_DEV_TOOLS or not FileAccess.file_exists(MP8_LAYOUT_FILE):
+		return []
+
+	var f := FileAccess.open(MP8_LAYOUT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] Manufacture Gun: can't open %s (%d), using built-in layout" % [
+			MP8_LAYOUT_FILE, FileAccess.get_open_error()
+		])
+		return []
+
+	var rows: Array = []
+	var line_no: int = 0
+
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		line_no += 1
+		if line.is_empty() or line.begins_with("#"):
+			continue
+
+		var cols: PackedStringArray = line.split(",", false)
+		if cols.size() < 3:
+			push_warning("[MP8] Manufacture Gun: layout file line %d isn't 3 numbers, skipping: %s" % [line_no, line])
+			continue
+
+		var x: String = cols[0].strip_edges()
+		var z: String = cols[1].strip_edges()
+		var a: String = cols[2].strip_edges()
+		if not (x.is_valid_float() and z.is_valid_float() and a.is_valid_float()):
+			push_warning("[MP8] Manufacture Gun: layout file line %d has non-numbers, skipping: %s" % [line_no, line])
+			continue
+
+		rows.append([Vector3(float(x), 0.0, float(z)), float(a)])
+
+	f.close()
+
+	# Fewer than 4 lines get filled out from the built-in table, and extras get truncated — so one missing line doesn't crash the whole match
+	if rows.is_empty():
+		return []
+	while rows.size() < MP8_LAYOUT_RING.size():
+		var r = MP8_LAYOUT_RING[rows.size()]
+		rows.append([r[0], float(r[1])])
+		push_warning("[MP8] Manufacture Gun: layout file only has %d lines, table %d filled in with the built-in value" % [
+			rows.size() - 1, rows.size()
+		])
+	rows.resize(MP8_LAYOUT_RING.size())
+	return rows
+
+
+func _mp8_save_layout_file() -> bool :
+
+	var f := FileAccess.open(MP8_LAYOUT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] Manufacture Gun: can't write %s (error %d)" % [
+			MP8_LAYOUT_FILE, FileAccess.get_open_error()
+		])
+		return false
+
+	f.store_line("# Manufacture Gun (mp8game=3) 8-player layout — the 4 new tables")
+	f.store_line("# The 4 vanilla tables aren't in this file, they haven't changed by a single byte.")
+	f.store_line("# Each line = x, z, rotation in degrees. Edit it directly in Notepad, or press 0 in game to save over it.")
+	f.store_line("# Delete this file to go back to the built-in ring layout.")
+	f.store_line("# Saved at %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for r in _mp8_layout_live:
+		var p: Vector3 = r[0]
+		f.store_line("%.2f, %.2f, %.0f" % [p.x, p.z, float(r[1])])
+	f.close()
+
+	# Also print a version to the log that can be pasted straight back into MP8_LAYOUT_RING —
+	# once finalized it should be baked into the constant, so the next agent doesn't have to reverse-engineer the coordinates again.
+	var snippet := PackedStringArray()
+	for r in _mp8_layout_live:
+		var p: Vector3 = r[0]
+		snippet.append("\t[Vector3(%.2f, 0.0, %.2f), %.1f]," % [p.x, p.z, float(r[1])])
+	print("[MP8] Manufacture Gun: layout saved → %s" % ProjectSettings.globalize_path(MP8_LAYOUT_FILE))
+	print("[MP8] Manufacture Gun: once finalized this can be pasted straight into MP8_LAYOUT_RING — \n%s" % "\n".join(snippet))
+	return true
+
+
+func _mp8_edit_layer() -> CanvasLayer :
+	if _mp8_edit_canvas == null:
+		_mp8_edit_canvas = CanvasLayer.new()
+		_mp8_edit_canvas.layer = 100
+		add_child(_mp8_edit_canvas)
+	return _mp8_edit_canvas
+
+
+# ⚠️ The game's own font must be set explicitly. The default theme font **has broken letter spacing**,
+# and in testing it displays "P3  id 104..." as "P36idc104...". Duck Hunt and Junk Platform both fell for this.
+func _mp8_style_label(lbl: Label, color: Color) -> void :
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 22)
+	lbl.add_theme_color_override("font_color", color)
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+
+
+func _mp8_edit_begin() -> void :
+
+	if _mp8_slots.is_empty():
+		push_warning("[MP8] Manufacture Gun: no new tables, manual tuning mode not started")
+		_mp8_edit_on = false
+		return
+
+	# Panel in the bottom-left corner of the screen
+	var lbl := Label.new()
+	lbl.name = "MP8GunEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.offset_left = 16.0
+	lbl.offset_top = -150.0
+	lbl.offset_right = 900.0
+	lbl.offset_bottom = -8.0
+	_mp8_style_label(lbl, Color(0.6, 0.95, 1.0))
+	_mp8_edit_layer().add_child(lbl)
+	_mp8_edit_panel = lbl
+
+	# Hang a number tag above each tunable table, otherwise among 8 tables there's no telling "which one am I tuning"
+	for i in _mp8_slots.size():
+		var rec: Dictionary = _mp8_slots[i]
+		var marker = rec.get("marker")
+		if marker == null or not is_instance_valid(marker):
+			continue
+		var tag := Label3D.new()
+		tag.name = "MP8EditTag"
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 200
+		tag.outline_size = 40
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true       # Must stay visible even when the table blocks it, otherwise it gets lost once rotated to the back
+		var f = load("res://fonts/Terminal F4.ttf")
+		if f != null:
+			tag.font = f
+		marker.add_child(tag)
+		tag.position = Vector3(0.0, 4.0, 0.0)
+		rec["tag"] = tag
+
+	_mp8_edit_check_keys()
+	_mp8_edit_refresh()
+
+	print("[MP8] Manufacture Gun: manual table tuning mode on — %d new tables tunable, current layout source: %s" % [
+		_mp8_slots.size(), _mp8_layout_src
+	])
+
+
+# [MP8] Key conflict self-check.
+# This project's rule is "don't treat script literals as ground truth", and keys are no different. Rather than betting I/J/K/L are free,
+# check the keys actually bound in the InputMap at match start, and report any collision.
+func _mp8_edit_check_keys() -> void :
+
+	var mine: Dictionary = {
+		KEY_1: "select1", KEY_2: "select2", KEY_3: "select3", KEY_4: "select4",
+		KEY_I: "far", KEY_K: "near", KEY_J: "left", KEY_L: "right",
+		KEY_U: "rotate left", KEY_O: "rotate right",
+		KEY_5: "step size", KEY_0: "save", KEY_9: "reset", KEY_8: "report",
+	}
+	var clash := PackedStringArray()
+
+	for action in InputMap.get_actions():
+		for ev in InputMap.action_get_events(action):
+			var k := ev as InputEventKey
+			if k == null:
+				continue
+			for code in [k.keycode, k.physical_keycode]:
+				if code != 0 and mine.has(code):
+					clash.append("%s(%s)↔action %s" % [
+						OS.get_keycode_string(code), mine[code], String(action)
+					])
+
+	if clash.is_empty():
+		print("[MP8] Manufacture Gun: manual tuning keys don't conflict with the game InputMap (checked %d actions)" % InputMap.get_actions().size())
+	else:
+		push_warning("[MP8] Manufacture Gun: manual tuning keys collide with game actions — %s" % ", ".join(clash))
+		print("[MP8] Manufacture Gun: ⚠️ key collision — %s" % ", ".join(clash))
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or _mp8_slots.is_empty():
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+
+	match key.keycode:
+		KEY_1, KEY_2, KEY_3, KEY_4:
+			var want: int = key.keycode - KEY_1
+			if want >= _mp8_slots.size():
+				return
+			_mp8_edit_sel = want
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			# Push along **screen directions**, not world axes. The camera looks along +X, so screen horizontal≈z and vertical≈x,
+			# but that isn't hard-coded here. It's computed straight from the current camera's basis vectors, so it won't flip if the camera ever changes.
+			var dir: Vector2 = _mp8_screen_axis(key.keycode)
+			if dir == Vector2.ZERO:
+				return
+			var cur: Vector3 = _mp8_layout_live[_mp8_edit_sel][0]
+			var np := Vector3(cur.x + dir.y * step, 0.0, cur.z + dir.x * step)
+			mp8_gun_move_rpc.rpc(_mp8_edit_sel, np, float(_mp8_layout_live[_mp8_edit_sel][1]))
+
+		KEY_U, KEY_O:
+			var d: float = (- MP8_EDIT_YAW_STEP if key.keycode == KEY_U else MP8_EDIT_YAW_STEP)
+			var yaw: float = fposmod(float(_mp8_layout_live[_mp8_edit_sel][1]) + d, 360.0)
+			mp8_gun_move_rpc.rpc(_mp8_edit_sel, _mp8_layout_live[_mp8_edit_sel][0], yaw)
+
+		KEY_5:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_0:
+			var ok: bool = _mp8_save_layout_file()
+			_mp8_edit_refresh()
+			if _mp8_edit_panel != null:
+				_mp8_edit_panel.text = ("[SAVED] These coordinates will be used automatically next match\n" if ok
+					else "[SAVE FAILED] Check the log\n") + _mp8_edit_panel.text
+
+		KEY_9:
+			# Back to the built-in table - broadcast each table back so all 8 windows reset together
+			var base: Array = (MP8_LAYOUT_SOLVER if _mp8_layout == "solver" else MP8_LAYOUT_RING)
+			for i in mini(base.size(), _mp8_slots.size()):
+				mp8_gun_move_rpc.rpc(i, base[i][0], float(base[i][1]))
+			print("[MP8] Manufacture Gun: layout reset to built-in %s (the save file wasn't deleted, delete it to fully revert)" % _mp8_layout)
+
+		KEY_8:
+			_mp8_edit_report()
+
+		_:
+			return
+
+	get_viewport().set_input_as_handled()
+
+
+# Screen direction → world horizontal direction. Returns Vector2(dz, dx), where the x component goes to world z and the y component to world x.
+func _mp8_screen_axis(code: int) -> Vector2 :
+
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector2.ZERO
+
+	# Camera right / forward directions, both flattened onto the horizontal plane (the camera pitch shouldn't turn "push up" into flying into the sky)
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var r2 := Vector2(right.z, right.x)
+	var f2 := Vector2(fwd.z, fwd.x)
+	if r2.length() < 0.001 or f2.length() < 0.001:
+		return Vector2.ZERO
+	r2 = r2.normalized()
+	f2 = f2.normalized()
+
+	match code:
+		KEY_L: return r2
+		KEY_J: return - r2
+		KEY_I: return f2
+		KEY_K: return - f2
+	return Vector2.ZERO
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Layout broadcast with the host as the authority (fixed 2026-08-19, reported by the user from a 6-player match with real players)
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# **Symptom** - in the host's view the field is clean, but in the client's view a table stands in the middle of the path, with collision too.
+#
+# **The root cause isn't geometry, it's "each machine reads its own save file"**.
+# `_mp8_setup_field()` hangs off `_ready()` and runs on every machine (the empty desks/highlight boxes are local nodes on each machine,
+# so each one has to place them itself anyway). And the `_mp8_build_live_layout()` it calls reads
+# `user://mp8_gun_layout.txt`. That file was saved by pressing `0` during the user's manual tuning,
+# and it **only exists on the host machine** — the host reads the final layout (all four tables against the walls),
+# while clients can't read it and fall back to the built-in ring (B/C in the middle of the open area at x=+8.0, exactly the two blocking the path).
+# The two sides have different fields from the very first frame of the match, and each side's log is clean.
+#
+# **Approach** - `initialize()` only runs on the server — and game.gd only calls it after `all_players_loaded()`
+# (`_client_minigame_loaded_rpc` → `all_players_loaded`
+# → `minigame_ready` → `_on_minigame_ready` → `initialize`),
+# which means by then **this minigame's node is already in the tree on every client**, so the RPC is guaranteed to arrive.
+# The host broadcasts its own `_mp8_layout_live` one table at a time, and each machine places its own pieces locally.
+#
+# Reuses the existing `mp8_gun_move_rpc` — manual tuning mode already proved it can move a whole group at once
+# (station marker + empty desk + tutorial highlight box + workstation entity), and it uses absolute coordinates, so it can be called repeatedly.
+#
+# ⚠️ Snapshot first, then send. `mp8_gun_move_rpc` is `call_local`, so `.rpc()` immediately writes back to
+# `_mp8_layout_live[slot]`, and modifying the array while iterating over it would trip over itself.
+# ⚠️ This **doesn't replace** baking the final layout into `MP8_LAYOUT_RING` (already baked above). The broadcast fixes
+# "the two sides disagree", while baking the constant fixes "the side without the file should default to the final layout". Both are needed.
+func _mp8_broadcast_layout() -> void :
+
+	if not multiplayer.is_server():
+		return
+	if GameManager.local_game:
+		return                      # Local split-screen has no clients and shouldn't send RPCs
+	if _mp8_no_expand or mp8_player_count <= 4:
+		return                      # The field wasn't expanded, so there are no new tables to broadcast
+	if _mp8_slots.is_empty():
+		push_warning("[MP8] Manufacture Gun: the host has no new stations at all, layout not broadcast")
+		return
+
+	var rows: Array = []
+	for r in _mp8_layout_live:
+		rows.append([r[0], float(r[1])])
+
+	var n: int = mini(_mp8_slots.size(), rows.size())
+	for i in n:
+		mp8_gun_move_rpc.rpc(i, rows[i][0], float(rows[i][1]))
+
+	print("[MP8] Manufacture Gun: broadcast %d tables with the host as authority (host source=%s) — %s" % [
+		n, _mp8_layout_src, _mp8_layout_desc()
+	])
+
+
+# [MP8] any_peer + call_local - whoever pressed the key initiates it, and all 8 machines move together.
+# ⚠️ Every machine has to move them. The empty desks and tutorial highlight boxes are **local scene nodes on each machine**, not network-synced
+# (the same reason _mp8_setup_field has to run on every machine).
+@rpc("any_peer", "call_local", "reliable")
+func mp8_gun_move_rpc(slot: int, pos: Vector3, yaw: float) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not (NetworkManager.mp8_finite_v3(pos) and NetworkManager.mp8_finite(yaw)):
+		return
+
+	if slot < 0 or slot >= _mp8_slots.size():
+		# The host broadcast this but this machine doesn't have that station = this machine never expanded its field (read too few players / wrong package built).
+		# Dropping it silently would show up as "the client has one table fewer than the host", which is still a mismatch — so make it speak up.
+		push_warning("[MP8] Manufacture Gun: received layout for station #%d, but this machine only has %d new stations, discarding" % [
+			slot + 1, _mp8_slots.size()
+		])
+		return
+
+	_mp8_layout_live[slot] = [Vector3(pos.x, 0.0, pos.z), yaw]
+
+	var rec: Dictionary = _mp8_slots[slot]
+	var marker = rec.get("marker")
+	if marker == null or not is_instance_valid(marker):
+		return
+
+	# The workstation entity is only created after the match starts. The first time it's needed, identify it once by "nearest to the old position", then keep using that reference.
+	var ws_node = rec.get("ws")
+	if (ws_node == null or not is_instance_valid(ws_node)) and workstations_node_parent != null:
+		ws_node = _mp8_nearest_child(workstations_node_parent, (marker as Node3D).global_position)
+		rec["ws"] = ws_node
+
+	# The station marker's **local** rotation_degrees is the value spawn_workstations() reads
+	# (it reads c.global_position + c.rotation_degrees), so this is written the same way as at build time.
+	(marker as Node3D).global_position = Vector3(pos.x, (marker as Node3D).global_position.y, pos.z)
+	(marker as Node3D).rotation_degrees = Vector3(0.0, yaw, 0.0)
+
+	for k in ["desk", "box"]:
+		_mp8_place_at(rec.get(k), pos, yaw)
+	_mp8_place_at(ws_node, pos, yaw)
+
+	_mp8_edit_refresh()
+
+
+# Move one piece - only change its horizontal position and yaw, **keeping its own y**
+# (the empty desk sits at -0.117 and the highlight box at +1.9, and these in-group height differences must not change).
+func _mp8_place_at(n, pos: Vector3, yaw: float) -> void :
+	if n == null or not is_instance_valid(n) or not (n is Node3D):
+		return
+	var n3: Node3D = n
+	n3.global_position = Vector3(pos.x, n3.global_position.y, pos.z)
+	n3.global_rotation_degrees = Vector3(0.0, yaw, 0.0)
+
+
+# Horizontal positions of all 8 stations (the 4 vanilla ones first, then the new ones, in the same order as the WorkstationSpawns children)
+func _mp8_desk_points() -> Array[Vector3] :
+	var out: Array[Vector3] = []
+	var ws: Node3D = get_node_or_null("WorkstationSpawns") as Node3D
+	if ws == null:
+		return out
+	for c in ws.get_children():
+		if c is Node3D:
+			out.append((c as Node3D).global_position)
+	return out
+
+
+# Distance from station i to the nearest other station (world horizontal distance)
+func _mp8_nearest_gap(pts: Array[Vector3], i: int) -> float :
+	var best: float = INF
+	for j in pts.size():
+		if j == i:
+			continue
+		best = minf(best, _mp8_flat(pts[i], pts[j]))
+	return best
+
+
+# [MP8] The pitfall #25 criterion - whether a placement is good depends on the **screen projection**, not on whether it fits on the floor.
+#
+# Returns [minimum screen gap across all 8 tables, minimum screen gap across the 4 vanilla tables].
+# ⚠️ The pass mark is **not hard-coded to 0.334**. The baseline is the value computed from the 4 vanilla tables **on the same screen, in the same frame**
+# — resolution, aspect ratio and fov all cancel out automatically, and that's the right way to "calibrate against vanilla".
+func _mp8_screen_gaps() -> Array :
+
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	var pts: Array[Vector3] = _mp8_desk_points()
+	if cam == null or pts.size() < 2:
+		return [-1.0, -1.0]
+
+	var size: Vector2 = get_viewport().get_visible_rect().size
+	if size.x <= 0.0 or size.y <= 0.0:
+		return [-1.0, -1.0]
+
+	var ndc: Array[Vector2] = []
+	var ok: Array[bool] = []
+	for p in pts:
+		if cam.is_position_behind(p):
+			ndc.append(Vector2.ZERO)
+			ok.append(false)
+			continue
+		var s: Vector2 = cam.unproject_position(p)
+		ndc.append(Vector2(s.x / size.x * 2.0 - 1.0, s.y / size.y * 2.0 - 1.0))
+		ok.append(true)
+
+	var all_min: float = INF
+	var orig_min: float = INF
+	for i in ndc.size():
+		for j in range(i + 1, ndc.size()):
+			if not (ok[i] and ok[j]):
+				continue
+			var d: float = ndc[i].distance_to(ndc[j])
+			all_min = minf(all_min, d)
+			if i < 4 and j < 4:
+				orig_min = minf(orig_min, d)
+
+	return [
+		(-1.0 if is_inf(all_min) else all_min),
+		(-1.0 if is_inf(orig_min) else orig_min),
+	]
+
+
+func _mp8_edit_refresh() -> void :
+
+	for i in _mp8_slots.size():
+		var tag = (_mp8_slots[i] as Dictionary).get("tag")
+		if tag == null or not is_instance_valid(tag):
+			continue
+		var sel: bool = (i == _mp8_edit_sel)
+		(tag as Label3D).text = ("▼ %d ▼" % (i + 1)) if sel else str(i + 1)
+		(tag as Label3D).modulate = (Color(1.0, 0.85, 0.2) if sel else Color(0.55, 0.75, 0.85))
+
+	if _mp8_edit_panel == null:
+		return
+
+	var cur: Vector3 = _mp8_layout_live[_mp8_edit_sel][0]
+	var yaw: float = float(_mp8_layout_live[_mp8_edit_sel][1])
+	var pts: Array[Vector3] = _mp8_desk_points()
+	var gap: float = (_mp8_nearest_gap(pts, 4 + _mp8_edit_sel) if pts.size() > 4 + _mp8_edit_sel else -1.0)
+	var sg: Array = _mp8_screen_gaps()
+
+	var gap_txt: String = "—"
+	if gap >= 0.0:
+		gap_txt = "%.2f m %s" % [gap, ("✓" if gap >= MP8_MIN_DESK_GAP else "⚠ below %.1f" % MP8_MIN_DESK_GAP)]
+
+	var scr_txt: String = "—"
+	if sg[0] >= 0.0 and sg[1] >= 0.0:
+		scr_txt = "%.3f (vanilla 4 tables %.3f) %s" % [
+			sg[0], sg[1], ("✓" if sg[0] >= sg[1] * 0.75 else "⚠ tables will be crowded together")
+		]
+
+	_mp8_edit_panel.text = "\n".join([
+		"[TABLE TUNING] Selected new table #%d   step %.1f m   source %s" % [
+			_mp8_edit_sel + 1, MP8_EDIT_STEPS[_mp8_edit_step_i], _mp8_layout_src],
+		"Position x=%.2f  z=%.2f   rotation %.0f°" % [cur.x, cur.z, yaw],
+		"Nearest table %s      min screen gap %s" % [gap_txt, scr_txt],
+		"1~4 select table   I/K far/near   J/L left/right   U/O rotate   5 step   0 save   9 reset   8 report",
+	])
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Spawn points follow their stations (added 2026-08-16 after the user hand-placed the tables)
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# The vanilla rule is a **fact** measured by probe32, not something designed.
+#
+#   | vanilla | station | spawn point | distance | spawn point yaw |
+#   | 1 | (-7.04,-7.59) | (-4.52,-5.15) | 3.51 | 90°  |
+#   | 2 | (-7.54,+7.53) | (-4.52,+5.33) | 3.73 | 90°  |
+#   | 3 | (+11.10,+8.38)| (+7.50,+8.00) | 3.62 | -90° |
+#   | 4 | (+10.39,-8.17)| (+6.97,-8.00) | 3.43 | -90° |
+#
+#   ① Spawn points **each line up with their own station** (index i ↔ index i), 3.4~3.7 m apart
+#   ② They stand on **the side of the station facing the field center** (all four tables are in corners, with the open side facing in)
+#   ③ They **face their own table** (every yaw lines up)
+#
+# The previous version didn't do this. #5~8 went through network_manager's generic top-up (midpoints of the four edges),
+# and as a result P3 had to run 11.7 m to reach their own table, versus 3.4~3.7 in vanilla.
+#
+# ⚠️ **The previous round tried "shift spawn points along with the stations", and in testing 2 landed inside solid geometry**
+# ((-1.32,-5.15) inside a prop on the center parts table, (-1.32,+5.33) right inside the parts table collision box).
+# So this time it **doesn't hard-compute an offset, it searches and tests with physics** - circling the table to find a spot where someone can really stand.
+#
+# **Only the 4 new spawn points move**, and the 4 vanilla ones aren't touched by a single byte — they're already correct,
+# and they also serve as the "criterion calibration baseline" (see _mp8_calibrate_spot_test).
+func _mp8_place_spawns() -> void :
+
+	if _mp8_no_expand or mp8_player_count <= 4 or _mp8_slots.is_empty():
+		return
+
+	var sp: Node3D = get_node_or_null("SpawnPositions") as Node3D
+	var ws: Node3D = get_node_or_null("WorkstationSpawns") as Node3D
+	if sp == null or ws == null:
+		push_warning("[MP8] Manufacture Gun: SpawnPositions / WorkstationSpawns not found, spawn points didn't follow the stations")
+		return
+
+	# ⚠️ Get the physics space from **a Node3D in the scene**, not from get_viewport().world_3d —
+	# the latter returns null when the viewport has no World3D of its own. Node3D.get_world_3d() gets
+	# the world this node is actually registered in, so by definition it can't be wrong.
+	_mp8_space = sp.get_world_3d().direct_space_state
+	if _mp8_space == null:
+		push_warning("[MP8] Manufacture Gun: couldn't get the physics space, spawn points fall back to the generic top-up (left alone)")
+		return
+
+	# First calibrate the "room to stand" check against the 4 vanilla spawn points.
+	# If they fail, the check is wrong, not the positions (the lesson from probe37's three calibration rounds).
+	var tol: float = _mp8_calibrate_spot_test(sp)
+
+	var desks: Array[Vector3] = _mp8_desk_points()
+	var n_orig: int = desks.size() - _mp8_slots.size()   # Vanilla station count (normally 4)
+	var report := PackedStringArray()
+
+	for i in range(n_orig, desks.size()):
+
+		# The matching spawn point node - add it ourselves if there aren't enough (normally network_manager's generic top-up
+		# has already brought it up to 8, so this only overrides the position. If it's still short, build it ourselves as a fallback)
+		var marker: Node3D = null
+		if i < sp.get_child_count():
+			marker = sp.get_child(i) as Node3D
+		if marker == null:
+			marker = Marker3D.new()
+			marker.name = "MP8Spawn%d" % (i - n_orig)
+			sp.add_child(marker)
+
+		var found: Array = _mp8_find_spawn_spot(desks, i, tol)
+		var pos: Vector3 = found[0]
+		var note: String = found[1]
+
+		marker.global_position = Vector3(pos.x, 0.0, pos.z)
+		# Face your own table.
+		# In Godot the forward direction at yaw=θ is the -Z axis = (-sinθ, 0, -cosθ), and pointing it at (dx,dz)
+		# needs sinθ=-dx and cosθ=-dz → θ = atan2(-dx, -dz).
+		# Checked against the four vanilla spawn points - tables 3/4 face almost straight along +X, giving -95.9°/-87.2°,
+		# which is 5.9°/2.8° off vanilla's -90°. Tables 1/2 are at an angle, and vanilla rounded them to a whole 90°,
+		# while here we point exactly at the table (more precise than vanilla's rounding, and it only affects the 4 new ones).
+		var look := Vector2(desks[i].x - pos.x, desks[i].z - pos.z)
+		if look.length() > 0.01:
+			marker.global_rotation_degrees = Vector3(
+				0.0, rad_to_deg(atan2(- look.x, - look.y)), 0.0
+			)
+
+		report.append("new%d station(%.2f,%.2f)→spawn(%.2f,%.2f) dist %.2fm %s" % [
+			i - n_orig + 1, desks[i].x, desks[i].z, pos.x, pos.z,
+			_mp8_flat(pos, desks[i]), note
+		])
+
+	print("[MP8] Manufacture Gun: spawn points follow stations — %s" % " | ".join(report))
+
+
+# Calibrate the "is there room for a person to stand here" check using the 4 vanilla spawn points.
+# Returns the allowed collision tolerance. If a vanilla spawn point itself touches something, the check must be loosened enough to let it pass,
+# otherwise "the vanilla position fails the check" happens — and that means the check is wrong.
+func _mp8_calibrate_spot_test(sp: Node3D) -> float :
+
+	var fails := PackedStringArray()
+	var n: int = mini(4, sp.get_child_count())
+
+	for i in n:
+		var c: Node3D = sp.get_child(i) as Node3D
+		if c == null:
+			continue
+		if not _mp8_spot_free(c.global_position, 0.0):
+			fails.append("vanilla spawn%d(%.2f,%.2f)" % [i + 1, c.global_position.x, c.global_position.z])
+
+	if fails.is_empty():
+		print("[MP8] Manufacture Gun: standing spot check calibrated — all 4 vanilla spawn points pass (probe height y=%.3f)" % MP8_SPOT_PROBE_Y)
+		return 0.0
+
+	# A vanilla position fails → the check is too strict. Shrink the query volume a little and try again.
+	var still := PackedStringArray()
+	for i in n:
+		var c2: Node3D = sp.get_child(i) as Node3D
+		if c2 != null and not _mp8_spot_free(c2.global_position, 0.25):
+			still.append("vanilla%d" % (i + 1))
+
+	if still.is_empty():
+		push_warning("[MP8] Manufacture Gun: standing spot check marked vanilla spawn points as occupied (%s), passes after loosening by 0.25 m" % ", ".join(fails))
+		print("[MP8] Manufacture Gun: ⚠️ standing spot check is too strict (%s fail), continuing with 0.25 m loosening" % ", ".join(fails))
+		return 0.25
+
+	# 🩸 Still failing after loosening = **the check itself is broken**, not the positions.
+	# At that point it must never keep taking part in picking spots — an "open floor check" that is always false would pick
+	# **outside the map** (the only place with no collision), and that's exactly how the user got placed outside the walls in testing.
+	# Turn the physics query off outright and fall back to pure geometry (3.5 m toward the field center), which is guaranteed to be in bounds.
+	_mp8_space = null
+	push_warning("[MP8] Manufacture Gun: standing spot check still marks vanilla spawn points as occupied after loosening (%s) — the check is broken, physics query turned off, using pure geometry placement" % ", ".join(still))
+	print("[MP8] Manufacture Gun: ❌ standing spot check is broken (vanilla %s still fail after loosening), physics query off, using pure geometry — check MP8_SPOT_PROBE_Y" % ", ".join(still))
+	return 0.25
+
+
+# Whether a person has room to stand on this spot.
+#
+# 🩸 The first version used the player's Capsule, radius 0.7 / **height 5.0, placed at y=2.5** (= the player's own collider),
+# so **the y range was [0, 5], with the bottom pressing right on the floor collider** → **everywhere in the field read as occupied**,
+# while **outside the walls, with no floor, read as empty** → all four players got placed outside the walls (user testing).
+#
+# Changed to only check **the waist-up band** - a sphere of radius 0.7 at y=1.375, i.e. y∈[0.675, 2.075].
+# This is exactly the criterion probe35/37's three calibration rounds finally settled on ("standing spots only look waist-up, y 0.75~2.0"),
+# for the same reason too - the recipe indicator light strip is only 0.65 m tall. It doesn't stop anyone standing, but it makes floor-level queries fail everywhere.
+#
+# **Lesson - this "empty" check can only veto, it can't choose a direction** — outside the map is always the emptiest.
+# The direction is fixed by geometry (only into the field, see the ±75° limit in _mp8_find_spawn_spot).
+func _mp8_spot_free(p: Vector3, shrink: float) -> bool :
+
+	if _mp8_space == null:
+		return true      # If we can't query, don't block. Better to place it and let people see than silently spawn one player fewer
+
+	var shape := SphereShape3D.new()
+	shape.radius = maxf(0.2, 0.7 - shrink)
+
+	var q := PhysicsShapeQueryParameters3D.new()
+	q.shape = shape
+	# The player's Dropcast / Wallcast use exactly mask 3 (layers 1|2 = field geometry), so copy that
+	q.collision_mask = 3
+	q.transform = Transform3D(Basis(), Vector3(p.x, MP8_SPOT_PROBE_Y, p.z))
+
+	return _mp8_space.intersect_shape(q, 1).is_empty()
+
+
+# Search around table i for a spawn point with room to stand.
+# The starting direction = toward the field center (that's how all four vanilla tables are set up), then sweep a full circle alternating left and right.
+# The radius favours vanilla's 3.4~3.7 m and only backs off if nothing is found.
+func _mp8_find_spawn_spot(desks: Array[Vector3], i: int, tol: float) -> Array :
+
+	var here: Vector3 = desks[i]
+	var base := Vector2(-here.x, -here.z)          # Toward the field center
+	if base.length() < 0.01:
+		base = Vector2(1.0, 0.0)
+	base = base.normalized()
+	var here_r: float = Vector2(here.x, here.z).length()
+
+	for r in [3.5, 3.1, 4.0, 2.7, 4.6]:
+		for k in MP8_SPOT_SWEEP:
+			# 0°, -15°, +15°, -30°, +30° ... try straight at the center first, then sweep outward alternating left and right
+			# (don't name the variable sign — that's a GDScript built-in function name)
+			var side: float = (1.0 if (k % 2) == 0 else -1.0)
+			var ang: float = deg_to_rad(float((k + 1) / 2) * 15.0) * side
+			var d: Vector2 = base.rotated(ang)
+			var cand := Vector3(here.x + d.x * r, 0.0, here.z + d.y * r)
+
+			# ⚠️ **Hard constraint - only move into the field, never outward.**
+			# The user's test result "all four players respawned outside the walls" came from not having this — the collision query judged
+			# **outside the map** to be the emptiest place, and sweeping to ±180° went headfirst out of bounds.
+			# Duck Hunt's "expand outward and someone jumped out of the map" was the same lesson.
+			# **The range vanilla provides is the only thing vouched for as "definitely in bounds", so don't take a single step outside it.**
+			# Criterion - a candidate must be closer to the field center than its table is (±75° already keeps the direction inward,
+			# and this adds one more safety layer so it can't wrap outward even at the 4.6 radius setting).
+			if Vector2(cand.x, cand.z).length() >= here_r:
+				continue
+
+			if not _mp8_spot_free(cand, tol):
+				continue
+			if not _mp8_clear_of_other_desks(desks, i, cand):
+				continue
+			return [cand, ("facing center" if k == 0 else "offset %.0f°" % rad_to_deg(ang))]
+
+	# Nothing found all the way around - fall back to a hard placement "3.5 m toward the center", and say plainly that this spot wasn't verified.
+	# Better to stand awkwardly than spawn one player fewer (one player fewer = this match may never end).
+	var fb := Vector3(here.x + base.x * 3.5, 0.0, here.z + base.y * 3.5)
+	push_warning("[MP8] Manufacture Gun: no spawn spot with room to stand found around station (%.2f,%.2f), hard-placed 3.5 m toward the center" % [
+		here.x, here.z
+	])
+	return [fb, "⚠️no free spot found, hard-placed"]
+
+
+# [MP8] Check once after the match starts - is anyone stuck inside a static collider (unable to move).
+#
+# Why people get stuck - the order in `initialize()` is **spawn_players() → spawn_workstations()**,
+# and workstations are static bodies added to the field with add_child **after players are placed** (collision box 2.40×3.80).
+# Stand too close and the table grows right out of the player. The user reported "P4 stuck in place, can't move" in testing on 2026-08-16.
+#
+# ⚠️ **Must wait for a physics frame**. A collider that was just added with add_child isn't in the physics space yet on that frame,
+# so querying immediately reports "all fine" everywhere (the same pitfall hit when placing spawn points).
+func _mp8_unstick_players() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	await get_tree().physics_frame
+	await get_tree().physics_frame
+
+	var sp: Node3D = get_node_or_null("SpawnPositions") as Node3D
+	if sp == null:
+		return
+	_mp8_space = sp.get_world_3d().direct_space_state
+	if _mp8_space == null:
+		return
+
+	var desks: Array[Vector3] = _mp8_desk_points()
+	var rows := PackedStringArray()
+
+	for id in active_players.keys():
+
+		var p = active_players[id]
+		if p == null or not is_instance_valid(p):
+			continue
+
+		var here: Vector3 = (p as Node3D).global_position
+		var nm: String = String(p.player_presence.network_name)
+
+		# Distance to the nearest workstation (table half diagonal 2.25 + player radius 0.7 ≈ 2.95 is the danger line)
+		var nd: float = INF
+		for d in desks:
+			nd = minf(nd, _mp8_flat(here, d))
+
+		if _mp8_spot_free(here, 0.0):
+			rows.append("%s(%.1f,%.1f) nearest table %.2fm ✓" % [nm, here.x, here.z, nd])
+			continue
+
+		# Stuck - search from the current position toward the field center for a spot with room to stand, and move the player there
+		var fixed := Vector3.INF
+		var base := Vector2(-here.x, -here.z)
+		if base.length() < 0.01:
+			base = Vector2(1.0, 0.0)
+		base = base.normalized()
+
+		for r in [1.0, 1.6, 2.2, 3.0]:
+			for k in 24:
+				var side: float = (1.0 if (k % 2) == 0 else -1.0)
+				var ang: float = deg_to_rad(float((k + 1) / 2) * 15.0) * side
+				var d2: Vector2 = base.rotated(ang)
+				var cand := Vector3(here.x + d2.x * r, here.y, here.z + d2.y * r)
