+# [MP8] Print the **runtime ground truth** before touching it (pitfall #3 - the real @export values come from the scene,
+# the defaults in the script lie, and this project has been burned by that three times).
+func _mp8_setup_field() -> void :
+
+	var args := NetworkManager.mp8_args()
+	_mp8_no_expand = args.has("mp8noexpand")
+	mp8_player_count = PlayerManager.player_presences.size()
+
+	var lay: String = _mp8_arg("mp8gunlayout=")
+	if lay == "ring" or lay == "solver":
+		_mp8_layout = lay
+	elif lay != "":
+		push_warning("[MP8] Manufacture Gun: mp8gunlayout=%s not recognized, using default ring" % lay)
+
+	# [MP8] Manual tuning mode - only on when mp8gunedit is passed explicitly. **Deliberately not tied to -debug-tools** —
+	# it grabs a bunch of keys, and hanging it off -debug-tools would mysteriously steal keys during every normal test.
+	_mp8_edit_on = args.has("mp8gunedit")
+
+	# Precedence - save file > mp8gunlayout= > built-in ring. mp8gunnofile ignores the file.
+	_mp8_build_live_layout(args.has("mp8gunnofile"))
+
+	print("[MP8] Manufacture Gun: runtime ground truth — empty_desk_array %d entries / recipe_indicator_ligths %d entries / %d stations / %d player spawn points / %d part points; %d players this match" % [
+		empty_desk_array.size(),
+		recipe_indicator_ligths.size(),
+		_mp8_child_count("WorkstationSpawns"),
+		_mp8_child_count("SpawnPositions"),
+		_mp8_child_count("ItemSpawner/ItemSpawns"),
+		mp8_player_count,
+	])
+
+	# [MP8] Top-right "gun nerfed this match" notice. It goes before the early return — the gun nerf follows player count,
+	# so even when mp8noexpand leaves the field alone the gun still gets nerfed, and the notice can't be skipped.
+	_mp8_gun_hud()
+
+	if _mp8_no_expand:
+		print("[MP8] Manufacture Gun: mp8noexpand, field left completely unchanged (pure vanilla control group, ⚠️ must be run with 4 players)")
+		return
+
+	if mp8_player_count <= 4:
+		print("[MP8] Manufacture Gun: %d players, using the 4 vanilla stations, nothing changed" % mp8_player_count)
+		if _mp8_edit_on:
+			push_warning("[MP8] Manufacture Gun: only %d players this match, no new tables to tune, manual tuning mode not started" % mp8_player_count)
+		return
+
+	_mp8_expand_workstations(clampi(mp8_player_count, 5, MP8_MAX_PLAYERS))
+
+	if _mp8_edit_on:
+		_mp8_edit_begin()
