+# [MP8] The server broadcasts this once in spawn_players() based on total player count.
+# **Every machine needs to receive it**. Hit detection via `gun_shot_area.get_overlapping_bodies()` and
+# `shoot_cooldown_timer` are both computed **on the shooter's own machine**,
+# so if it were only changed on the server, client players would still be holding the strong vanilla gun.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_set_gun_power_rpc(m: float) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not (NetworkManager.mp8_finite(m, 10.0)):
+		return
+
+	mp8_gun_power = m
+	_mp8_apply_gun_power()
+
+
+func _mp8_apply_gun_power() -> void :
+
+	# Record the base values only once, and always use "base × multiplier" after that.
+	# Without a recorded base, repeated calls would **compound** (the Junk Platform falling-rock multiplier pitfall, where applying 5× twice became 25×).
+	if _mp8_cd_base < 0.0:
+		_mp8_cd_base = shoot_cooldown
+	if _mp8_area_base_pos == Vector3.INF and gun_shot_area != null:
+		_mp8_area_base_pos = gun_shot_area.position
+
+	var m: float = maxf(0.05, mp8_gun_power)
+
+	# Fire rate ×m ⇒ cooldown ÷m (longer cooldown = slower shooting)
+	shoot_cooldown = _mp8_cd_base / m
+
+	# Range ×m - scale the Area3D's own position and scale, **without touching the shared SphereShape3D resource**
+	if gun_shot_area != null:
+		gun_shot_area.position = _mp8_area_base_pos * m
+		gun_shot_area.scale = Vector3.ONE * m
+
+	# Log only once, since 8 game instances × 8 player nodes would flood the log
+	if not _mp8_gun_logged:
+		_mp8_gun_logged = true
+		var r: float = 0.0
+		if gun_shot_area != null:
+			for c in gun_shot_area.get_children():
+				if c is CollisionShape3D and (c as CollisionShape3D).shape is SphereShape3D:
+					r = ((c as CollisionShape3D).shape as SphereShape3D).radius * m
+		print("[MP8] Manufacture Gun: gun power ×%.2f — cooldown %.2f→%.2f s (%.1f→%.1f shots/min), kill radius %.2f, sphere center forward offset %.2f m" % [
+			m, _mp8_cd_base, shoot_cooldown, 60.0 / _mp8_cd_base, 60.0 / shoot_cooldown,
+			r, absf(gun_shot_area.position.z) if gun_shot_area != null else 0.0
+		])
+
