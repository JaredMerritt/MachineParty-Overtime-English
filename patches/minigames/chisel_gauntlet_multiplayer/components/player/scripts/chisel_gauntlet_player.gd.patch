+
+# [MP8] ============ Camera positioning for 45° seats when looking at the jumbotron ============
+#
+# The problem (real screenshot notes\shots\chisel8_a_memorize_P4.png)
+#   The jumbotron is a four-sided box, and each of the four screens faces one vanilla seat (bravo 0° / alpha 90° /
+#   charlie 270° / delta 180°), with **pillars on the four corners**.
+#   The new 45° seats face right at one of those pillars — seeing half of a badly skewed screen on each side,
+#   with the squares squashed into diamonds. Not being able to read the pattern in the memorize phase = a direct disadvantage, so this is a functional issue, not a cosmetic one.
+#
+# Why only the camera can move, not the player.
+#   The player root node is at the venue center, and the player is pushed out onto a radius 8 circle by the ./Visuals offset (0,-0.037,-8),
+#   so **changing yaw means changing seats**. Actually rotating the player would overlap them with whoever is in the vanilla seat.
+#   So the body stays in its own seat and only the camera is rotated around the venue center.
+#
+# Which level to hook into (this step is key, hooking the wrong level has no effect at all).
+#   The camera hierarchy is  .  →  Node3D  →  CameraParent  →  CameraSubParent  →  Camera
+#   and the root of the `anim_camera` AnimationPlayer is **CameraParent**,
+#   whose tracks write `.:position` and `.:rotation` every frame (rotation.y is constant at 3.14159).
+#   → **writing CameraParent gets overwritten by the animation every frame** (the same pitfall that made the Escalator Pit IK target change useless, T19 detour 2).
+#   `CameraSubParent` doesn't work either. It shares an origin with CameraParent, so rotating it changes only the facing, not the position,
+#   and the screen just gets moved to the middle of the frame, still a skewed trapezoid rather than "head-on".
+#   → the only correct insertion point is **CameraParent's parent `Node3D`**. The animation doesn't touch it,
+#     and since it's under the player root node, left-multiplying a Y rotation rotates around the **venue center**,
+#     swinging the whole camera over to another bearing where it faces a screen head-on.
+#
+# How the offset is computed (derived from yaw, no hardcoded table).
+#   offset = -(yaw mod 90)
+#   The four vanilla yaws (0/180/90/-90) are all 0 mod 90 → **the offset is always 0, so ≤4 players match vanilla frame for frame**.
+#   The four new seats (45/225/135/-45) are all 45 mod 90 → all get -45°,
+#   each landing directly in front of a **different** screen (225→180, 45→0, 315→270, 135→90),
+#   exactly one per screen across all four, with no conflicts.
+
+## This seat's yaw (given by teleport_rpc)
+var _mp8_seat_yaw: float = 0.0
+## How many degrees the camera rotates around the venue center when looking at the jumbotron (always 0 for vanilla seats)
+var _mp8_view_offset_deg: float = 0.0
+## Original local transform of the camera rig (CameraParent's parent), captured only once
+var _mp8_rig_rest: Transform3D = Transform3D.IDENTITY
+var _mp8_rig_rest_taken: bool = false
+var _mp8_view_tween: Tween
+
+
+func _mp8_camera_rig() -> Node3D :
+	if camera_parent == null:
+		return null
+	return camera_parent.get_parent() as Node3D
+
+
+func _mp8_set_seat_yaw(yaw_deg: float) -> void :
+
+	_mp8_seat_yaw = yaw_deg
+
+	# Rotate back by however far it is from the nearest "vanilla bearing" (a multiple of 90°)
+	var within: float = fposmod(yaw_deg, 90.0)
+	_mp8_view_offset_deg = - within
+
+	if not is_zero_approx(_mp8_view_offset_deg):
+		print("[MP8] Chisel Gauntlet: local player is in the %.0f° seat (not a vanilla bearing), camera rotates %+.0f° when looking at the jumbotron" % [
+			fposmod(yaw_deg, 360.0), _mp8_view_offset_deg
+		])
+
+
+# Rotates the camera rig around the **venue center** to target_deg. Left-multiplying a rotation = rotating around the parent's (player root) origin,
+# and the player root sits at the venue center, so no absolute coordinates are needed (pitfall #8).
+func _mp8_apply_view_angle(deg: float) -> void :
+
+	var rig: Node3D = _mp8_camera_rig()
+	if rig == null:
+		return
+	if not _mp8_rig_rest_taken:
+		_mp8_rig_rest = rig.transform
+		_mp8_rig_rest_taken = true
+
+	rig.transform = Transform3D(Basis(Vector3.UP, deg_to_rad(deg)), Vector3.ZERO) * _mp8_rig_rest
+
+
+# Turn to it. If duration > 0 it tweens, in sync with vanilla's 1.5-second head-turn animation, so it looks like a single motion.
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Hide other players during the memorize phase (user feedback from a real-player match on 2026-08-18)
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# **Symptom** - during the memorize phase at the jumbotron, the view was filled with the back of someone else's head.
+#
+# **The root cause is a side effect of the camera positioning above**. The jumbotron is a four-sided box with each of the four screens facing a vanilla seat,
+# and pillars on the four corners. The new 45° seats face a pillar, so we **rotate the camera -45° around the venue center**
+# to face a screen head-on (45→0 / 225→180 / 315→270 / 135→90).
+# After rotating, the camera ends up right near **the vanilla seat that screen belongs to** —
+# and someone is actually sitting in that seat. So "looking at the screen" means "looking at the back of their head".
+#
+# **Why not move the camera out of the way instead** - wherever it dodges to, it's back to viewing that screen at an angle (the very reason for rotating in the first place),
+# and each of the four screens has its own seat, so dodging sideways even a little starts encroaching on the neighboring one. Geometrically there's no spot that is both head-on and unobstructed.
+#
+# **So the players simply aren't drawn**. The memorize phase only needs the pattern on the screen, and what other players look like carries no information.
+# What gets hidden is other players' third-person visuals in **this machine's** own scene tree — purely client-side, no RPC is sent,
+# it affects no game logic, and what others see on their own machines is unchanged.
+#
+# ⚠️ **Don't touch setup_local_visuals's visibility layers**. It assigns layers by `10 + index*2`,
+# so 8 seats would reach layer 26, while Godot's VisualInstance3D only has 20 layers.
+# It also hardcodes `for i in 4`. That's a separate issue (this mod has never touched it, it's byte for byte identical to vanilla),
+# so here we go around it and toggle the nodes' visible directly, rather than wading into that mess.
+#
+# ⚠️ Only record **what we hid ourselves**, and only restore those. Players eliminated mid-match already have their visuals off,
+# and a blanket `visible = true` would bring them back onto the screen out of nowhere.
+var _mp8_hidden_others: Array[Node3D] = []
+
+
+func _mp8_is_local_view() -> bool :
+	if player_presence == null:
+		return false
+	return GameManager.local_game or (multiplayer.get_unique_id() == player_presence.network_id)
+
+
+# [MP8] The other player instances in the venue — **must not go through `game_instance.players`**.
+#
+# 🩸 Reported by the user in a 6-player real match on 2026-08-19 - players were hidden in the host's view, but clients could still see the backs of heads.
+# Root cause - the `players` dictionary is filled in `spawn_players()`, and `spawn_players()` is only
+# called from `initialize()`, and `initialize()` **only runs on the server** (the comment in chisel_gauntlet.gd's
+# `_ready()` states this explicitly). So the client's copy of `players` **is always an empty dictionary** —
+# the loop never runs even once, nobody gets hidden, and no error is reported.
+#
+# Player instances are children of `PlayerSpawnNode` on **every machine** (the server calls add_child,
+# and each peer receives them via the replicator), so we just scan our own sibling nodes, which works the same on host and clients.
+func _mp8_others() -> Array :
+
+	var parent: Node = get_parent()
+	if parent == null:
+		return []
+
+	var out: Array = []
+	for c in parent.get_children():
+		if c != self and c is ChiselGauntletPlayer:
+			out.append(c)
+	return out
+
+
+func _mp8_hide_others(hide_them: bool) -> void :
+
+	# Only "me on my own machine" needs to care about what's in the camera view
+	if not _mp8_is_local_view():
+		return
+
+	if not hide_them:
+		for v in _mp8_hidden_others:
+			if is_instance_valid(v):
+				v.visible = true
+		_mp8_hidden_others.clear()
+		return
+
+	if not _mp8_hidden_others.is_empty():
+		return  # Already hidden, don't record them twice
+
+	for other in _mp8_others():
+		if not is_instance_valid(other):
+			continue
+		var v: Node3D = other.visuals_third_person
+		if v == null or not v.visible:
+			continue          # Already invisible (eliminated/disconnected) → not ours to manage, and not ours to restore
+		v.visible = false
+		_mp8_hidden_others.append(v)
+
+	if not _mp8_hidden_others.is_empty():
+		print("[MP8] Chisel Gauntlet: hid the visuals of %d other players for the memorize phase (local)" % _mp8_hidden_others.size())
+
+
+func _mp8_aim_view(target_deg: float, duration: float) -> void :
+
+	var rig: Node3D = _mp8_camera_rig()
+	if rig == null:
+		return
+	if not _mp8_rig_rest_taken:
+		_mp8_rig_rest = rig.transform
+		_mp8_rig_rest_taken = true
+
+	if _mp8_view_tween != null and _mp8_view_tween.is_valid():
+		_mp8_view_tween.kill()
+
+	# Vanilla seat offset is always 0. Here from/to are both 0, so the tween doesn't move anything and behavior matches vanilla
+	var from: float = rad_to_deg((_mp8_rig_rest.affine_inverse() * rig.transform).basis.get_euler().y)
+	if is_zero_approx(target_deg) and is_zero_approx(from):
+		return
+
+	if duration <= 0.0:
+		_mp8_apply_view_angle(target_deg)
+		return
+
+	_mp8_view_tween = create_tween()
+	_mp8_view_tween.tween_method(_mp8_apply_view_angle, from, target_deg, duration
+	).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_SINE)
