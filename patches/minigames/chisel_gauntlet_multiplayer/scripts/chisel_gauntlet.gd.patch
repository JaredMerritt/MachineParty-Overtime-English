+# [MP8] ================ Chisel Gauntlet (ChiselGauntlet) 8-player adaptation ================
+#
+# Scene facts from reverse engineering (measured by probe17 dumping the stock PCK, not guesses).
+#
+# 1. **All players share the same spawn point**. In spawn_players(),
+#    `teleport_rpc(player_spawn_node.global_position, Vector3(0, player_rotations[counter], 0))`,
+#    PlayerSpawnNode is at the origin, and **players are told apart only by yaw**. The ./Visuals local offset in the player scene
+#    (0, -0.037, -8.0) pushes players out onto a circle of radius 8 m → a seat = an angle, not a coordinate.
+#    **So adding seats needs no new spawn point geometry, extending player_rotations is enough.**
+#
+# 2. **Desk colliders** - `Colliders/StaticBody3D{,2,3,4}`, all four at the origin and differing only in yaw,
+#    with child `collision shape desk` at local offset (0.037, 0.822, 4.613).
+#    → clone one and rotate it around Y, and that's the desk collider for a new seat.
+#
+# 3. **The visible desks are not one single piece** (this contradicts the initial diagnostic finding, so it must be written down).
+#    The single `Geometry/environment` piece is a **`visible = false` greybox**, not what players actually see.
+#    The real art is in `./chisel gauntlet art2`, where
+#    `walls/control panel alpha|bravo|charlie|delta` are **four separate MeshInstance3D nodes**,
+#    all at the origin like the colliders, differing only in yaw. → the visible desks can also be cloned whole + rotated.
+#    **Lesson - before judging "can it be split", first confirm the mesh you're looking at is actually on screen.**
+#
+# All pairing (collider ↔ seat, visible piece ↔ seat) **is always done by spatial angle, never by index arithmetic**
+# — the Junk Platform flipped-pairing pitfall (HANDOFF pitfall #5 / T18) tripped over exactly that.
+
+const MP8_MAX_SEATS: int = 8
+
+## Visible art pieces that follow the seats (under `chisel gauntlet art2/walls`).
+## Four copies of the same thing, each rotated 90° from the others, so just clone them whole + rotate around Y to the new direction.
+## ⚠️ `control panel hole mesh` / `control panel hole wires` are single pieces at the center of the venue.
+## The names look similar but they **don't follow the seats**, so they must never go in this table.
+const MP8_SEAT_ART_NODES: Array[String] = [
+	"control panel alpha", "control panel bravo",
+	"control panel charlie", "control panel delta",
+]
+
+## The signs above the seats (four of them, alpha/bravo/charlie/delta). Cloned along with the desks by default.
+const MP8_SEAT_SIGN_NODES: Array[String] = [
+	"sign_alpha", "sign_bravo", "sign_charlie", "sign_delta",
+]
+
+var _mp8_seat_count: int = 0
+## Clone **visible** desks for the new seats. User decision 2026-08-16 - visible desks are wanted, so it's on by default.
+## `mp8chiselnodesk` turns it off (falls back to colliders only, for comparison).
+var _mp8_clone_desk_art: bool = true
+## mp8chiselnosign - clone the visible desks without the signs
+var _mp8_clone_sign: bool = true
+
+
+func _mp8_setup_seats() -> void :
+
+	var args := NetworkManager.mp8_args()
+
+	_mp8_clone_desk_art = not args.has("mp8chiselnodesk")
+	_mp8_clone_sign = not args.has("mp8chiselnosign")
+
+	# ⚠️ Log the **real runtime value** before touching it (pitfall #3 - an @export's real value comes from the scene,
+	# and the default in the script is misleading. This project has already been burned by this twice).
+	print("[MP8] Chisel Gauntlet: runtime player_rotations (real value) = %s, %d entries total" % [
+		str(player_rotations), player_rotations.size()
+	])
+
+	var want: int = clampi(PlayerManager.player_presences.size(), 0, MP8_MAX_SEATS)
+	if want > player_rotations.size():
+		push_warning("[MP8] Chisel Gauntlet: %d players but player_rotations only has %d entries, not enough seats" % [
+			want, player_rotations.size()
+		])
+		want = player_rotations.size()
+	_mp8_seat_count = want
+
+	# ---- Shotgun scan order - sorted by ascending angle, no hand-written indices ----
+	_mp8_rebuild_shotgun_order(want)
+
+	if args.has("mp8noexpand"):
+		print("[MP8] Chisel Gauntlet: mp8noexpand, not adding any seat furniture (pure vanilla control group)")
+		return
+
+	if want <= 4:
+		print("[MP8] Chisel Gauntlet: %d players, using the vanilla 4 sets of seat furniture, unchanged" % want)
+		return
+
+	_mp8_expand_seats(want)
+
+
+# Vanilla's [0, 2, 1, 3] is just "ascending by angle 0→90→180→270", written out as index literals.
+# This turns it back into an algorithm. With 4 players the result matches vanilla value for value, and with 8 it automatically gives [0,4,2,6,1,5,3,7].
+func _mp8_rebuild_shotgun_order(seat_count: int) -> void :
+
+	var vanilla := shotgun_check_order.duplicate()
+
+	var order: Array[int] = []
+	for i in seat_count:
+		order.append(i)
+	order.sort_custom(func(a, b):
+		return _mp8_wrap360(player_rotations[a]) < _mp8_wrap360(player_rotations[b])
+	)
+	shotgun_check_order = order
+
+	var parts := PackedStringArray()
+	for i in order:
+		parts.append("%d(%.0f°)" % [i, _mp8_wrap360(player_rotations[i])])
+	print("[MP8] Chisel Gauntlet: shotgun scan order %s → %s   %s" % [
+		str(vanilla), str(order), ", ".join(parts)
+	])
+
+	if seat_count == 4 and order != vanilla:
+		push_warning("[MP8] Chisel Gauntlet: with 4 players the scan order differs from vanilla (%s vs %s), please check" % [
+			str(order), str(vanilla)
+		])
+
+
+func _mp8_expand_seats(seat_count: int) -> void :
+
+	# ---- 1. Seat bearings - computed from the real ./Visuals offset in the player scene, not a hardcoded 8.0/180 ----
+	# (The offset is the real runtime value read from the PackedScene, so if the art ever changes, this follows automatically.)
+	var visuals_offset: Vector3 = _mp8_player_visuals_offset()
+	if is_zero_approx(Vector2(visuals_offset.x, visuals_offset.z).length()):
+		push_warning("[MP8] Chisel Gauntlet: couldn't measure the horizontal offset of the player's Visuals, giving up on adding seat furniture")
+		return
+	print("[MP8] Chisel Gauntlet: player Visuals local offset = %s (radius %.2f m)" % [
+		str(visuals_offset), Vector2(visuals_offset.x, visuals_offset.z).length()
+	])
+
+	var seat_dir: Array[float] = []
+	for i in seat_count:
+		seat_dir.append(_mp8_seat_direction(visuals_offset, player_rotations[i]))
+
+	# ---- 2. First verify "new seats = vanilla seats rotated as a whole by MP8_SEAT_STEP degrees" ----
+	# The whole cloning strategy rests on this. Only if it holds is it safe to rotate whole groups, otherwise it has to fall back to pairing piece by piece.
+	if not _mp8_verify_rotational_layout(seat_dir):
+		push_warning("[MP8] Chisel Gauntlet: seats aren't 'vanilla rotated as a whole by %.0f°', giving up on adding seat furniture" % MP8_SEAT_STEP)
+		return
+
+	# ---- 3. Desk colliders ----
+	var colliders: Node3D = get_node_or_null("Colliders") as Node3D
+	if colliders != null:
+		var desks: Array[Node3D] = []
+		for c in colliders.get_children():
+			if c is StaticBody3D and _mp8_find_child_named(c, "desk") != null:
+				desks.append(c)
+		_mp8_clone_group_rotated(colliders, desks, "desk colliders")
+	else:
+		push_warning("[MP8] Chisel Gauntlet: Colliders node not found, desk colliders not added")
+
+	# ---- 4. Visible desks + signs ----
+	var walls: Node3D = get_node_or_null("chisel gauntlet art2/walls") as Node3D
+	if walls == null:
+		push_warning("[MP8] Chisel Gauntlet: 'chisel gauntlet art2/walls' not found, skipping all visible pieces")
+		return
+
+	if not _mp8_clone_desk_art:
+		print("[MP8] Chisel Gauntlet: new seats only have desk colliders, **no visible desks** (mp8chiselnodesk is active)")
+		return
+
+	var groups: Array = [MP8_SEAT_ART_NODES]
+	var labels: Array = ["visible desks"]
+	if _mp8_clone_sign:
+		groups.append(MP8_SEAT_SIGN_NODES)
+		labels.append("seat signs")
+
+	for g in groups.size():
+		var srcs: Array[Node3D] = []
+		for nm in groups[g]:
+			var n: Node3D = walls.get_node_or_null(nm) as Node3D
+			if n == null:
+				push_warning("[MP8] Chisel Gauntlet: visible piece '%s' is missing, skipping" % nm)
+				continue
+			srcs.append(n)
+		_mp8_clone_group_rotated(walls, srcs, labels[g])
+
+
+## Angle step of the new seats relative to the vanilla seats. Eight seats = the four seats, each with an extra seat in between.
+const MP8_SEAT_STEP: float = 45.0
+
+
+# Verifies "new seats = the four vanilla seats rotated as a whole by MP8_SEAT_STEP degrees".
+#
+# This is the **only premise** of the whole-group rotation strategy, so it's checked explicitly rather than assumed.
+# Every new seat must have a counterpart among the vanilla seats that is "exactly MP8_SEAT_STEP degrees apart",
+# and the mapping must be one to one (two new seats can't claim the same vanilla seat).
+func _mp8_verify_rotational_layout(seat_dir: Array[float]) -> bool :
+
+	if seat_dir.size() <= 4:
+		return true
+
+	var used: Array[int] = []
+	for i in range(4, seat_dir.size()):
+		var found: int = -1
+		for j in 4:
+			if absf(_mp8_angle_delta(seat_dir[j], seat_dir[i]) - MP8_SEAT_STEP) < 1.0:
+				found = j
+				break
+		if found < 0 or used.has(found):
+			return false
+		used.append(found)
+	return true
+
+
+# Clones a whole group of "one per seat" nodes, rotating each copy around the venue center by MP8_SEAT_STEP degrees.
+#
+# ⚠️ **It does not decide "which seat this copy serves"** — that's exactly where the previous version fell over.
+# It identified seats by "the bearing of the mesh AABB center", but the four `control panel *` meshes are off-center,
+# so their bounding box center is **off by 33.2°** from the real seat axis (the signs and jumbotron screens aren't off, so only the desks came out wrong).
+# Three tests tried in practice. The AABB center angle is accurate for signs/screens but 33° off for desks. The node origin angles are all the same value
+# (these pieces all sit at the origin, differing only in yaw) → neither is reliable.
+#
+# The right approach is to **sidestep the problem**. The four vanilla copies already cover the four vanilla seats,
+# so rotating those four **as a group** by 45° covers the four new seats exactly — no need to work out which goes with which.
+# This is also the lobby layout lesson (pitfall #8 - don't compute coordinates yourself, clone the originals and translate/rotate them as a whole).
+#
+# The cost is that new seat desks are **added all four at once**, so with 5~7 players there will be empty desks nobody sits at.
+# That doesn't break immersion in this game — desks already stay in place after players are eliminated.
+func _mp8_clone_group_rotated(
+	parent: Node3D,
+	sources: Array[Node3D],
+	label: String
+) -> void :
+
+	if sources.is_empty():
+		push_warning("[MP8] Chisel Gauntlet: no %s found at all, skipping" % label)
+		return
+
+	# Self-check - these four must be "the same thing rotated 90°" for whole-group rotation to make sense.
+	# The test uses each node's own yaw (orientation), not the mesh center — see the section above.
+	var yaws: Array[float] = []
+	for s in sources:
+		yaws.append(_mp8_wrap360(rad_to_deg(s.global_transform.basis.get_euler().y)))
+	var sorted_yaws := yaws.duplicate()
+	sorted_yaws.sort()
+	var even: bool = sources.size() == 4
+	if even:
+		for i in 4:
+			if absf(_mp8_angle_delta(sorted_yaws[i], sorted_yaws[(i + 1) % 4]) - 90.0) > 1.0:
+				even = false
+				break
+
+	var wire := PackedStringArray()
+	for i in sources.size():
+		wire.append("%s(yaw %.0f°)" % [String(sources[i].name), yaws[i]])
+	print("[MP8-WIRE] Chisel Gauntlet: %s, %d in vanilla — %s   %s" % [
+		label, sources.size(), ", ".join(wire),
+		("✓four copies 90° apart" if even else "❌not four evenly spaced copies, whole-group rotation may not hold")
+	])
+	if not even:
+		push_warning("[MP8] Chisel Gauntlet: %s are not 'four copies 90° apart', still rotating the whole group by %.0f°, please check visually" % [
+			label, MP8_SEAT_STEP
+		])
+
+	var added := PackedStringArray()
+	for s in sources:
+		var dup: Node3D = s.duplicate()
+		dup.name = "%s_MP8" % String(s.name)
+		parent.add_child(dup)
+		_mp8_rotate_about_center(dup, s, MP8_SEAT_STEP)
+		added.append("%s→%s" % [String(s.name), String(dup.name)])
+
+	print("[MP8] Chisel Gauntlet: %s cloned as a group, %d copies, each rotated %+.0f° — %s" % [
+		label, added.size(), MP8_SEAT_STEP, ", ".join(added)
+	])
+
+
+# Reference frame of the venue center.
+#
+# ⚠️⚠️ **`Minigame extends Node`, not Node3D** — this script's `self` has **no**
+# `global_transform`/`global_position`. The first version used them directly here and in _mp8_node_direction
+# (writing `global_transform`), and `tools\build.ps1` **still compiled fine**
+# (gdre doesn't resolve base class identifiers), but as soon as the game loaded it hit
+#   `Parse Error: Identifier "global_transform" not declared in the current scope`
+#   → the whole script fails to load → the chisel_gauntlet node has no script → the three exported Array[Node]
+#     can't be hooked up (`Failed to get property 'speakers_switches'`) → the minigame never starts,
+#     and the surface symptom is "stuck in SessionIntro", which has nothing at all to do with 4→8.
+# **Lesson - compiling ≠ running. The only real test is that the log has no `Parse Error`.**
+#
+# Uses `PlayerSpawnNode` as the reference. It's a Node3D, and **by definition it's the center of the seat circle**
+# (spawn_players() teleports everyone to its global_position and separates them by yaw).
+# That's more fitting than "the minigame root node", and it doesn't assume the venue sits at the world origin.
+func _mp8_field_transform() -> Transform3D :
+	if player_spawn_node != null:
+		return player_spawn_node.global_transform
+	return Transform3D.IDENTITY
+
+
+# Rotates dup by delta degrees around the Y axis of the **venue center**.
+#
+# ⚠️ You can't just call `dup.rotate_y()`, since that rotates around the node's **own** origin.
+# So a Y rotation is always left-multiplied in venue center space.
+func _mp8_rotate_about_center(dup: Node3D, src: Node3D, delta_deg: float) -> void :
+	var base: Transform3D = _mp8_field_transform()
+	var rot := Transform3D(Basis(Vector3.UP, deg_to_rad(delta_deg)), Vector3.ZERO)
+	dup.global_transform = base * rot * base.affine_inverse() * src.global_transform
+
+
+# A node's bearing within the venue (degrees, 0 = the root node's +Z direction).
+# Mesh pieces use **the mesh AABB center** instead of the node origin — these art pieces all sit at the origin
+# differing only in yaw, so the node origin comes out as (0,0) and its bearing is meaningless (the art baked the real placement into the mesh).
+func _mp8_node_direction(n: Node3D) -> float :
+
+	if n == null:
+		return 0.0
+
+	var p: Vector3 = n.global_position
+	var m = n.get("mesh")
+	if m != null and m is Mesh:
+		var ab: AABB = (m as Mesh).get_aabb()
+		p = n.global_transform * (ab.position + ab.size * 0.5)
+
+	var local: Vector3 = _mp8_field_transform().affine_inverse() * p
+	return _mp8_wrap360(rad_to_deg(atan2(local.x, local.z)))
+
+
+# A seat's (= one yaw) bearing within the venue. The player root node sits at the origin and only rotates in yaw,
+# and what actually pushes the player outward is the ./Visuals local offset, so the bearing = the direction of that offset after rotating it by yaw.
+func _mp8_seat_direction(visuals_offset: Vector3, yaw_deg: float) -> float :
+	var v: Vector3 = Basis(Vector3.UP, deg_to_rad(yaw_deg)) * visuals_offset
+	return _mp8_wrap360(rad_to_deg(atan2(v.x, v.z)))
+
+
+# Measures the ./Visuals local offset from the player scene (PackedScene, read only, not instantiated).
+# 8.0 isn't hardcoded, per the rule "real values can only be read from data, don't treat memory as the truth".
+func _mp8_player_visuals_offset() -> Vector3 :
+
+	var st: SceneState = player_scene.get_state()
+	for i in st.get_node_count():
+		var path: String = String(st.get_node_path(i)).trim_prefix("./")
+		if path != "Visuals":
+			continue
+		for k in st.get_node_property_count(i):
+			if String(st.get_node_property_name(i, k)) != "transform":
+				continue
+			var v = st.get_node_property_value(i, k)
+			if v is Transform3D:
+				return (v as Transform3D).origin
+	return Vector3.ZERO
+
+
+func _mp8_find_child_named(n: Node, needle: String) -> Node3D :
+	for c in n.get_children():
+		if c is Node3D and String(c.name).to_lower().contains(needle):
+			return c
+	return null
+
+
+func _mp8_wrap360(a: float) -> float :
+	return fposmod(a, 360.0)
+
+
+## Shortest angle between two bearings (absolute value, 0~180)
+func _mp8_angle_gap(a: float, b: float) -> float :
+	return absf(_mp8_angle_delta(a, b))
+
+
+## How many degrees to turn from a to b (signed, -180~180)
+func _mp8_angle_delta(a: float, b: float) -> float :
+	return rad_to_deg(angle_difference(deg_to_rad(a), deg_to_rad(b)))
+
+
+# [MP8] Self-screenshots (copied from Junk Platform / Escalator Pit) - the game saves PNGs itself, no screen permissions needed.
+# ⚠️ Must go through an RPC broadcast. The call sites (generate_random_cube_instructions / start_round_timer)
+# both come after `if not multiplayer.is_server(): return`, so calling it directly means only the host saves screenshots,
+# and "does the new seat have a desk" is exactly what has to be seen from the new seat player's own first-person view.
+@rpc("authority", "call_local", "reliable")
+func mp8_shot_rpc(tag: String, delay: float) -> void :
+
+	if not NetworkManager.mp8_args().has("mp8shot"):
+		return
+
+	await get_tree().create_timer(delay, false).timeout
+	if not is_inside_tree():
+		return
+	await RenderingServer.frame_post_draw
+
+	var me: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var who: String = "p%d" % me
+	if PlayerManager.player_presences.has(me):
+		who = String(PlayerManager.player_presences[me].network_name)
+
+	var img: Image = get_viewport().get_texture().get_image()
+	if img != null:
+		# Both parts of the name come from outside (the host's tag, the player's name), so strip path characters first
+		img.save_png("user://mp8_chisel_%s_%s.png" % [NetworkManager.mp8_file_text(tag), NetworkManager.mp8_file_text(who)])
+
+
+# [MP8] Read-only log - at results time, logs placement / player name / score, **without changing a single point**.
+# Chisel Gauntlet is the only one of all 15 minigames that can produce negative scores (scoring family C), and the actual 8-player numbers
+# need real test data before any tuning is discussed (per the work order the user set, scoring only comes after the adaptation passes acceptance).
+func _mp8_log_scores() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var rows: Array = []
+	for id in player_scores.keys():
+		var nm: String = "id%d" % id
+		if PlayerManager.player_presences.has(id):
+			nm = String(PlayerManager.player_presences[id].network_name)
+		rows.append({"name": nm, "score": player_scores[id]})
+	rows.sort_custom(func(a, b): return a["score"] > b["score"])
+
+	var parts := PackedStringArray()
+	for i in rows.size():
+		parts.append("#%d %s %d pts" % [i + 1, rows[i]["name"], rows[i]["score"]])
+	print("[MP8] Chisel Gauntlet results (%d players present / starting score %d): %s" % [
+		player_count, player_count, " / ".join(parts)
+	])
+
+
 func _ready() -> void :
 	super._ready()
 
+	# [MP8] Seat expansion must run before spawn_players(), and **must run on every machine**
+	# (desks are local scene nodes on each machine and aren't network synced).
+	# initialize() only runs on the server, so this must never go in there.
+	_mp8_setup_seats()
+
