diff --git a/minigames/knife_at_the_office/components/countdown_handler/countdown_handler.gd b/minigames/knife_at_the_office/components/countdown_handler/countdown_handler.gd
--- a/minigames/knife_at_the_office/components/countdown_handler/countdown_handler.gd
+++ b/minigames/knife_at_the_office/components/countdown_handler/countdown_handler.gd
@@ -19,8 +19,33 @@ var active: bool = false
 
 signal expired()
 
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Knife at the Office - alive indicators 4 → 8 (2026-08-17)
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# `alive_indicator_icons` is **4 TextureRects** baked into the scene (measured by probe55),
+# while the value fed in is the "number of uninfected players", via
+#   set_active_rpc(...)            up to 7 in an 8-player match
+#   update_alive_indicator_rpc(...) same as above
+# The two `alive_indicator_icons[i].visible = true` spots below **index directly** → out of bounds in an 8-player match.
+# This is exactly the pattern from pitfall #13 (it's how the scoreboard crashed before).
+#
+# The fix is to duplicate the first icon and put the copies into **the same parent container** (an HBoxContainer that lays itself out),
+# until there are MP8_ICON_TARGET of them. TextureRect has no @export pointing at child nodes,
+# so the "re-resolve @export after duplicating" routine from pitfall #14 does not apply (that one is for lobby display slots/scoreboard).
+# It also **creates no new audio sources** (pitfall #14 showed in practice that doing so hangs the flow) — these are plain UI nodes only.
+#
+# ⚠️ One thing not yet verified. If the "show"/"hide" tracks in `anim_alive_indicator_fader`
+# **target the original 4 icons one by one** (instead of animating the parent container), the 4 new ones won't fade in and out with them.
+# The scoreboard hit the same kind of issue in T15. Keep an eye on this during in-game acceptance. When the hunt phase starts in an 8-player match,
+# check whether the last 4 indicators appear/disappear along with the rest. If they really don't, switch to setting visible directly in code.
+const MP8_ICON_TARGET: int = 8
+
+
 func _ready() -> void :
 
+	_mp8_extend_alive_indicators()
+
 	countdown_label.visible = false
 	countdown_background.visible = false
 	time_remaining = countdown_time
@@ -31,6 +56,34 @@ func _ready() -> void :
 	timer.timeout.connect(_on_timer_tick)
 
 
+# [MP8] Pad the indicators up to 8. The vanilla 4 stay byte-for-byte untouched, new ones are only appended after them.
+func _mp8_extend_alive_indicators() -> void :
+
+	var have: int = alive_indicator_icons.size()
+	if have == 0:
+		push_warning("[MP8] Knife at the Office: alive indicator array is empty, can't pad it")
+		return
+	if have >= MP8_ICON_TARGET:
+		return
+
+	var src: TextureRect = alive_indicator_icons[0]
+	if src == null or src.get_parent() == null:
+		push_warning("[MP8] Knife at the Office: alive indicator has no parent container, can't pad it")
+		return
+
+	var parent: Node = src.get_parent()
+
+	for i in range(have, MP8_ICON_TARGET):
+		var dup: TextureRect = src.duplicate()
+		dup.name = "MP8AliveIndicator%d" % i
+		parent.add_child(dup)
+		dup.visible = false
+		alive_indicator_icons.append(dup)
+
+	print("[MP8] Knife at the Office: alive indicators %d → %d (parent container %s)" % [
+		have, alive_indicator_icons.size(), parent.name])
+
+
 
 @rpc("any_peer", "call_local", "reliable")
 func set_active_rpc(num_of_players: int = 1):
@@ -68,7 +121,12 @@ func _on_timer_tick():
 func setup_alive_indicator(num_of_alive_players: int):
 	for i in alive_indicator_icons:
 		i.visible = false
-	for i in num_of_alive_players:
+	# [MP8] Fallback - normally _mp8_extend_alive_indicators() has already padded this to 8.
+	# If that somehow failed, vanilla uses a raw index here → out of bounds. Clamp it and report it rather than staying silent.
+	if num_of_alive_players > alive_indicator_icons.size():
+		push_warning("[MP8] Knife at the Office: need to light %d alive indicators but only have %d (did the padding not run?)" % [
+			num_of_alive_players, alive_indicator_icons.size()])
+	for i in mini(num_of_alive_players, alive_indicator_icons.size()):
 		alive_indicator_icons[i].visible = true
 
 
@@ -87,6 +145,7 @@ func update_alive_indicator_rpc(num_of_alive_players: int):
 	await get_tree().create_timer(0.16, false).timeout
 	for i in alive_indicator_icons:
 		i.visible = false
-	for i in num_of_alive_players:
+	# [MP8] Same as above, clamp the index
+	for i in mini(num_of_alive_players, alive_indicator_icons.size()):
 		alive_indicator_icons[i].visible = true
 	anim_alive_indicator_fader.play("show")
