+# ═══════ [MP8] 2026-08-19 - call_remote → call_local ═══════
+#
+# Goes with the change in `knife_at_the_office.gd` that turned the broadcast into `rpc_id(_network_id, ...)`.
+# Once it's sent to a specific peer, if this were still `call_remote` then
+#   the host searches a cabinet itself → `rpc_id(1, ...)` targets itself → blocked by call_remote
+#   → **neither side runs it, and the host can never get the syringe**.
+# With call_local it runs exactly once in both the host and client cases.
+@rpc("any_peer", "call_local", "reliable")
+func search_result_rpc(_found_item: bool, _equip_item: bool = true):
 
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+
 	if _found_item:
