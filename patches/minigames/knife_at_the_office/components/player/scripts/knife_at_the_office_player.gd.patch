+		# The parameter has a default value, so leaving it out gives vanilla behavior.
+		set_has_item_rpc.rpc(true, _equip_item)
 
 	stop_searching()
 
+# [MP8] Infected move speed multiplier (user decision 2026-08-17 - brought down to 1.05 for 5+ players).
+# It must go through an RPC broadcast — movement is computed locally on each peer (`speed *= infected_move_speed_multiplier`),
+# so if this value only changes on the server, infected players on everyone else's side still run at 1.25.
+# With ≤4 players the game side never sends this RPC, and the scene's original @export value stays unchanged.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_set_infected_speed_rpc(_multiplier: float):
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not (NetworkManager.mp8_finite(_multiplier, 10.0)):
+		return
+
+	infected_move_speed_multiplier = _multiplier
+
