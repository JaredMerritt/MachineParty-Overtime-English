+# [MP8] After a move, also teleport the matching player there so their position can be checked right away (only the server sends it, otherwise all 8 machines would each broadcast it)
+func _mp8_edit_sync_player(index: int) -> void :
+
+	if not multiplayer.is_server():
+		return
+	if index >= _mp8_spawn_markers.size():
+		return
+
+	var list: Array = players.values()
+	if index >= list.size():
+		return
+
+	var node3d: Node3D = _mp8_spawn_markers[index]
+	list[index].teleport_rpc.rpc(node3d.global_position, node3d.global_rotation)
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on:
+		return
+	if not (event is InputEventKey) or not event.pressed or event.echo:
+		return
+
+	var key: int = (event as InputEventKey).keycode
+
+	if key >= KEY_1 and key <= KEY_8:
+		var want_sel: int = key - KEY_1
+		if want_sel < _mp8_spawn_markers.size():
+			_mp8_edit_sel = want_sel
+			_mp8_edit_refresh()
+		return
+
+	if _mp8_edit_sel >= _mp8_spawn_markers.size():
+		return
+	var sel: Node3D = _mp8_spawn_markers[_mp8_edit_sel]
+
+	match key:
+		KEY_I: sel.position.z -= _mp8_edit_step
+		KEY_K: sel.position.z += _mp8_edit_step
+		KEY_J: sel.position.x -= _mp8_edit_step
+		KEY_L: sel.position.x += _mp8_edit_step
+		KEY_U: sel.rotation.y += deg_to_rad(15.0)
+		KEY_O: sel.rotation.y -= deg_to_rad(15.0)
+		KEY_M:
+			_mp8_edit_step = (
+				1.0 if is_equal_approx(_mp8_edit_step, 0.5)
+				else (0.1 if is_equal_approx(_mp8_edit_step, 1.0) else 0.5)
+			)
+		KEY_0:
+			_mp8_save_spawn_file()
+			return
+		KEY_N:
+			_mp8_edit_report()
+			return
+		_:
+			return
+
+	_mp8_edit_sync_player(_mp8_edit_sel)
+	_mp8_edit_refresh()
+
+
+# [MP8] Collect the scene's **actual** searchable containers into `searchables`.
+# `searchables` is an array vanilla declared but never filled (and its type happens to fit), so it gets put to use here.
+# The hard-coded 26 isn't used (it's a design-intent value that doesn't match the actual scene, where probe70 counted 36),
+# and detection is still mainly by type. Only the original #5 / #6, confirmed unreachable in-game, are excluded by stable full path.
+func _mp8_collect_searchables() -> void :
+
+	if mp8_searchables_collected:
+		return
+	mp8_searchables_collected = true
+
+	searchables.clear()
+	var stack: Array = [self]
+	var disabled_count: int = 0
+	var raw_index: int = 0
+	while not stack.is_empty():
+		var node: Node = stack.pop_back()
+		if node is KnifeAtTheOfficeSearchable:
+			var searchable := node as KnifeAtTheOfficeSearchable
+			# Debug markers keep showing the raw pre-filter numbers. After disabling, #5/#6 will be missing on screen,
+			# rather than the original #7/#8 shifting forward and posing as a new #5/#6.
+			searchable.set_meta(&"mp8_raw_searchable_index", raw_index)
+			raw_index += 1
+			if _mp8_disable_searchable_if_needed(searchable):
+				disabled_count += 1
+			else:
+				searchables.append(searchable)
+		for c in node.get_children():
+			stack.append(c)
+
+	if disabled_count != MP8_DISABLED_SEARCHABLE_PATHS.size():
+		push_warning("[MP8] Knife at the Office: expected to disable %d unreachable containers but matched %d; the scene paths may have changed" % [
+			MP8_DISABLED_SEARCHABLE_PATHS.size(), disabled_count])
+	else:
+		print("[MP8] Knife at the Office: unreachable containers #5/#6 disabled; %d valid containers" % searchables.size())
+
+
+func _mp8_disable_searchable_if_needed(node: KnifeAtTheOfficeSearchable) -> bool :
+
+	var relative_path: String = String(get_path_to(node))
+	if not MP8_DISABLED_SEARCHABLE_PATHS.has(relative_path):
+		return false
+
+	# The player interaction area finds Searchables via area_entered. Clearing all four means it can no longer be found
+	# and no longer actively detects anything either. The visual subtree is untouched, so the room's set dressing stays as it was.
+	node.monitoring = false
+	node.monitorable = false
+	node.collision_layer = 0
+	node.collision_mask = 0
+	return true
+
+
+# [MP8] Syringes are **actually placed inside containers** (the container model the user asked for on 2026-08-17).
+#
+# Vanilla uses a counter model. When `containers_searched == guaranteed_search_result`,
+# whoever is searching gets it — the syringe has no location, and containers don't know whether they hold anything
+# (nothing in vanilla ever calls `Searchable.has_item` / `set_has_item_rpc`).
+# Now the syringe is put into a random container at match start with `has_item = true`, and it only counts as found when that cabinet is opened.
+#
+# This also fixes a vanilla hang. Vanilla computes the appearance position as `round(26 * players/4) - random`,
+# which can reach 52 in an 8-player match, while the map only has 38 containers and they're **single-use** → about 52% of matches never find the syringe,
+# the hunt phase never starts, the countdown never starts, check_game_end never holds → **the whole match hangs**.
+# The container model doesn't have this problem. The syringe is in some cabinet, and the worst case is just waiting for it to be opened.
+#
+# Vanilla's **pacing lower bound** is kept. No syringe before 34% of the map's search count (vanilla's lower bound for 4-player matches).
+# If the cabinet hiding it is opened before that, it's treated as "not here yet" and moved according to the teleport rules.
+# There's no upper bound — under the container model the upper bound comes naturally (the cabinet gets opened sooner or later).
+func _mp8_setup_syringes() -> void :
+
+	var args := NetworkManager.mp8_args()
+	mp8_player_count = PlayerManager.player_presences.size()
+	mp8_syringes_found = 0
+	mp8_relocations = 0
+	mp8_syringe_containers.clear()
+	mp8_syringe_holders.clear()
+
+	_mp8_collect_searchables()
+	var total: int = searchables.size()
+
+	if args.has("mp8noexpand"):
+		mp8_syringes_needed = 1
+		print("[MP8] Knife at the Office: mp8noexpand, syringe keeps the vanilla counter model (pure vanilla control group, ⚠️ must be used with 4 players)")
+		return
+
+	if total <= 0:
+		push_warning("[MP8] Knife at the Office: not a single searchable container counted, syringe falls back to the vanilla counter model")
+		return
+
+	# ≤4 players get vanilla's single syringe. ⚠️ They still switch to the container model — vanilla's counter model doesn't hang with 4 players,
+	# but having both models side by side would mean writing the teleport rules below twice. With 4 players the container model feels the same as vanilla,
+	# both being "appears somewhere past the 34% mark of searches", only the decision moves from a counter to a cabinet.
+	mp8_syringes_needed = 1 if mp8_player_count <= 4 else 2
+
+	# At match start put the syringes into random containers (really writing has_item, via that vanilla RPC nobody ever used)
+	var pool: Array = searchables.duplicate()
+	pool.shuffle()
+	for i in mini(mp8_syringes_needed, pool.size()):
+		var c = pool[i]
+		c.set_has_item_rpc.rpc(true)
+		mp8_syringe_containers.append(c)
+
+	var names := PackedStringArray()
+	for c in mp8_syringe_containers:
+		names.append(String(c.name))
+
+	print("[MP8] Knife at the Office: %d players — %d containers, %d syringes placed in [%s] (no pacing lower bound, found as soon as opened)" % [
+		mp8_player_count, total, mp8_syringes_needed, ", ".join(names)])
+
+
+# [MP8] Syringe teleport (rules set by the user on 2026-08-17).
+#
+# The rule is that **someone already infected may not get their hands on a syringe again.** They can still search (not blocked),
+# but when they open a cabinet holding a syringe, the syringe **immediately moves to another container that hasn't been searched yet**.
+#
+# When picking the new cabinet, **ones far from the triggering player are preferred** (only a real container model can do this, a counter model can't express it).
+#
+# Fallback (specifically requested by the user) - **when no unsearched containers are left, pick a random one, reset its state and put the syringe in it.**
+# Without this, once an infected player opens the last container there's nowhere left to put the syringe → another hang.
+func _mp8_relocate_syringe(from_container, away_from: Vector3, reason: String) -> void :
+
+	if is_instance_valid(from_container):
+		from_container.set_has_item_rpc.rpc(false)
+		mp8_syringe_containers.erase(from_container)
+
+	# Candidates - not yet searched, not the one just opened, and not already holding a syringe
+	var candidates: Array = []
+	for s in searchables:
+		if not is_instance_valid(s):
+			continue
+		if s == from_container or s.searched or mp8_syringe_containers.has(s):
+			continue
+		candidates.append(s)
+
+	mp8_relocations += 1
+
+	if candidates.is_empty():
+
+		# ═══════════════════════════════════════════════════════════════════
+		# [MP8] 🩸 When no unsearched containers are left, **cabinets are no longer reset** — that was the root cause of "can't find the second syringe"
+		# ═══════════════════════════════════════════════════════════════════
+		#
+		# The old approach picked a random searched cabinet, called `set_searched_rpc(false)` and put the syringe back in.
+		# It looked reasonable, but it actually hid the syringe in a **cabinet that stays visibly open forever**.
+		#
+		#   `set_searched_rpc()` in `searchable.gd` only has
+		#       `if searched && searchable_visuals != null: open_container()`
+		#   — **there is no branch that closes it again**, and `Searchable_Visuals` only has `open_container()` too,
+		#   the drawer is tweened out and there's no method at all to bring it back.
+		#
+		# So even though the `searched` flag was cleared, the cabinet was still wide open, and the highlight was still red
+		# (`get_highlight_color()` reads searched, so that one actually did turn green,
+		#  but whether the drawer is open is the visual cue players really go by).
+		# Players glance at it, think "this one's been opened" and walk off — the syringe vanishes into thin air and the second one can never be found that match.
+		#
+		# The new approach is to **skip the teleport and just let this infected player take it**.
+		# The reasoning is that reaching this point means all 38 cabinets on the map have been searched and the game is already wrapping up,
+		# so the purpose of the "infected players can't touch syringes" rule (keeping the suspense) no longer exists,
+		# and **letting the match end** has higher priority — the lesson from the vanilla hang is item 3 at the top of this file.
+		# Normal matches never reach this path (teleports are rare anyway now that the pacing lower bound is gone), it's purely a fallback.
+		mp8_relocations -= 1   # No real teleport happened this time, so don't count it
+		_mp8_debug_last = "%s → no unsearched containers left, counted as found as an exception" % reason
+		_mp8_debug_refresh()
+		print("[MP8] Knife at the Office: ⚠️ all %d containers have been searched, nowhere to move it — counting this one as found as an exception (%s)" % [
+			searchables.size(), reason])
+		mp8_force_find = true
+		return
+
+	# Prefer moving it far away - take the half of the candidates farthest from the triggering player, then pick one at random
+	candidates.sort_custom(func(a, b):
+		return a.global_position.distance_to(away_from) > b.global_position.distance_to(away_from)
+	)
+	var half: int = maxi(candidates.size() / 2, 1)
+	var target = candidates[randi() % half]
+	target.set_has_item_rpc.rpc(true)
+	mp8_syringe_containers.append(target)
+
+	var from_name: String = String(from_container.name) if is_instance_valid(from_container) else "?"
+	_mp8_debug_last = "%s → %s moved to %s (%.1f m away)" % [
+		reason, from_name, target.name, target.global_position.distance_to(away_from)]
+	_mp8_debug_refresh()
+
+	print("[MP8] Knife at the Office: syringe teleport (%s) — moved from %s to %s (%.1f m from the trigger point, %d candidates)" % [
+		reason, from_name, target.name,
+		target.global_position.distance_to(away_from),
+		candidates.size(),
+	])
+
+
+# [MP8] Results log. **Changes no scores**, it's purely for checking afterwards that the scoring was right.
+# Three ways to score. Finding a syringe +1 / infecting someone +1 / human surviving to the end +mp8_survivor_bonus.
+# How to check - break down each person's score. Survivors have at least the bonus, and an infected player's score = found a syringe or not + number infected.
+func _mp8_log_scores(survivors: int) -> void :
+
+	var rows := PackedStringArray()
+	for id in players.keys():
+		rows.append("%s %d pts %s" % [
+			_mp8_name(id),
+			player_scores.get(id, 0),
+			"(infected)" if infected_players.has(id) else "(human)",
+		])
+
+	print("[MP8] Knife at the Office results (%d present / %d survived / survivor score %d / %d infected): %s" % [
+		players.size(), survivors, mp8_survivor_bonus, infected_players.size(),
+		" | ".join(rows),
+	])
+
+
+func _mp8_name(network_id: int) -> String :
+
+	if players.has(network_id) and is_instance_valid(players[network_id]):
+		return String(players[network_id].player_presence.network_name)
+	return "id%d" % network_id
+
+
+# [MP8] When the hunt phase starts, equip everyone who was "holding it unrevealed" all at once.
+#
+# Whoever found one first received the syringe via `set_has_item_rpc(true, false)` —
+# has_item was recorded, but no model appeared and they didn't turn infected. At this point equip=true is sent once more.
+#
+# ⚠️ Resending makes the player side call `item_found.emit()` again → `_on_item_found` runs another time.
+# That path is already blocked by `mp8_first_time` (= `not infected_players.has()`), so no double scoring
+# — this dependency must always hold.
+#
+# [MP8] 2026-08-19 - `mp8_syringes_found` is **no longer incremented in `_on_item_found`**
+# (it moved to `request_item_find_rpc`), so this resend path can't touch the syringe count at all,
+# which is safer than before. A pass that comes in through the resend only has its scoring blocked by mp8_first_time and changes nothing else.
+func _mp8_equip_all_infected() -> void :
+
+	var done: int = 0
+	for id in infected_players:
+		if not (players.has(id) and is_instance_valid(players[id])):
+			continue
+		# Don't resend to anyone already equipped — with needed=1 the finder equips on the spot, so this is a no-op,
+		# which avoids a pointless extra round of RPCs and an item_found loop.
+		if players[id].is_holding_syringe:
+			continue
+		players[id].set_has_item_rpc.rpc(true, true)
+		done += 1
+
+	print("[MP8] Knife at the Office: reveal — %d infected now equip the syringe and switch model (%d infected present)" % [
+		done, infected_players.size()])
+
+
+# ═══════════════ [MP8] Syringe debug panel (mp8knifedebug) ═══════════════
+# From the user on 2026-08-17, "I'll control players and search crates to test whether it really teleports".
+# The top-left lists live which cabinet the syringe is in, how many times it has teleported, and where the last move went from and to.
+# ⚠️ The state only exists on the server, so **only window 1 (the host)** has anything in its panel.
+
+func _mp8_debug_begin() -> void :
+
+	var layer := CanvasLayer.new()
+	layer.name = "MP8KnifeDebugHud"
+	layer.layer = 99
+	add_child(layer)
+
+	_mp8_debug_panel = Label.new()
+	_mp8_debug_panel.set_anchors_preset(Control.PRESET_TOP_LEFT)
+	_mp8_debug_panel.offset_left = 18.0
+	_mp8_debug_panel.offset_top = 14.0
+	_mp8_debug_panel.offset_right = 860.0
+	_mp8_debug_panel.offset_bottom = 460.0
+	# As before - the default theme font has broken letter spacing, so the game's own font is required (this has bitten us four times already)
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		_mp8_debug_panel.add_theme_font_override("font", f)
+	_mp8_debug_panel.add_theme_font_size_override("font_size", 20)
+	_mp8_debug_panel.add_theme_color_override("font_color", Color(1.0, 0.9, 0.4))
+	_mp8_debug_panel.add_theme_color_override("font_outline_color", Color.BLACK)
+	_mp8_debug_panel.add_theme_constant_override("outline_size", 6)
+	_mp8_debug_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	layer.add_child(_mp8_debug_panel)
+
+	_mp8_debug_refresh()
+	print("[MP8] Knife at the Office: syringe debug panel enabled (top-left, only the host's has content)")
+
+
+func _mp8_debug_refresh() -> void :
+
+	if not _mp8_debug_on or _mp8_debug_panel == null:
+		return
+
+	if not multiplayer.is_server():
+		_mp8_debug_panel.text = "Knife at the Office syringe debug\n(syringe state only lives on the host, nothing to show here)"
+		return
+
+	var searched: int = 0
+	for s in searchables:
+		if is_instance_valid(s) and s.searched:
+			searched += 1
+
+	var where := PackedStringArray()
+	for c in mp8_syringe_containers:
+		if is_instance_valid(c):
+			where.append(String(c.name))
+
+	var infected := PackedStringArray()
+	for id in infected_players:
+		infected.append(_mp8_name(id))
+
+	var lines := PackedStringArray()
+	lines.append("Knife at the Office syringe debug (host)")
+	lines.append("%d containers: searched %d / unsearched %d    searches %d" % [
+		searchables.size(), searched, searchables.size() - searched, containers_searched])
+	lines.append("Syringes %d/%d found  %d still on the map" % [
+		mp8_syringes_found, mp8_syringes_needed, mp8_syringe_containers.size()])
+	lines.append("Syringes now in: %s" % ("(none left)" if where.is_empty() else ", ".join(where)))
+	lines.append("Teleported %d times" % mp8_relocations)
+	lines.append("  Last one: %s" % _mp8_debug_last)
+	lines.append("Infected: %s" % ("(none)" if infected.is_empty() else ", ".join(infected)))
+	lines.append("Hunt phase: %s (decides whether stabbing is allowed)" % ("started" if searching_disabled else "**not started**"))
+	_mp8_debug_panel.text = "\n".join(lines)
+
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Top-right container indicator "Containers 12/34" (requested by the user on 2026-08-19)
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# The user asked for it after finding in testing that "sometimes the second syringe can't be found". After searching for ages there was no way to know how many cabinets were still unopened,
+# or whether you just hadn't found it or the syringe wasn't on the map at all. This line makes that visible.
+#
+# ### Why each machine counts for itself without an RPC
+#
+# `_mp8_collect_searchables()` runs in `_ready()`, **on every peer**,
+# so every machine has the full `searchables`. And `set_searched_rpc` is a
+# `call_local` broadcast, so every machine's `searched` flags are accurate too.
+# → One local pass gives the right answer, there's no need for the server to report it.
+# (This differs from the debug panel in the top-left. That one shows which cabinet the syringe is in,
+#   and only the server has `mp8_syringe_containers`, so that panel only means anything to the host.)
+#
+# ### It shows "searched/total", not "remaining"
+#
+# 34/34 = all currently valid containers have been searched.
+# It turns red when everything is searched but the syringe still hasn't been found — that means the fallback path was hit, and one glance tells you to check the log.
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Container markers (mp8knifemark) — turning "hunting for cabinets" into "taking a glance"
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# Every container **not yet searched** gets a Label3D above it showing its raw pre-filter collection number,
+# with `no_depth_test = true` so it's **visible through walls**. Each one disappears once searched.
+#
+# The purpose is to find containers that "get counted but players can't reach". The user reported on 2026-08-19 that "only 34 on the map are interactable,
+# and after searching for ages I couldn't find the last two", while probe70 confirmed the 36 containers are structurally identical
+# and differ only in coordinates — so being unreachable comes from level geometry, which static analysis can't find, and you have to go in and look.
+#
+# After a run, tell me the remaining numbers (or check the "N containers left unsearched" line in the log), and they can be excluded precisely.
+func _mp8_mark_begin() -> void :
+
+	if not _mp8_marks.is_empty():
+		return
+	_mp8_collect_searchables()
+
+	for i in searchables.size():
+		var s = searchables[i]
+		if not is_instance_valid(s):
+			continue
+
+		var lbl := Label3D.new()
+		lbl.text = str(s.get_meta(&"mp8_raw_searchable_index", i))
+		lbl.font_size = 96
+		lbl.pixel_size = 0.012
+		lbl.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		# Visible through walls — that's the whole point of this switch, without it you'd still have to search room by room
+		lbl.no_depth_test = true
+		lbl.modulate = Color(1.0, 0.9, 0.2)
+		lbl.outline_modulate = Color.BLACK
+		lbl.outline_size = 12
+		lbl.position = Vector3(0, 1.6, 0)
+		s.add_child(lbl)
+		_mp8_marks.append([lbl, s])
+
+	print("[MP8] Knife at the Office: mp8knifemark — %d containers numbered (visible through walls, removed once searched)" % _mp8_marks.size())
+
+
+func _mp8_mark_refresh() -> void :
+
+	if _mp8_marks.is_empty():
+		return
+
+	var left := PackedStringArray()
+	for pair in _mp8_marks:
+		var lbl = pair[0]
+		var s = pair[1]
+		if not is_instance_valid(lbl) or not is_instance_valid(s):
+			continue
+		lbl.visible = not s.searched
+		if not s.searched:
+			left.append(lbl.text)
+
+	# Only log when "almost everything is searched", to avoid spam. With 4 or fewer left, report every change.
+	if left.size() <= 4 and left.size() > 0:
+		var key: String = ",".join(left)
+		if key != _mp8_mark_last:
+			_mp8_mark_last = key
+			var parts := PackedStringArray()
+			for pair in _mp8_marks:
+				var s = pair[1]
+				if is_instance_valid(s) and not s.searched:
+					parts.append("#%s (%.1f, %.1f)" % [
+						pair[0].text, s.global_position.x, s.global_position.z])
+			print("[MP8] Knife at the Office: %d containers left unsearched — %s" % [left.size(), " / ".join(parts)])
+
+
+func _mp8_container_hud_refresh() -> void :
+
+	if mp8_container_label == null or not is_instance_valid(mp8_container_label):
+		return
+
+	var total: int = searchables.size()
+	if total <= 0:
+		mp8_container_label.text = ""
+		return
+
+	var searched: int = 0
+	for s in searchables:
+		if is_instance_valid(s) and s.searched:
+			searched += 1
+
+	mp8_container_label.text = "Containers %d/%d" % [searched, total]
+
+	# Everything opened and still searching = something's wrong, so highlight it in red
+	if searched >= total:
+		mp8_container_label.add_theme_color_override("font_color", Color(1.0, 0.45, 0.45))
+	else:
+		mp8_container_label.add_theme_color_override("font_color", Color(0.85, 0.9, 0.85))
+
+
+func _mp8_container_hud_begin() -> void :
+
+	if mp8_container_label != null and is_instance_valid(mp8_container_label):
+		return
+
+	var layer := CanvasLayer.new()
+	layer.name = "MP8ContainerHud"
+	layer.layer = 100
+	add_child(layer)
+
+	var lbl := Label.new()
+	lbl.set_anchors_preset(Control.PRESET_TOP_RIGHT)
+	lbl.offset_left = -320.0
+	# ⚠️ Sits **below** the "someone has been infected" line (that line is top=14 / bottom=54),
+	# and without setting bottom you get a negative height and clipped text — see the hard-learned comment on the function below.
+	lbl.offset_top = 58.0
+	lbl.offset_right = -18.0
+	lbl.offset_bottom = 96.0
+	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+
+	# ⚠️ The game's own font must be set explicitly, the default theme font has broken letter spacing (fifth time hitting this, see the comment below)
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 24)
+	lbl.add_theme_color_override("font_color", Color(0.85, 0.9, 0.85))
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	layer.add_child(lbl)
+
+	mp8_container_label = lbl
+	_mp8_container_hud_refresh()
+	print("[MP8] Knife at the Office: top-right container indicator created (counted locally, %d containers)" % searchables.size())
+
+
+# [MP8] A persistent "someone has been infected" line in the top-right (requested by the user on 2026-08-17).
+# ⚠️ Same as Manufacture Gun - the HUD is built **on the minigame itself**, only once.
+# Duck Hunt originally hung the HUD on players, so on each machine all 8 players built their own Label and they piled up on top of each other.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_show_infected_notice_rpc() -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+
+	if mp8_notice_label != null and is_instance_valid(mp8_notice_label):
+		return
+
+	var layer := CanvasLayer.new()
+	layer.name = "MP8InfectedHud"
+	layer.layer = 100
+	add_child(layer)
+
+	var lbl := Label.new()
+	lbl.set_anchors_preset(Control.PRESET_TOP_RIGHT)
+	lbl.offset_left = -640.0
+	lbl.offset_top = 14.0
+	lbl.offset_right = -18.0
+	# ⚠️ offset_bottom must be set. `set_anchors_preset` zeroes all four offsets,
+	# so setting top without bottom → the height is **negative** and the text gets clipped. That's exactly how the first version went wrong.
+	lbl.offset_bottom = 54.0
+	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+	lbl.text = "Someone has been infected"
+
+	# ⚠️ The game's own font must be set explicitly. The default theme font **has broken letter spacing**.
+	# Duck Hunt, Junk Platform and Manufacture Gun all tripped on it — this is the fourth time, so this copies Manufacture Gun's version.
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 26)
+	lbl.add_theme_color_override("font_color", Color(1.0, 0.35, 0.35))   # Red = someone is infected
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	layer.add_child(lbl)
+
+	mp8_notice_label = lbl
+	print("[MP8] Knife at the Office: top-right notice 'Someone has been infected' shown")
+
