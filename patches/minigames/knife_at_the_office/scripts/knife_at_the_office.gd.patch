+		push_warning("[MP8] Knife at the Office: can't write %s (error %d)" % [
+			MP8_SPAWN_FILE, FileAccess.get_open_error()])
+		return
+
+	f.store_line("# Knife at the Office (mp8game=7) spawn points")
+	f.store_line("# One point per line: x, z, facing in degrees. **Must be 8 lines**, fewer lines will be ignored.")
+	f.store_line("# The first 4 lines are the scene's vanilla 4 (these can be tuned too), the last 4 are the ones this mod adds.")
+	f.store_line("# Only applies to 5+ players. ≤4 players always use the scene's vanilla 4 points, byte-for-byte untouched.")
+	f.store_line("# Delete this file = back to the built-in convex hull farthest-point insertion algorithm. You can edit it directly in Notepad.")
+	f.store_line("# Saved at %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+
+	var snippet := PackedStringArray()
+	for m in _mp8_spawn_markers:
+		var node3d: Node3D = m
+		f.store_line("%.2f, %.2f, %.0f" % [
+			node3d.position.x, node3d.position.z, rad_to_deg(node3d.rotation.y)])
+		snippet.append("\t[Vector3(%.2f, 0.0, %.2f), %.1f]," % [
+			node3d.position.x, node3d.position.z, rad_to_deg(node3d.rotation.y)])
+	f.close()
+
+	print("[MP8] Knife at the Office: spawn points saved (%d) → %s" % [
+		_mp8_spawn_markers.size(), ProjectSettings.globalize_path(MP8_SPAWN_FILE)])
+	# Once finalized this can be pasted straight back into the code as the built-in default, so the next agent doesn't have to work the coordinates out again
+	print("[MP8] Knife at the Office: for pasting back into code —\n%s" % "\n".join(snippet))
+
+
