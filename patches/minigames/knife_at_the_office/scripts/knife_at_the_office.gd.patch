+# [MP8] Spawn points 4 → 8 via **farthest-point insertion inside the convex hull** (the algorithm validated in T4b, copied from network_manager's
+# `_mp8_spread_inside` without changing a character).
+#
+# Why not interpolate by column like Train Race? Here the vanilla 4 points are crammed into a small area at x≈±5 / z∈[-7.5,-2.2],
+# and even column interpolation gives a minimum spacing of only **1.33 m**, which is too close. Convex hull farthest-point insertion finds the gaps by itself.
+#
+# Two hard constraints (set in T4b). ① Don't move the original points. ② New points can only be **convex combinations** of the originals —
+# so they always land inside the vanilla convex hull and naturally can't end up off the map (pitfall #25 - outside is always the emptiest, but that doesn't mean "OK to place").
+func _mp8_spread_inside(originals: Array[Vector3], want: int) -> Array[Vector3] :
+
+	var chosen: Array[Vector3] = originals.duplicate()
+	var result: Array[Vector3] = []
+
+	if originals.size() < 2 or want <= originals.size():
+		return result
+
+	var pool: Array[Vector3] = []
+	for i in originals.size():
+		for j in range(i + 1, originals.size()):
+			for k in range(1, 8):
+				pool.append(originals[i].lerp(originals[j], float(k) / 8.0))
+
+	while chosen.size() < want:
+
+		var best: Vector3 = pool[0]
+		var best_d: float = -1.0
+
+		for c in pool:
+			var d: float = INF
+			for ch in chosen:
+				d = minf(d, c.distance_to(ch))
+			if d > best_d:
+				best_d = d
+				best = c
+
+		chosen.append(best)
+		result.append(best)
+
+	return result
+
