+	_mp8_shot_armed = NetworkManager.mp8_args().has("mp8shot")
+
+	# [MP8] Expand the scoreboard slots. **Must be deferred**, see _mp8_extend() for why.
+	if not NetworkManager.mp8_args().has("mp8noscore"):
+		_mp8_extend.call_deferred()
+
+
+# [MP8] The 3D results scoreboard shown after each match only has 4 rows, so with 8 players the last 4 never show at all.
+#
+# Why it must be call_deferred
+#   Intermission_UserContainer._ready() does
+#       for child in get_parent().get_children(): user_container_array.append(child)
+#   (each row collects all of its siblings itself, for the "swap with the placement above" animation).
+#   This script sits on `intermission score screen`, which is a **sibling** of `users list` and comes before it,
+#   so this script's _ready() runs **before** the _ready() of those 4 rows.
+#   Duplicating nodes at that point happens before the originals have collected, so each row ends up with an incomplete list.
+#   So wait one frame until all 4 rows have collected before acting, then finally overwrite all 8 rows' lists with one complete list.
+#
+# Layout follows the same idea as the pre-match briefing screen — **shrink to fit the original area and don't move anything around it**.
+# This board is full above and below (the SIMULATION CONCLUDED header above, the binary panel right underneath),
+# and the vanilla 4 rows span y 0.84 ~ -0.705 (spacing 0.515).
+func _mp8_extend() -> void :
+
+	var target: int = NetworkManager.MAX_PLAYERS
+	var n: int = user_container_array.size()
+	if n == 0 or n >= target:
+		return
+
+	var src: Intermission_UserContainer = user_container_array[0]
+	if not is_instance_valid(src):
+		return
+	var parent: Node = src.get_parent()
+	if parent == null:
+		return
+
+	var s: float = MP8_ROW_SCALE
+	var step: float = MP8_ROW_STEP
+	for a in NetworkManager.mp8_args():
+		var t: String = String(a)
+		if t.begins_with("mp8srow="):
+			var parts: PackedStringArray = t.substr(8).split(",")
+			if parts.size() >= 1 and parts[0] != "":
+				s = float(parts[0])
+			if parts.size() >= 2 and parts[1] != "":
+				step = float(parts[1])
+
+	# Score roll duration. The vanilla 4 rows use 2.0 / 2.5 / 3.0 / 3.5, increasing row by row.
+	# Continuing that +0.5 pattern for 8 rows would reach 5.5, and total duration = the longest ×1.5×1.5,
+	# which would make the whole results screen take twice as long. So instead **the 8 rows are spread across the original [first,last] range**,
+	# the longest value stays the same → results pacing matches vanilla exactly.
+	var lerp_first: float = src.lerp_duration_score
+	var lerp_last: float = user_container_array[n - 1].lerp_duration_score
+
+	for i in range(n, target):
+		var dup: Intermission_UserContainer = src.duplicate()
+		dup.name = "MP8UserInfo%d" % (i + 1)
+		_mp8_reresolve_children(src, dup)
+		dup.container_id = i
+		dup.visible = false
+		parent.add_child(dup)
+		user_container_array.append(dup)
+
+	# How many columns to lay out in (mp8scols=<columns>,<column gap>).
+	# 1 column = all 8 rows stacked vertically, 2 columns = 1~4 on the left and 5~8 on the right.
+	var cols: int = MP8_COLS
+	var col_gap: float = MP8_COL_GAP
+	for a in NetworkManager.mp8_args():
+		var t: String = String(a)
+		if t.begins_with("mp8scols="):
+			var cp: PackedStringArray = t.substr(9).split(",")
+			if cp.size() >= 1 and cp[0] != "":
+				cols = maxi(int(cp[0]), 1)
+			if cp.size() >= 2 and cp[1] != "":
+				col_gap = float(cp[1])
+	var per_col: int = int(ceil(float(target) / float(cols)))
+
+	# y table - the first row stays put and the rest stack downward at the new spacing. With columns, each column starts again from the top
+	var base_y: float = rank_y_positions[0] if rank_y_positions.size() > 0 else 0.84
+	rank_y_positions.clear()
+	_mp8_rank_x_offsets.clear()
+	for i in target:
+		rank_y_positions.append(base_y - float(i % per_col) * step)
+		_mp8_rank_x_offsets.append(float(i / per_col) * col_gap)
+
+	# Uniform scaling **shrinks toward each node's own origin**, and a row's origin sits between the score and the name,
+	# so the left part (the placement number and the two square connectors) shrinks rightward as a whole,
+	# which pulls the whole list off its original spot and opens a gap between it and the large total score on the left.
+	# Add back the amount the leftmost child shrank by, so the list's left edge stays where it was.
+	var left_x: float = 0.0
+	for child in src.get_children():
+		if child is Node3D:
+			left_x = minf(left_x, (child as Node3D).position.x)
+	var x_shift: float = left_x * (1.0 - s)
+
+	_mp8_base_x = src.position.x + x_shift
+
+	# Absolute table of placement → slot x, used by the swap animation (see user_container_order_manager.gd)
+	mp8_rank_x_positions.clear()
+	for i in target:
+		mp8_rank_x_positions.append(_mp8_base_x + _mp8_rank_x_offsets[i])
+
+	for i in target:
+		var uc: Intermission_UserContainer = user_container_array[i]
+		uc.scale = Vector3.ONE * s
+		uc.position.x = _mp8_base_x + _mp8_rank_x_offsets[i]
+		uc.position.y = rank_y_positions[i]
+		uc.lerp_duration_score = lerpf(lerp_first, lerp_last, float(i) / float(target - 1))
+
+	# ⚠️ This array is **written** by index, so without padding it that's an out-of-bounds write (that is how last session's 0xc0000005 happened). The write is in
+	#   sort_user_containers_by_score():  score_container_nodes[rank_position_counter] = uc
+	score_container_nodes = user_container_array.duplicate()
+
+	# Overwrite each row's own "all siblings" list with the complete set of 8.
+	# duplicate() gives each row its own copy, so the 8 rows don't share one Array object.
+	for uc in user_container_array:
+		uc.user_container_array = user_container_array.duplicate()
+
+	print("[MP8] 3D scoreboard: player rows %d->%d, scale %.2f, spacing %.4f, %d columns (gap %.2f)\n        y table %s\n        x table %s" % [
+		n, user_container_array.size(), s, step, cols, col_gap,
+		str(rank_y_positions), str(mp8_rank_x_positions)
+	])
+
+
+# [MP8] duplicate() does **not** remap @export references that point at its own child nodes —
+# the copied row keeps pointing at the **original's** Label3D, so all 8 rows write text into the same row.
+# The fix follows _mp8_extend_lobby() in network_manager.gd.
+# First get the relative path with src.get_path_to(), then re-resolve it on the copy with get_node().
+func _mp8_reresolve_children(src: Intermission_UserContainer, dup: Intermission_UserContainer) -> void :
+
+	if is_instance_valid(src.anim_connector):
+		dup.anim_connector = dup.get_node(src.get_path_to(src.anim_connector))
+	if is_instance_valid(src.label_rank):
+		dup.label_rank = dup.get_node(src.get_path_to(src.label_rank))
+	if is_instance_valid(src.label_score):
+		dup.label_score = dup.get_node(src.get_path_to(src.label_score))
+	if is_instance_valid(src.label_name):
+		dup.label_name = dup.get_node(src.get_path_to(src.label_name))
+	if is_instance_valid(src.speaker_connector):
+		dup.speaker_connector = dup.get_node(src.get_path_to(src.speaker_connector))
+
+	var ops: Array[GeometryInstance3D] = []
+	for op in src.opacity_visuals:
+		if is_instance_valid(op):
+			var re = dup.get_node_or_null(src.get_path_to(op))
+			if re != null:
+				ops.append(re)
+	dup.opacity_visuals = ops
+
+	# score_screen / container_order_swapper point at **external** shared nodes,
+	# so the copied references are already correct and don't need re-resolving.
+
+
+# [MP8] Self-screenshot. It is captured differently from the pre-match briefing screen one.
+# The briefing screen is 2D UI drawn into a SubViewport, so grabbing that SubViewport is enough.
+# **This scoreboard is a real 3D object placed in the intermission room**, so only the whole game window can be captured.
+#
+# Why a series of time points instead of one shot? The first version hooked score_screen_finished,
+# but as soon as that signal fired the server immediately set up the next match and hid the scoreboard,
+# so the capture was a full screen of green noise (the transition mask). The scoreboard timeline goes like this.
+#   0.6s rows appear one by one → 2.2s binary board → 2.7s scores start rolling → ~8s rolling done → ~10.6s screen closes
+# So just take a burst at fixed time points and pick the right one afterward. One run is enough to check.
+const MP8_SHOT_TIMES: Array[float] = [4.0, 7.0, 10.0]
+
+var _mp8_shot_armed: bool = false
+
+# [MP8] Player row layout parameters. Command-line mp8srow=<scale>,<spacing> / mp8scols=<columns>,<column gap> can override them temporarily.
+# Vanilla 4 rows use spacing 0.515 and span y 0.84 ~ -0.705.
+# With two columns each column only has 4 rows, so it's no longer cramped vertically and row spacing goes back to vanilla's 0.515.
+# Width is the new bottleneck. One row (7-character name) takes about 420px at scale 1.0, and the board's usable width is about 490px,
+# so two columns + gap have to be squeezed to around scale 0.55.
+const MP8_ROW_SCALE: float = 0.48
+const MP8_ROW_STEP: float = 0.515
+const MP8_COLS: int = 2
+const MP8_COL_GAP: float = 3.5
+
+# Slot x for each placement (an **absolute value**, not an offset).
+# user_container_order_manager.gd reads it when swapping, so it is public and its name has the mp8 prefix.
+var mp8_rank_x_positions: Array[float] = []
+
+var _mp8_rank_x_offsets: Array[float] = []
+var _mp8_base_x: float = 0.0
+
+
+# [MP8] Put a row in place according to its placement.
+# Vanilla only sets y (`user_container.position.y = rank_y_positions[i]`), because x never changes with one column.
+# With columns, x also depends on placement and must be set too, otherwise the rows that switch column stay at their old column's x.
+func _mp8_place(uc: Node3D, i: int) -> void :
+	if i < rank_y_positions.size():
+		uc.position.y = rank_y_positions[i]
+	if i < _mp8_rank_x_offsets.size():
+		uc.position.x = _mp8_base_x + _mp8_rank_x_offsets[i]
+
+
+func _mp8_shot_timeline() -> void :
+
+	if not _mp8_shot_armed:
+		return
+
+	var tag: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var waited: float = 0.0
+
+	for t in MP8_SHOT_TIMES:
+		await get_tree().create_timer(t - waited, false).timeout
+		waited = t
+		if not is_inside_tree():
+			return
+		await RenderingServer.frame_post_draw
+		var img: Image = get_viewport().get_texture().get_image()
+		if img != null:
+			img.save_png("user://mp8_score_%d_t%d.png" % [tag, int(t)])
+			print("[MP8] mp8shot: saved user://mp8_score_%d_t%d.png" % [tag, int(t)])
+
 func _physics_process(delta: float) -> void :
 
