diff --git a/minigames/intermission_new/components/intermission_briefing_screen.gd b/minigames/intermission_new/components/intermission_briefing_screen.gd
--- a/minigames/intermission_new/components/intermission_briefing_screen.gd
+++ b/minigames/intermission_new/components/intermission_briefing_screen.gd
@@ -124,6 +124,361 @@ func _ready() -> void :
 
 	Globals.locale_changed.connect(debug_update)
 
+	# [MP8] Auto-ready is now its own mp8ready switch instead of being tied to mp8fast —
+	# debugging needs the "no fast-forward but still auto-ready" combination.
+	var _mp8_args := NetworkManager.mp8_args()
+	# mp8hold turns off only auto-ready and keeps mp8fast's cutscene fast-forward —
+	# so the pre-match briefing screen stays up for screenshots of the layout.
+	_mp8_auto_ready_armed = (
+		(_mp8_args.has("mp8fast") or _mp8_args.has("mp8ready"))
+		and not _mp8_args.has("mp8hold")
+	)
+	# mp8noscore is a debugging switch that skips the scoreboard slot expansion (to isolate whether it causes "stuck in SessionIntro")
+	if not _mp8_args.has("mp8noscore"):
+		_mp8_extend_score_slots()
+	else:
+		print("[MP8] mp8noscore: skipping results scoreboard slot expansion")
+
+
+# [MP8] The results scoreboard only has 4 player rows (user_container_array is an @export array
+# with 4 items filled in the scene, and rank_y_positions is also 4 hard-coded y coordinates),
+# so with 8 players the last 4 never get their scores shown.
+#
+# The approach follows the hard-learned lesson from the lobby layout - **duplicate existing entries and let the existing code position them, don't compute coordinates ourselves.**
+# reset_briefing_rpc() already sets each row's y from rank_y_positions[i],
+# so here we only pad the entries to 8 and extend the y coordinate table to 8 at the original spacing. Not a single line of the sorting/data-filling code needs to change.
+func _mp8_extend_score_slots() -> void :
+
+	var target: int = NetworkManager.MAX_PLAYERS
+	var n: int = user_container_array.size()
+
+	if n == 0 or n >= target:
+		return
+
+	var src = user_container_array[0]
+	if not is_instance_valid(src):
+		return
+
+	var parent: Node = src.get_parent()
+	if parent == null:
+		return
+
+	for i in range(n, target):
+		var dup = src.duplicate()
+		dup.name = "MP8UserContainer%d" % i
+		parent.add_child(dup)
+		user_container_array.append(dup)
+
+	# ---- Layout - 8 rows only fit if shrunk ----------------------------------------
+	# Panel geometry (exact values measured from the stock PCK by probe13/15, in "panel units",
+	# the whole UI is scaled 4x by its parent and then drawn into a 1920×1080 SubViewport).
+	#
+	#   player rows start  y = 69.25 (position of user data container parent)
+	#   row spacing          = 19        text height = font size 221 × 0.06703 ≈ 14.8
+	#   ready button       y = 149.5   (local_ready_button is at 147.6)
+	#   progress bar frame y = 227.5
+	#
+	# So the usable height is only 149.5 - 67.5 ≈ 79.5, while 8 rows at the original spacing need 7×19+14.8 = 148,
+	# so **at the original size they can't fit however they're arranged** (even pushing the ready button onto the progress bar leaves them 10 units short).
+	# So whole rows must shrink. With scale s and spacing 19×s they take 147.8×s ≤ 79.5 → s ≤ 0.538.
+	# Using s = 0.5 / spacing 9.5, 8 rows take 73.9, entirely within the space the original 4 rows used,
+	# and **none of the ready button, progress bar or page divider has to move** (changing other elements is where the risk is).
+	var s: float = MP8_ROW_SCALE
+	var step: float = MP8_ROW_STEP
+	for a in NetworkManager.mp8_args():
+		var t: String = String(a)
+		if t.begins_with("mp8row="):
+			var parts: PackedStringArray = t.substr(7).split(",")
+			if parts.size() >= 1 and parts[0] != "":
+				s = float(parts[0])
+			if parts.size() >= 2 and parts[1] != "":
+				step = float(parts[1])
+
+	var base_y: float = rank_y_positions[0] if rank_y_positions.size() > 0 else 0.0
+	rank_y_positions.clear()
+	for i in target:
+		rank_y_positions.append(base_y + float(i) * step)
+
+	for uc in user_container_array:
+		uc.scale = Vector2(s, s)
+
+	# Invite buttons - first pad to 8 sets and hook each player row to its own set, then position them by row spacing.
+	# The order can't be reversed — positioning has to apply to all 8 sets.
+	_mp8_extend_invite_buttons(target)
+	_mp8_align_invite_buttons(s, step)
+
+	# ⚠️ This screen has two more fixed-length arrays **indexed by player index**, and they must be padded to 8 as well.
+	# Padding only user_container_array leads straight to a native crash (0xc0000005) at these points.
+	#   sort_user_containers_by_score():  score_container_nodes[i] = ...   ← out-of-bounds **write**
+	#   show_score_nodes() / update_players():  speakers_show_player_card[i].play()  ← out-of-bounds **read**
+	# Release templates have no bounds checking, so an out-of-bounds write is an access violation.
+	# (Tested 2026-08-14 - with only one array padded, duck_hunt / dvd_roomba always crash,
+	#   and disco_dodge not crashing is just luck of execution order, it is not safe.)
+	while score_container_nodes.size() < target:
+		score_container_nodes.append(user_container_array[score_container_nodes.size()])
+
+	# The audio sources only need "the array long enough that indexes stay in bounds", so **don't add new nodes to the scene tree**.
+	# We tried creating 4 new AudioStreamPlayers with duplicate(), and the whole flow got stuck in SessionIntro
+	# and couldn't move on (tested 2026-08-14, turning this function off with mp8noscore brought it back to normal).
+	# So this now reuses the existing audio sources in a cycle. The sounds for cards 5~8 retrigger the first 4 sources,
+	# which at most loses one layer of overlapping sound, with no cost to function or stability.
+	var spk_n: int = speakers_show_player_card.size()
+	if spk_n > 0:
+		while speakers_show_player_card.size() < target:
+			speakers_show_player_card.append(
+				speakers_show_player_card[speakers_show_player_card.size() % spk_n]
+			)
+
+	print("[MP8] Results scoreboard: player rows %d->%d, score_container %d, audio sources %d, scale %.2f, spacing %.2f, y table %s" % [
+		n, user_container_array.size(), score_container_nodes.size(),
+		speakers_show_player_card.size(), s, step, str(rank_y_positions)
+	])
+
+
+# [MP8] Player row layout parameters. Command-line mp8row=<scale>,<spacing> can override them temporarily, handy for tuning against the screen.
+const MP8_ROW_SCALE: float = 0.5
+const MP8_ROW_STEP: float = 9.5
+
+
+# [MP8] Self-screenshot. Pass mp8shot on the command line, and once the pre-match briefing screen is laid out the frame gets saved as PNG.
+#
+# Why not use an external screenshot? The briefing screen is drawn into a 1920×1080 SubViewport
+# and then put onto a 3D monitor mesh, so an external capture is a "photo" with perspective and reflections that can't measure layout accurately.
+# Grabbing the SubViewport directly gives the raw UI, accurate to the pixel.
+# Two images are saved. ui = the screen itself, win = the whole game window (to see how it actually looks in the scene).
+func _mp8_shot() -> void :
+
+	if not NetworkManager.mp8_args().has("mp8shot"):
+		return
+
+	await get_tree().create_timer(1.0, false).timeout
+	if not is_inside_tree():
+		return
+	await RenderingServer.frame_post_draw
+
+	var tag: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+
+	# Walk up to find the SubViewport hosting this screen
+	var vp: Viewport = null
+	var node: Node = user_data_container_parent
+	while node != null:
+		if node is SubViewport:
+			vp = node
+			break
+		node = node.get_parent()
+
+	if vp != null:
+		var img: Image = vp.get_texture().get_image()
+		if img != null:
+			img.save_png("user://mp8_shot_ui_%d.png" % tag)
+
+	var win_img: Image = get_viewport().get_texture().get_image()
+	if win_img != null:
+		win_img.save_png("user://mp8_shot_win_%d.png" % tag)
+
+	print("[MP8] mp8shot: saved user://mp8_shot_{ui,win}_%d.png" % tag)
+
+
+# [MP8] Invite buttons, the "click to invite friends" area on empty slots. Vanilla has 4 sets, one per player row.
+#
+# ⚠️ There's a pitfall here. These two arrays are **not in the same coordinate system** (as measured live by probe69).
+#   invite_buttons_visuals   = InviteButton0..3 inside the SubViewport
+#                              (panel coordinates, parent node InviteButtonParent is at y=69.25,
+#                                button offset_top = 3.5 / 22.25 / 41.0 / 59.75, step 18.75)
+#   invite_buttons_interacts = InviteOverlayButton0..3 in the screen overlay
+#                              (screen coordinates, offset_top = 124 / 172 / 210 / 248,
+#                                note the **uneven steps** of 48 / 38 / 38, placed by hand)
+# The clickable ones are the latter. The former are only ButtonClass's custom_ui_target (opacity changes on hover).
+#
+# 🩸 The old version got two things wrong here, which caused the "misaligned, only three of them" issue the user reported on 2026-08-18.
+#   ① The mapping factor was taken as (act[1]-act[0])/(vis[1]-vis[0]) = 48/18.75 = 2.56 —
+#      which happens to land on that **anomalous first gap** (the real three gaps are 48/38/38).
+#      It now does a least-squares fit over all the original points instead, slope about 2.19.
+#   ② There were only 4 sets, while MP8 has 8 player rows — see _mp8_extend_invite_buttons.
+# (The old version already had the click areas scaling correctly, so that part is kept.)
+var _mp8_inv_fit_ok: bool = false
+var _mp8_inv_k: float = 0.0        # Slope from panel y → screen y
+var _mp8_inv_b: float = 0.0        # Intercept
+var _mp8_inv_act_scale: Vector2 = Vector2.ONE
+
+
+# Least squares over the original 4 (panel y, screen y) pairs gives the mapping between the two coordinate systems.
+# All points are used instead of the first two. Vanilla's first gap is an outlier, and using only it pushes the later ones further and further off.
+func _mp8_fit_invite_mapping() -> void :
+
+	var vis: Array[Button] = invite_buttons_visuals
+	var act: Array[Button] = invite_buttons_interacts
+	var n: int = mini(vis.size(), act.size())
+	if n < 2:
+		return
+
+	var xs: Array[float] = []
+	var ys: Array[float] = []
+	for i in n:
+		if is_instance_valid(vis[i]) and is_instance_valid(act[i]):
+			xs.append(vis[i].position.y)
+			ys.append(act[i].position.y)
+	if xs.size() < 2:
+		return
+
+	var mx: float = 0.0
+	var my: float = 0.0
+	for i in xs.size():
+		mx += xs[i]
+		my += ys[i]
+	mx /= float(xs.size())
+	my /= float(xs.size())
+
+	var num: float = 0.0
+	var den: float = 0.0
+	for i in xs.size():
+		num += (xs[i] - mx) * (ys[i] - my)
+		den += (xs[i] - mx) * (xs[i] - mx)
+	if absf(den) < 0.0001:
+		return
+
+	_mp8_inv_k = num / den
+	_mp8_inv_b = my - _mp8_inv_k * mx
+	_mp8_inv_act_scale = act[0].scale if is_instance_valid(act[0]) else Vector2.ONE
+	_mp8_inv_fit_ok = true
+
+	print("[MP8] Invite button mapping: screen y = %.4f × panel y + %.2f (fit from %d original points)" % [
+		_mp8_inv_k, _mp8_inv_b, xs.size()])
+
+
+# [MP8] Pad the invite buttons from 4 sets to 8, and hook each player row up to **its own** set.
+#
+# 🩸 Not padding them causes exactly what the user saw. The player rows are copies made with duplicate(),
+#    and duplicate() **does not remap @export references** (pitfall #14).
+#    So invite_visual_button / invite_interact_button on rows 4~7 all point at row 0's set.
+#    So in a 2-player match (0/1 are players, 2~7 are empty slots)
+#      row 2 → InviteButton2 lights up, row 3 → InviteButton3 lights up,
+#      rows 4/5/6/7 → all light up InviteButton0
+#    → **only 3 invite buttons on screen**, and one of them sits on top of player 0's row (the "misalignment").
+#
+# References that need rewiring when copying (duplicate() fixes none of them for you)
+#   · the overlay button's ButtonClass.custom_ui_target → must point at the **new** visual button,
+#     otherwise hovering the new button flashes button 0.
+#   · the player row's two @exports → point at the new set.
+#   · the pressed signal → setup_invite_buttons() has already run (in _ready, before the slot expansion),
+#     and lambdas connected at runtime aren't carried over by duplicate, so we have to connect them ourselves.
+# speaker_press / speaker_hover in ButtonClass are **relative paths**,
+# and the copies sit under the same parent at the same depth, so those two can stay as they are.
+func _mp8_extend_invite_buttons(target: int) -> void :
+
+	var vis: Array[Button] = invite_buttons_visuals
+	var act: Array[Button] = invite_buttons_interacts
+	if vis.size() == 0 or not is_instance_valid(vis[0]):
+		print("[MP8] Invite buttons: none in the scene at all, skipping")
+		return
+
+	# ⚠️ The mapping must be fitted **before anything is touched**. The positioning below overwrites the original geometry.
+	_mp8_fit_invite_mapping()
+
+	var n0: int = vis.size()
+	if n0 >= target:
+		return
+
+	var vis_parent: Node = vis[0].get_parent()
+	var act_parent: Node = act[0].get_parent() if (act.size() > 0 and is_instance_valid(act[0])) else null
+
+	for i in range(n0, target):
+		# ---- Visual part ----------------------------------------------------
+		var v: Button = vis[0].duplicate()
+		v.name = "MP8InviteButton%d" % i
+		v.visible = false
+		vis_parent.add_child(v)
+		vis.append(v)
+
+		# ---- Click area ----------------------------------------------------
+		if act_parent != null:
+			var a: Button = act[0].duplicate()
+			a.name = "MP8InviteOverlayButton%d" % i
+			a.visible = false
+			act_parent.add_child(a)
+			act.append(a)
+
+			# The hover highlight target must switch to the new visual part, otherwise button 0 flashes
+			var bc: Node = a.get_node_or_null("ButtonClass")
+			if bc != null:
+				bc.set("custom_ui_target", v)
+
+			# setup_invite_buttons() in _ready finished long ago, so the new buttons have to be wired up here
+			if not GameManager.local_game:
+				a.pressed.connect(func():
+					Steam.activateGameOverlayInviteDialog(
+						NetworkManager.active_backend.lobby_id
+					)
+				)
+
+	# ---- Hook each player row to its own set (0~3 were already right, 4~7 get corrected here) ----
+	var fixed: int = 0
+	for i in user_container_array.size():
+		var uc = user_container_array[i]
+		if not is_instance_valid(uc):
+			continue
+		if i < vis.size() and is_instance_valid(vis[i]):
+			if uc.get("invite_visual_button") != vis[i]:
+				uc.set("invite_visual_button", vis[i])
+				fixed += 1
+		if i < act.size() and is_instance_valid(act[i]):
+			uc.set("invite_interact_button", act[i])
+
+	# Local offline matches get no invites on this screen at all (_ready already turned off the vanilla 4, this covers the new ones)
+	if GameManager.local_game:
+		for b in vis:
+			if is_instance_valid(b):
+				b.visible = false
+		for b in act:
+			if is_instance_valid(b):
+				b.visible = false
+
+	print("[MP8] Invite buttons: %d -> %d sets (visual %d / click area %d), rewired dangling references on %d player rows" % [
+		n0, target, vis.size(), act.size(), fixed])
+
+
+# [MP8] Invite button box height as a fraction of row spacing.
+#
+# Why this gets its own shrink (decided 2026-08-18 from in-game screenshots). Button height is anchor-driven
+# (anchor_bottom - anchor_top = 0.4 × parent height), which at runtime works out to **roughly one full row spacing**.
+# With 4 rows the spacing is 19 and it looks fine. Squeezed to 8 rows at spacing 9.5, neighboring box borders touch outright,
+# and six empty slots merge into one table instead of looking like six buttons. Shrinking to 0.78 leaves a visible gap.
+# ⚠️ Only the box height shrinks, **the font size is untouched** (it lives in theme_override and is already only 12×0.5, any smaller and it blurs).
+const MP8_INVITE_H_RATIO: float = 0.78
+
+var _mp8_invite_h_done: bool = false
+
+
+func _mp8_align_invite_buttons(s: float, step: float) -> void :
+
+	var vis: Array[Button] = invite_buttons_visuals
+	if vis.size() == 0:
+		return
+	var act: Array[Button] = invite_buttons_interacts
+
+	for i in vis.size():
+		# Vanilla y = 3.5 + i×18.75, i.e. "3.5 below the player row", and uniform scaling keeps that relationship
+		var new_y: float = float(i) * step + 3.5 * s
+
+		if is_instance_valid(vis[i]):
+			# Shrink the height first, then position. Changing an anchor recalculates the rect, so doing it the other way round wipes out the position.
+			# _mp8_invite_h_done guards against re-entry — if this function ever gets called twice,
+			# the ratio would be multiplied in twice and the boxes would keep getting flatter.
+			if not _mp8_invite_h_done:
+				var span: float = vis[i].anchor_bottom - vis[i].anchor_top
+				vis[i].anchor_bottom = vis[i].anchor_top + span * MP8_INVITE_H_RATIO
+			vis[i].scale = Vector2(s, s)
+			vis[i].position.y = new_y
+
+		# Click areas use the fitted mapping and **shrink along with the rest** —
+		# without shrinking, neighboring click areas overlap each other with 8 rows (vanilla click areas are about 36 screen pixels tall,
+		# while the 8-row spacing maps to only about 21).
+		if _mp8_inv_fit_ok and i < act.size() and is_instance_valid(act[i]):
+			act[i].position.y = _mp8_inv_k * new_y + _mp8_inv_b
+			act[i].scale = _mp8_inv_act_scale * s
+
+	_mp8_invite_h_done = true
+
 func debug_update():
 	update_page_number_visuals()
 	update_page_content()
