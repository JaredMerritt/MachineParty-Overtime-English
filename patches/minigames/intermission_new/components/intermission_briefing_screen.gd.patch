+# [MP8] Automated testing - once the pre-match briefing screen appears, count down 3 seconds and press "Ready" once automatically.
+#
+# Why "auto-press the button" instead of Globals.debug_skip_brief?
+# skip_brief cuts out the whole briefing and countdown, compressing in-match timing, which then trips vanilla's
+# latent issue in disco_dodge where the "displayed symbol" drifts out of step with symbol_index (what should collapse doesn't, and what shouldn't does,
+# see HANDOFF section 6, item 10). This function goes through exactly the same ready flow as a real person,
+# only swapping "clicking by hand" for "clicking automatically on time", so timing is unchanged and no fake bugs get created.
+# The countdown seconds are shown in brackets after the "Ready" button text, e.g. "Ready (3)" → "Ready (2)" → "Ready (1)".
+# label_ready_button's text comes from the scene (a localized string) and nothing else in the script writes it,
+# so changing it here and restoring it afterward is safe.
+const MP8_AUTO_READY_SECONDS: int = 3
+
+var _mp8_auto_ready_armed: bool = false     # Command-line switch, cached once in _ready()
+var _mp8_auto_ready_running: bool = false   # The countdown for this showing is running
+var _mp8_auto_ready_done: bool = false      # Already auto-pressed for this showing
+
+# Poll every frame instead of firing once from show_briefing_screen().
+# The reason is that show_briefing_screen() has two near-duplicate call paths (lines 405 and 435 of
+# intermission_game_picker.gd), each with an early `if not is_inside_tree(): return`,
+# and it's hard to tell which one runs in which match — in practice the first match had the countdown and later ones didn't.
+# Polling the "button is pressable and not ready yet" state itself doesn't depend on which path ran, so it's reliable.
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] 🩸 Unfocused windows must also tick the ready button cooldown — otherwise clients can never ready up again from the second match on
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# **Symptom** (2026-08-18, reported by the user while recording footage for a promo video).
+# Running 8 instances with `-Room` (hosts its own match, auto-ready at every intermission), the first match was fine,
+# but **from the second match's intermission onward none of the clients auto-readied any more**, and the match was stuck on the pre-match briefing screen.
+#
+# ### It takes all three of these stacked together to break, remove any one and it doesn't happen
+#
+# 1. `check_ready_button_cooldown()` is the **only** place that clears `ready_button_on_cooldown`,
+#    and in `_physics_process` it sits **after** the `game_focused` gate —
+#    with 8 instances only 1 window has focus, so the other 7 never reach it.
+# 2. The very first line of `_on_ready_button_pressed()` is `if ready_button_on_cooldown: return`.
+# 3. `show_briefing_screen()` never resets `ready_button_on_cooldown`.
+#
+# So after a client's first auto-press, the cooldown is **stuck at true forever**, and every later screen's auto-ready
+# gets blocked at item 2 — and **not a single log line is printed**, so it looks like "auto-ready never triggered".
+#
+# ### ⚠️ This is vanilla's structure, not something we introduced. **Real matches don't have this bug**
+#
+# Vanilla `_physics_process` is already "the `game_focused` gate first, then `check_ready_button_cooldown()`",
+# and vanilla `show_briefing_screen()` never resets the cooldown either.
+# In a real match everyone's window on their own machine has focus, so the cooldown ticks every frame and never gets stuck.
+# **Only our 8-instance test bench hits it** (7 windows without focus).
+# So this fix is **entirely gated behind `_mp8_auto_ready_armed`** (armed only by mp8fast / mp8ready),
+# and real matches behave frame for frame like vanilla — in line with "not a single byte of the vanilla code may change".
+#
+# ### 🩸 Why it only surfaced now
+#
+# The default test mode includes `mp8fast`, which sets `debug_instant_start`,
+# and **that path skips the pre-match briefing screen entirely** — client auto-ready had never actually run all the way through.
+# It only showed up after switching to `mp8ready` (which runs the full timing).
+#
+# **Rule of thumb - a switch meant "to run faster" may also skip the very logic you want to verify.**
+# This has the same root as pitfalls #10 and #20 — the `-Clean` section covers exactly this.
+func _mp8_tick_cooldown_offscreen() -> void :
+
+	if not _mp8_auto_ready_armed:
+		return
+	# A focused window goes through the vanilla path below, so don't tick the timer twice
+	if GameManager.game_focused:
+		return
+
+	check_ready_button_cooldown()
+
+
+func _mp8_tick_auto_ready() -> void :
+
+	if not _mp8_auto_ready_armed:
+		return
+	if _mp8_auto_ready_running or _mp8_auto_ready_done:
+		return
+	if not ready_button_press_allowed:
+		return
+	if button_ready == null or not button_ready.visible:
+		return
+	if is_ready:
+		return
+
+	_mp8_auto_ready_running = true
+	_mp8_auto_ready_countdown()
+
+
+func _mp8_auto_ready_countdown() -> void :
+
+	var base_text: String = ""
+	if label_ready_button:
+		base_text = label_ready_button.text
+
+	for remaining in range(MP8_AUTO_READY_SECONDS, 0, -1):
+
+		if not is_inside_tree():
+			_mp8_auto_ready_running = false
+			return
+		# If a person pressed it manually first, they get the final say. Don't auto-press again and toggle it back to not ready
+		if is_ready:
+			break
+
+		if label_ready_button:
+			label_ready_button.text = "%s (%d)" % [base_text, remaining]
+
+		await get_tree().create_timer(1.0, false).timeout
+
+	if label_ready_button:
+		label_ready_button.text = base_text
+
+	_mp8_auto_ready_running = false
+
+	if not is_inside_tree():
+		return
+	if is_ready:
+		return
+	if not ready_button_press_allowed:
+		return
+
+	_mp8_auto_ready_done = true
+	print("[MP8] Pre-match briefing: countdown finished, auto-readying")
+	_on_ready_button_pressed()
+
