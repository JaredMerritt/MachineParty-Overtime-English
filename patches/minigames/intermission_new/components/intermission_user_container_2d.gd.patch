diff --git a/minigames/intermission_new/components/intermission_user_container_2d.gd b/minigames/intermission_new/components/intermission_user_container_2d.gd
--- a/minigames/intermission_new/components/intermission_user_container_2d.gd
+++ b/minigames/intermission_new/components/intermission_user_container_2d.gd
@@ -25,6 +25,63 @@ var state: ContainerState = Intermission_UserContainer_2D.ContainerState.None
 
 func _ready() -> void :
 	hide_invite_button()
+	_mp8_apply_bold()
+
+
+# [MP8] Name length limit and font weight.
+#
+# Vanilla cuts names to 8 characters and appends "-" (anything over 9 characters gets cut), so most Steam names lose more than half.
+# Bolding uses FontVariation.variation_embolden. It needs no separate bold font file
+# and can synthesize bold for any font. Thin-stroke fonts like Terminal F4 especially need it once scaled down.
+#
+# ⚠️ Bolding makes text wider and competes for the same horizontal space as "longer names", so when tuning both, check the result visually.
+#
+# There is an **identical** copy of this block in the 3D intermission_user_container.gd.
+# It isn't pulled into a shared file because a new .gd means registering a new class_name, and the class_name table lives in
+# project.binary, so the project settings would need patching too. That is far riskier than copying these twenty lines.
+const MP8_NAME_MAX: int = 7   # User's final call 2026-08-15 (vanilla 9, tried 20)
+const MP8_BOLD: float = 0.12  # 0.3 was too heavy in testing and the holes inside the digits filled in (see HANDOFF T16)
+
+
+static func _mp8_arg_int(prefix: String, fallback: int) -> int:
+	for a in NetworkManager.mp8_args():
+		var t: String = String(a)
+		if t.begins_with(prefix):
+			return int(t.substr(prefix.length()))
+	return fallback
+
+
+static func _mp8_arg_float(prefix: String, fallback: float) -> float:
+	for a in NetworkManager.mp8_args():
+		var t: String = String(a)
+		if t.begins_with(prefix):
+			return float(t.substr(prefix.length()))
+	return fallback
+
+
+static func _mp8_format_name(_name: String) -> String:
+	var limit: int = maxi(_mp8_arg_int("mp8name=", MP8_NAME_MAX), 2)
+	if _name.length() > limit:
+		return _name.left(limit - 1) + "-"
+	return _name
+
+
+func _mp8_apply_bold() -> void :
+
+	var amount: float = _mp8_arg_float("mp8bold=", MP8_BOLD)
+	if is_equal_approx(amount, 0.0):
+		return
+
+	for label: Label in [label_rank, label_score, label_name]:
+		if not is_instance_valid(label):
+			continue
+		var base: Font = label.get_theme_font("font")
+		if base == null:
+			continue
+		var fv := FontVariation.new()
+		fv.base_font = base
+		fv.variation_embolden = amount
+		label.add_theme_font_override("font", fv)
 
 func _physics_process(_delta: float) -> void :
 	set_ready_visuals()
@@ -40,10 +97,7 @@ func set_user_data(_score: int, _name: String):
 	state = ContainerState.Normal
 
 	user_score_value = _score
-	var formatted_name = _name
-	if _name.length() > 9:
-		formatted_name = _name.left(8)
-		formatted_name += "-"
+	var formatted_name = _mp8_format_name(_name)  # [MP8] Vanilla cut names to 8 characters
 
 	label_score.text = "%04d" % _score
 	label_name.text = formatted_name
