 func _ready() -> void :
 	for child in get_parent().get_children():
 		user_container_array.append(child)
+	_mp8_apply_bold()
+
+
+# [MP8] Name length limit and font weight. **This block is identical to the one in intermission_user_container_2d.gd**,
+# and why it isn't pulled into a shared file is explained in the comment over there (a new class_name means patching project.binary too).
+# The only difference is that this one is a Label3D, so the font lives on the `font` property instead of a theme override.
+const MP8_NAME_MAX: int = 7   # User's final call 2026-08-15 (vanilla 9, tried 20)
+const MP8_BOLD: float = 0.12  # 0.3 was too heavy in testing and the holes inside the digits filled in (see HANDOFF T16)
+
+
+static func _mp8_arg_int(prefix: String, fallback: int) -> int:
+	for a in NetworkManager.mp8_args():
+		var t: String = String(a)
+		if t.begins_with(prefix):
+			return int(t.substr(prefix.length()))
+	return fallback
+
+
+static func _mp8_arg_float(prefix: String, fallback: float) -> float:
+	for a in NetworkManager.mp8_args():
+		var t: String = String(a)
+		if t.begins_with(prefix):
+			return float(t.substr(prefix.length()))
+	return fallback
+
+
+static func _mp8_format_name(_name: String) -> String:
+	var limit: int = maxi(_mp8_arg_int("mp8name=", MP8_NAME_MAX), 2)
+	if _name.length() > limit:
+		return _name.left(limit - 1) + "-"
+	return _name
+
+
+func _mp8_apply_bold() -> void :
+
+	var amount: float = _mp8_arg_float("mp8bold=", MP8_BOLD)
+	if is_equal_approx(amount, 0.0):
+		return
+
+	for label: Label3D in [label_rank, label_score, label_name]:
+		if not is_instance_valid(label):
+			continue
+		if label.font == null:
+			continue
+		var fv := FontVariation.new()
+		fv.base_font = label.font
+		fv.variation_embolden = amount
+		label.font = fv
+
 
 func _process(_delta: float) -> void :
 	check_to_switch_places_with_upstairs_container()
