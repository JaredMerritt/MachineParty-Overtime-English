+# [MP8] Tell the player "the device on your back right now is me".
+#
+# Why this is needed at all — `spine_breaker_device` in the player script is hard-set to the **first device** during setup_rpc().
+# Once two devices are in play, whoever carries the second one presses throw and the first one gets thrown — they can't shake off their own
+# and remotely send the other one away instead. So on attach the device identifies itself and the player remembers the current one.
+#
+# ⚠️ This has to be a call_local RPC, not just set on the server.
+# The player's _process uses this device's light_animation_player.speed_scale to sync the blinking,
+# and that runs on **every client**. On clients attached_to is empty (the state machine only transitions on the server),
+# so it can't be worked out from server data alone, and whoever carries the second device would see the first device's fuse rhythm.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_bind_rpc(player_path: NodePath) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+
+	var p = get_node_or_null(player_path)
+	if p == null:
+		# Failing to bind is the root cause of "the player carrying device 2 presses throw and sends device 1 flying", so it has to be visible
+		push_warning("[MP8] Spine Breaker: device %d can't bind to a player — node %s not found" % [
+			mp8_index, str(player_path)
+		])
+		if multiplayer.is_server():
+			print("[MP8] Spine Breaker: ⚠️ device %d failed to bind, path %s" % [mp8_index, str(player_path)])
+		return
+
+	p.mp8_current_device = self
+
+	# [MP8] Apply this device's color to the visual on his back — the device itself is already invisible by now,
+	# so whether players see red depends entirely on this line (see spine_breaker_player.mp8_set_visual_tint).
+	# Reapply it on every attach. If the previous device was red and this one is white, it has to be able to switch back.
+	var painted: int = p.mp8_set_visual_tint(mp8_tint, mp8_tex_key)
+
+	if multiplayer.is_server():
+		# Print how many surfaces got tinted too — the first version was "called but didn't tint a single surface",
+		# and the "bind succeeded" log alone gave no sign of the problem
+		print("[MP8] Spine Breaker: device %d bound to %s (tinted %d surfaces on the back visual)" % [
+			mp8_index, String(p.name), painted
+		])
+
 
