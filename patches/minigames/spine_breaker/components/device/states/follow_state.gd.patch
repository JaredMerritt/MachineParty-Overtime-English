--- a/minigames/spine_breaker/components/device/states/follow_state.gd
+++ b/minigames/spine_breaker/components/device/states/follow_state.gd
@@ -3,6 +3,54 @@ extends State
 var target: SpineBreakerPlayer
 var elapsed: float = 0.0
 
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Stuck → sidestep around (2026-08-17, user tested in practice "a grabbed player can block another device in place")
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# **Why this only happens with two devices** — once a player has A on their back, `has_spine_breaker = true`,
+# and B's `_mp8_can_take()` rules them out — B **can neither grab them nor push them away**,
+# so they can use their body to pin B in place. Vanilla only has one device, so bumping into it means getting grabbed and there's no deadlock.
+#
+# **Why "re-pathing" can't fix it** — NavigationAgent3D follows the navigation mesh,
+# and the mesh doesn't contain dynamic bodies like players or the other device at all — however many times it recalculates it gets the same path
+# and hits the same person. What actually works is **sidestepping along the obstacle for a bit**, getting around it and then rejoining the original path.
+const MP8_STUCK_RATIO: float = 0.35   # Actual movement < this fraction of intended movement = being blocked
+const MP8_STUCK_SECS: float = 0.5     # Must be blocked this long in a row to count as stuck (so a brief bump doesn't trigger a detour)
+const MP8_DODGE_SECS: float = 0.8     # How long one detour lasts
+
+var _mp8_stuck: float = 0.0
+var _mp8_dodge_left: float = 0.0
+var _mp8_dodge_dir: Vector3 = Vector3.ZERO
+var _mp8_dodge_count: int = 0
+
+# ═════════════════════════════════════════════════════════════════════════
+# [MP8] 🩸 Deadlocked target — locked onto **someone it can never latch onto** (reported by the user from real gameplay on 2026-08-24)
+# ═════════════════════════════════════════════════════════════════════════
+#
+# **The user's exact words** — "If one person already has a device on them and someone else throws a device near them,
+#   the second device can't get on them, but it keeps chasing them forever and never changes target"
+#
+# **We introduced this ourselves when T37 fixed double attaching.** The fallback in `thrown_state` when it can't stick is
+# `transition_to("Follow", {target: body})`, and the old comment said "the device on his back will sooner or later
+# be thrown off or reset after its kill" — **that was wrong**, because the chain below has no way out at all.
+#
+#   1. In `update_proximity_check()`, `_mp8_can_take(target)` is always false
+#      (`has_spine_breaker`), so this person gets skipped by `continue` — it can neither latch onto nor select them.
+#   2. The target switch is `if closest != target: if closest_distance < target_distance:`,
+#      and `target_distance` **is always INF and nothing ever assigns it** (vanilla is like this, we didn't touch it)
+#      — so it only switches when "there's another person nearby it can latch onto". Nobody nearby = no switch.
+#   3. `request_new_target` **is only sent from Idle after BreakSpine**,
+#      and getting into BreakSpine requires latching on first — if it can't latch on it can never send it.
+#
+# Conclusion — once it locks onto someone carrying a device with nobody else nearby, this device **circles them forever**.
+#
+# The fix is, when the current target turns out to be impossible to latch onto, to proactively ask the host for a new target
+# (using the existing reassignment path that runs after a kill).
+# It uses a **cooldown** rather than a one-shot flag — `_mp8_pick_prey()` can legitimately return null when "every candidate
+# was filtered out", and then it has to ask again a bit later, otherwise it hangs again.
+const MP8_DEADEND_RETRY: float = 4.0   # Longer than the longest MP8_DEVICE_WAIT (3 sec) so it doesn't fight the reassignment
+var _mp8_deadend_cd: float = 0.0
+
 func init() -> void :
 
 	owner.navigation_update_timer.timeout.connect(_on_navigation_timer_timeout)
@@ -21,6 +69,12 @@ func enter(_msg: Dictionary = {}) -> void :
 	state_time = 0.0
 	elapsed = 0.0
 
+	# [MP8] Reset the detour state "per chase" — otherwise detour state built up in the previous chase carries over to the new target
+	_mp8_stuck = 0.0
+	_mp8_dodge_left = 0.0
+	_mp8_dodge_count = 0
+	_mp8_deadend_cd = 0.0
+
 	var new_target = _msg.get("target", null)
 	var is_new_target: bool = _msg.get("new_target", false)
 
@@ -39,6 +93,12 @@ func update(_delta: float) -> void :
 
 func update_physics(_delta: float) -> void :
 
+	# [MP8] This goes at the **very start** and not after `update_proximity_check()`.
+	# That call does `transition_to("Attached")` when it touches someone, and after the transition the rest of this frame's code
+	# still runs to the end — by then `target.has_spine_breaker` has already been set to true,
+	# so putting it after would make **a device that just latched on falsely report a deadlock on the spot**.
+	_mp8_check_dead_end(_delta)
+
 	var increase_ratio = elapsed / owner.speed_increase_duration
 	var elapsed_speed = increase_ratio * owner.speed_increase_over_time
 
@@ -48,13 +108,120 @@ func update_physics(_delta: float) -> void :
 	var current_agent_position: Vector3 = owner.global_position
 	var next_path_position: Vector3 = owner.navigation_agent.get_next_path_position()
 
-	owner.velocity = current_agent_position.direction_to(next_path_position) * (owner.speed + elapsed_speed)
+	var dir: Vector3 = current_agent_position.direction_to(next_path_position)
+
+	# [MP8] During a detour swap the direction for the sidestep direction (it's mixed with the original direction, so it "slides past at an angle" instead of spinning in place)
+	if _mp8_dodge_left > 0.0:
+		_mp8_dodge_left -= _delta
+		dir = _mp8_dodge_dir
+
+	owner.velocity = dir * (owner.speed + elapsed_speed)
 	owner.velocity.y = vertical_velocity
 
+	var before: Vector3 = owner.global_position
 	owner.move_and_slide()
+	_mp8_check_stuck(_delta, before, dir)
 
 	update_proximity_check()
 
+
+# [MP8] How far it wanted to move this frame vs how far it actually moved. If the gap is too big, it's being blocked.
+# Uses the movement ratio instead of "is velocity zero", because when move_and_slide hits a wall the velocity is still there, it just can't move.
+func _mp8_check_stuck(_delta: float, before: Vector3, dir: Vector3) -> void :
+
+	if _mp8_dodge_left > 0.0:      # Detour in progress, let it finish first
+		return
+
+	var want: float = Vector2(owner.velocity.x, owner.velocity.z).length() * _delta
+	var got: float = Vector2(
+		owner.global_position.x - before.x, owner.global_position.z - before.z
+	).length()
+
+	if want <= 0.001 or got >= want * MP8_STUCK_RATIO:
+		_mp8_stuck = 0.0
+		return
+
+	_mp8_stuck += _delta
+	if _mp8_stuck < MP8_STUCK_SECS:
+		return
+
+	_mp8_stuck = 0.0
+	_mp8_dodge_dir = _mp8_pick_dodge(dir)
+	_mp8_dodge_left = MP8_DODGE_SECS
+	_mp8_dodge_count += 1
+
+	# Only report the first one per chase. That's enough to see "this device is detouring" without spamming the log
+	if _mp8_dodge_count == 1 and multiplayer.is_server():
+		print("[MP8] Spine Breaker: device %d is blocked, switching to a sideways detour (target %s)" % [
+			owner.mp8_index, (String(target.name) if target != null else "?")
+		])
+
+
+# Pick the detour direction. Take the tangents of the blocking surface's normal and pick the one of the two that **doesn't head backwards**.
+# If there's no normal (for example wedged between two bodies), fall back to "perpendicular to the current heading".
+func _mp8_pick_dodge(dir: Vector3) -> Vector3 :
+
+	var n: Vector3 = Vector3.ZERO
+	for i in owner.get_slide_collision_count():
+		var cn: Vector3 = owner.get_slide_collision(i).get_normal()
+		if absf(cn.y) < 0.7:        # Ignore the floor, only vertical surfaces
+			n = cn
+			break
+
+	var side: Vector3 = (n.cross(Vector3.UP) if n != Vector3.ZERO else dir.cross(Vector3.UP))
+	side.y = 0.0
+	if side.length() < 0.01:
+		return dir
+	side = side.normalized()
+
+	if side.dot(dir) < 0.0:         # Pick the tangent on the same side as the original direction
+		side = - side
+
+	# Mix in a little of the original direction. It still leans toward the target while detouring, so once past it naturally rejoins the original path
+	return (side * 0.8 + dir * 0.4).normalized()
+
+
+# [MP8] Can I latch onto this person?
+#
+# Vanilla has **no checks at all**. Distance <1.45 means Attached, and body_entered is unconditional too.
+# With one device that's fine, but with two things go wrong —
+#   * Two devices can latch onto the same person at once. Two 10-second fuses run in parallel, the person dies when the first burns out,
+#     the second device is still attached to the corpse, and when its activation_timer runs out it does BreakSpine on the dead person again.
+#   * A dead person's collision layer is turned off (set_collision_layer_value(1,false) in break_spine_rpc),
+#     so in theory they can't enter the Area3D, but players_in_proximity is an array we maintain ourselves,
+#     and missing a single exit signal leaves a dead person's reference behind.
+# So each case is blocked here one by one.
+func _mp8_can_take(p) -> bool :
+
+	if p == null or not is_instance_valid(p):
+		return false
+	if not (p is SpineBreakerPlayer):
+		return false
+	if not p.active:
+		return false
+	if p.has_spine_breaker:
+		return false
+	return true
+
+
+# Can I **make them my target** (one more rule than _mp8_can_take — don't steal someone another device is already locked onto).
+#
+# Why split this into two rules? `choose_new_target` already avoids the other device when assigning targets,
+# but while the device is on its way, update_proximity_check() below switches target to
+# "the closest one nearby" — that vanilla logic ignores who the other device is chasing, so both devices converge on the same person again
+# (user tested in practice, "the aggro locks onto one person at the same time").
+#
+# ⚠️ But **the contact check (distance < 1.45) is not bound by this rule**. If it's already touching and still won't stick,
+#    players will just think the device is broken. Stealing or not is a "choosing a target" matter, sticking or not is a "made contact" matter.
+func _mp8_can_target(p) -> bool :
+
+	var gi = owner.game_instance
+	if gi != null and gi.has_method("mp8_is_claimed_by_other"):
+		if gi.mp8_is_claimed_by_other(p, owner):
+			return false
+	return true
+
+
 func update_proximity_check():
 
 	var target_distance: float = INF
@@ -62,14 +229,27 @@ func update_proximity_check():
 	var closest = null
 	var closest_distance = target_distance
 	for p in owner.players_in_proximity:
+
+		if not _mp8_can_take(p):        # [MP8]
+			continue
+
 		var distance = owner.global_position.distance_to(p.global_position)
-		if distance < closest_distance:
 
-			if distance < 1.45:
-				state_machine.transition_to(&"Attached", {
-					"target": p
-				})
-				return
+		# [MP8] The contact check is moved up front and is **not bound by "don't steal someone else's target"** (see the comment on _mp8_can_target).
+		# ⚠️ Moving it out of `if distance < closest_distance` is equivalent to vanilla case by case, not a behavior change.
+		#    It used to be nested inside, but closest_distance only ever goes down — the only way someone <1.45 could be excluded
+		#    is if someone even closer came earlier, and that person would be <1.45 themselves and would already have returned.
+		#    So "the first person to come within 1.45 triggers it" holds either way it's written.
+		if distance < 1.45:
+			state_machine.transition_to(&"Attached", {
+				"target": p
+			})
+			return
+
+		if not _mp8_can_target(p):      # [MP8] Ownership only matters when switching targets
+			continue
+
+		if distance < closest_distance:
 
 			closest_distance = distance
 			closest = p
@@ -78,6 +258,46 @@ func update_proximity_check():
 		if closest_distance < target_distance:
 			set_target(closest, false)
 
+# [MP8] See the block above MP8_DEADEND_RETRY at the top of the file. If the target can't be latched onto anymore, ask the host for a new one.
+#
+# ⚙ The check uses `_mp8_can_take` instead of only `has_spine_breaker`. Dead players and stale references
+#    are also "never latchable", so they're covered too (for example another device killed him first and this one is still chasing the corpse).
+# ⚙ Only sent on the server. The `request_new_target` wiring in `spine_breaker.gd` is already wrapped in
+#    `if multiplayer.is_server():`, so if a client sends it nobody is listening.
+# ⚙ Return right away when `not active`. This frame has already transitioned out of Follow, so it shouldn't step in.
+func _mp8_check_dead_end(_delta: float) -> void :
+
+	if not active:
+		return
+
+	if _mp8_deadend_cd > 0.0:
+		_mp8_deadend_cd -= _delta
+		return
+
+	if target == null:
+		return
+	if _mp8_can_take(target):
+		return
+
+	_mp8_deadend_cd = MP8_DEADEND_RETRY
+
+	if not multiplayer.is_server():
+		return
+
+	var who: String = "?"
+	var why: String = "reference no longer valid"
+	if is_instance_valid(target):
+		who = String(target.name)
+		if target.has_spine_breaker:
+			why = "already carrying a device"
+		elif not target.active:
+			why = "dead"
+	print("[MP8] Spine Breaker: device %d is locked onto %s but can never latch on (%s) — requesting a new target" % [
+		owner.mp8_index, who, why
+	])
+	owner.request_new_target.emit()
+
+
 func set_target(_target: SpineBreakerPlayer, new_target: bool):
 	target = _target
 
@@ -107,6 +327,9 @@ func _on_player_attach_entered(body):
 	if body is not SpineBreakerPlayer:
 		return
 
+	if not _mp8_can_take(body):        # [MP8] Don't latch onto someone already carrying a device / a dead person
+		return
+
 	state_machine.transition_to(&"Attached", {
 		"target": body
 	})
