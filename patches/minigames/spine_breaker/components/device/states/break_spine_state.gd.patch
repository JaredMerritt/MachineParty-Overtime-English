diff --git a/minigames/spine_breaker/components/device/states/break_spine_state.gd b/minigames/spine_breaker/components/device/states/break_spine_state.gd
--- a/minigames/spine_breaker/components/device/states/break_spine_state.gd
+++ b/minigames/spine_breaker/components/device/states/break_spine_state.gd
@@ -17,9 +17,41 @@ func enter(_msg: Dictionary = {}) -> void :
 
 	target = _msg.get("target")
 
+	# ═══════════════════════════════════════════════════════════════════════
+	# [MP8] 🩸 If the target is already dead, don't enter this flow — it will hang
+	# ═══════════════════════════════════════════════════════════════════════
+	#
+	# The reset below is driven by `target.spine_broken`, a **one-shot signal**. If we run it again on someone
+	# who is already dead, `break_spine_rpc` is doing await 0.5 + await 0.5, so the signal may have finished
+	# firing before we connect — then `_on_spine_broken` never arrives, and since this state's
+	# update/update_physics are both empty, this device **stays stuck in BreakSpine forever**.
+	#
+	# This is exactly the second half of "both Spine Breakers stopped moving", reported by the user from a 6-player match with real players on 2026-08-18.
+	# The first half (two devices stuck to the same person) is already blocked in thrown_state. This is the **second gate**.
+	# Even if some future path gets around it, we only miss one kill instead of hanging the device.
+	if target == null or not is_instance_valid(target) or not target.active:
+		if multiplayer.is_server():
+			print("[MP8] Spine Breaker: the person device %d was going to execute is already dead — skipping, going straight to find a new target" % owner.mp8_index)
+		owner.light_animation_player.stop()
+		# ⚠️ Can't call transition_to synchronously in enter() (the state machine is midway through this very transition),
+		# so call_deferred pushes it to the end of this frame. When Idle receives after_break it sends request_new_target.
+		state_machine.call_deferred("transition_to", &"Idle", {"after_break": true})
+		return
+
 	owner.light_animation_player.stop()
 	target.blink_animation_player.stop()
 
+	# [MP8] Which death number does this kill make? Ask here rather than after the person is actually dead —
+	# the vanilla order is spine_broken.emit() (device resets) **first** and emit_died (main script tallies) **after**,
+	# so by the time the main script knows "the 4th one died", the device has long since reset and run off to its next target.
+	# mp8_claim_retire() is first come, first served. When two devices are killing at the same time only one of them gets to retire,
+	# otherwise both retire, no device is left on the field, and this round can never end.
+	# [MP8] Pass the victim along too — the main script uses it to dedupe (one life cut once by each of two devices counts as a single kill).
+	if owner.game_instance != null and owner.game_instance.has_method("mp8_claim_retire"):
+		if owner.game_instance.mp8_claim_retire(target):
+			owner.mp8_retired = true
+			print("[MP8] Spine Breaker: device %d stays on after this kill (2 players left after it, keeping 1 device for the 1v1), leaving rotation" % owner.mp8_index)
+
 	fallback_position = target.global_position
 	target.spine_broken.connect(_on_spine_broken, CONNECT_ONE_SHOT)
 	target.break_spine_rpc.rpc()
@@ -37,6 +69,25 @@ func update_physics(_delta: float) -> void :
 
 func _on_spine_broken():
 
+	# [MP8] The retired device skips the whole reset and simply stays in the BreakSpine state.
+	#   * No global_position = fallback_position → the device stays 100 m underground where it was moved while attached, out of the way.
+	#   * No spine_broken_exited_rpc() → it doesn't reappear and its light doesn't turn green.
+	#   * **No target.set_spine_breaker_rpc(false)** → the device visual on the corpse's back stays lit,
+	#     which is exactly the "device won't come off him" look.
+	#   * No transition_to(Idle, after_break) → no request_new_target is sent, so this device leaves rotation for good.
+	# The state machine stays in BreakSpine, and since this state's update/update_physics are both empty, it won't move again.
+	if owner.mp8_retired:
+		print("[MP8] Spine Breaker: device %d is pinned to the corpse (no reset, no new target, lights off)" % owner.mp8_index)
+		# Lights-off has to be broadcast. The blinking of the device visual on the corpse's back is driven by **each client on its own** in _process
+		# from this device's light_animation_player.speed_scale (see mp8_retire_quiet_rpc).
+		if target != null and is_instance_valid(target):
+			owner.mp8_retire_quiet_rpc.rpc(target.get_path())
+		return
+
+	print("[MP8] Spine Breaker: device %d reset after the kill to (%.2f, %.2f)" % [
+		owner.mp8_index, fallback_position.x, fallback_position.z
+	])
+
 	owner.global_position = fallback_position
 	owner.force_update_transform()
 
