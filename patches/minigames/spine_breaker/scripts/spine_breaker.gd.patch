+# [MP8] Tint a device's body and return how many surfaces were tinted.
+#
+# ⚠️⚠️ **Never modify the material itself directly** (writing something like `mat.albedo_color = red`).
+# probe44 confirmed the body material is `StandardMaterial3D_66jhi` **embedded in device.tscn**,
+# and two devices instanced from the same .tscn **point to the same resource object** — changing it turns device 1 red too,
+# and resources are cached across matches, so it stays red in the next match and the next minigame (T19's "runs farther every match"
+# was left over from modifying a resource).
+#
+# The right way is `set_surface_override_material()` — the override material lives on the **MeshInstance3D node**,
+# and each device has its own node. Duplicate the material and change the copy, so not a single byte of the original resource is touched.
+# (It duplicates a **resource**, not a **node**, so it doesn't violate pitfall #14, "don't create new scene nodes when padding arrays".)
+#
+# Only tint surfaces that "already have a StandardMaterial3D and are visible".
+# The sphere at `Visuals/MeshInstance3D` is a `visible=false` helper with no material,
+# and forcing an override material onto it would conjure a red ball out of nowhere.
+func _mp8_tint_device(d, c: Color) -> int :
+
+	if not is_instance_valid(d):
+		return 0
+
+	var n: int = 0
+
+	for mi in d.find_children("", "MeshInstance3D", true, false):
+
+		if not mi.visible or mi.mesh == null:
+			continue
+
+		for s in mi.mesh.get_surface_count():
+
+			var src = mi.get_active_material(s)
+			if not (src is StandardMaterial3D):
+				continue
+
+			var sd: StandardMaterial3D = src
+
+			# Record the body texture key while we're here (**the white device needs it too**, whether or not it gets tinted).
+			# After attaching, it's used to pick out which surface is the device among the meshes on the player's back.
+			if d.mp8_tex_key == "" and sd.albedo_texture != null:
+				var f: String = str(sd.albedo_texture.resource_path).get_file()
+				var us: int = f.rfind("_")
+				d.mp8_tex_key = (f.substr(us + 1) if us >= 0 else f)
+
+			if c == Color.WHITE:
+				continue
+
+			# Skip if already tinted — this function runs every round, and without this check it would duplicate another material every round
+			if mi.get_surface_override_material(s) != null:
+				continue
+
+			var m: StandardMaterial3D = sd.duplicate()
+			m.albedo_color = c
+			mi.set_surface_override_material(s, m)
+			n += 1
+
+	return n
+
