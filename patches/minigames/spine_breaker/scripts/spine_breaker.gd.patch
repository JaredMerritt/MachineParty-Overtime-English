+# Command line `mp8spinefuse=<seconds>` overrides the fuse of **all** devices with the same value. Returns 0 if not passed.
+# It's "override all" on purpose — its whole point is **manually creating lockstep** to reproduce the "two people die at the same time" issue
+# (two devices with equal fuses kill on the same frame, see the MP8_DEVICE_FUSE section).
+func _mp8_fuse_forced() -> float :
+
+	for a in NetworkManager.mp8_args():
+		var s: String = str(a)
+		if s.begins_with("mp8spinefuse="):
+			var v: String = s.substr(len("mp8spinefuse="))
+			if v.is_valid_float():
+				return clampf(float(v), 1.0, 60.0)
+
+	return 0.0
+
