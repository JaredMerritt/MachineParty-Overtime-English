+	push_warning("[MP8] Spine Breaker: %d enabled points aren't enough for %d players, duplicate spawn points in use" % [enabled, n])
+	var fill: Array = []
+	for i in n:
+		fill.append(idx[i % idx.size()])
+	return _mp8_rows(fill)
+
+
+# Pick a landing spot for each device, ≥ gap m from all players and **from the other device**, relaxing one meter at a time if none fit.
+# If no spot is found for a device, it keeps its original scene position — the vanilla position is far from players, which is safer than forcing a point-blank spot.
+func _mp8_place_devices(player_pts: Array) -> void :
+
+	if _mp8_pool.is_empty():
+		return
+
+	# Occupied points. Starts as all player spawn points, and each device gets added once it's placed
+	var occupied: Array = player_pts.duplicate()
+
+	for d in _mp8_devices:
+
+		if not is_instance_valid(d):
+			continue
+
+		var spot = _mp8_find_device_spot(occupied, player_pts.size())
+		if spot == null:
+			print("[MP8] Spine Breaker: device %d can't find a spot ≥%.0f m from everyone, keeping its original position" % [
+				d.mp8_index, MP8_DEVICE_MIN_GAP
+			])
+			continue
+
+		mp8_device_place_rpc.rpc(d.get_path(), spot)
+		occupied.append(spot)
+		print("[MP8] Spine Breaker: device %d placed at (%.2f, %.2f), %.1f m from the nearest player" % [
+			d.mp8_index, spot.x, spot.z, _mp8_min_dist(spot, player_pts)
+		])
+
+
+func _mp8_find_device_spot(occupied: Array, n: int):
+
+	var enabled: int = int(MP8_POOL_BY_COUNT.get(n, _mp8_pool.size()))
+	enabled = maxi(mini(enabled, _mp8_pool.size()), 1)
+
+	var cand: Array = range(enabled)
+	# No randomness in manual editing mode. The user is adjusting points against the screen, and devices jumping somewhere new every match would make comparison impossible
+	if not _mp8_edit_on:
+		cand.shuffle()
+
+	var gap: float = MP8_DEVICE_MIN_GAP
+	while gap > 0.0:
+		for i in cand:
+			var p: Vector3 = _mp8_pool[i][0]
+			if _mp8_min_dist(p, occupied) >= gap:
+				return p
+		gap -= 1.0
+
+	return null
+
+
+func _mp8_min_dist(p: Vector3, pts: Array) -> float :
+	var best: float = INF
+	for q in pts:
+		best = minf(best, p.distance_to(q))
+	return best
+
+
+func _mp8_enable_desc() -> String :
+	var parts := PackedStringArray()
+	for n in [4, 5, 6, 7, 8]:
+		parts.append("%d players→first %d" % [n, int(MP8_POOL_BY_COUNT.get(n, _mp8_pool.size()))])
+	return "  ".join(parts)
+
+
+# Each peer places its own copy of the device.
+# ⚠️ Setting global_position on the server alone isn't enough. The device's physics only runs on the server
+# (its _ready() calls set_physics_process(false) on non-servers), so the client copies have to be aligned by this RPC,
+# otherwise each machine would see the devices in different positions at the start.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_device_place_rpc(dev_path: NodePath, pos: Vector3) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not (NetworkManager.mp8_finite_v3(pos)):
+		return
+
+	var d = get_node_or_null(dev_path)
+	# Only this minigame's own devices can be moved, never an arbitrary node picked by path
+	if d == null or not is_instance_valid(d) or not (d == device or _mp8_devices.has(d)):
+		return
+	d.global_position = pos
+	d.velocity = Vector3.ZERO
+
+
+# ───────────────────────────── Second device
+
+func _mp8_want_devices(n: int) -> int :
+	return int(MP8_DEVICES_BY_COUNT.get(n, 1))
+
+
+# Each peer gets its own devices ready. **Every end has to create them**. device.tscn comes with a MultiplayerSynchronizer,
+# which pairs up by "the node path matching on both ends", so the name (MP8Device2) and parent must be the same on both sides.
+#
+# ⚠️ Use load(), not preload(). preload resolves at script **load time**, so one wrong path means
+# the whole script fails to load → all 8 screens go black (the pitfall #24 kind). A failed load just gives null here.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_ensure_devices_rpc(want: int) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+
+	if device == null or not is_instance_valid(device):
+		return
+
+	want = clampi(want, 1, 4)
+
+	while _mp8_devices.size() < want:
+
+		var ps = load(MP8_DEVICE_SCENE)
+		if ps == null:
+			push_warning("[MP8] Spine Breaker: can't load the device scene %s, giving up on the second device" % MP8_DEVICE_SCENE)
+			return
+
+		var idx: int = _mp8_devices.size() + 1
+		var d = ps.instantiate()
+		d.name = "MP8Device%d" % idx
+		device.get_parent().add_child(d)
+
+		# Back-reference normally set via @export. The instanced device doesn't know which minigame it belongs to
+		d.game_instance = self
+		d.mp8_index = idx
+		d.global_position = device.global_position
+
+		# The fuse isn't copied here anymore — both devices get set individually from MP8_DEVICE_FUSE below (and deliberately unequal).
+		# (probe43 compared every property. The main scene only overrides activation_duration on Device,
+		#  and everything else is identical to device.tscn, so there's nothing but the fuse to align.
+		#  The previous version lazily copied 11 properties, which introduced 10 variables with no basis — we don't do that.)
+
+		# ⚠️ The two devices **don't collide with each other**.
+		# On attach a device is moved to Vector3.DOWN * 100 — both devices end up at **the same point**.
+		# When each comes off a person they reset almost simultaneously and re-enable their collision layers, and once the two colliders overlap
+		# the physics engine shoves the CharacterBody3D away violently (user tested in practice, the device flew up into the sky).
+		# Vanilla only has one device, which can never collide with itself, so this problem came in with the second device.
+		# Collision exceptions are used instead of changing collision_layer, since they only affect these two bodies,
+		# and collisions with the floor, walls and players aren't touched at all.
+		for other in _mp8_devices:
+			if is_instance_valid(other):
+				d.add_collision_exception_with(other)
+				other.add_collision_exception_with(d)
+
+		_mp8_devices.append(d)
+
+		# Signals are only connected on the server (vanilla _ready splits it the same way)
+		if multiplayer.is_server():
+			d.request_new_target.connect(_on_device_requested_target.bind(d))
+
+		print("[MP8] Spine Breaker: device %d in place (%s)" % [idx, str(d.get_path())])
+
+	# [MP8] Set the fuse and speed for each device. **Device 1 needs it too** — it's the one the main scene overrides to 20 sec.
+	# This function is a call_local broadcast, so every device on every machine gets set.
+	var forced: float = _mp8_fuse_forced()
+	var parts: PackedStringArray = []
+
+	for i in _mp8_devices.size():
+
+		var d = _mp8_devices[i]
+		if not is_instance_valid(d):
+			continue
+
+		var fuse: float = (forced if forced > 0.0 else float(
+			MP8_DEVICE_FUSE[i] if i < MP8_DEVICE_FUSE.size() else MP8_DEVICE_FUSE[0]
+		))
+		var sp: float = float(
+			MP8_DEVICE_SPEED[i] if i < MP8_DEVICE_SPEED.size() else MP8_DEVICE_SPEED[0]
+		)
+
+		d.activation_duration = fuse
+
+		# ⚠️ Speed is **multiplied**, so the baseline must be recorded and multiplied, not the current value multiplied again and again —
+		# this function runs once every round and devices are reused across rounds, so multiplying by 1.2 two rounds in a row gives 1.44
+		# (Manufacture Gun's falling-rock multiplier tripped over this, see _mp8_cd_base in manufacture_gun_player).
+		if d.mp8_speed_base.is_empty():
+			d.mp8_speed_base = [
+				d.default_speed, d.new_target_speed, d.speed_increase_over_time
+			]
+		d.default_speed = d.mp8_speed_base[0] * sp
+		d.new_target_speed = d.mp8_speed_base[1] * sp
+		d.speed_increase_over_time = d.mp8_speed_base[2] * sp
+
+		var tint: Color = (
+			MP8_DEVICE_TINT[i] if i < MP8_DEVICE_TINT.size() else MP8_DEVICE_TINT[0]
+		)
+		# The device keeps a copy too. After attaching, the device itself is invisible, so whether it shows red depends on carrying this over to the player's back
+		d.mp8_tint = tint
+		var painted: int = _mp8_tint_device(d, tint)
+
+		var wait: float = _mp8_wait_for(d)
+
+		parts.append("device %d fuse %.1fs + wait %.1fs = cycle %.1fs %.2fx speed (%.1f→%.1f m/s)%s tex key=%s" % [
+			i + 1, fuse, wait, fuse + wait,
+			sp, float(d.mp8_speed_base[1]), d.new_target_speed,
+			("" if painted <= 0 else " tinted %d surfaces" % painted),
+			(d.mp8_tex_key if d.mp8_tex_key != "" else "❌not found")
+		])
+
+	if _mp8_devices.size() > 0:
+		print("[MP8] Spine Breaker: this match has %d players → %d devices, retiring on kill %d — %s" % [
+			PlayerManager.player_presences.size(), _mp8_devices.size(),
+			_mp8_retire_at(), " | ".join(parts)
+		])
+
+
+# Wipe the devices clean at the start of each round. Only touch **state this mod introduced** and what attaching leaves behind.
+# The retired device stays in BreakSpine, invisible, with collisions off, 100 m underground,
+# and without a reset it would be an invisible dud in round two. Position doesn't matter, since _mp8_place_devices re-places them every round.
+#
+# ⚠️ Vanilla's active / deactivated fields are **deliberately left alone** — nothing in the whole script reads them
+# (active is only read in device's navigation handler, which always returns),
+# so they're dead variables, and touching them might wake up some branch nobody has ever run.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_device_reset_rpc() -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+
+	for d in _mp8_devices:
+
+		if not is_instance_valid(d):
+			continue
+
+		# First fully detach any device still riding someone, then switch to Idle.
+		# Switching to Idle only runs attached_state.exit() (which only clears can_kick / attached_to)
+		# and **doesn't** call target.set_spine_breaker_rpc(false),
+		# so the device visual on last round's victim would stay — and the next round would start with an extra ghost device.
+		# Properties are changed directly here instead of sending an RPC. This function is itself a call_local broadcast, so each end clears its own.
+		if d.attached_to != null and is_instance_valid(d.attached_to):
+			var victim = d.attached_to
+			victim.has_spine_breaker = false
+			victim.mp8_current_device = null
+			if victim.spine_breaker_visual != null:
+				victim.spine_breaker_visual.visible = false
+			victim.set_spinebreaker_visuals()
+
+		d.mp8_retired = false
+		d.attached_to = null
+		d.is_attached = false
+		d.breaking_spine = false
+		d.can_kick = true
+		d.can_proximity_target = true
+		d.can_proximity_attach = true
+		d.players_in_proximity.clear()
+		d.visible = true
+		d.set_collision_layer_value(1, true)
+		d.set_collision_mask_value(1, true)
+
+		if multiplayer.is_server():
+			d.state_machine.transition_to(&"Idle")
+
+
+# Claim "retirement". For the 4th person killed by a device, the device that killed them stays pinned on them (set by the user on 2026-08-17).
+#
+# First come, first served, and **only handed out once**. Two devices may be killing at the same time, and without this gate both would retire —
+# no device left on the field, active_players can never go down again, check_game_end() never sees <=1,
+# and this round hangs (this match has no timeout fallback at all).
+#
+# ⚠️⚠️ **The check can't count dead_players — the version that counted it never worked once.** (Fixed 2026-08-17)
+#
+#   It used to withhold it if `dead_players.size() != MP8_RETIRE_AFTER_DEATHS - 1`,
+#   meaning "exactly 3 must already be dead". But dead_players is appended in _on_player_died,
+#   while this function is called in BreakSpine.enter() (the moment the blow lands) — a whole death animation sits between the two.
+#   The comment over in BreakSpine spells out this lag itself, yet the lagging count was still used for a **strict equality** check.
+#
+#   Tested in practice (8-player match on 08-17 at 02:41, the log has since been overwritten by a later Manufacture Gun match).
+#   Deaths 1/2/3/4 all printed "retirement slot: not yet", and it was never claimed even once.
+#   When the two devices struck one after another, both enter() calls happened before the 3rd death was recorded → the count was 2 at that moment,
+#   and by the time it was recorded it had jumped to 4 — **the strict equality window was skipped over entirely**,
+#   and since dead_players only ever grows, once past 3 the equality never holds again = it can never be handed out for the rest of the round.
+#
+#   Now it counts **how many times the devices themselves struck** (one call to this function = one blow),
+#   which is the same thing as "which person killed by a device this is", and isn't affected by the bookkeeping lag.
+#   The check uses `<` rather than `==`. If a count is ever missed, the next blow makes up for it, so "miss it and it's gone forever" can't happen again.
+#
+# ⚠️ Bookkeeping only happens on the server. Clients never get it today either (their dead_players is always empty,
+#    since player nodes are spawned server-side and emit_died is connected there), but it's blocked explicitly here —
+#    with the new check the client's count would go up on its own, and without the block it would mark a device as retired
+#    while the server didn't, and the two sides' screens would stop matching from then on.
+# victim can be omitted (old call sites), but it has to be passed for deduping to work — see the section below.
+func mp8_claim_retire(victim = null) -> bool :
+
+	if not multiplayer.is_server():
+		return false
+
+	# [MP8] 🩸 One life only counts as one blow.
+	#
+	# In the user's 6-player match with real players on 2026-08-18, two devices were stuck to the same person, and when each fuse ran out
+	# **each called this function once for the same life**, so `_mp8_kills_started` was inflated —
+	# in a 6-player match the retirement slot should only go out on the 4th blow, but it may have gone out when the 3rd person died,
+	# leaving only one device on the field too early. (The actual "two devices stuck" issue is already blocked in thrown_state,
+	# and this is the third gate. Even if that gets bypassed again, **the retirement timing won't be miscounted**.)
+	#
+	# Dedupe by network_id rather than node reference. The node is still alive during the death animation, but the id is stable.
+	if victim != null and is_instance_valid(victim):
+		var vid = victim.player_presence.network_id if victim.player_presence != null else -1
+		if vid != -1:
+			if _mp8_counted_victims.has(vid):
+				print("[MP8] Spine Breaker: %s has already been counted as a blow, not counting it again (means two devices are stuck to the same person)" % String(victim.name))
+				return false
+			_mp8_counted_victims.append(vid)
+
+	_mp8_kills_started += 1
+
+	if _mp8_retire_claimed:
+		return false
+	if _mp8_devices.size() < 2:              # Matches with only one device (4~5 players) don't retire
+		return false
+	if _mp8_kills_started < _mp8_retire_at():
+		return false
+
+	_mp8_retire_claimed = true
+	return true
+
+
+func _mp8_rows(indices: Array) -> Array :
+	var out: Array = []
+	for i in indices:
+		out.append([_mp8_pool[i][0], float(_mp8_pool[i][1])])
+	return out
+
+
+# ───────────────────────────── Checks (the manual editing panel shows these two live)
+
+# Navigation mesh. The device chases players with NavigationAgent3D, so it can't reach anyone whose spawn point is off the mesh.
+# ⚠️ Query the runtime NavigationServer3D. Don't do your own XZ point-in-polygon test against navmesh vertices —
+#    this mesh has **multiple levels** (probe41 measured y∈[0.50, 6.50]), so a projection check would misjudge.
+# ⚠️ The world has to come from camera, **don't write self.get_world_3d()** — `Minigame extends Node` (not
+#    Node3D), so self doesn't have that method at all and it errors with Nonexistent function at runtime.
+#    Vanilla's `_physics_process` also uses `camera.get_world_3d()`, for exactly this reason.
+#    (parsecheck checks scopes, not whether methods exist, so it can't catch this — an extension of pitfall #24.)
+func _mp8_on_navmesh(pos: Vector3) -> bool :
+	if camera == null:
+		return true
+	var map: RID = camera.get_world_3d().navigation_map
+	if not map.is_valid():
+		return true
+	var closest: Vector3 = NavigationServer3D.map_get_closest_point(map, pos)
+	return Vector2(closest.x - pos.x, closest.z - pos.z).length() <= MP8_NAV_TOL
+
+
+# The camera is **fixed** (it doesn't follow), so a spawn point outside the frame = that player can't find themselves at the start.
+# Leave an 8% margin. A point right on the edge goes out of frame as soon as the player moves.
+func _mp8_in_frame(pos: Vector3) -> bool :
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return true
+	if cam.is_position_behind(pos):
+		return false
+	var vr: Rect2 = get_viewport().get_visible_rect()
+	var m: Vector2 = vr.size * 0.08
+	return Rect2(vr.position + m, vr.size - m * 2.0).has_point(cam.unproject_position(pos))
+
+
+func _mp8_nearest_gap(i: int) -> float :
+	var best: float = INF
+	var pi: Vector3 = _mp8_pool[i][0]
+	for j in _mp8_pool.size():
+		if j == i:
+			continue
+		var pj: Vector3 = _mp8_pool[j][0]
+		best = minf(best, pi.distance_to(pj))
+	return best
+
+
+# ───────────────────────────── Manual editing mode
+
+# ⚠️ These visual markers are **scene nodes created at runtime**, and only when mp8spineedit is passed.
+# (Pitfall #14's "don't create new nodes when padding array lengths" is about things like stuffing AudioStreamPlayers into fixed-length arrays
+# in ways that break the flow. These are like Junk Platform's overhead name tags, purely visual, and never created in normal play.)
+func _mp8_edit_begin() -> void :
+
+	if _mp8_pool.is_empty():
+		push_warning("[MP8] Spine Breaker: the spawn pool is empty, manual editing mode won't start")
+		_mp8_edit_on = false
+		return
+
+	var lbl := Label.new()
+	lbl.name = "MP8SpineEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.offset_left = 16.0
+	lbl.offset_top = -190.0
+	lbl.offset_right = 1100.0
+	lbl.offset_bottom = -8.0
+	_mp8_style_label(lbl, Color(0.6, 0.95, 1.0))
+	_mp8_edit_layer().add_child(lbl)
+	_mp8_edit_panel = lbl
+
+	_mp8_rebuild_markers()
+	_mp8_edit_check_keys()
+	_mp8_edit_refresh()
+
+	print("[MP8] Spine Breaker: spawn point manual editing enabled — pool has %d points, source %s" % [
+		_mp8_pool.size(), _mp8_pool_src
+	])
+
+
+func _mp8_edit_layer() -> CanvasLayer :
+	if _mp8_edit_canvas == null:
+		_mp8_edit_canvas = CanvasLayer.new()
+		_mp8_edit_canvas.layer = 100
+		add_child(_mp8_edit_canvas)
+	return _mp8_edit_canvas
+
+
+# ⚠️ The game's own font must be set explicitly. The default theme font's **letter spacing is broken**
+# (tested in practice, it shows "P3  id 104..." as "P36idc104..."). Duck Hunt, Junk Platform and Manufacture Gun all tripped over this.
+func _mp8_style_label(lbl: Label, color: Color) -> void :
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 22)
+	lbl.add_theme_color_override("font_color", color)
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+
+
+func _mp8_rebuild_markers() -> void :
+
+	for m in _mp8_markers:
+		if is_instance_valid(m):
+			m.queue_free()
+	_mp8_markers.clear()
+
+	var font = load("res://fonts/Terminal F4.ttf")
+
+	for i in _mp8_pool.size():
+
+		var root := Node3D.new()
+		root.name = "MP8SpawnMarker%d" % i
+		add_child(root)
+
+		var mi := MeshInstance3D.new()
+		var cyl := CylinderMesh.new()
+		cyl.top_radius = 0.35
+		cyl.bottom_radius = 0.35
+		cyl.height = MP8_MARKER_H
+		mi.mesh = cyl
+		var mat := StandardMaterial3D.new()
+		mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+		mat.albedo_color = Color(0.2, 1.0, 0.3, 0.45)
+		mi.material_override = mat
+		mi.position.y = MP8_MARKER_H * 0.5
+		root.add_child(mi)
+
+		# Facing indicator. A short stub sticks straight out the front of the pillar, to confirm this point's yaw is right
+		var nose := MeshInstance3D.new()
+		var box := BoxMesh.new()
+		box.size = Vector3(0.18, 0.18, 1.2)
+		nose.mesh = box
+		nose.material_override = mat
+		nose.position = Vector3(0.0, 0.35, -0.8)
+		root.add_child(nose)
+
+		var tag := Label3D.new()
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 180
+		tag.outline_size = 36
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true      # Must stay visible behind walls, otherwise you can't find the one you're editing
+		if font != null:
+			tag.font = font
+		tag.text = str(i + 1)
+		tag.position = Vector3(0.0, MP8_MARKER_H + 0.6, 0.0)
+		root.add_child(tag)
+
+		_mp8_markers.append(root)
+
+	_mp8_sync_markers()
+
+
+func _mp8_sync_markers() -> void :
+
+	for i in _mp8_markers.size():
+		if i >= _mp8_pool.size():
+			break
+		var root: Node3D = _mp8_markers[i]
+		if not is_instance_valid(root):
+			continue
+		var p: Vector3 = _mp8_pool[i][0]
+		root.global_position = p
+		root.rotation_degrees = Vector3(0.0, float(_mp8_pool[i][1]), 0.0)
+
+		# Color = check result. Selected is yellow, valid is green, invalid is red
+		var col := Color(0.2, 1.0, 0.3, 0.45)
+		if not _mp8_on_navmesh(p) or not _mp8_in_frame(p):
+			col = Color(1.0, 0.25, 0.2, 0.55)
+		if i == _mp8_edit_sel:
+			col = Color(1.0, 0.9, 0.2, 0.75)
+		for c in root.get_children():
+			if c is MeshInstance3D:
+				var mat = (c as MeshInstance3D).material_override
+				if mat is StandardMaterial3D:
+					(mat as StandardMaterial3D).albedo_color = col
+
+
+func _mp8_edit_check_keys() -> void :
+
+	var mine: Dictionary = {
+		KEY_Q: "previous point", KEY_E: "next point",
+		KEY_I: "far", KEY_K: "near", KEY_J: "left", KEY_L: "right",
+		KEY_U: "turn left", KEY_O: "turn right",
+		KEY_N: "add", KEY_X: "delete", KEY_T: "try out",
+		KEY_5: "step size", KEY_0: "save", KEY_9: "reset", KEY_8: "report",
+	}
+	var clash := PackedStringArray()
+
+	for action in InputMap.get_actions():
+		for ev in InputMap.action_get_events(action):
+			var k := ev as InputEventKey
+			if k == null:
+				continue
+			for code in [k.keycode, k.physical_keycode]:
+				if code != 0 and mine.has(code):
+					clash.append("%s(%s)↔action %s" % [
+						OS.get_keycode_string(code), mine[code], String(action)
+					])
+
+	if clash.is_empty():
+		print("[MP8] Spine Breaker: manual editing keys don't conflict with the game's InputMap (checked %d actions)" % InputMap.get_actions().size())
+	else:
+		push_warning("[MP8] Spine Breaker: manual editing keys clash with game actions — %s" % ", ".join(clash))
+		print("[MP8] Spine Breaker: ⚠️ key clash — %s" % ", ".join(clash))
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or _mp8_pool.is_empty():
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+	_mp8_edit_sel = clampi(_mp8_edit_sel, 0, _mp8_pool.size() - 1)
+
+	match key.keycode:
+
+		KEY_Q, KEY_E:
+			var d: int = (-1 if key.keycode == KEY_Q else 1)
+			_mp8_edit_sel = posmod(_mp8_edit_sel + d, _mp8_pool.size())
+			_mp8_sync_markers()
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			# Moves along **screen directions**, not world axes — and it's calculated live from the current camera basis vectors,
+			# so it won't flip if the camera ever changes (same approach as Manufacture Gun's _mp8_screen_axis).
+			var dir: Vector2 = _mp8_screen_axis(key.keycode)
+			if dir == Vector2.ZERO:
+				return
+			var cur: Vector3 = _mp8_pool[_mp8_edit_sel][0]
+			_mp8_pool[_mp8_edit_sel][0] = Vector3(cur.x + dir.y * step, cur.y, cur.z + dir.x * step)
+			_mp8_sync_markers()
+			_mp8_edit_refresh()
+
+		KEY_U, KEY_O:
+			var dy: float = (- MP8_EDIT_YAW_STEP if key.keycode == KEY_U else MP8_EDIT_YAW_STEP)
+			_mp8_pool[_mp8_edit_sel][1] = fposmod(float(_mp8_pool[_mp8_edit_sel][1]) + dy, 360.0)
+			_mp8_sync_markers()
+			_mp8_edit_refresh()
+
+		KEY_N:
+			# Add. Place a new point 2 m to the right of the current one, copying its facing. It goes at the **end** (order=priority)
+			var base: Vector3 = _mp8_pool[_mp8_edit_sel][0]
+			var right: Vector2 = _mp8_screen_axis(KEY_L)
+			var np := Vector3(base.x + right.y * 2.0, base.y, base.z + right.x * 2.0)
+			_mp8_pool.append([np, float(_mp8_pool[_mp8_edit_sel][1])])
+			_mp8_edit_sel = _mp8_pool.size() - 1
+			_mp8_rebuild_markers()
+			_mp8_edit_refresh()
+			print("[MP8] Spine Breaker: added point %d (%.2f, %.2f)" % [_mp8_pool.size(), np.x, np.z])
+
+		KEY_X:
+			if _mp8_pool.size() <= 1:
+				return
+			_mp8_pool.remove_at(_mp8_edit_sel)
+			_mp8_edit_sel = clampi(_mp8_edit_sel, 0, _mp8_pool.size() - 1)
+			_mp8_rebuild_markers()
+			_mp8_edit_refresh()
+			print("[MP8] Spine Breaker: deleted a point, now %d" % _mp8_pool.size())
+
+		KEY_T:
+			mp8_spine_tryout_rpc.rpc()
+
+		KEY_5:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_0:
+			var ok: bool = _mp8_save_layout_file()
+			_mp8_edit_refresh()
+			if _mp8_edit_panel != null:
+				_mp8_edit_panel.text = ("[Saved] This spawn pool will be used automatically next match\n" if ok
+					else "[Save failed] Check the log\n") + _mp8_edit_panel.text
+
+		KEY_9:
+			_mp8_init_pool(true)
+			_mp8_edit_sel = 0
+			_mp8_rebuild_markers()
+			_mp8_edit_refresh()
+			print("[MP8] Spine Breaker: spawn pool reset to the vanilla scene (the save file wasn't deleted, delete it to fully revert)")
+
+		KEY_8:
+			_mp8_edit_report()
+
+		_:
+			return
+
+	get_viewport().set_input_as_handled()
+
+
+# Screen direction → world horizontal direction. Returns Vector2(dz, dx), where the x component goes to world z and the y component to world x.
+func _mp8_screen_axis(code: int) -> Vector2 :
+
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector2.ZERO
+
+	# Flatten onto the horizontal plane. The pitch shouldn't turn "push up" into flying into the sky (this minigame's camera pitch is -67°, so flattening really matters)
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var r2 := Vector2(right.z, right.x)
+	var f2 := Vector2(fwd.z, fwd.x)
+	if r2.length() < 0.001 or f2.length() < 0.001:
+		return Vector2.ZERO
+	r2 = r2.normalized()
+	f2 = f2.normalized()
+
+	match code:
+		KEY_L: return r2
+		KEY_J: return - r2
+		KEY_I: return f2
+		KEY_K: return - f2
+	return Vector2.ZERO
+
+
+# Try out. Place the players present onto the first N points in pool order, to see directly what it looks like with 8 people standing there.
+# ⚠️ This goes through an RPC because it moves **every** player's position, not a local visual.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_spine_tryout_rpc() -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not NetworkManager.MP8_DEV_TOOLS:
+		return
+
+	if not multiplayer.is_server():
+		return
+
+	var list: Array = players.values()
+	for i in list.size():
+		if i >= _mp8_pool.size():
+			break
+		var pl = list[i]
+		if not is_instance_valid(pl):
+			continue
+		pl.setup_rpc.rpc(
+			_mp8_pool[i][0],
+			device.get_path(),
+			Vector3(0.0, float(_mp8_pool[i][1]), 0.0)
+		)
+	print("[MP8] Spine Breaker: try out — %d players placed on the first %d pool points" % [
+		list.size(), mini(list.size(), _mp8_pool.size())
+	])
+
+
+func _mp8_edit_refresh() -> void :
+
+	if _mp8_edit_panel == null:
+		return
+
+	var i: int = clampi(_mp8_edit_sel, 0, _mp8_pool.size() - 1)
+	var p: Vector3 = _mp8_pool[i][0]
+	var n: int = PlayerManager.player_presences.size()
+	var need: int = int(MP8_POOL_BY_COUNT.get(n, _mp8_pool.size()))
+	var gap: float = _mp8_nearest_gap(i)
+
+	var lines := PackedStringArray()
+	lines.append("[Spine Breaker spawn point editor] point %d/%d   step %.1f m   source: %s" % [
+		i + 1, _mp8_pool.size(), MP8_EDIT_STEPS[_mp8_edit_step_i], _mp8_pool_src
+	])
+	lines.append("position (%.2f, %.2f)   facing %.0f°   nearest point %.1f m" % [
+		p.x, p.z, float(_mp8_pool[i][1]), gap
+	])
+	lines.append("navmesh %s     camera frame %s" % [
+		("✅on the mesh" if _mp8_on_navmesh(p) else "❌off the mesh, device can't reach it"),
+		("✅in frame" if _mp8_in_frame(p) else "❌out of frame, can't see yourself at the start"),
+	])
+	lines.append("current %d-player match enables the first %d points, the pool has %d%s" % [
+		n, need, _mp8_pool.size(),
+		("" if _mp8_pool.size() >= need else "  ⚠️ %d short" % (need - _mp8_pool.size()))
+	])
+	lines.append("Q/E select  IKJL move  U/O turn  N add  X delete  T try out  5 step  0 save  9 reset  8 report")
+
+	_mp8_edit_panel.text = "\n".join(lines)
+
+
+func _mp8_edit_report() -> void :
+
+	print("[MP8] ========== Spine Breaker spawn pool report (%d points) ==========" % _mp8_pool.size())
+	var bad: int = 0
+	for i in _mp8_pool.size():
+		var p: Vector3 = _mp8_pool[i][0]
+		var nav: bool = _mp8_on_navmesh(p)
+		var frm: bool = _mp8_in_frame(p)
+		if not nav or not frm:
+			bad += 1
+		print("  %2d. (%7.2f, %7.2f) facing %3.0f°  nearest point %5.2f m  mesh %s  camera frame %s" % [
+			i + 1, p.x, p.z, float(_mp8_pool[i][1]), _mp8_nearest_gap(i),
+			("in" if nav else "❌out"), ("in" if frm else "❌out")
+		])
+	print("[MP8] enabled per player count: %s" % _mp8_enable_desc())
+	var maxn: int = int(MP8_POOL_BY_COUNT.get(8, 0))
+	if _mp8_pool.size() > maxn:
+		print("[MP8] ⚠️ the pool has %d points, but an 8-player match only enables the first %d — points %d~%d are dead points and can never be drawn. Change MP8_POOL_BY_COUNT" % [
+			_mp8_pool.size(), maxn, maxn + 1, _mp8_pool.size()
+		])
+	if bad > 0:
+		print("[MP8] ⚠️ %d points are invalid (off the mesh or out of camera frame), fix them before saving" % bad)
+	else:
+		print("[MP8] ✅ all %d points are on the navigation mesh and inside the camera frame" % _mp8_pool.size())
