+# Command line `mp8devwait=<seconds>` overrides "seconds to wait after a kill" with the same value for **all** devices. Returns 0 = not passed.
+#
+# Like `mp8spinefuse=`, it's for **manually widening the race window to reproduce a bug** —
+# the T51 bug needs "the attach to land exactly inside the await window of `_on_device_requested_target`",
+# and that window is only 2~3 seconds by default, so hitting it is down to luck. Passing `mp8devwait=15` stretches it to 15 seconds,
+# and with 8 idle instances bumping into each other it reproduces within minutes (run it once before the fix so you have a baseline).
+#
+# ⚠️ It's also **the knob for normal pacing**, so don't pass it in real play.
+#    Cycle = fuse + this value, and the offset between the two devices is maintained by these values being unequal (see the MP8_DEVICE_WAIT section).
+func _mp8_wait_forced() -> float :
+
+	for a in NetworkManager.mp8_args():
+		var s: String = str(a)
+		if s.begins_with("mp8devwait="):
+			var v: String = s.substr(len("mp8devwait="))
+			if v.is_valid_float():
+				return clampf(float(v), 0.0, 60.0)
+
+	return 0.0
+
+
+# How many seconds this device waits after a kill. Looked up by mp8_index (starting at 1), falling back to device 1's value when out of range.
+func _mp8_wait_for(which) -> float :
+
+	var forced: float = _mp8_wait_forced()
+	if forced > 0.0:
+		return forced
+
+	var i: int = 0
+	if which != null and is_instance_valid(which):
+		i = maxi(0, int(which.mp8_index) - 1)
+
+	return float(MP8_DEVICE_WAIT[i] if i < MP8_DEVICE_WAIT.size() else MP8_DEVICE_WAIT[0])
+
+
+func _mp8_retire_at() -> int :
+
+	# player_count is only set in the server's spawn_players(). On clients it's 0 when this runs (for that log line),
+	# so fall back to checking PlayerManager live, so client logs don't print a misleading "retire on kill 1".
+	var n: int = (player_count if player_count > 0 else PlayerManager.player_presences.size())
+	return maxi(1, n - 2)
+
