@@ -24,6 +24,63 @@ class_name GreenPeaCoach extends Node3D
 
 signal execution_finished()
 
+# [MP8] 座位号 → 用哪个 coach_shoot_position_N 动画。
+# 由 green_pea.gd 的 _mp8_map_animations() 按实际坐标算好写进来（每个端各算一次，
+# 因为 shoot_player 是 call_local 广播，每台机器都要播动画）。
+# 空表 = 没初始化，直接用座位号本身（≤4 人时两者恒等，与原版逐值一致）。
+var mp8_anim_by_seat: Array = []
+
+
+func _mp8_anim_index(seat: int) -> int :
+
+	if seat >= 0 and seat < mp8_anim_by_seat.size():
+		return int(mp8_anim_by_seat[seat])
+
+	return seat
+
+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] T55 错落延迟按人数摊薄（2026-09-02，玩家 09-01 报的）
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# 玩家原话：「新增的位置（第五个人第六个人）在主人重新拿起报纸后拿起叉子的速度
+#            会相较于原来的四人慢很多，影响游戏平衡性。」
+#
+# 原版这两个循环把 `await` 写在**循环体内**：
+#
+#     for player in players:
+#         player.continue_eating_rpc.rpc()
+#         await get_tree().create_timer(randf_range(0, 0.3)).timeout
+#
+# 所以第 i 个人要等**前面 i 个人的随机延迟累加完**才收到指令 ——
+# 期望 0.15×i 秒，最坏 0.3×i 秒。人数一翻倍，最后那个人的等待也翻倍：
+#
+#     座位 1  0.00 s   座位 4  0.45 s（原版最差）
+#     座位 5  0.60 s   座位 6  0.75 s   座位 8  1.05 s   （均值，最坏 ×2）
+#
+# 再叠上 `continue_eating_rpc` 自己固定的 0.2 s + 0.3 s 补间，
+# 8 号位从「教练恢复看报」到「叉子能用」最坏要 2.6 秒。
+# 而教练那边是 `anim_tree_coach.set(...blend_amount, 0)`，**瞬间**就恢复看报 ——
+# 视觉信号对所有人同时出现，实际解锁却拖了一条长尾。这就是玩家说的「慢很多」。
+#
+# ⚠️ 严格说「总进食时长」大致是抵消的（暂停那个循环用同一份顺序，靠后的人也被暂停得晚，
+#    处决期间多吃了差不多的时间）。但**补偿发生在没人在吃的处决过程中**，
+#    **损失发生在回合刚恢复、正抢时间的时候** —— 所以玩家的体感是对的。
+#
+# 🩸 又一次「原版按 4 人写的东西，成本随人数线性增长」（第六节 D 组第 55 条那一类）。
+#    这个错落是**故意做的**（大家依次回神，看着自然），所以不能删，只能摊薄。
+#
+# 做法：每档延迟 = randf_range(0, 总预算 / 人数)，让**整条斜坡的长度与人数无关**。
+# 4 人时 1.2/4 = 0.3，与原版 `randf_range(0, 0.3)` 逐值一致 —— ≤4 人一个字没改。
+#
+# ⚠️ 用 `players.size()` 而不是活人数：两个循环都是遍历整个数组（`continue` 那个
+#    连死人都不跳过），斜坡长度由数组长度决定，用活人数会算短。
+const MP8_STAGGER_BUDGET: float = 1.2   # 原版 4 人的总斜坡长度：4 × 0.3
+
+
+func _mp8_stagger() -> float :
+
+	return randf_range(0.0, MP8_STAGGER_BUDGET / float(maxi(players.size(), 1)))
+
