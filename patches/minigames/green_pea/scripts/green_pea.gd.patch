+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Everything below is new
+# ═══════════════════════════════════════════════════════════════════════════
+
+func _mp8_setup_seats() -> void :
+
+	if player_spawn_positions == null:
+		push_warning("[MP8] Green Pea: no spawn point container, skipping 8 seats")
+		return
+
+	var base: int = player_spawn_positions.get_child_count()
+	if base != 4:
+		print("[MP8] Green Pea: found %d spawn points (expected 4), the version may have changed, skipping 8 seats" % base)
+		return
+
+	# Read the 4 vanilla seats' z **live** instead of copying coordinates (copying coordinates is something this project has been burned by before)
+	_mp8_seat_z.clear()
+	for i in base:
+		_mp8_seat_z.append(player_spawn_positions.get_child(i).position.z)
+
+	# Take one vanilla Marker on each side as a template. x / y / facing all come from it, only z changes
+	var left_src: Node3D = null
+	var right_src: Node3D = null
+	for i in base:
+		var m: Node3D = player_spawn_positions.get_child(i)
+		if m.position.x < 0.0:
+			if left_src == null:
+				left_src = m
+		elif right_src == null:
+			right_src = m
+
+	if left_src == null or right_src == null:
+		print("[MP8] Green Pea: can't identify the left and right spawn points, skipping 8 seats")
+		return
+
+	# ① Spawn points. Add a left and a right one for each new z, in the order left, right (matching vanilla's left/right alternation)
+	for z in MP8_NEW_SEAT_Z:
+		for src in [left_src, right_src]:
+			var dup: Node3D = src.duplicate()
+			dup.name = "MP8Seat%d" % _mp8_seat_z.size()
+			player_spawn_positions.add_child(dup)
+			dup.transform = src.transform
+			dup.position = Vector3(src.position.x, src.position.y, z)
+			_mp8_seat_z.append(z)
+
+	_mp8_add_chairs(left_src, right_src)
+	_mp8_extend_decals(base)
+	_mp8_map_animations(base)
+	_mp8_clear_table_cans()
+
+	print("[MP8] Green Pea: seats %d → %d, z = %s" % [base, _mp8_seat_z.size(), str(_mp8_seat_z)])
+
+
+# Chair objects. Duplicate one vanilla chair for each side.
+# ⚠️ The parent node `walls` has an **identity** basis in practice (probe48 checked every level), so position can be edited directly.
+#    If a different version ever isn't identity, convert with basis.inverse() per pitfall #27 instead of translating directly.
+func _mp8_add_chairs(left_src: Node3D, right_src: Node3D) -> void :
+
+	var walls := get_node_or_null("pea dinner scene4/walls")
+	if walls == null:
+		print("[MP8] Green Pea: walls not found, new seats have no chairs")
+		return
+
+	var chair_l := walls.get_node_or_null("chair player0")   # left, z≈1.29
+	var chair_r := walls.get_node_or_null("chair player3")   # right, z≈1.29
+	if chair_l == null or chair_r == null:
+		print("[MP8] Green Pea: template chairs not found, new seats have no chairs")
+		return
+
+	# The chair z differs slightly from the spawn point z (0.07 m in practice) — **compute that offset live**, don't hardcode it
+	var off_l: float = chair_l.position.z - left_src.position.z
+	var off_r: float = chair_r.position.z - right_src.position.z
+
+	var n: int = 0
+	for z in MP8_NEW_SEAT_Z:
+		for pair in [[chair_l, off_l], [chair_r, off_r]]:
+			var src: Node3D = pair[0]
+			var d: Node3D = src.duplicate()
+			d.name = "MP8Chair%d" % n
+			walls.add_child(d)
+			d.transform = src.transform
+			d.position = Vector3(src.position.x, src.position.y, z + float(pair[1]))
+			n += 1
+
+	print("[MP8] Green Pea: added %d chairs" % n)
+
+
+# Blood decals. `decals_by_seat_index` is a fixed 4-entry array indexed by seat (the pattern from pitfall #13),
+# so seats 5~8 would read out of bounds. Duplicate the **nearest group on the same side** and shift the whole group along world z.
+# ⚠️ Each group has its own yaw (seat1/seat3 are -180°), but position is in parent space and the parent is identity,
+#    so adding to z is a plain world translation. Children move with their group, so their local orientation doesn't matter.
+func _mp8_extend_decals(base: int) -> void :
+
+	var coach = coach_handler.coach if coach_handler != null else null
+	if coach == null or coach.decals_by_seat_index == null:
+		return
+
+	var arr: Array = coach.decals_by_seat_index
+	if arr.size() != base:
+		print("[MP8] Green Pea: blood decal array has %d entries (expected %d), skipping extension" % [arr.size(), base])
+		return
+
+	for i in range(base, _mp8_seat_z.size()):
+
+		var v: int = _mp8_nearest_vanilla(i, base)
+		var src = arr[v]
+		if src == null or not is_instance_valid(src):
+			arr.append(null)
+			continue
+
+		var d: Node3D = src.duplicate()
+		src.get_parent().add_child(d)
+		d.name = "MP8Decals%d" % i
+		d.transform = src.transform
+		d.position = src.position + Vector3(0.0, 0.0, _mp8_seat_z[i] - _mp8_seat_z[v])
+		d.visible = false
+		arr.append(d)
+
+	print("[MP8] Green Pea: blood decal groups %d → %d" % [base, arr.size()])
+
+
+# Nearest-match coach animations. New seats borrow the animation of the vanilla seat **on the same side with the closest z**.
+# The whole table only has coach_shoot_position_0..3. Adding seats can't add new animations, so borrowing is the only option.
+func _mp8_map_animations(base: int) -> void :
+
+	var coach = coach_handler.coach if coach_handler != null else null
+	if coach == null:
+		return
+
+	var table: Array = []
+	var desc := PackedStringArray()
+
+	for i in _mp8_seat_z.size():
+		if i < base:
+			table.append(i)                       # vanilla seats use their own, perfect aim
+			continue
+		var v: int = _mp8_nearest_vanilla(i, base)
+		table.append(v)
+		desc.append("seat%d→anim%d(off %.2fm)" % [i, v, absf(_mp8_seat_z[i] - _mp8_seat_z[v])])
+
+	coach.mp8_anim_by_seat = table
+	print("[MP8] Green Pea: animation mapping %s" % " ".join(desc))
+
+
+# [MP8] Placement scoring (decided by the user on 2026-08-17 — **placement scoring + one extra point for finishing first**)
+#
+# Vanilla belongs to family B (cumulative), capped at 3 points per round (+1 at halfway, +1 for finishing, +1 more for finishing first),
+# and **it doesn't scale with player count at all**. In an 8-player match seven people all get 2 points and the ranking can't tell them apart.
+# It now uses placement points, so score gaps widen with player count, in line with the placement family.
+#
+# **Ordering (worst to best), all using existing order arrays, no new mechanisms**
+#   ① Shot before reaching halfway — by death order (first to die is worst)
+#   ② Reached halfway but shot before finishing — by death order
+#   ③ Finished — in **reverse** finish order (the last to finish comes first in this tier, the first to finish is best)
+# Score = index in this sequence, **step of 1 across all tiers**, then whoever finished first gets **another +1**.
+#
+# ⚠️ This +1 creates a 2-point gap at the top (every other step is 1) —
+# the same shape as the gap we deliberately flattened in Spine Breaker, but **here the user explicitly asked for it**.
+# That gap was a side effect left over from vanilla, while this one deliberately rewards "clearing the plate first".
+#
+# ⚠️ Players who disconnected (neither finished nor shot) aren't in any order array and stay at 0 points —
+# tied with "the first to die". They've disconnected anyway, so it isn't worth a separate tier for them.
+func _mp8_apply_rank_scores() -> void :
+
+	var order: Array = []
+
+	# ① / ② Didn't finish. Split into two tiers by "reached halfway or not" first, then by death order within each tier
+	for want_half in [false, true]:
+		for nid in _mp8_dead_order:
+			if finished_players.has(nid):
+				continue                      # shot after finishing still counts as finished
+			if halfway_done_players.has(nid) == want_half:
+				order.append(nid)
+
+	# ③ Finished. Reverse the finish order so the first to finish comes last = highest score
+	var fin: Array = finished_players.duplicate()
+	fin.reverse()
+	order.append_array(fin)
+
+	for i in order.size():
+		player_scores[order[i]] = i
+
+	if not finished_players.is_empty():
+		player_scores[finished_players[0]] += 1
+
+	_mp8_log_scores(order.size())
+
+
+# Write placement/name/score to the log at results (doesn't change any score, purely for reconciling afterward).
+# Same format as Junk Platform and Spine Breaker, so the placement-scored minigames are easy to compare side by side.
+func _mp8_log_scores(ranked: int) -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var keys: Array = player_scores.keys()
+	keys.sort_custom(func(a, b): return player_scores[a] > player_scores[b])
+
+	var parts: PackedStringArray = []
+	for i in keys.size():
+		var nid = keys[i]
+		var nm: String = "id%d" % nid
+		if PlayerManager.player_presences.has(nid):
+			nm = String(PlayerManager.player_presences[nid].network_name)
+		var how := "disconnected?"
+		if finished_players.has(nid):
+			how = "finished #%d" % (finished_players.find(nid) + 1)
+		elif _mp8_dead_order.has(nid):
+			how = ("shot after halfway" if halfway_done_players.has(nid) else "shot before halfway")
+		parts.append("place %d %s %dpts(%s)" % [i + 1, nm, player_scores[nid], how])
+
+	print("[MP8] Green Pea results (%d present / %d finished / %d shot / %d ranked): %s" % [
+		player_scores.size(), finished_players.size(), _mp8_dead_order.size(),
+		ranked, " / ".join(parts)
+	])
+
+
+# Clear the can debris **on the tabletop** (the user found in testing on 2026-08-17 that it blocks the plates at the new seats).
+#
+# ⚠️ **Decide by area, don't hardcode names**. There are a dozen or so `pea can*` nodes and only 4 of them are on the table.
+# The rest sit on a distant raised ledge (y 3.5~5.4, z≈-7). Those are set dressing, and clearing them would just leave things missing.
+# The test is "AABB center falls within the tabletop's xz range and is above the tabletop" — the tabletop range is also read live, not copied.
+#
+# Only turns off `visible` and doesn't delete nodes. It's reversible and leaves the scene structure alone.
+# (If a can has its own collider, this doesn't touch it — players are seated and can't reach the middle of the table,
+#  and testing showed the cans block **sight lines**, not bodies. We'll deal with it if they ever turn out to be bumpable.)
+func _mp8_clear_table_cans() -> int :
+
+	var scene := get_node_or_null("pea dinner scene4")
+	if scene == null:
+		return 0
+
+	var table := scene.find_child("table", true, false)
+	if table == null or not (table is MeshInstance3D) or (table as MeshInstance3D).mesh == null:
+		print("[MP8] Green Pea: tabletop mesh not found, cans not cleared")
+		return 0
+
+	var tb: AABB = (table as MeshInstance3D).global_transform * (table as MeshInstance3D).mesh.get_aabb()
+	var n: int = 0
+
+	for m in scene.find_children("pea can*", "MeshInstance3D", true, false):
+
+		if (m as MeshInstance3D).mesh == null:
+			continue
+
+		var c: Vector3 = ((m as MeshInstance3D).global_transform * (m as MeshInstance3D).mesh.get_aabb()).get_center()
+
+		# Only counts as "on the table" if above the tabletop (the distant ledge ones are above y 3.5, but their xz is also outside the tabletop range, so they're excluded twice over)
+		if c.y < tb.end.y - 0.10:
+			continue
+		if c.x < tb.position.x - 0.30 or c.x > tb.end.x + 0.30:
+			continue
+		if c.z < tb.position.z - 0.30 or c.z > tb.end.z + 0.30:
+			continue
+
+		m.visible = false
+		n += 1
+
+	print("[MP8] Green Pea: cleared %d tabletop cans (tabletop x[%.2f,%.2f] z[%.2f,%.2f] top y=%.2f)" % [
+		n, tb.position.x, tb.end.x, tb.position.z, tb.end.z, tb.end.y
+	])
+	return n
+
+
+# The vanilla seat on the same side (same sign of x) with the closest z
+func _mp8_nearest_vanilla(seat: int, base: int) -> int :
+
+	var mine: Node3D = player_spawn_positions.get_child(seat)
+	var best: int = 0
+	var best_d: float = INF
+
+	for v in base:
+		var vm: Node3D = player_spawn_positions.get_child(v)
+		if signf(vm.position.x) != signf(mine.position.x):
+			continue
+		var d: float = absf(vm.position.z - mine.position.z)
+		if d < best_d:
+			best_d = d
+			best = v
+
+	return best
+
