+# ------------------------------------------------------------------------ [MP8]
+# Two-player teams. `belongs_to_id` is a single int, and a whole pile of alive-check code runs off
+# `belongs_to_id > check_id_threshold`, so **we leave it alone** — it is still the first person on the team.
+# The second person is only registered here, and the only effect is that they can also see the spotlight on their own area
+# (vanilla's `multiplayer.get_unique_id() == network_id` line only recognizes the team leader).
+# Team logic (who is teamed with whom, eliminated together, scored together) all lives in forklift_certified.gd.
+# This file only handles "who my area lights up for".
+var mp8_member_ids: Array[int] = []
+
+@rpc("any_peer", "call_local", "reliable")
+func mp8_add_owner_rpc(network_id: int):
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+
+	if not mp8_member_ids.has(network_id):
+		mp8_member_ids.append(network_id)
+
+	if multiplayer.get_unique_id() == network_id:
+		area_light.visible = true
+
+
+# ------------------------------------------------------------------ [MP8] Score multiplier
+# **For a solo team, one crate counts as two** (decided by the user on 2026-08-17).
+# With 5~7 players the teams are uneven (like `[2,1,1,1]`), and a 2-player team collects crates at roughly twice the speed,
+# while the rule is "everyone not on the top score is eliminated" — without compensation a solo team is basically dead in round one.
+#
+# The multiplier is computed by forklift_certified._mp8_refresh_score_mults() and broadcast down.
+# Value = largest team size / this team's size. With ≤4 players and with 8 players it is always 1 (**value-for-value identical to vanilla**),
+# and with 5~7 players only solo teams get 2.
+#
+# ⚠️ **The counter shows the score after the multiplier** (explicitly requested by the user on 2026-08-17 - one crate forked into a solo area shows 2).
+# Three places must use the same number - the elimination check, the leader spotlight and the counter —
+# what players see must be exactly what the referee uses. Hidden scoring is a cardinal sin in a party game.
+#
+# The only thing that goes by the **real crate count** is the achievement `ach_crate_number`
+#("really forked 4 crates" shouldn't be made easier by the multiplier). See forklift_certified._on_crate_numbers_changed.
+var mp8_score_mult: int = 1
+
+@rpc("any_peer", "call_local", "reliable")
+func mp8_set_score_mult_rpc(mult: int):
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	mult = clampi(mult, 1, NetworkManager.MAX_PLAYERS)
+
+	mp8_score_mult = maxi(1, mult)
+
+	# The multiplier can change mid-match (a teammate disconnects → the remaining player becomes a solo team), and the counter has to catch up right away.
+	# ⚠️ `crates_in_area` is only maintained by the server (body_entered is only hooked up on the server),
+	# so the refresh can only be computed by the server and then broadcast, not computed by each side itself — a client would always get 0.
+	if multiplayer.is_server():
+		update_counter_rpc.rpc(crates_in_area.size() * mp8_score_mult)
