+		for j in _mp8_area_members[i].size():
+			used.append((_mp8_spawns[i * MP8_TEAM_SIZE + j] as Array)[0])
+	var worst: float = INF
+	for a in used.size():
+		for b in range(a + 1, used.size()):
+			var pa: Vector3 = used[a]
+			var pb: Vector3 = used[b]
+			worst = minf(worst, Vector2(pa.x - pb.x, pa.z - pb.z).length())
+	if used.size() >= 2:
+		print("[MP8] Forklift Certified: %d spawn points, minimum spacing between them %.2f m (vehicle 3.0x6.0, source=%s)" % [
+			used.size(), worst, _mp8_spawns_src
+		])
+		if worst < 3.2:
+			push_warning("[MP8] Forklift Certified: minimum spawn spacing is only %.2f m, two forklifts may overlap" % worst)
+
