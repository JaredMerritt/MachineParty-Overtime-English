+func _mp8_build_spawns() -> void :
+
+	_mp8_spawns = []
+
+	var area_count: int = delivery_area_parent.get_child_count()
+	var markers: Array = player_spawn_positions_node.get_children()
+
+	# Primary = the scene's vanilla point, not a single number changed (these are what 4-player matches use).
+	# Secondary = primary moved MP8_MATE_OFFSET toward the **field center**, with the facing copied from the primary.
+	for i in area_count:
+
+		var pos: Vector3 = Vector3.ZERO
+		var yaw: float = 0.0
+
+		if i < markers.size():
+			var m: Node3D = markers[i]
+			pos = m.global_position
+			var rot: Vector3 = m.rotation_degrees
+			# Only horizontal facing matters for spawn points. If vanilla really does have x/z components, report it first rather than silently discarding them.
+			if absf(rot.x) > 0.01 or absf(rot.z) > 0.01:
+				push_warning("[MP8] Forklift Certified: spawn point %s has x/z rotation components %s, using y only" % [
+					String(m.name), str(rot)
+				])
+			yaw = rot.y
+		else:
+			# Fewer spawn points than areas (vanilla never does this). Fall back to the area's own position so at least it isn't null.
+			push_warning("[MP8] Forklift Certified: only %d spawn points but %d areas, area %d falls back to the area's position" % [
+				markers.size(), area_count, i
+			])
+			pos = (delivery_area_parent.get_child(i) as Node3D).global_position
+
+		_mp8_spawns.append([pos, yaw])
+
+		var toward_center: float = (-1.0 if pos.x > 0.0 else 1.0)
+		_mp8_spawns.append([
+			Vector3(pos.x + toward_center * MP8_MATE_OFFSET, pos.y, pos.z),
+			yaw,
+		])
+
+	_mp8_spawns_src = "scene vanilla + built-in secondary spots"
+
+	var rows: Array = _mp8_load_layout_file()
+	if not rows.is_empty():
+		if rows.size() < _mp8_spawns.size():
+			push_warning("[MP8] Forklift Certified: save file only has %d rows but %d are needed, the missing ones still use built-in values" % [
+				rows.size(), _mp8_spawns.size()
+			])
+		for i in mini(rows.size(), _mp8_spawns.size()):
+			_mp8_spawns[i] = rows[i]
+		_mp8_spawns_src = "save file (%d rows)" % rows.size()
+
+	print("[MP8] Forklift Certified: spawn table has %d points (%d areas x %d players), source=%s" % [
+		_mp8_spawns.size(), area_count, MP8_TEAM_SIZE, _mp8_spawns_src
+	])
+
