+func _mp8_load_layout_file() -> Array :
+
+	# [MP8] Saved layout files are a dev-build editor feature. Release builds always use the built-in layout.
+	if not NetworkManager.MP8_DEV_TOOLS or not FileAccess.file_exists(MP8_LAYOUT_FILE):
+		return []
+
+	var f := FileAccess.open(MP8_LAYOUT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] Forklift Certified: can't read %s (error %d)" % [
+			MP8_LAYOUT_FILE, FileAccess.get_open_error()
+		])
+		return []
+
+	var rows: Array = []
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var parts: PackedStringArray = line.split(",", false)
+		if parts.size() < 2:
+			push_warning("[MP8] Forklift Certified: can't parse this layout file line, skipping — '%s'" % line)
+			continue
+		var x: float = float(parts[0].strip_edges())
+		var z: float = float(parts[1].strip_edges())
+		var yaw: float = (float(parts[2].strip_edges()) if parts.size() >= 3 else 0.0)
+		if not (parts[0].strip_edges().is_valid_float() and parts[1].strip_edges().is_valid_float()):
+			continue
+		if not (NetworkManager.mp8_finite(x, 1000.0) and NetworkManager.mp8_finite(z, 1000.0) and NetworkManager.mp8_finite(yaw, 3600.0)):
+			continue
+		rows.append([Vector3(x, 0.0, z), yaw])
+	f.close()
+	return rows
+
+
+func _mp8_save_layout_file() -> bool :
+
+	var f := FileAccess.open(MP8_LAYOUT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] Forklift Certified: can't write %s (error %d)" % [
+			MP8_LAYOUT_FILE, FileAccess.get_open_error()
+		])
+		return false
+
+	f.store_line("# Forklift Certified (mp8game=16) spawn table — teams of two, two spots per delivery area")
+	f.store_line("# One point per line: x, z, facing in degrees. **Don't change the order**:")
+	f.store_line("#   Lines 1 and 2 = the area 0 team (primary, secondary), lines 3 and 4 = area 1, and so on.")
+	f.store_line("#   Area order is the child order of DropAreas in the scene.")
+	f.store_line("# Delete this file = back to built-in values (primary = the scene's 4 vanilla points, secondary = primary moved %.1f m toward the field center)." % MP8_MATE_OFFSET)
+	f.store_line("# Can be edited directly in Notepad. Saved at %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for i in _mp8_spawns.size():
+		var r: Array = _mp8_spawns[i]
+		var p: Vector3 = r[0]
+		f.store_line("%.2f, %.2f, %.0f    # area %d %s" % [
+			p.x, p.z, float(r[1]), i / MP8_TEAM_SIZE,
+			("primary" if i % MP8_TEAM_SIZE == 0 else "secondary")
+		])
+	f.close()
+
+	print("[MP8] Forklift Certified: spawn table saved (%d points) → %s" % [
+		_mp8_spawns.size(), ProjectSettings.globalize_path(MP8_LAYOUT_FILE)
+	])
+	return true
