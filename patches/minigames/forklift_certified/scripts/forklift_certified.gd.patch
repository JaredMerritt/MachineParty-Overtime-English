+		mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
+		mat.albedo_color = Color(0.2, 1.0, 0.3, 0.45)
+		mi.material_override = mat
+		mi.position.y = 0.1
+		root.add_child(mi)
+
+		# Facing indicator. A short stub sticking out the front to confirm the yaw is right
+		var nose := MeshInstance3D.new()
+		var nb := BoxMesh.new()
+		nb.size = Vector3(0.18, 0.18, 1.2)
+		nose.mesh = nb
+		nose.material_override = mat
+		nose.position = Vector3(0.0, 0.35, -MP8_CAR_HZ - 0.6)
+		root.add_child(nose)
+
+		var tag := Label3D.new()
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 180
+		tag.outline_size = 36
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true      # Must stay visible behind walls, otherwise you can't find which one you're editing
+		if font != null:
+			tag.font = font
+		tag.text = "%d%s" % [i / MP8_TEAM_SIZE + 1, ("A" if i % MP8_TEAM_SIZE == 0 else "B")]
+		tag.position = Vector3(0.0, 3.0, 0.0)
+		root.add_child(tag)
+
+		_mp8_markers.append(root)
+
+	_mp8_sync_markers()
+
+
+func _mp8_sync_markers() -> void :
+
+	for i in _mp8_markers.size():
+		if i >= _mp8_spawns.size():
+			break
+		var root: Node3D = _mp8_markers[i]
+		if not is_instance_valid(root):
+			continue
+		var r: Array = _mp8_spawns[i]
+		root.global_position = r[0] as Vector3
+		root.rotation_degrees = Vector3(0.0, float(r[1]), 0.0)
+
+		# Color = check result. Selected yellow, valid green, invalid red
+		var col := Color(0.2, 1.0, 0.3, 0.45)
+		if not _mp8_spawn_ok(i):
+			col = Color(1.0, 0.25, 0.2, 0.55)
+		if i == _mp8_edit_sel:
+			col = Color(1.0, 0.95, 0.2, 0.65)
+		for c in root.get_children():
+			if c is MeshInstance3D:
+				var m = (c as MeshInstance3D).material_override
+				if m is StandardMaterial3D:
+					(m as StandardMaterial3D).albedo_color = col
+
+
+# Three checks, all measured rather than guessed.
+#   1. The vehicle must be inside the railing (side railing_002 from probe60).
+#   2. Two vehicles must not overlap (collision box 3.0 x 6.0, with a 0.2 m margin).
+#   3. The player should spawn inside **their own area** (vanilla does this, primary spots are 0~1.17 m from their area).
+func _mp8_spawn_ok(i: int) -> bool :
+
+	var p: Vector3 = (_mp8_spawns[i] as Array)[0]
+
+	if absf(p.x) > MP8_FIELD_X - MP8_CAR_HX or absf(p.z) > MP8_FIELD_Z - MP8_CAR_HZ:
+		return false
+
+	for j in _mp8_spawns.size():
+		if j == i:
+			continue
+		var q: Vector3 = (_mp8_spawns[j] as Array)[0]
+		if absf(p.x - q.x) < MP8_CAR_HX * 2.0 + 0.2 and absf(p.z - q.z) < MP8_CAR_HZ * 2.0 + 0.2:
+			return false
+
+	var area_i: int = i / MP8_TEAM_SIZE
+	if area_i < delivery_area_parent.get_child_count():
+		var c: Vector3 = (delivery_area_parent.get_child(area_i) as Node3D).global_position
+		if absf(p.x - c.x) > MP8_ZONE_HX or absf(p.z - c.z) > MP8_ZONE_HZ:
+			return false
+
+	return true
+
+
+func _mp8_edit_check_keys() -> void :
+
+	var mine: Dictionary = {
+		KEY_Q: "previous point", KEY_E: "next point",
+		KEY_I: "far", KEY_K: "near", KEY_J: "left", KEY_L: "right",
+		KEY_U: "turn left", KEY_O: "turn right",
+		KEY_5: "step", KEY_0: "save", KEY_9: "reset", KEY_8: "report",
+	}
+	var clash := PackedStringArray()
+
+	for action in InputMap.get_actions():
+		for ev in InputMap.action_get_events(action):
+			var k := ev as InputEventKey
+			if k == null:
+				continue
+			for code in [k.keycode, k.physical_keycode]:
+				if code != 0 and mine.has(code):
+					clash.append("%s(%s)↔action %s" % [
+						OS.get_keycode_string(code), mine[code], String(action)
+					])
+
+	if clash.is_empty():
+		print("[MP8] Forklift Certified: edit keys don't conflict with the game InputMap (checked %d actions)" % InputMap.get_actions().size())
+	else:
+		push_warning("[MP8] Forklift Certified: edit keys clash with game actions — %s" % ", ".join(clash))
+		print("[MP8] Forklift Certified: ⚠️ key clash — %s" % ", ".join(clash))
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or _mp8_spawns.is_empty():
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+	_mp8_edit_sel = clampi(_mp8_edit_sel, 0, _mp8_spawns.size() - 1)
+
+	match key.keycode:
+
+		KEY_Q, KEY_E:
+			var d: int = (-1 if key.keycode == KEY_Q else 1)
+			_mp8_edit_sel = posmod(_mp8_edit_sel + d, _mp8_spawns.size())
+			_mp8_sync_markers()
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			# Push in **screen direction**, not along world axes — computed live from the current camera basis vectors.
+			# (Manufacture Gun v1 didn't do this and ended up piling the tables into a heap, see pitfall #25.)
+			var dir := Vector2.ZERO
+			match key.keycode:
+				KEY_I: dir = Vector2(0, -1)
+				KEY_K: dir = Vector2(0, 1)
+				KEY_J: dir = Vector2(-1, 0)
+				KEY_L: dir = Vector2(1, 0)
+			var world := _mp8_screen_to_world(dir)
+			var moved: Array = _mp8_spawns[_mp8_edit_sel]
+			moved[0] = (moved[0] as Vector3) + world * step
+			_mp8_sync_markers()
+			_mp8_edit_refresh()
+
+		KEY_U, KEY_O:
+			var dy: float = (- MP8_EDIT_YAW_STEP if key.keycode == KEY_U else MP8_EDIT_YAW_STEP)
+			var arr: Array = _mp8_spawns[_mp8_edit_sel]
+			arr[1] = fposmod(float(arr[1]) + dy, 360.0)
+			_mp8_sync_markers()
+			_mp8_edit_refresh()
+
+		KEY_5:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_0:
+			_mp8_save_layout_file()
+			_mp8_edit_refresh()
+
+		KEY_9:
+			_mp8_build_spawns()
+			_mp8_rebuild_markers()
+			_mp8_edit_refresh()
+
+		KEY_8:
+			_mp8_edit_report()
+
+
+func _mp8_screen_to_world(dir: Vector2) -> Vector3 :
+
+	var cam := get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector3(dir.x, 0.0, dir.y)
+
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = -cam.global_transform.basis.z
+	right.y = 0.0
+	fwd.y = 0.0
+	if right.length() < 0.001 or fwd.length() < 0.001:
+		return Vector3(dir.x, 0.0, dir.y)
+	return (right.normalized() * dir.x + fwd.normalized() * -dir.y).normalized()
+
+
+func _mp8_edit_refresh() -> void :
+
+	if _mp8_edit_panel == null or not is_instance_valid(_mp8_edit_panel):
+		return
+
+	var r: Array = _mp8_spawns[_mp8_edit_sel]
+	var p: Vector3 = r[0]
+
+	var bad := PackedStringArray()
+	for i in _mp8_spawns.size():
+		if not _mp8_spawn_ok(i):
+			bad.append("%d%s" % [i / MP8_TEAM_SIZE + 1, ("A" if i % MP8_TEAM_SIZE == 0 else "B")])
+
+	_mp8_edit_panel.text = "\n".join([
+		"[Forklift Certified spawn edit]  QE select   IJKL push (screen direction)   UO turn   5 step   0 save   9 reset   8 report",
+		"Current %d%s (area %d %s)  x=%.2f  z=%.2f  yaw=%.0f   step %.2f m" % [
+			_mp8_edit_sel / MP8_TEAM_SIZE + 1,
+			("A" if _mp8_edit_sel % MP8_TEAM_SIZE == 0 else "B"),
+			_mp8_edit_sel / MP8_TEAM_SIZE, ("primary" if _mp8_edit_sel % MP8_TEAM_SIZE == 0 else "secondary"),
+			p.x, p.z, float(r[1]), MP8_EDIT_STEPS[_mp8_edit_step_i],
+		],
+		"%d points total (%s)  invalid: %s" % [
+			_mp8_spawns.size(), _mp8_spawns_src,
+			("none" if bad.is_empty() else ", ".join(bad)),
+		],
+	])
+
+
+func _mp8_edit_report() -> void :
+
+	print("[MP8] Forklift Certified: spawn report (%d points, source %s)" % [_mp8_spawns.size(), _mp8_spawns_src])
+	for i in _mp8_spawns.size():
+		var r: Array = _mp8_spawns[i]
+		var p: Vector3 = r[0]
+		print("   %d%s  area%d %-4s  (%7.2f, %7.2f)  yaw=%4.0f   %s" % [
+			i / MP8_TEAM_SIZE + 1, ("A" if i % MP8_TEAM_SIZE == 0 else "B"),
+			i / MP8_TEAM_SIZE, ("primary" if i % MP8_TEAM_SIZE == 0 else "secondary"),
+			p.x, p.z, float(r[1]),
+			("OK" if _mp8_spawn_ok(i) else "❌ out of bounds/overlapping/not in own area"),
+		])
+
+	var worst: float = INF
+	for a in _mp8_spawns.size():
+		for b in range(a + 1, _mp8_spawns.size()):
+			var pa: Vector3 = (_mp8_spawns[a] as Array)[0]
+			var pb: Vector3 = (_mp8_spawns[b] as Array)[0]
+			worst = minf(worst, Vector2(pa.x - pb.x, pa.z - pb.z).length())
+	print("   minimum spacing between points %.2f m (vehicle 3.0 x 6.0)" % worst)
