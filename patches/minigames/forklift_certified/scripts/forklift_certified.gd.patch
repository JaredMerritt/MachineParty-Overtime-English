+# Team helpers -------------------------------------------------------------------
+
+func _mp8_members_of_area(area) -> Array :
+
+	# Prefer our own roster. If the roster isn't built yet (e.g. early in _ready in a 4-player match), fall back to vanilla semantics.
+	var idx: int = delivery_areas.find(area)
+	if idx >= 0 and idx < _mp8_area_members.size():
+		var members: Array = _mp8_area_members[idx]
+		if not members.is_empty():
+			return members
+
+	if area.belongs_to_id > check_id_threshold:
+		return [area.belongs_to_id]
+	return []
+
+
+func _mp8_area_has_member(area, network_id: int) -> bool :
+	return _mp8_members_of_area(area).has(network_id)
+
+
+# How many teams are left (a team counts if at least one member is alive).
+# With 4 or fewer players each team has 1 player → always equals active_players.size(), value-for-value identical to vanilla.
+func _mp8_active_team_count() -> int :
+
+	if _mp8_area_members.is_empty():
+		return active_players.size()
+
+	var n: int = 0
+	for members in _mp8_area_members:
+		for pid in members:
+			if active_players.has(pid):
+				n += 1
+				break
+	return n
+
+
+# Score multiplier - **for solo teams one crate counts as two** (decided by the user 2026-08-17) -----------------------
+#
+# Why it exists. With 5~7 players teams are uneven (`[2,1,1,1]` / `[2,2,1,1]` / `[2,2,2,1]`),
+# a 2-player team collects crates at roughly twice the speed, and the rule is "every team not on the top score is eliminated" —
+# without compensation a solo team is almost certainly dead in round one, and a 5-player match is decided from the start.
+#
+# How it's computed. Multiplier = **largest team size ÷ this team's size** (integer, team size can only be 1 or 2).
+#
+#   ≤4 players - 1 per team → largest team 1 → everything ×1, **value-for-value identical to vanilla** (counter numbers too)
+#   5~7 players - largest team 2 → 2-player teams ×1, solo teams **×2**
+#   8 players   - 2 per team → everything ×1
+#
+# The alternative the user explicitly rejected on 2026-08-17 - **don't** close an area just to make teams even
+#(like opening 3 areas for 6 players). Teams are still split randomly with vanilla's shuffle.
+#
+# ⚠️ The multiplier applies to the **elimination check** (calculate_results), the **leader spotlight**
+#(_on_crate_numbers_changed) and the **counter display** (over in delivery_area) at once, and all three must use the same number —
+# fork 1 crate into a solo area and the counter shows 2 (explicitly requested by the user 2026-08-17).
+# The only thing that goes by the real crate count is the achievement `ach_crate_number`.
+func _mp8_refresh_score_mults() -> void :
+
+	var areas: Array = delivery_area_parent.get_children()
+
+	var max_team: int = 1
+	for members in _mp8_area_members:
+		max_team = maxi(max_team, (members as Array).size())
+
+	for i in _mp8_area_members.size():
+		if i >= areas.size():
+			continue
+		var n: int = (_mp8_area_members[i] as Array).size()
+		if n <= 0:
+			continue
+		areas[i].mp8_set_score_mult_rpc.rpc(max_team / n)
+
+
+func _mp8_area_score(area) -> int :
+	return area.crates_in_area.size() * area.mp8_score_mult
+
+
+func _mp8_light_team(area, on: bool) -> void :
+
+	for pid in _mp8_members_of_area(area):
+		# ⚠️ Vanilla read `active_players[da.belongs_to_id]` unguarded here. In the instant after a player is eliminated
+		# but before the area is set to -2, a crate knocked out of the area lands here → missing key error.
+		# With teams of two the window is wider (teammates are eliminated together), so a has() check was added.
+		if active_players.has(pid):
+			active_players[pid].set_indicator_light_rpc.rpc(on)
+
