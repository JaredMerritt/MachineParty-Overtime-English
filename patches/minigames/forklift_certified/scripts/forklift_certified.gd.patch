+func _mp8_log_teams() -> void :
+
+	var areas: Array = delivery_area_parent.get_children()
+
+	var lines := PackedStringArray()
+	for i in _mp8_area_members.size():
+		var members: Array = _mp8_area_members[i]
+		if members.is_empty():
+			continue
+		var names := PackedStringArray()
+		for pid in members:
+			names.append("%s(%d)" % [_mp8_name_of(pid), pid])
+		# Print the ones with multiplier >1 (solo teams) so acceptance testing can tell at a glance whether compensation took effect
+		var mult: int = (int(areas[i].mp8_score_mult) if i < areas.size() else 1)
+		lines.append("area%d=[%s]%s" % [
+			i, ", ".join(names), ("" if mult <= 1 else " 1 crate counts as %d" % mult)
+		])
+
+	print("[MP8] Forklift Certified: %d players in %d teams — %s" % [
+		player_count, _mp8_active_team_count(), "  ".join(lines)
+	])
+
+	# Spawn point self-check. Print the minimum pairwise spacing of the points actually used.
+	# ⚠️ Just printing "topped up enough" is useless (pitfall #33) — you need to see the spacing.
