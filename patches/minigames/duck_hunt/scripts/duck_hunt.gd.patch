+const MP8_ROLE_COLOR_NAME: String = "#9bcf87"  # Vanilla's green, to keep the look consistent
+const MP8_ROLE_COLOR_BUFF: String = "#ff2d2d"  # Buff = red
+const MP8_ROLE_COLOR_NERF: String = "#3fa9ff"  # Nerf = blue
