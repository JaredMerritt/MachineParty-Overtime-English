+	var role: String = "hunter" if is_hunter else "duck"
+	var peer: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var img: Image = get_viewport().get_texture().get_image()
+	if img != null:
+		img.save_png("user://mp8_duck_%s_%s_%d.png" % [tag, role, peer])
+		print("[MP8] mp8shot: saved user://mp8_duck_%s_%s_%d.png" % [tag, role, peer])
