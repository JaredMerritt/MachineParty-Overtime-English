+func mp8_shot(tag: String, delay: float = 0.0) -> void :
+
+	if not NetworkManager.mp8_args().has("mp8shot"):
+		return
+
+	if delay > 0.0:
+		await get_tree().create_timer(delay, false).timeout
+	if not is_inside_tree():
+		return
+	await RenderingServer.frame_post_draw
