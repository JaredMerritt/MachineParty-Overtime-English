+# [MP8] How many hunters this match should have. Always leave at least one duck, otherwise there's nobody to shoot.
+func _mp8_hunter_count(total_players: int) -> int:
+	# [MP8] mp8lone - test switch that forces a single hunter.
+	# A "lone hunter round" normally only happens in the **last** round of a 7-player match, and idle bots can't get through the first three
+	# (ducks neither die nor escape), so that round's buffed parameters and special slogans could never be verified.
+	# With this switch an 8-player match is simply 1 hunter vs 7 ducks, exercising the whole lone hunter path.
+	if NetworkManager.mp8_args().has("mp8lone"):
+		return 1
+	var wanted: int = 2 if total_players >= MP8_TWO_HUNTERS_FROM else 1
+	return clampi(wanted, 1, maxi(total_players - 1, 1))
+
+
+# [MP8] Hunter positions. One hunter guards the center (vanilla position), two hunters take one side each.
+func _mp8_hunter_position(index: int, total_hunters: int) -> Vector3:
+	var base: Vector3 = hunter_player_spawn_position.global_position
+	if total_hunters <= 1:
+		return base
+	# index 0 → left, index 1 → right
+	var side: float = -1.0 if index == 0 else 1.0
+	return base + Vector3(side * MP8_HUNTER_SIDE_OFFSET, 0.0, 0.0)
+
+
+# [MP8] Fill duck spawn points up from 3 until there are enough.
+#
+# The first version "extended outward on both sides with vanilla's spacing of 5" (x = 0, ±5, ±10, -15),
+# **and in the user's testing some players jumped off the map** — extending outward went past the arena boundary.
+# Now it **only spreads evenly within the span of vanilla's 3 points** (x ∈ [-5, +5]).
+# That span is the only range vanilla vouches for as "definitely inside the arena", so it never steps outside it.
+# The only cost is that ducks start a bit closer together (spacing 2 with 6 ducks), in exchange for never going out of bounds.
+func _mp8_ensure_duck_spawns(needed: int) -> void :
+
+	var container: Node3D = duck_player_spawn_positions
+	var kids: Array = container.get_children()
+	if kids.is_empty() or needed <= 0:
+		return
+
+	# The vanilla span is only captured the first time. Points we add later must not feed into it (otherwise it creeps outward round after round)
+	if not _mp8_duck_span_set:
+		var xs: Array[float] = []
+		for k in kids:
+			if k is Node3D:
+				xs.append((k as Node3D).position.x)
+		xs.sort()
+		_mp8_duck_span_min = xs[0]
+		_mp8_duck_span_max = xs[xs.size() - 1]
+		_mp8_duck_span_set = true
+
+	if kids.size() >= needed:
+		return
+
+	var template: Node3D = kids[0]
+	while container.get_child_count() < needed:
+		var dup: Node3D = template.duplicate()
+		dup.name = "MP8DuckSpawn%d" % container.get_child_count()
+		container.add_child(dup)
+
+	# Re-spread everything evenly within the vanilla span (including the original 3, spacing gets tighter but all stay in bounds)
+	var all: Array = container.get_children()
+	var n: int = all.size()
+	for i in n:
+		var node: Node3D = all[i]
+		var t: float = 0.5 if n <= 1 else float(i) / float(n - 1)
+		var pos: Vector3 = node.position
+		pos.x = lerpf(_mp8_duck_span_min, _mp8_duck_span_max, t)
+		node.position = pos
+
+	var final_xs: Array = []
+	for k in all:
+		final_xs.append(snappedf((k as Node3D).position.x, 0.01))
+	print("[MP8] Duck spawn points %d -> %d, span [%.1f, %.1f], x = %s" % [
+		kids.size(), n, _mp8_duck_span_min, _mp8_duck_span_max, str(final_xs)
+	])
+
