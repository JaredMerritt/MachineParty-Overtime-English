diff --git a/minigames/duck_hunt/states/play_state.gd b/minigames/duck_hunt/states/play_state.gd
--- a/minigames/duck_hunt/states/play_state.gd
+++ b/minigames/duck_hunt/states/play_state.gd
@@ -21,6 +21,15 @@ func enter(_msg: Dictionary = {}) -> void :
 		for player in owner.players:
 			player.set_active_rpc.rpc(true)
 
+	owner.mp8_shot("go", 0.3)    # [MP8] Right as "go" is called, to check the countdown slogan / footnote
+	owner.mp8_shot("play", 3.0)  # [MP8] 3 seconds into play, to check where the two hunters stand
+
+	# [MP8] T52 roll call. The moment play starts is the only time you can see both "who should move" and "who got activated".
+	# The server calls the roll for everyone and each machine checks itself — we need both, because the two failures look identical (the player can't move)
+	# but have opposite causes. Either the server has no role, or the server has it but it never replicated to that client.
+	owner.mp8_roll_call()
+	owner.mp8_self_check()
+
 func exit(_msg: Dictionary = {}) -> void :
 	pass
 
