+
+
+# [MP8] Get the sign. Positive = buffed, negative = nerfed, 0 = no effect. Float comparison keeps a small tolerance so 0.7999 isn't judged a nerf.
+func _mp8_sign(v: float) -> int:
+	if v > 0.001:
+		return 1
+	if v < -0.001:
+		return -1
+	return 0
+
+
+# [MP8] One line of "stat + buffed/nerfed/normal". Colors follow the role reveal screen - buffed red, nerfed blue, no effect green.
+# **No actual numbers are shown** (user request).
+func _mp8_buff_line(what: String, direction: int, zh: bool) -> String:
+
+	var color: String = "#4dff6a"
+	var word: String = "No effect" if zh else "NORMAL"
+	if direction > 0:
+		color = "#ff2d2d"
+		word = "Buffed" if zh else "BUFFED"
+	elif direction < 0:
+		color = "#3fa9ff"
+		word = "Nerfed" if zh else "NERFED"
+
+	return "[color=%s]%s %s[/color]" % [color, what, word]
+
+
+func _mp8_show_rate_hint(text: String) -> void :
+
+	if _mp8_rate_label == null:
+		var lbl := Label.new()
+		lbl.set_anchors_preset(Control.PRESET_TOP_WIDE)
+		lbl.offset_top = 40.0
+		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+		_mp8_style_debug_label(lbl, Color(1.0, 0.85, 0.2))
+		_mp8_debug_layer().add_child(lbl)
+		_mp8_rate_label = lbl
+
+	_mp8_rate_label.text = text
+	_mp8_rate_label.modulate.a = 1.0
+	var t := create_tween()
+	t.tween_interval(2.0)
+	t.tween_property(_mp8_rate_label, "modulate:a", 0.0, 0.6)
+
+
+# [MP8] Makes an animation exactly fill a given time window. Speed = the animation's own length / available time.
+# If the animation length can't be read, fall back to 1.0 (normal speed) so the animation doesn't get broken.
+# Clamped to [0.25, 4.0]. Any faster turns into a blur and any slower looks frozen, so outside that range it's better not to sync.
+func _mp8_anim_speed_for(anim_name: StringName, window: float) -> float:
+
+	if window <= 0.0 or anim_rig == null:
+		return 1.0
+	if not anim_rig.has_animation(anim_name):
+		return 1.0
+
+	var anim: Animation = anim_rig.get_animation(anim_name)
+	if anim == null or anim.length <= 0.0:
+		return 1.0
+
+	return clampf(anim.length / window, 0.25, 4.0)
+
+
+func _mp8_hipfire_spread_deg() -> float:
+	for a in NetworkManager.mp8_args():
+		var t: String = String(a)
+		if t.begins_with("mp8spread="):
+			return float(t.substr(10))
+	return mp8_hipfire_spread_deg
+
+
+func _mp8_apply_hipfire_spread() -> void :
+
+	_mp8_spread_applied = false
+
+	if laser_raycast == null:
+		return
+	if zoom_fov_index > 0:   # Scoped = accurate, leave as is
+		return
+
+	var spread: float = deg_to_rad(_mp8_hipfire_spread_deg())
+	if spread <= 0.0:
+		return
+
+	_mp8_spread_saved_rotation = laser_raycast.rotation
+	_mp8_spread_applied = true
+
+	# Pick a direction **uniformly by area** within the cone. The radius uses sqrt(randf()) instead of randf(),
+	# otherwise hits bunch up toward the center and the actual spread is smaller than the configured value.
+	var angle: float = randf() * TAU
+	var radius: float = sqrt(randf()) * spread
+	laser_raycast.rotation.x += sin(angle) * radius
+	laser_raycast.rotation.y += cos(angle) * radius
+
+	# ⚠️ RayCast3D collision results come from the previous physics frame, so after rotating it must be recomputed manually,
+	# otherwise is_colliding()/get_collider() still return the old result from before the offset and the spread has no effect at all.
+	laser_raycast.force_raycast_update()
+
+
+func _mp8_clear_hipfire_spread() -> void :
+
+	if not _mp8_spread_applied:
+		return
+	_mp8_spread_applied = false
+	laser_raycast.rotation = _mp8_spread_saved_rotation
+	laser_raycast.force_raycast_update()
+
+
+# [MP8] ===== Lone hunter round =====
+#
+# 7 is odd. The first 3 rounds each take 2 hunters, so **the last round has only 1 person as hunter, facing 6 ducks**
+# (everyone takes one turn as hunter until the pool runs dry). But the five-tier table was set up for "7 players = 5 ducks:2 hunters",
+# so that unlucky player would face 6 ducks alone with a nerfed gun, directly contradicting the five-tier table's design intent.
+#
+# The user decided on 2026-08-15 that this kind of round gets its own "1 hunter" parameters, buffed further on top of the 5-player tier.
+#
+# **Basis for the buff amount** (baseline is the 5-player tier - 4 ducks:1 hunter, magazine 12, interval 0.92 s)
+#   The lone hunter is 6 ducks:1 hunter, exactly 1.5x the pressure → scale linearly by that ratio. Magazine ×1.5 = 18, interval ÷1.5 = 0.61.
+#   Checking against "sustained output including reloads" (reload stays fixed at 2.85 s)
+#     5-player tier - 12×0.92 + 2.85 = 13.89 s for 12 shots → 0.864 shots/s ÷ 4 ducks = 0.216
+#     Lone hunter   - 18×0.61 + 2.85 = 13.83 s for 18 shots → 1.302 shots/s ÷ 6 ducks = 0.217
+#   **Fire pressure per duck differs by only 0.4%**, so linear scaling lands right on "same per-duck fire as the 5-player tier".
+@export var mp8_lone_hunter_magazine: int = 18
+@export var mp8_lone_hunter_cycle: float = 0.11
+
+
+# Whether this round is a lone hunter round that "should have had two hunters but only has one"
+func _mp8_is_lone_hunter() -> bool:
+	return mp8_hunter_total == 1 and mp8_player_count >= 6
+
+
+# [MP8] Clamp the player count to the table's key range before the lookup, so a missing key never lands on the fallback value
+func _mp8_tier() -> int:
+	var n: int = mp8_player_count
+	if n <= 0:
+		n = duck_count + 1  # Fallback when no player count was passed - duck count + 1 hunter
+	return clampi(n, 4, 8)
+
+
+# [MP8] The magazine / shot interval actually in effect this round (lone hunter rounds use their own set).
+# set_active_rpc, the cycle wait in shoot() and the top-right HUD must all go through these two functions,
+# otherwise "the strength shown won't match how shooting actually feels".
+func _mp8_effective_magazine() -> int:
+	if _mp8_is_lone_hunter():
+		return mp8_lone_hunter_magazine
+	return magazine_capacity_by_player_count.get(_mp8_tier(), 10)
+
+
+func _mp8_effective_cycle() -> float:
+	if _mp8_is_lone_hunter():
+		return mp8_lone_hunter_cycle
+	return cycle_time_by_player_count.get(_mp8_tier(), 0.80)
+
