+		lbl.add_theme_font_size_override("normal_font_size", 26)
+		lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+		lbl.add_theme_constant_override("outline_size", 6)
+		lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		_mp8_debug_layer().add_child(lbl)
+		_mp8_id_label = lbl
+
+	var zh: bool = TranslationServer.get_locale().to_upper().begins_with("ZH")
+	var tier: int = _mp8_tier()
+
+	# Compared with the baseline tier (4 players). A bigger magazine is stronger and a smaller interval is stronger (cycle is an interval, not a fire rate)
+	var base_mag: int = magazine_capacity_by_player_count.get(4, 10)
+	var base_cycle: float = cycle_time_by_player_count.get(4, 0.80)
+	var mag: int = _mp8_effective_magazine()
+	var cyc: float = _mp8_effective_cycle()
+
