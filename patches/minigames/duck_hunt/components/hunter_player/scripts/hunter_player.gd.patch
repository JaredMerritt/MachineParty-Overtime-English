+# [MP8] ===== Fire-rate debug hotkeys (number keys 1 / 2 / 3) =====
+#
+# Why "changing the fire rate doesn't feel any different". **The gap between two shots isn't just cycle_time**,
+# it is `0.5 s (hardcoded) + cycle_time`, plus another 2.85 s reload when the magazine runs dry.
+# So 0.80 → 0.70 only turns 1.30 s into 1.20 s, **just 8% faster**, which you basically can't feel.
+#
+# That's why this debug multiplier applies to the **whole interval** (the 0.5 s is scaled too),
+# so pressing 2 really gives double the fire rate and people can actually tell the difference.
+#   1 = normal speed   2 = 2x fire rate (interval ×0.5)   3 = half speed (interval ×2)
+#
+# Only active in dev builds (MP8_DEV_TOOLS) launched with `mp8ratekeys`, so it can't be triggered in release builds.
+var _mp8_rate_scale: float = 1.0
+var _mp8_rate_keys: bool = false
+var _mp8_rate_label: Label = null
+var _mp8_id_label: RichTextLabel = null  # Two lines in two colors, so it has to be rich text
+var _mp8_debug_canvas: CanvasLayer = null
+
+# [MP8] Which hunter this is / how many there are in total (used to show "left/right" in the top-right)
+var mp8_hunter_index: int = -1
+var mp8_hunter_total: int = 1
+
+
+func _mp8_init_rate_keys() -> void :
+	# [MP8] On 2026-08-15 the user asked for the debug keys to be turned off. Now it **only honors an explicit mp8ratekeys**
+	# and no longer turns on along with -debug-tools (the test bench passes -debug-tools by default, which would make it always on).
+	_mp8_rate_keys = NetworkManager.mp8_args().has("mp8ratekeys")
+
+
+func _mp8_handle_rate_key(event: InputEvent) -> void :
+
+	if not _mp8_rate_keys:
+		return
+	if not (event is InputEventKey):
+		return
+	var key: InputEventKey = event
+	if not key.pressed or key.echo:
+		return
+
+	var scale: float = -1.0
+	match key.keycode:
+		KEY_1:
+			scale = 1.0
+		KEY_2:
+			scale = 0.5
+		KEY_3:
+			scale = 2.0
+	if scale < 0.0:
+		return
+
+	_mp8_rate_scale = scale
+
+	var base: float = 0.5 + _mp8_effective_cycle()
+	var label: String = "Normal speed" if is_equal_approx(scale, 1.0) else (
+		"2x fire rate" if scale < 1.0 else "Half speed"
+	)
+	var msg: String = "[Fire rate debug] %s  shot interval %.2f s (%d-player tier cycle=%.2f)" % [
+		label, base * scale, _mp8_tier(), _mp8_effective_cycle()
+	]
+	print("[MP8] " + msg)
+	_mp8_show_rate_hint(msg)
+
