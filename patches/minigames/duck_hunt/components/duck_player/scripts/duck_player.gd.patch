+
 	health -= _damage
 
 	if health > 0:
@@ -343,6 +442,12 @@ func teleport_rpc(_position: Vector3):
 
 	global_position = _position
 
+	# [MP8] T52：换了地方，面包屑与卡住计时一并重置，免得把人传回上一轮的位置
+	_mp8_crumb = _position
+	_mp8_prev_pos = _position
