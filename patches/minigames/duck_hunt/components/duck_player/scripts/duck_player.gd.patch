+	#
+	# The scoring side has a safety net (that part of `duck_hunt.gd` is guarded by `duck_players.has(id)`, so the second call can't get in),
+	# so **the score is not added twice**. What this guards against is duplicated presentation, and `health` being reduced further.
+	#
+	# ⚠️ The check uses `active` instead of `health > 0`. `active` is set to false on death (see below),
+	#    and is also false before the round has started — this covers both "shouldn't take a shot" cases at once.
+	if not active:
+		return
+
 	health -= _damage
 
 	if health > 0:
@@ -343,6 +442,12 @@ func teleport_rpc(_position: Vector3):
 
