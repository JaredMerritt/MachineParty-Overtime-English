+		if r[3] != null:
+			row["crate_pos"] = r[3] as Vector3
+			row["crate_yaw"] = float(r[4])
+		rows.append(row)
+	return rows
+
+
+func _mp8_save_seats() -> bool :
+	var f := FileAccess.open(MP8_SEAT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] Smoke Break: can't write %s" % MP8_SEAT_FILE)
+		return false
+	f.store_line("# Smoke Break (mp8game=4) seat table — **8 rows, one row per seat 1~8**")
+	f.store_line("# Each row = x, z, yaw (degrees), has crate (1/0)")
+	f.store_line("# ⚠️ Only applies with 5 or more players. With ≤4 players the 4 vanilla seats are always used, not a byte changed.")
+	f.store_line("# ⚠️ The revolver angle is computed from coordinates and is only reliable within the angular span of the four vanilla seats:")
+	f.store_line("#    the result must land between %.0f° ~ %.0f°. Outside that range the gun won't aim correctly (the editor shows a yellow warning)." % [
+		MP8_AIM_MIN, MP8_AIM_MAX])
+	f.store_line("# Only added seats have crates (the vanilla four sit on scene art, which can't be removed or added to).")
+	f.store_line("# Deleting this file = back to the built-in 'arc gap filling'.")
+	f.store_line("# Saved at %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for i in player_spawn_positions.size():
+		var n: Node3D = player_spawn_positions[i]
+		var crate = _mp8_crates.get(i)
+		var has: int = 0
+		var line: String = "%.2f, %.2f, %.1f" % [
+			n.global_position.x, n.global_position.z, rad_to_deg(n.global_rotation.y)
+		]
+		if crate != null and is_instance_valid(crate) and (crate as Node3D).visible:
+			has = 1
+			var c3: Node3D = crate
+			# The crate's **absolute position** is saved too (including height) — it's hand-tuned,
+			# so it can't be derived from "seat + fixed offset", or the next match would put it back in the auto position
+			line += ", 1, %.2f, %.2f, %.2f, %.1f" % [
+				c3.global_position.x, c3.global_position.y, c3.global_position.z,
+				rad_to_deg(c3.global_rotation.y)
+			]
+		else:
+			line += ", %d" % has
+		f.store_line(line)
+	f.close()
+	print("[MP8] Smoke Break: seats saved → %s" % ProjectSettings.globalize_path(MP8_SEAT_FILE))
+	return true
+
+
+# ---- In-match manual tuning (mp8smokeedit / play.ps1 -SmokeEdit) ----
+
+func _mp8_edit_begin() -> void :
+
+	if player_spawn_positions.size() <= 4:
+		_mp8_edit_on = false
+		return
+
+	var lbl := Label.new()
+	lbl.name = "MP8SmokeEditPanel"
+	lbl.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
+	lbl.offset_left = 16.0
+	lbl.offset_top = -150.0
+	lbl.offset_right = 980.0
+	lbl.offset_bottom = -8.0
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		lbl.add_theme_font_override("font", f)
+	lbl.add_theme_font_size_override("font_size", 20)
+	lbl.add_theme_color_override("font_color", Color(0.6, 0.95, 1.0))
+	lbl.add_theme_color_override("font_outline_color", Color.BLACK)
+	lbl.add_theme_constant_override("outline_size", 6)
+	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	if _mp8_edit_canvas == null:
+		_mp8_edit_canvas = CanvasLayer.new()
+		_mp8_edit_canvas.layer = 100
+		add_child(_mp8_edit_canvas)
+	_mp8_edit_canvas.add_child(lbl)
+	_mp8_edit_panel = lbl
+
+	# Hang a number tag above each seat — seats are Marker3D nodes and can't be seen
+	for i in player_spawn_positions.size():
+		var tag := Label3D.new()
+		tag.name = "MP8SeatTag"
+		tag.billboard = BaseMaterial3D.BILLBOARD_ENABLED
+		tag.font_size = 90
+		tag.outline_size = 20
+		tag.outline_modulate = Color.BLACK
+		tag.no_depth_test = true
+		if f != null:
+			tag.font = f
+		player_spawn_positions[i].add_child(tag)
+		tag.position = Vector3(0.0, 1.6, 0.0)
+		_mp8_tags.append(tag)
+
+	_mp8_edit_sel = 4
+	# Freeze the countdown right away to allow plenty of time for placement. Press P to let it run
+	mp8_edit_paused = true
+	_mp8_edit_refresh()
+	print("[MP8] Smoke Break: seat tuning on — adjustable %d~%d (vanilla 0~3 locked), round countdown paused (P to resume)" % [
+		4, player_spawn_positions.size() - 1
+	])
+
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or player_spawn_positions.size() <= 4:
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+	var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+
+	match key.keycode:
+		KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8:
+			# [MP8] Number keys 1~8 map to seat indices 0~7, **and the panel and overhead tags also always show 1~8**.
+			# It used to be "keys 5~8 → tags show 4~7", off by one, and the user already got caught by that once.
+			var want: int = key.keycode - KEY_1
+			if want >= player_spawn_positions.size():
+				return
+			_mp8_edit_sel = want
+			_mp8_edit_refresh()
+
+		KEY_X:
+			# Delete/restore the current seat's crate (user on 2026-08-17, some seats shouldn't have a crate)
+			mp8_toggle_crate_rpc.rpc(_mp8_edit_sel)
+
+		KEY_C:
+			# Toggle what I/K/J/L moves, either the seat (with the player) or that seat's crate
+			var cr0 = _mp8_crates.get(_mp8_edit_sel)
+			if cr0 == null or not is_instance_valid(cr0):
+				print("[MP8] Smoke Break: seat %d has no crate, can't switch to it" % (_mp8_edit_sel + 1))
+				return
+			_mp8_edit_crate = not _mp8_edit_crate
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			var dir: Vector2 = _mp8_screen_axis(key.keycode)
+			if dir == Vector2.ZERO:
+				return
+			if _mp8_edit_crate:
+				var cr1 = _mp8_crates.get(_mp8_edit_sel)
+				if cr1 == null or not is_instance_valid(cr1):
+					return
+				var cp := (cr1 as Node3D).global_position
+				mp8_move_crate_rpc.rpc(_mp8_edit_sel,
+					Vector3(cp.x + dir.y * step, cp.y, cp.z + dir.x * step),
+					rad_to_deg((cr1 as Node3D).global_rotation.y))
+			else:
+				var p := n.global_position
+				mp8_move_seat_rpc.rpc(_mp8_edit_sel,
+					Vector2(p.x + dir.y * step, p.z + dir.x * step),
+					rad_to_deg(n.global_rotation.y))
+
+		KEY_U, KEY_O:
+			var d: float = (-15.0 if key.keycode == KEY_U else 15.0)
+			if _mp8_edit_crate:
+				var cr2 = _mp8_crates.get(_mp8_edit_sel)
+				if cr2 == null or not is_instance_valid(cr2):
+					return
+				mp8_move_crate_rpc.rpc(_mp8_edit_sel,
+					(cr2 as Node3D).global_position,
+					rad_to_deg((cr2 as Node3D).global_rotation.y) + d)
+			else:
+				mp8_move_seat_rpc.rpc(_mp8_edit_sel,
+					Vector2(n.global_position.x, n.global_position.z),
+					rad_to_deg(n.global_rotation.y) + d)
+
+		KEY_Y:
+			# Crate height (vanilla crates sit on the ground, and rearranged seats may need them raised a bit)
+			if not _mp8_edit_crate:
+				return
+			var cr3 = _mp8_crates.get(_mp8_edit_sel)
+			if cr3 == null or not is_instance_valid(cr3):
+				return
+			var q := (cr3 as Node3D).global_position
+			mp8_move_crate_rpc.rpc(_mp8_edit_sel,
+				Vector3(q.x, q.y + (step if key.shift_pressed else - step), q.z),
+				rad_to_deg((cr3 as Node3D).global_rotation.y))
+
+		KEY_M:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_P:
+			# Pause/resume the countdown. ⚠️ Must go through an RPC. The timer loop only runs on the **server**,
+			# so changing a local flag does nothing to it (the same shape of pitfall as the Junk Platform falling rocks one).
+			mp8_set_pause_rpc.rpc(not mp8_edit_paused)
+
+		KEY_0:
+			var ok: bool = _mp8_save_seats()
+			_mp8_edit_refresh()
+			if _mp8_edit_panel != null:
+				_mp8_edit_panel.text = ("[SAVED] This seat layout will be used automatically next match\n" if ok
+					else "[SAVE FAILED] Check the log\n") + _mp8_edit_panel.text
+
+		KEY_N:
+			var parts := PackedStringArray()
+			for i in range(4, player_spawn_positions.size()):
+				var q := player_spawn_positions[i].global_position
+				parts.append("Seat %d (%.2f, %.2f) angle %.1f°" % [
+					i, q.x, q.z, _mp8_aim_for(q)])
+			print("[MP8] Smoke Break seat report: %s" % " | ".join(parts))
+
+		_:
+			return
+
+	get_viewport().set_input_as_handled()
+
+
+func _mp8_screen_axis(code: int) -> Vector2 :
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector2.ZERO
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var r2 := Vector2(right.x, right.z)
+	var f2 := Vector2(fwd.x, fwd.z)
+	if r2.length() < 0.001 or f2.length() < 0.001:
+		return Vector2.ZERO
+	r2 = r2.normalized()
+	f2 = f2.normalized()
+	match code:
+		KEY_L: return Vector2(r2.y, r2.x)
+		KEY_J: return - Vector2(r2.y, r2.x)
+		KEY_I: return Vector2(f2.y, f2.x)
+		KEY_K: return - Vector2(f2.y, f2.x)
+	return Vector2.ZERO
+
+
+# [MP8] any_peer + call_local, so all 8 machines move it together (seat markers, crates and number tags are all local nodes on each machine).
+@rpc("any_peer", "call_local", "reliable")
+func mp8_move_seat_rpc(slot: int, pos: Vector2, yaw_deg: float) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not (NetworkManager.mp8_finite_v2(pos) and NetworkManager.mp8_finite(yaw_deg)):
+		return
+
+	# [MP8] The user changed the call on 2026-08-17 so **position and facing of all eight seats can be adjusted** (previously only 4~7 were open).
+	# With ≤4 players this whole custom layout doesn't run, so "4-player matches are identical to vanilla" still holds — that now relies on
+	# the player count check in `_mp8_setup_seats()`, no longer on "locking the vanilla seats".
+	if slot < 0 or slot >= player_spawn_positions.size():
+		return
+	var n: Node3D = player_spawn_positions[slot]
+	if n == null or not is_instance_valid(n):
+		return
+
+	var old: Vector3 = n.global_position
+	n.global_position = Vector3(pos.x, old.y, pos.y)
+	n.global_rotation = Vector3(0.0, deg_to_rad(yaw_deg), 0.0)
+
+	# ⚠️ **Crates don't follow** (the user decided on 2026-08-17 that crate positions are fixed and players get arranged onto the crates).
+	# Moving a seat used to drag its crate along, now a crate is pinned in place once it's built.
+
+	# [MP8] Move **the player sitting in this seat** along with it — a number tag alone isn't enough to place things accurately,
+	# you need to see a player sit there to know whether it's cramped and facing the right way (user request, 2026-08-17).
+	#
+	# ⚠️ Only the server sends this step. `setup_rpc` is itself an RPC,
+	# so sending it again inside a broadcast RPC handler would have all 8 machines broadcast it once each (a storm).
+	if multiplayer.is_server():
+		for p in players_node_parent.get_children():
+			if not (p is SmokeBreakPlayer):
+				continue
+			if (p as SmokeBreakPlayer).active_player_seat_index != slot:
+				continue
+			p.setup_rpc.rpc(
+				n.global_position, n.global_rotation, slot,
+				(mp8_death_anim_by_seat[slot] if slot < mp8_death_anim_by_seat.size() else "")
+			)
+			break
+
+	# Recompute the angle to follow and hand it back to the trolley
+	var trolley: Node = _mp8_find_trolley()
+	if trolley != null:
+		var rots = trolley.get("rot_by_seat_index_array")
+		if rots is Array and slot < (rots as Array).size():
+			var arr: Array[Vector3] = []
+			for r in (rots as Array):
+				arr.append(r as Vector3)
+			arr[slot] = Vector3(_mp8_aim_for(n.global_position), 0.0, 0.0)
+			trolley.set("rot_by_seat_index_array", arr)
+
+	_mp8_edit_refresh()
+
+
+# [MP8] Move a seat's crate (position + facing). Crates are local scene nodes on each machine, so this broadcasts to all of them.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_move_crate_rpc(slot: int, pos: Vector3, yaw_deg: float) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	if not (NetworkManager.mp8_finite_v3(pos) and NetworkManager.mp8_finite(yaw_deg)):
+		return
+
+	var crate = _mp8_crates.get(slot)
+	if crate == null or not is_instance_valid(crate):
+		return
+	(crate as Node3D).global_position = pos
+	(crate as Node3D).global_rotation = Vector3(0.0, deg_to_rad(yaw_deg), 0.0)
+	_mp8_edit_refresh()
+
+
+# [MP8] Delete/restore a seat's crate. Crates are local scene nodes on each machine, so this broadcasts to all of them.
+# Uses visible rather than queue_free, so it can be toggled back and forth and a misplacement doesn't need a new match.
+@rpc("any_peer", "call_local", "reliable")
+func mp8_toggle_crate_rpc(slot: int) -> void :
+
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+
+	var crate = _mp8_crates.get(slot)
+	if crate == null or not is_instance_valid(crate):
+		print("[MP8] Smoke Break: seat %d never had a crate (vanilla seats sit on scene art)" % (slot + 1))
+		_mp8_edit_refresh()
+		return
+
+	(crate as Node3D).visible = not (crate as Node3D).visible
+	print("[MP8] Smoke Break: seat %d crate %s" % [
+		slot + 1, ("shown" if (crate as Node3D).visible else "hidden")
+	])
+	_mp8_edit_refresh()
+
+
+# [MP8] Pause/resume the round countdown. The timer loop is on the server, so this broadcasts to every machine (call_local).
+@rpc("any_peer", "call_local", "reliable")
+func mp8_set_pause_rpc(paused: bool) -> void :
+	if not NetworkManager.mp8_sender_is_host(multiplayer):
+		return
+	# Pausing the round is a dev-build editor feature. Release builds only ever accept an unpause.
+	if paused and not NetworkManager.MP8_DEV_TOOLS:
+		return
+
+	mp8_edit_paused = paused
+	_mp8_edit_refresh()
+	print("[MP8] Smoke Break: round countdown %s" % ("paused" if paused else "resumed"))
+
+
+func _mp8_edit_refresh() -> void :
+
+	for i in _mp8_tags.size():
+		var t: Label3D = _mp8_tags[i]
+		if t == null or not is_instance_valid(t):
+			continue
+		# [MP8] Always show 1~8 to match keys 1~8 (tags used to show 0~7 with keys 5~8, off by one)
+		var sel: bool = (i == _mp8_edit_sel)
+		t.text = ("▼%d▼" % (i + 1)) if sel else str(i + 1)
+		t.modulate = (Color(1.0, 0.85, 0.2) if sel else Color(0.55, 0.75, 0.85))
+
+	if _mp8_edit_panel == null:
+		return
+
+	var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+	var p := n.global_position
+	var aim: float = _mp8_aim_for(p)
+	var ok: bool = _mp8_aim_ok(aim)
+
+	# Distance to the nearest other seat ("too cramped" means this number is too small)
+	var gap: float = INF
+	for i in player_spawn_positions.size():
+		if i == _mp8_edit_sel:
+			continue
+		gap = minf(gap, Vector2(p.x - player_spawn_positions[i].global_position.x,
+			p.z - player_spawn_positions[i].global_position.z).length())
+
+	var crate = _mp8_crates.get(_mp8_edit_sel)
+	var crate_txt: String = "no crate (vanilla seat)"
+	if crate != null and is_instance_valid(crate):
+		crate_txt = ("has crate" if (crate as Node3D).visible else "crate deleted")
+
+	var cr_now = _mp8_crates.get(_mp8_edit_sel)
+	var target: String = "▶ Adjusting [seat/player]"
+	var line2: String = "Position x=%.2f z=%.2f  facing %.0f°   nearest seat %.2f m %s" % [
+		p.x, p.z, rad_to_deg(n.global_rotation.y), gap, ("✓" if gap >= 0.9 else "⚠cramped")]
+	if _mp8_edit_crate and cr_now != null and is_instance_valid(cr_now):
+		var c3: Node3D = cr_now
+		target = "▶ Adjusting [crate]"
+		line2 = "Crate x=%.2f y=%.2f z=%.2f  facing %.0f°   (player at %.2f, %.2f)" % [
+			c3.global_position.x, c3.global_position.y, c3.global_position.z,
+			rad_to_deg(c3.global_rotation.y), p.x, p.z]
+
+	_mp8_edit_panel.text = "\n".join([
+		"[Tuning] Seat %d / %d total   %s   step %.2f m   %s   source %s" % [
+			_mp8_edit_sel + 1, player_spawn_positions.size(), target,
+			MP8_EDIT_STEPS[_mp8_edit_step_i], crate_txt, _mp8_seat_src],
+		line2,
+		"Revolver angle %.1f°  %s" % [aim,
+			("✓ within the vanilla span, aims accurately" if ok
+			else "⚠️ outside the vanilla span %.0f°~%.0f°, this angle **can't be computed reliably**, the gun may miss" % [
+				MP8_AIM_MIN, MP8_AIM_MAX])],
+		"Countdown %s   1~8 select seat  C toggle player/crate  I/K/J/L move  U/O rotate  Y crate height (Shift raises)  M step  X delete crate  P pause  0 save" % [
+			("⏸ paused" if mp8_edit_paused else "▶ running")],
+	])
+
+
+# [MP8] Seat coordinates → revolver angle. See the MP8_AIM_* notes above (including the "not a unique solution" warning).
+func _mp8_aim_for(pos: Vector3) -> float :
+	var b: float = rad_to_deg(atan2(pos.z - MP8_AIM_PIVOT.y, pos.x - MP8_AIM_PIVOT.x))
+	return MP8_AIM_K * b + MP8_AIM_C
+
+
+# Is this angle still within the span of the four vanilla seats (inside = reliable, outside = can't be computed accurately)
+func _mp8_aim_ok(deg: float) -> bool :
+	return deg >= MP8_AIM_MIN - 0.5 and deg <= MP8_AIM_MAX + 0.5
+
+
+# [MP8] Give a new seat a crate to use as a chair (the three props the vanilla four seats sit on stay untouched).
+# Duplicates seat 3's crate and places it under the new seat — using the **offset relative to seat 3**,
+# so the crate sits relative to the player exactly as in vanilla (no need to know the crate's absolute height).
+func _mp8_make_crate(seat_idx: int, seat_pos: Vector3) -> void :
+
+	# Only put crates on the seats that are named
+	if not MP8_CRATE_SEATS.has(seat_idx):
+		return
+
+	var src: Node3D = get_node_or_null(MP8_CRATE_PATH) as Node3D
+	if src == null:
+		push_warning("[MP8] Smoke Break: crate %s not found, seat %d gets no crate" % [MP8_CRATE_PATH, seat_idx + 1])
+		return
+
+	var dup: Node3D = src.duplicate()
+	dup.name = "MP8Crate%d" % seat_idx
+	src.get_parent().add_child(dup)
+	# ⚠️ The offset must be computed from vanilla seat 3's position **before it was moved** (`_mp8_crate_offset`).
+	# This crate is the one vanilla seat 3 originally sits on, so "crate position relative to the player" is measured from there.
+	# Computing it from the seat after it moved would offset every crate — by however far the user moved it,
+	# which looks like "crates wandering at random" and is hard to trace back to the wrong reference frame.
+	dup.global_position = seat_pos + _mp8_crate_offset
+	_mp8_crates[seat_idx] = dup
+
+
+# A new seat uses the death animation of whichever vanilla seat it's next to (window / fan)
+func _mp8_nearest_vanilla_anim(p: Vector3) -> String :
+	var best: int = 0
+	var bd: float = INF
+	for i in mini(4, player_spawn_positions.size()):
+		var d: float = p.distance_to(player_spawn_positions[i].global_position)
+		if d < bd:
+			bd = d
+			best = i
+	return mp8_death_anim_by_seat[best]
+
+
+func _mp8_find_trolley() -> Node :
+	# The trolley manager lives at `trolley gun main parent/trolley gun manager` (measured by probe51)
+	var t: Node = get_node_or_null("trolley gun main parent/trolley gun manager")
+	if t != null:
+		return t
+	# In case the path ever changes, search for "whoever has that angle table" rather than relying on the name
+	for c in find_children("*", "", true, false):
+		if c.get("rot_by_seat_index_array") != null:
+			return c
+	return null
+
