@@ -22,6 +22,68 @@ class_name SmokeBreak_Trolley extends Node
 
 var smoke_particle_active_index = -1
 
+# [MP8] Which seats light up the "fan blood decals" when they die. Vanilla hardcodes `if seat in [1, 2]`,
+# while new seats are judged by the death animation they inherited (inheriting death_fan counts).
+var _mp8_fan_seats: Array[int] = [1, 2]
+
+
+# [MP8] Called by the minigame in _ready() to hand over the expanded seat tables.
+#
+# Why the trolley doesn't expand them itself — it's a **child** of the minigame root node, so its `_ready()` runs **before** the root's
+# (Godot readies descendants first), when the minigame hasn't worked out the new seats yet. So the order is an explicit call rather than guesswork.
+func mp8_extend_seat_arrays(new_rots: Array, seats: Array) -> void :
+
+	# ---- ① Revolver angles. Replace the whole table with the expanded one (the first 4 entries match vanilla value for value) ----
+	var typed: Array[Vector3] = []
+	for r in new_rots:
+		typed.append(r as Vector3)
+	rot_by_seat_index_array = typed
+
+	# ---- ② Blood decals. Duplicate a set for each new seat and shift the whole set over to the new seat ----
+	var made := PackedStringArray()
+	while blood_decals_by_seat_index_array.size() < seats.size():
+
+		var idx: int = blood_decals_by_seat_index_array.size()
+		var seat_pos: Vector3 = (seats[idx] as Node3D).global_position
+
+		# Use the set of the spatially nearest vanilla seat as the template
+		var src_i: int = 0
+		var bd: float = INF
+		for i in mini(4, seats.size()):
+			var d: float = seat_pos.distance_to((seats[i] as Node3D).global_position)
+			if d < bd and i < blood_decals_by_seat_index_array.size():
+				bd = d
+				src_i = i
+
+		var src: Node3D = blood_decals_by_seat_index_array[src_i]
+		if src == null or not is_instance_valid(src):
+			blood_decals_by_seat_index_array.append(null)
+			continue
+
+		var dup: Node3D = src.duplicate()
+		dup.name = "MP8BloodSeat%d" % idx
+		src.get_parent().add_child(dup)
+		# Shift the whole set. The blood decals are **children** of this set node (each with its own world position),
+		# so moving the parent moves the whole set without needing each piece's offset — the lesson from the lobby layout.
+		dup.global_position = src.global_position + (
+			seat_pos - (seats[src_i] as Node3D).global_position
+		)
+		dup.visible = false
+		blood_decals_by_seat_index_array.append(dup)
+
+		# The fan blood follows the template. If the template belongs to seat 1/2, the new seat also counts as "facing the fan"
+		if src_i in [1, 2]:
+			_mp8_fan_seats.append(idx)
+
+		made.append("seat %d←copied seat %d" % [idx, src_i])
+
+	print("[MP8] Smoke Break·trolley: angle table %d entries / blood decals %d sets (new %s) / smoke particles %d (reused via modulo) / fan seats %s" % [
+		rot_by_seat_index_array.size(), blood_decals_by_seat_index_array.size(),
+		(" ".join(made) if made.size() > 0 else "none"),
+		particles_smoke.size(), str(_mp8_fan_seats)
+	])
+
+
