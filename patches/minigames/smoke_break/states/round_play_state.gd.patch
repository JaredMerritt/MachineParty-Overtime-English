diff --git a/minigames/smoke_break/states/round_play_state.gd b/minigames/smoke_break/states/round_play_state.gd
--- a/minigames/smoke_break/states/round_play_state.gd
+++ b/minigames/smoke_break/states/round_play_state.gd
@@ -37,6 +37,12 @@ func enter(_msg: Dictionary = {}) -> void :
 
 	while countdown_timer >= 0:
 
+		# [MP8] Freeze the countdown while seats are being hand-tuned — otherwise the round ends halfway through placement and players get shot.
+		# The flag is read with `owner.get()`, which returns null instead of erroring when the property doesn't exist,
+		# so without tuning mode this while never runs even once, identical to vanilla value for value.
+		while owner.get("mp8_edit_paused") == true:
+			await get_tree().create_timer(0.25).timeout
+
 		countdown_timer -= 1
 		tick_rpc.rpc(countdown_timer + 1)
 		await get_tree().create_timer(1.0).timeout
@@ -60,6 +66,19 @@ func update_physics(_delta: float) -> void :
 @rpc("any_peer", "call_local", "reliable")
 func tick_rpc(time):
 	timer_updated.emit(time)
+
+	# ═══════ [MP8] 2026-08-19 fix — the inner sound effect is only triggered by the server ═══════
+	#
+	# `tick_rpc` itself is a `call_local` broadcast — all 8 peers **do** run this code.
+	# The old version had no guard here, so each of the 8 peers broadcast `play_omni_rpc.rpc()` once,
+	# and every peer ended up receiving 8 copies. `play_omni_rpc` takes a free slot from a 32-voice pool,
+	# so **8 copies = 8 voices sounding at once** (not restarting the same player), about +18 dB,
+	# plus RTT lag smearing them into rapid-fire repeats. The countdown has 31 ticks, and the whole thing was like that.
+	#
+	# With the guard added, only the server broadcasts once → each peer plays it exactly once.
+	if not multiplayer.is_server():
+		return
+
 	SoundManager.play_omni_rpc.rpc(
 		"ekg_beep", 
 		&"MINIGAME_SFX", 
