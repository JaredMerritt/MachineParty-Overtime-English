diff --git a/minigames/smoke_break/states/round_end_state.gd b/minigames/smoke_break/states/round_end_state.gd
--- a/minigames/smoke_break/states/round_end_state.gd
+++ b/minigames/smoke_break/states/round_end_state.gd
@@ -23,13 +23,62 @@ func enter(_msg: Dictionary = {}) -> void :
 	await get_tree().create_timer(1, false).timeout
 	var losers = owner.active_players.duplicate()
 
-	var score_counter: int = 3
-	for player in owner.finished_players:
-		if score_counter <= 0:
-			break
-		owner.player_scores[player.player_presence.network_id] += 1
-		losers.erase(player)
-		score_counter -= 1
+	# ═══════════════════════════════════════════════════════════════════════
+	# [MP8] Placement-based scoring (user decided on 2026-08-17 — placement-based, plus an extra +1 for whoever finishes smoking first)
+	# ═══════════════════════════════════════════════════════════════════════
+	#
+	# **Vanilla mechanics** (checked against the code). Points are only awarded in two places —
+	#   `smoke_break.gd:143` `if finished_players.is_empty(): +1`  first to finish gets +1
+	#   the original `score_counter = 3` in this file              top 3 get +1 each
+	# So 1st place gets +2, 2nd/3rd get +1 and the rest get 0. The default playlist has 2 rounds → **0~4 points** for the whole minigame.
+	#
+	# **Problems with 8 players**
+	#   ① It's the least valuable minigame of all — 0~4, versus Disco Dodge 0~24, Junk Platform 0~21 and Exploding Collar Race 0~18.
+	#   ② "Top 3 score" **doesn't scale with player count**. With 4 players 75% of people can score, with 8 only 37.5%,
+	#      so **5 people get nothing and get shot as well**. That's purely a side effect of player count, not design intent.
+	#   ③ 4th and 8th place tie (both 0), so most of the placement information is lost.
+	#
+	# **The fix** (the project's established approach is to use the minigame's own existing order array index as the score).
+	# `finished_players` really is appended in finishing order, so it's ready to use
+	#   Didn't finish (got shot)      → **0 points** (none of them passed the check, all treated the same)
+	#   j-th to finish (j from 0)     → **N - j** points (N = players this match)
+	#   The first to finish gets another **+1** (keeps vanilla's bonus, which the user specifically asked for)
+	# All 8 finish → 9 / 7 / 6 / 5 / 4 / 3 / 2 / 1, and the 2-point gap between 1st and 2nd
+	# is that bonus. 2 rounds → 0~18, the same tier as Exploding Collar Race, so **no extra multiplier is needed**.
+	#
+	# ⚠️ **Overwrites the whole table** (zero first, then assign) instead of adding onto vanilla's increments —
+	# the "first to finish +1" in `smoke_break.gd` is added during play,
+	# so keeping it would count the bonus a second time. Overwriting is the least hassle, and that line doesn't need to change.
+	#
+	# ⚠️ **Who gets shot is completely unchanged**. `losers` = `active_players`, and players who finish
+	# have already been erased from `active_players` in `_on_player_finished`,
+	# so vanilla's `losers.erase(player)` was always a **no-op** —
+	# everyone who didn't finish still gets shot, identical to vanilla value for value.
+	var mp8_total: int = owner.player_scores.size()
+	for id in owner.player_scores.keys():
+		owner.player_scores[id] = 0
+
+	var mp8_rows := PackedStringArray()
+	for j in owner.finished_players.size():
+		var p = owner.finished_players[j]
+		if p == null or not is_instance_valid(p):
+			continue
+		var pid: int = p.player_presence.network_id
+		if not owner.player_scores.has(pid):
+			continue
+		var s: int = mp8_total - j
+		if j == 0:
+			s += 1
+		owner.player_scores[pid] = s
+		mp8_rows.append("#%d to finish %s %d pts%s" % [
+			j + 1, String(p.player_presence.network_name), s,
+			("(first place bonus +1)" if j == 0 else "")
+		])
+
+	print("[MP8] Smoke Break results (%d players / %d finished / %d shot): %s" % [
+		mp8_total, owner.finished_players.size(), losers.size(),
+		(" | ".join(mp8_rows) if mp8_rows.size() > 0 else "nobody finished, everyone gets 0 points")
+	])
 
 	owner.player_scores_finalized.emit(owner.player_scores)
 
