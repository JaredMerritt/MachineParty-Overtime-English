diff --git a/minigames/smoke_break/components/player/scripts/smoke_break_player_anim_handler.gd b/minigames/smoke_break/components/player/scripts/smoke_break_player_anim_handler.gd
--- a/minigames/smoke_break/components/player/scripts/smoke_break_player_anim_handler.gd
+++ b/minigames/smoke_break/components/player/scripts/smoke_break_player_anim_handler.gd
@@ -173,6 +173,17 @@ func get_eliminated():
 			death_anim_active = "death_fan"
 		3:
 			death_anim_active = "death_window"
+
+	# [MP8] Death animations are **hand-made per seat**, and vanilla only has four branches for 0~3.
+	# Seats 4~7 fall straight through the gap → `anim_player.play("")` (the player gets shot but doesn't fall over).
+	# The minigame works out the animation name from "the spatially nearest vanilla seat" and sends it to the player with setup_rpc. This is the fallback.
+	# With ≤4 players the match always hits, so the two blocks below never run, identical to vanilla value for value.
+	if death_anim_active == "":
+		death_anim_active = String(player.mp8_death_anim)
+	if death_anim_active == "":
+		death_anim_active = "death_window"
+		push_warning("[MP8] Smoke Break: seat %d has no death animation name, falling back to death_window" % player.active_player_seat_index)
+
 	ik_right.stop()
 	anim_player.play(death_anim_active, 0.2)
 
