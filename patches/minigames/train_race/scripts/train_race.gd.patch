+# [MP8] Spawn points 4 → 8 with evenly spaced inserts per column. The 4 vanilla ones stay byte-for-byte untouched.
+func _mp8_expand_spawns() -> void :
+
+	var args := NetworkManager.mp8_args()
+	mp8_player_count = PlayerManager.player_presences.size()
+
+	if player_spawn_positions_node == null:
+		push_warning("[MP8] Train Race: no spawn point container, skipping 8-seat setup")
+		return
+
+	var originals: Array = []
+	for child in player_spawn_positions_node.get_children():
+		if child is Node3D:
+			originals.append(child)
+
+	var n: int = originals.size()
+	if n == 0:
+		push_warning("[MP8] Train Race: spawn point container is empty, skipping 8-seat setup")
+		return
+
+	if args.has("mp8noexpand"):
+		print("[MP8] Train Race: mp8noexpand, spawn points left completely unchanged (pure vanilla control group, ⚠️ must be run with 4 players)")
+		return
+
+	# ⚠️ At ≤4 players never touch anything. This minigame's spawn_players() **shuffles and then picks by index**,
+	# so extra points would get drawn in a 4-player match — once added it would no longer "match vanilla value for value".
+	# (DVD Roomba / Disco Dodge also shuffle, and this is exactly how Disco Dodge guards against it.)
+	if mp8_player_count <= 4:
+		print("[MP8] Train Race: %d players, using the %d vanilla spawn points, nothing changed" % [mp8_player_count, n])
+		return
+
+	var want: int = mini(maxi(mp8_player_count, 5), MP8_MAX_PLAYERS)
+	if n >= want:
+		print("[MP8] Train Race: already %d spawn points (need %d), no top-up needed" % [n, want])
+		return
+
+	# Split into two columns by the sign of x (vanilla has two on each side)
+	var columns: Dictionary = {"left": [], "right": []}
+	for m in originals:
+		if m.position.x < 0.0:
+			columns["left"].append(m)
+		else:
+			columns["right"].append(m)
+
+	# Sort each column by z so we can interpolate between the endpoints
+	for key in columns.keys():
+		columns[key].sort_custom(func(a, b): return a.position.z < b.position.z)
+
+	var need: int = want - n
+	var added: Array = []
+
+	# Hand the needed points out to the two columns in turn so left and right stay symmetric
+	var order: Array = ["left", "right"]
+	var per_column: Dictionary = {"left": 0, "right": 0}
+	for j in need:
+		per_column[order[j % order.size()]] += 1
+
+	for key in order:
+
+		var col: Array = columns[key]
+		var add: int = per_column[key]
+		if add <= 0:
+			continue
+
+		# A column needs at least two endpoints to interpolate. With only one it degrades to "line up right next to it",
+		# but vanilla is 2/2 so this path is never reached. If it ever is, report it instead of silently placing things wrong.
+		if col.size() < 2:
+			push_warning("[MP8] Train Race: column %s has only %d vanilla points, can't interpolate, skipping this column" % [key, col.size()])
+			continue
+
+		var a: Node3D = col[0]
+		var b: Node3D = col[col.size() - 1]
+
+		for i in add:
+			# t runs from 1/(add+1) .. add/(add+1), spreading the new points evenly between the endpoints (lerping x too)
+			var t: float = float(i + 1) / float(add + 1)
+			var extra: Node3D = a.duplicate()
+			extra.name = "MP8Spawn_%s_%d" % [key, i]
+			player_spawn_positions_node.add_child(extra)
+			extra.position = a.position.lerp(b.position, t)
+			added.append(extra)
+
+	# Self-check - compute the minimum gap and write it to the log. Placement changes must be checkable against numbers, not just "it's placed fine".
+	var all_points: Array = originals + added
+	var min_gap: float = INF
+	var min_pair: String = ""
+	for i in all_points.size():
+		for j in range(i + 1, all_points.size()):
+			var d: float = all_points[i].position.distance_to(all_points[j].position)
+			if d < min_gap:
+				min_gap = d
+				min_pair = "%s↔%s" % [all_points[i].name, all_points[j].name]
+
+	var parts: Array = []
+	for m in added:
+		parts.append("%s(%.2f,%.2f)" % [m.name, m.position.x, m.position.z])
+
+	print("[MP8] Train Race: %d players — spawn points %d → %d, min gap %.2f m (%s); added %s" % [
+		mp8_player_count, n, all_points.size(), min_gap, min_pair, ", ".join(parts)])
+
+	if min_gap < MP8_MIN_SPAWN_GAP:
+		push_warning("[MP8] Train Race: min gap %.2f m < %.2f, players may spawn stacked" % [
+			min_gap, MP8_MIN_SPAWN_GAP])
+
