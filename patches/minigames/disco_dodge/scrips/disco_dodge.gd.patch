@@ -156,6 +196,99 @@ func spawn_players():
 
 		counter += 1
 
+# [MP8] Spread the spawn points onto tile centers, one player per tile.
+#
+# **The 4 vanilla nodes are not touched at all** — new ones only go on tile centers they don't already occupy.
+# With ≤4 players none of this runs, so it matches vanilla value for value.
+func _mp8_setup_spawns() -> void :
+
+	var args := NetworkManager.mp8_args()
+	mp8_player_count = PlayerManager.player_presences.size()
+
+	if player_spawn_positions_node == null:
+		push_warning("[MP8] Disco Dodge: no spawn point container, cannot spread out")
+		return
+
+	var have: int = player_spawn_positions_node.get_child_count()
+
+	print("[MP8] Disco Dodge: runtime values — tile grid %d×%d (%d tiles) / tile size %.1f / %d tiles removed per round / %d spawn points; %d players this match" % [
+		tile_rows, tile_columns, tile_rows * tile_columns, tile_size,
+		tiles_to_remove, have, mp8_player_count,
+	])
+
+	if args.has("mp8noexpand"):
+		print("[MP8] Disco Dodge: mp8noexpand, spawn points left unchanged (pure vanilla control group, ⚠️ must be run with 4 players)")
+		return
+
+	if mp8_player_count <= 4:
+		print("[MP8] Disco Dodge: %d players, using the %d vanilla spawn points unchanged" % [mp8_player_count, have])
+		return
+
+	var want: int = mini(maxi(mp8_player_count, 5), MP8_MAX_PLAYERS)
+	if have >= want:
+		return
+
+	# Tile centers already taken by vanilla spawns (matched by local coordinates, tolerance of half a tile)
+	var taken: Array[Vector2] = []
+	for c in player_spawn_positions_node.get_children():
+		if c is Node3D:
+			taken.append(Vector2((c as Node3D).position.x, (c as Node3D).position.z))
+
+	var added := PackedStringArray()
+	for p in _mp8_tile_centers():
+		if player_spawn_positions_node.get_child_count() >= want:
+			break
+		var dup: bool = false
+		for t in taken:
+			if t.distance_to(p) < tile_size * 0.5:
+				dup = true
+				break
+		if dup:
+			continue
+		var m := Marker3D.new()
+		m.name = "MP8Spawn%d" % player_spawn_positions_node.get_child_count()
+		player_spawn_positions_node.add_child(m)
+		m.position = Vector3(p.x, 0.0, p.y)
+		taken.append(p)
+		added.append("(%.0f,%.0f)" % [p.x, p.y])
+
+	print("[MP8] Disco Dodge: spawn points %d → %d, new ones placed on tile centers %s" % [
+		have, player_spawn_positions_node.get_child_count(), " ".join(added)
+	])
+
+
+# **Local** coordinates of every tile center (same space as the vanilla spawn points. The parent has a 0.03 z offset,
+# and local coordinates inherit it automatically, so old and new points share the same offset).
+#
+# Sort order = |z| first, then |x| → **prefer hugging the two central rows and spreading sideways**.
+# That way 8 players fill exactly a central 4×2 block instead of a cross or an irregular shape.
+# It also suits the arena shape (8 tiles along x and only 6 along z, so there is more room sideways anyway).
+func _mp8_tile_centers() -> Array[Vector2] :
+
+	var out: Array[Vector2] = []
+	var start_x: float = - (tile_rows * 0.5) * tile_size + tile_size * 0.5
+	var start_z: float = - (tile_columns * 0.5) * tile_size + tile_size * 0.5
+
+	for ix in tile_rows:
+		for iz in tile_columns:
+			out.append(Vector2(start_x + ix * tile_size, start_z + iz * tile_size))
+
+	out.sort_custom(func(a: Vector2, b: Vector2) -> bool:
+		var az: float = absf(a.y)
+		var bz: float = absf(b.y)
+		if not is_equal_approx(az, bz):
+			return az < bz
+		var ax: float = absf(a.x)
+		var bx: float = absf(b.x)
+		if not is_equal_approx(ax, bx):
+			return ax < bx
+		if not is_equal_approx(a.y, b.y):
+			return a.y < b.y
+		return a.x < b.x
+	)
+	return out
+
+
 func spawn_tiles():
 
 	var start_columns: float = - (tile_columns * 0.5) * tile_size + (tile_size * 0.5)
