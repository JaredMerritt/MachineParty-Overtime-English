+
+# Name length cap. Steam nicknames can be up to 32 characters, and 8 players can add up to 250+ characters,
+# which would blow up the panel without truncation. Godot's String counts by character, so CJK names won't be cut in half.
+const MP8_VOTE_NAME_MAX: int = 10
+const MP8_VOTE_NAMES_SHOWN: int = 6
+const MP8_VOTE_PANEL_W: float = 420.0     # Native render is 960 wide, so a panel this wide is enough
+
+# Our own string table. The game has 17 languages via the standard tr(), but those are compiled
+# .translation binaries we can't add entries to — so we bring a small table of our own,
+# looked up with match TranslationServer.get_locale() (the game itself does exactly this in lobby_handler.gd:80 and
+# credits.gd:38, and the locale codes are short uppercase codes like "ZHS"/"ZHT"/"JA").
+#
+# ⚠️ The game **doesn't detect the system language**. globals.gd's default_settings["language"] is hard-coded to "EN",
+# and after that it follows what the player picked in settings. So falling back to EN here matches the game's own default.
+#
+# Adding a language = adding a block below. PRs welcome.
+const MP8_VOTE_L10N: Dictionary = {
+	"EN": {
+		"title": "Restart this round?",
+		"title_go": "Round restarting",
+		"ctx": "%s · round %d/%d · %d players",
+		"count": "Agreed %d / need %d",
+		"who": "Agreed: ",
+		"sep": ", ",
+		"none": "(nobody yet)",
+		"more": "%s (%d total)",
+		"you_yes": "You: agreed   —   F5 to withdraw",
+		"you_no": "You: not voted   —   F5 to agree, or the ESC menu",
+		"go": "%d s until restart   —   %s",
+		"go_yes": "F5 to withdraw",
+		"go_no": "F5 to agree",
+		"btn": "Restart Round",
+		"btn_vote": "Restart Round (%d/%d)",
+		"btn_undo": "Withdraw Vote (%d/%d)",
+		"btn_go": "Restarting · %d s",
+	},
+	"ZHS": {
+		"title": "Vote to restart this round",
+		"title_go": "This round is about to restart",
+		"ctx": "%s · round %d/%d · %d players",
+		"count": "Agreed %d / needed %d",
+		"who": "Agreed: ",
+		"sep": ", ",
+		"none": "(nobody yet)",
+		"more": "%s and others, %d players",
+		"you_yes": "You: agreed   —   F5 to withdraw vote",
+		"you_no": "You: not voted   —   F5 to agree, also in the ESC menu",
+		"go": "Runs automatically in %d s   —   %s",
+		"go_yes": "F5 to withdraw vote",
+		"go_no": "F5 to agree",
+		"btn": "Restart This Round",
+		"btn_vote": "Restart This Round (%d/%d)",
+		"btn_undo": "Withdraw Vote (%d/%d)",
+		"btn_go": "Restart This Round · %d s",
+	},
+	"ZHT": {
+		"title": "Vote to restart this round",
+		"title_go": "This round is about to restart",
+		"ctx": "%s · round %d/%d · %d players",
+		"count": "Agreed %d / needed %d",
+		"who": "Agreed: ",
+		"sep": ", ",
+		"none": "(nobody yet)",
+		"more": "%s and others, %d players",
+		"you_yes": "You: agreed   —   F5 to withdraw vote",
+		"you_no": "You: not voted   —   F5 to agree, also in the ESC menu",
+		"go": "Runs automatically in %d s   —   %s",
+		"go_yes": "F5 to withdraw vote",
+		"go_no": "F5 to agree",
+		"btn": "Restart This Round",
+		"btn_vote": "Restart This Round (%d/%d)",
+		"btn_undo": "Withdraw Vote (%d/%d)",
+		"btn_go": "Restart This Round · %d s",
+	},
+}
+
+# — UI nodes —
+var _mp8_vote_hud: PanelContainer = null
+var _mp8_vote_lbl_title: Label = null
+var _mp8_vote_lbl_ctx: Label = null
+var _mp8_vote_lbl_count: Label = null
+var _mp8_vote_lbl_who: Label = null
+var _mp8_vote_lbl_you: Label = null
+var _mp8_vote_btn: Button = null              # The one duplicated from the ESC menu's Resume button
+
+
+# --------------------- Input ---------------------
+
+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not (event is InputEventKey):
+		return
+	var k: InputEventKey = event
+	if not k.pressed or k.echo or k.keycode != MP8_VOTE_KEY:
+		return
+
+	get_viewport().set_input_as_handled()
+	_mp8_vote_press()
+
+
+# Shared entry point for F5 and the ESC button.
+func _mp8_vote_press() -> void :
+
+	# When not online (local/single player), take the local path directly — rpc_id errors out when there's no peer
+	if not multiplayer.has_multiplayer_peer():
+		_mp8_vote_rpc()
+	else:
+		_mp8_vote_rpc.rpc_id(1)
+
+
+# --------------------- Server side ---------------------
+
+@rpc("any_peer", "call_local", "reliable")
+func _mp8_vote_rpc() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var who: int = multiplayer.get_remote_sender_id()
+	if who == 0:
+		who = 1                                    # Pressed by the host itself, and a local call has no sender
+
+	# Online, only players actually in the lobby can vote, and each player can toggle at most twice a second.
+	# Without this a modified client could flood the host's log and every player's connection.
+	if multiplayer.has_multiplayer_peer():
+		if not PlayerManager.player_presences.has(who):
+			return
+		var now: int = Time.get_ticks_msec()
+		if now - int(_mp8_vote_last_press.get(who, -100000)) < 500:
+			return
+		_mp8_vote_last_press[who] = now
+
+	if minigame == null or not _mp8_vote_round_open:
+		print("[MP8-VOTE] %d pressed restart outside a running round, ignored" % who)
+		return
+
+	if int(_mp8_restarts_by_slot.get(session_minigame_index, 0)) >= MP8_VOTE_MAX_RESTARTS:
+		print("[MP8-VOTE] %d pressed restart, but this minigame was already restarted %d times, ignored" % [who, MP8_VOTE_MAX_RESTARTS])
+		return
+
+	if PlayerManager.player_presences.size() < 2:
+		print("[MP8-VOTE] Fewer than 2 players, restarting is pointless, ignored")
+		return
+
+	if _mp8_vote_yes.has(who):
+		_mp8_vote_yes.erase(who)
+		print("[MP8-VOTE] %d withdrew their vote" % who)
+	else:
+		_mp8_vote_yes[who] = true
+		print("[MP8-VOTE] %d voted to restart this round" % who)
+
+	_mp8_vote_recount()
+
+
+# Recount the votes. Disconnected players shouldn't keep holding a vote — in an 8-player match one disconnect could push the votes past half on the spot,
+# which means "fewer people", not "everyone agreed", so their vote has to be removed before counting.
+func _mp8_vote_recount() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	for id in _mp8_vote_yes.keys():
+		if not PlayerManager.player_presences.has(id):
+			_mp8_vote_yes.erase(id)
+			print("[MP8-VOTE] %d is no longer in the lobby, removing their vote" % id)
+
+	var n: int = PlayerManager.player_presences.size()
+	var yes: int = _mp8_vote_yes.size()
+	var need: int = int(floor(float(n) / 2.0)) + 1      # Majority
+
+	if yes >= need:
+		if _mp8_vote_deadline < 0.0:
+			_mp8_vote_deadline = MP8_VOTE_COUNTDOWN
+			print("[MP8-VOTE] Majority reached (%d/%d, need %d) — auto-restarting this round in %.0f s" % [yes, n, need, MP8_VOTE_COUNTDOWN])
+	else:
+		if _mp8_vote_deadline >= 0.0:
+			_mp8_vote_deadline = -1.0
+			print("[MP8-VOTE] Votes fell back to %d/%d (need %d), countdown cancelled" % [yes, n, need])
+
+	_mp8_vote_broadcast(need)
+
+
+# Names are resolved **on the server** before broadcasting. Having clients look up player_presences by id themselves
+# fails (in testing it showed "P6") — the server has the full data and can also fall back to
+# connected_players, which is how the game itself does it in propagate_player_rpc.
+func _mp8_vote_broadcast(need: int) -> void :
+
+	var voters := PackedInt32Array()
+	var names := PackedStringArray()
+	for id in _mp8_vote_yes.keys():
+		voters.append(int(id))
+		names.append(_mp8_vote_name_of(int(id)))
+	_mp8_vote_state_rpc.rpc(
+		voters, names, need, _mp8_vote_deadline,
+		session_current_minigame_round, session_current_minigame_max_rounds
+	)
+
+
+func _mp8_vote_name_of(id: int) -> String :
+
+	var pres = PlayerManager.player_presences.get(id)
+	if pres != null and is_instance_valid(pres):
+		var nm := String(pres.network_name)
+		if nm != "":
+			return nm
+
+	# Fallback. The game itself iterates connected_players in propagate_player_rpc
+	# and matches by peer_id, so copy that path.
+	if NetworkManager.active_backend != null:
+		for info in NetworkManager.active_backend.connected_players.values():
+			if typeof(info) == TYPE_DICTIONARY and int(info.get("peer_id", -1)) == id:
+				var nm2 := String(info.get("name", ""))
+				if nm2 != "":
+					return nm2
+
+	return "P%d" % id
+
+
+func _mp8_vote_tick(delta: float) -> void :
+
+	if not multiplayer.is_server():
+		return
+	if _mp8_vote_yes.is_empty() and _mp8_vote_deadline < 0.0:
+		return
+
+	# Someone dropped during the countdown -> the player count and the threshold changed, so recount
+	if _mp8_vote_yes.size() > PlayerManager.player_presences.size():
+		_mp8_vote_recount()
+
+	if _mp8_vote_deadline >= 0.0:
+		_mp8_vote_deadline -= delta
+		if _mp8_vote_deadline <= 0.0:
+			# Check again at the moment of restarting. The round may have ended while the countdown was running.
+			if minigame == null or not is_instance_valid(minigame) or not _mp8_vote_round_open:
+				print("[MP8-VOTE] The round ended before the countdown finished, restart cancelled")
+				_mp8_vote_clear()
+				return
+			_mp8_do_restart_round()
+			return
+
+	# Rebroadcast the full state once per second. Besides refreshing the countdown, this also solves "someone joining midway
+	# can't see the vote in progress" — they get the full state the next second, with no separate resend logic needed.
+	_mp8_vote_beat -= delta
+	if _mp8_vote_beat <= 0.0:
+		_mp8_vote_beat = 1.0
+		var n: int = PlayerManager.player_presences.size()
+		_mp8_vote_broadcast(int(floor(float(n) / 2.0)) + 1)
+
+
+func _mp8_do_restart_round() -> void :
+
+	var n: int = PlayerManager.player_presences.size()
+	var yes: int = _mp8_vote_yes.size()
+	var mg: String = "?" if minigame == null else String(minigame.name)
+
+	# Forced log — the most valuable line in the whole feature, not gated by any debug switch.
+	# When players restarted, in which minigame, with how many players, in which round, it's all here.
+	# printerr is used so it also goes to stderr, making it harder to miss when players send in logs.
+	printerr("[MP8-RESTART] This round was restarted by vote — minigame=%s id=%d players=%d round=%d/%d votes=%d" % [
+		mg, int(Globals.current_minigame_identifier), n,
+		session_current_minigame_round, session_current_minigame_max_rounds, yes
+	])
+
+	# Count this restart against the playlist slot and close voting until load_minigame opens the new round
+	_mp8_restarts_by_slot[session_minigame_index] = int(_mp8_restarts_by_slot.get(session_minigame_index, 0)) + 1
+	_mp8_vote_round_open = false
+
+	# Roll back the scores already booked this round (the reason is at the start of this section)
+	if not _mp8_round_score_snapshot.is_empty():
+		round_score_by_network_id = _mp8_round_score_snapshot.duplicate(true)
+
+	_mp8_vote_clear()      # It broadcasts the empty state by itself
+
+	if session_minigame_index < 0 or session_minigame_index >= session_minigame_list.size():
+		printerr("[MP8-RESTART] Playlist index %d out of range (%d entries), aborting restart" % [session_minigame_index, session_minigame_list.size()])
+		return
+
+	# Same path as "go to the next round". _total_rounds uses the default -1, and the round counter isn't reset
+	load_minigame(session_minigame_list[session_minigame_index], true)
+
+
+func _mp8_vote_clear() -> void :
+
+	_mp8_vote_yes.clear()
+	_mp8_vote_deadline = -1.0
+	_mp8_vote_beat = 0.0
+	_mp8_vote_view = PackedInt32Array()
+	_mp8_vote_view_secs = -1.0
+	_mp8_vote_refresh_ui()
+
+	# When the server clears votes it must broadcast the empty state, otherwise the client's panel would linger.
+	# The per-second heartbeat only broadcasts while "there are votes", so after clearing nobody would tell the clients anymore.
+	# (Moving on to the next round normally also comes through here — that's actually the path most likely to leave leftovers.)
+	if multiplayer.has_multiplayer_peer() and multiplayer.is_server():
+		_mp8_vote_state_rpc.rpc(PackedInt32Array(), PackedStringArray(), 0, -1.0, 0, 0)
+
+
+# --------------------- Display layer (each peer on its own) ---------------------
+
+@rpc("authority", "call_local", "reliable")
+func _mp8_vote_state_rpc(
+	voters: PackedInt32Array, names: PackedStringArray,
+	need: int, secs: float, rnd: int, rnd_max: int
+) -> void :
+
+	_mp8_vote_view = voters
+	_mp8_vote_view_names = names
+	_mp8_vote_view_need = need
+	_mp8_vote_view_secs = secs
+	_mp8_vote_view_round = rnd
+	_mp8_vote_view_round_max = rnd_max
+	_mp8_vote_refresh_ui()
+
+
+func _mp8_vote_local_id() -> int :
+
+	return 1 if not multiplayer.has_multiplayer_peer() else multiplayer.get_unique_id()
+
+
+# String lookup for this mod's own strings. Falls back to EN — matching the default in the game's default_settings.
+func _mp8_t(key: String) -> String :
+
+	var en: Dictionary = MP8_VOTE_L10N["EN"]
+	var tbl: Dictionary = MP8_VOTE_L10N.get(String(TranslationServer.get_locale()).to_upper(), en)
+	return String(tbl.get(key, en.get(key, key)))
+
+
+func _mp8_vote_clip(nm: String) -> String :
+
+	if nm.length() <= MP8_VOTE_NAME_MAX:
+		return nm
+	return nm.substr(0, MP8_VOTE_NAME_MAX) + "…"
+
+
+func _mp8_vote_names_text() -> String :
+
+	var n: int = _mp8_vote_view_names.size()
+	if n == 0:
+		return _mp8_t("none")
+
+	var shown := PackedStringArray()
+	for i in mini(n, MP8_VOTE_NAMES_SHOWN):
+		shown.append(_mp8_vote_clip(_mp8_vote_view_names[i]))
+
+	var joined: String = String(_mp8_t("sep")).join(shown)
+	if n > MP8_VOTE_NAMES_SHOWN:
+		return _mp8_t("more") % [joined, n]
+	return joined
+
+
+func _mp8_vote_refresh_ui() -> void :
+
+	var n: int = PlayerManager.player_presences.size()
+	var yes: int = _mp8_vote_view.size()
+	var me: int = _mp8_vote_local_id()
+	var i_voted: bool = _mp8_vote_view.has(me)
+	var counting: bool = _mp8_vote_view_secs >= 0.0
+
+	# — The ESC menu button - always present during a match, with text that follows the state —
+	if is_instance_valid(_mp8_vote_btn):
+		_mp8_vote_btn.visible = (minigame != null)
+		if counting:
+			_mp8_vote_btn.text = _mp8_t("btn_go") % int(ceil(_mp8_vote_view_secs))
+		elif yes <= 0:
+			_mp8_vote_btn.text = _mp8_t("btn")
+		elif i_voted:
+			_mp8_vote_btn.text = _mp8_t("btn_undo") % [yes, _mp8_vote_view_need]
+		else:
+			_mp8_vote_btn.text = _mp8_t("btn_vote") % [yes, _mp8_vote_view_need]
+
+	# — The HUD at the top of the screen - fully collapsed when there's no vote —
+	if yes <= 0 and not counting:
+		if is_instance_valid(_mp8_vote_hud):
+			_mp8_vote_hud.visible = false
+		return
+
+	if not is_instance_valid(_mp8_vote_hud):
+		_mp8_vote_hud_build()
+
+	_mp8_vote_hud.visible = true
+
+	# Minigame names go through the game's own localization table — the same path the picker screen uses
+	# (intermission_game_picker.gd:345), so all 17 languages follow automatically.
+	var mg_name: String = tr(String(
+		Globals.MinigameReadableNames.get(Globals.current_minigame_identifier, "N/A")
+	))
+
+	_mp8_vote_lbl_ctx.text = _mp8_t("ctx") % [
+		mg_name, _mp8_vote_view_round, _mp8_vote_view_round_max, n
+	]
+	_mp8_vote_lbl_count.text = _mp8_t("count") % [yes, _mp8_vote_view_need]
+	_mp8_vote_lbl_who.text = _mp8_t("who") + _mp8_vote_names_text()
+
+	if counting:
+		_mp8_vote_lbl_title.text = _mp8_t("title_go")
+		_mp8_vote_lbl_you.text = _mp8_t("go") % [
+			int(ceil(_mp8_vote_view_secs)),
+			(_mp8_t("go_yes") if i_voted else _mp8_t("go_no"))
+		]
+	else:
+		_mp8_vote_lbl_title.text = _mp8_t("title")
+		_mp8_vote_lbl_you.text = (_mp8_t("you_yes") if i_voted else _mp8_t("you_no"))
+
+
+# Native rendering is only 960x540, so small font sizes are unreadable, and without a background it's unreadable in bright scenes too,
+# so it uses a PanelContainer with a semi-transparent dark background + green border (the same colors as this mod's other HUDs).
+func _mp8_vote_hud_build() -> void :
+
+	var layer := CanvasLayer.new()
+	layer.name = "MP8VoteHud"
+	layer.layer = 100
+	add_child(layer)
+
+	var panel := PanelContainer.new()
+	panel.name = "Panel"
+	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	panel.anchor_left = 0.5
+	panel.anchor_right = 0.5
+	panel.anchor_top = 0.0
+	panel.anchor_bottom = 0.0
+	panel.grow_horizontal = Control.GROW_DIRECTION_BOTH
+	panel.grow_vertical = Control.GROW_DIRECTION_END
+	panel.offset_top = 10.0
+
+	var sb := StyleBoxFlat.new()
+	sb.bg_color = Color(0.0, 0.0, 0.0, 0.72)
+	sb.border_color = Color(0.4, 0.9, 0.4)
+	sb.set_border_width_all(1)
+	sb.set_content_margin_all(10)
+	panel.add_theme_stylebox_override("panel", sb)
+	layer.add_child(panel)
+
+	var box := VBoxContainer.new()
+	box.add_theme_constant_override("separation", 2)
+	panel.add_child(box)
+
+	_mp8_vote_lbl_title = _mp8_vote_mk_label(box, 18, Color(0.55, 1.0, 0.55))
+	_mp8_vote_lbl_ctx   = _mp8_vote_mk_label(box, 13, Color(0.75, 0.75, 0.75))
+	_mp8_vote_lbl_count = _mp8_vote_mk_label(box, 16, Color(1.0, 1.0, 1.0))
+	_mp8_vote_lbl_who   = _mp8_vote_mk_label(box, 13, Color(0.85, 0.85, 0.85))
+	_mp8_vote_lbl_you   = _mp8_vote_mk_label(box, 14, Color(1.0, 0.9, 0.4))
+
+	# These two lines are the only ones that can get long. Names can be long and numerous, and English hints are longer than Chinese.
+	# A width limit + autowrap keeps the panel from being pushed off screen.
+	for l in [_mp8_vote_lbl_who, _mp8_vote_lbl_you]:
+		l.custom_minimum_size.x = MP8_VOTE_PANEL_W
+		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+
+	_mp8_vote_hud = panel
+
+
+# The game's bundled font must be applied explicitly. The default theme font has no Chinese glyphs,
+# and using it directly shows boxes — Manufacture Gun's "guns heavily nerfed" notice
+# (manufacture_gun.gd) does it this way, and that path has already been verified in the real game.
+func _mp8_vote_mk_label(parent: Node, size: int, col: Color) -> Label :
+
+	var l := Label.new()
+	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+
+	var f = load("res://fonts/Terminal F4.ttf")
+	if f != null:
+		l.add_theme_font_override("font", f)
+
+	l.add_theme_font_size_override("font_size", size)
+	l.add_theme_color_override("font_color", col)
+	l.add_theme_color_override("font_outline_color", Color.BLACK)
+	l.add_theme_constant_override("outline_size", 4)
+	parent.add_child(l)
+	return l
+
+
+# ----------- Button in the ESC menu (injected at runtime) -----------
+#
+# Why inject at runtime instead of changing the scene? This project's build pipeline only compiles .gdc (54 scripts),
+# and changing a .tscn means producing binary scenes, a whole new capability, with cost and risk out of proportion.
+#
+# Why does game.gd inject it instead of adding a pause_menu.gd patch? That would take the patch surface from 54 to 55,
+# and the just-verified "overlay pack vs PCK repack byte-for-byte equivalence" would have to be redone.
+# Also, the voting logic already all lives in this file.
+#
+# The look comes for free via duplicate(). Copying the existing Resume button inherits the theme, font,
+# and even its ButtonClass child node at no cost —
+# the same trick as copying the chairs in the lobby (_mp8_clone_chairs).
+
+func _mp8_vote_button_attach() -> void :
+
+	if is_instance_valid(_mp8_vote_btn):
+		return
+	if PauseMenu == null:
+		return
+
+	var resume = PauseMenu.get("resume_button")
+	if resume == null or not is_instance_valid(resume):
+		print("[MP8-VOTE] Resume button not found in the ESC menu, skipping button injection (F5 still works)")
+		return
+
+	var box: Node = (resume as Button).get_parent()
+	if box == null:
+		return
+
+	# Don't copy signals — if they came along, clicking it would trigger Resume.
+	var btn: Button = (resume as Button).duplicate(
+		Node.DUPLICATE_GROUPS | Node.DUPLICATE_SCRIPTS
+	)
+	btn.name = "MP8RestartVote"
+	btn.visible = false
+
+	# Safety net - in case duplicate still brought connections along, disconnect all of them
+	for c in btn.pressed.get_connections():
+		btn.pressed.disconnect(c["callable"])
+	btn.pressed.connect(_mp8_vote_press)
+
