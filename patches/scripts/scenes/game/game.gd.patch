+var _mp8_round_score_snapshot: Dictionary = {}
+var _mp8_vote_round_open: bool = false        # True from a round's load until its scores are booked. Votes only count in between
+var _mp8_vote_last_press: Dictionary = {}     # network_id -> msec of their last vote toggle, for rate limiting
+var _mp8_restarts_by_slot: Dictionary = {}    # session_minigame_index -> restarts already used on that playlist slot
+const MP8_VOTE_MAX_RESTARTS: int = 2          # Restarts allowed per playlist slot, so a majority can't wipe a round forever
+
