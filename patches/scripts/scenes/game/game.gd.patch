+# [MP8] T44 item 0 - re-evaluate the loading gate after a disconnect.
+#
+# The fix differs for the two disconnect timings, so **both removal and recount are needed**.
+#   · Drops **before** reporting → once the denominator drops by 1 it's actually equal, so recounting alone is enough.
+#   · Drops **after** reporting → `players_loaded` has one more than the denominator, and **it can never be equal without removing that entry first**.
+#
+# ⚠️ `is_all_player_loaded` is used as the "already let through" flag. All 15 minigames'
+#    `all_players_loaded()` overrides set it to true on the server side (checked one by one), so it can be trusted.
+#    Without this check, a disconnect **after the match has started** would re-initialize the whole match.
+# ⚠️ Server only. The gate itself is also wrapped in `if multiplayer.is_server()`.
+func _mp8_recheck_load_gate(_network_id: int) -> void :
+
+	if not multiplayer.is_server():
+		return
+	if not is_instance_valid(minigame):
+		return
+	if minigame.is_all_player_loaded:
+		return
+
+	var before: int = minigame.players_loaded.size()
+	minigame.players_loaded.erase(_network_id)
+
+	var have: int = minigame.players_loaded.size()
+	var want: int = PlayerManager.player_presences.size()
+	var pass_now: bool = want > 0 and have >= want
+
+	print("[MP8] Gate recheck after disconnect: %d dropped → reported %d (before removal %d) / present %d — %s" % [
+		_network_id, have, before, want, "gate passed" if pass_now else "some players haven't reported yet, still waiting"
+	])
+
+	if not pass_now:
+		return
+
+	minigame.all_players_loaded()
+
