+# ═══════════════════════════════════════════════════════════════════════════
+# [MP8] Promo screenshots (mp8promo) — generic in-match self-screenshots, independent of any specific minigame
+# ═══════════════════════════════════════════════════════════════════════════
+#
+# Background. Of the 15 minigames only 5 have their own `_mp8_shot()` (Junk Platform/Chisel Gauntlet/Duck Hunt/Escalator Pit/Burn Recycle),
+# and the other 10 can't capture a single frame. Adding it one by one means changing 10 scripts, with 10 regression risks,
+# while **grabbing the viewport has nothing to do with which minigame it is** — so it hangs here, with one place covering all 15.
+#
+# Division of labor with `_mp8_shot()`. Those are for **acceptance checks** (fixed spots, fixed timing, tied to their own debug switches).
+# This one is for **making promo images** and only cares whether the frame is clean. The two don't interfere and can coexist.
+#
+# ⚠️ Why hang this off the end of load_minigame() instead of some Play state?
+# `game.gd` can't see each minigame's internal state machine (those are 15 different things).
+# Counting seconds from the moment "the minigame enters the tree" is the only reference point that holds for all 15.
+# The cost is imprecise timing (each minigame's intro has a different length), so by default it captures three time points to pick from.
+#
+# Switches (all only meaningful together with mp8promo)
+#   mp8promo          master switch. If it isn't passed, the function returns on its first line
+#   mp8promoat=10,16  which seconds after entering the minigame to capture at, comma-separated, as many as you like (default 10,16,22)
+#   mp8promoui        **keep** the debug UI (by default it's hidden at the moment of capture)
+#
+# Output goes to user://mp8_promo_<minigame_id>_t<seconds>_<peer>.png
+#   i.e. %APPDATA%\Godot\app_userdata\Machine Party\
+func _mp8_promo_shot(minigame_identifier: int) -> void :
+
+	if not NetworkManager.mp8_args().has("mp8promo"):
+		return
+
+	var times: Array = []
+	var spec: String = _mp8_arg("mp8promoat=")
+	if spec == "":
+		times = [10.0, 16.0, 22.0]
+	else:
+		for part in spec.split(",", false):
+			var v: float = float(part)
+			if v > 0.0:
+				times.append(v)
+	if times.is_empty():
+		return
+	times.sort()
+
+	var peer: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var waited: float = 0.0
+
+	for t in times:
+		# Wait segment by segment. Time points are absolute seconds counted from "entering the tree", not intervals between each other
+		var gap: float = float(t) - waited
+		if gap > 0.0:
+			await get_tree().create_timer(gap, false).timeout
+			waited = float(t)
+
+		# If the minigame gets swapped out midway (rounds finished / restarted after a disconnect), stop capturing,
+		# otherwise the next minigame's frame would be saved under the previous one's id.
+		if not is_inside_tree():
+			return
+		if Globals.current_minigame_identifier != minigame_identifier:
+			return
+
+		# Hide the debug UI at the moment of capture, and restore it right after.
+		# That way the image comes out clean no matter how many debug switches are on the command line.
+		# ⚠️ Only hide help_label (debug help text), and **leave the overhead nametags alone** —
+		# nametags and help_label are both in Globals.GROUP_UI, but the nametags are a vanilla feature,
+		# and "8 names over heads at once" is exactly what this image is meant to show. Hiding them would make it less convincing.
+		var hidden: Array = []
+		if not NetworkManager.mp8_args().has("mp8promoui"):
+			if debug_player_handler != null and debug_player_handler.help_label != null:
+				if debug_player_handler.help_label.visible:
+					hidden.append(debug_player_handler.help_label)
+					debug_player_handler.help_label.visible = false
+			_mp8_hide_debug_overlays(get_tree().root, hidden)
+
+		await RenderingServer.frame_post_draw
+
+		var img: Image = get_viewport().get_texture().get_image()
+		if img != null:
+			var path: String = "user://mp8_promo_%d_t%d_%d.png" % [minigame_identifier, int(t), peer]
+			img.save_png(path)
+			print("[MP8] mp8promo: saved %s" % path)
+
+		for node in hidden:
+			if is_instance_valid(node):
+				node.visible = true
+
+
+# [MP8] Recursively hide the debug overlays this mod added, collecting them into out so they can be restored after the capture.
+#
+# ⚠️ The criterion is **all three conditions at once**. Missing any one of them causes collateral damage.
+#   ① Is a CanvasLayer or Control — this excludes MP8Press / MP8Belt / MP8Spawn and the like,
+#      Node3Ds that also start with MP8 but **are gameplay entities**. Hiding those would take the arena apart.
+#   ② Name starts with MP8 — only things this mod added. Vanilla UI is never touched.
+#   ③ Name contains Panel / Debug / Info — only **debug overlays**.
+#      This keeps MP8BurnScoreBoard (the 8-player results board) and MP8RoleRich (the role reveal) visible,
+#      which players are meant to see and which are exactly what the promo images want to show.
+func _mp8_hide_debug_overlays(node: Node, out: Array) -> void :
+
+	var n: String = node.name
+	if n.begins_with("MP8") and (node is CanvasLayer or node is Control):
+		if n.contains("Panel") or n.contains("Debug") or n.contains("Info"):
+			if node.visible:
+				out.append(node)
+				node.visible = false
+			return
+
+	for child in node.get_children():
+		_mp8_hide_debug_overlays(child, out)
+
+
+# [MP8] Read a command-line argument of the form mp8xxx=<value>, returning an empty string if it isn't found
+func _mp8_arg(prefix: String) -> String:
+	for a in NetworkManager.mp8_args():
+		var s: String = str(a)
+		if s.begins_with(prefix):
+			return s.substr(prefix.length())
+	return ""
+
+
+# [MP8] Crash breadcrumbs. Each entry is open-write-close to guarantee it reaches the disk. Only enabled when mp8trace is passed.
+var _mp8_trace_on: int = -1
+
+func _mp8_trace(msg: String) -> void :
+
+	if _mp8_trace_on == -1:
+		_mp8_trace_on = 1 if NetworkManager.mp8_args().has("mp8trace") else 0
+
+	if _mp8_trace_on == 0:
+		return
+
+	var path := "user://mp8_trace.txt"
+	var f := FileAccess.open(path, FileAccess.READ_WRITE) if FileAccess.file_exists(path) else FileAccess.open(path, FileAccess.WRITE)
+	if f == null:
+		return
+	f.seek_end()
+	f.store_line("[%d] %s" % [multiplayer.get_unique_id() if multiplayer else 0, msg])
+	f.close()
 
